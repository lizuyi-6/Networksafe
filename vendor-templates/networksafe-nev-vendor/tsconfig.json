{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "contracts/**/*.ts",
    "mock-control-plane/**/*.ts",
    "reference-companion/**/*.ts",
    "acceptance-tests/**/*.ts"
  ]
}


