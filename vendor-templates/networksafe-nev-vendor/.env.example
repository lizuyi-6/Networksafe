# Mock control plane listen port
MOCK_CONTROL_PLANE_PORT=3405

# Device gateway path exposed by the mock control plane
MOCK_DEVICE_GATEWAY_PATH=/ws/device

# Local development identity used by the reference companion
MOCK_DEVICE_ID=nev-demo-001
MOCK_DEVICE_API_KEY=vendor-test-device-key
MOCK_DEVICE_COMMAND_SECRET=vendor-test-command-secret

# Commands listed here auto-confirm in the reference companion for bench validation only
MOCK_AUTO_CONFIRM_COMMANDS=host_remove

# Test-only physical confirmation keys shipped with this repository
PHYSICAL_CONFIRMATION_PRIVATE_KEY_FILE=./contracts/test-keys/physical-confirmation-private.pem
PHYSICAL_CONFIRMATION_PUBLIC_KEY_FILE=./contracts/test-keys/physical-confirmation-public.pem
