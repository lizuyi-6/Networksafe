(wire (pts (xy 88.9 105.41) (xy 88.9 104.775)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000020"))
;; C5 pin 2 (bottom) → GND power symbol
(wire (pts (xy 88.9 110.49) (xy 88.9 113.03)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000021"))

;; ----- C6 connections (GND/VCC pin 21 area decoupling) -----
