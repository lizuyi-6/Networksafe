(wire (pts (xy 88.9 79.375) (xy 88.9 80.01)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000001"))
;; C3 pin 2 (bottom) → GND power symbol
(wire (pts (xy 88.9 85.09) (xy 88.9 87.63)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000002"))
;; C3 top rail connects to U1 pin 2 (3V3) via short trace < 5mm annotation
(wire (pts (xy 88.9 80.01) (xy 105.41 80.01)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000003"))

;; ----- C4 connections (VCC pin 20 decoupling) -----
