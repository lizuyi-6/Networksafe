;; C4 top rail connects to U1 pin 20 (VCC) via short trace < 5mm annotation
(wire (pts (xy 152.4 87.63) (xy 136.525 87.63)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000012"))

;; ----- C5 connections (GND/VCC pin 15 area decoupling) -----
