;; ===== C3: 100nF MLCC 0402 — VCC Pin 2 decoupling =====
;; Placed within 5mm of U1 pin 2 (3V3). Trace annotation: < 5mm.
;; Requirement 1.5: one 100nF MLCC at each ESP32 VCC pin, trace < 5mm
(symbol
(lib_id "AG_CAP_100NF_0402")
