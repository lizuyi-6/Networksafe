;; ----- ESP32-WROOM-32E Module Symbol -----
;; 38-pin module: 18 pins left side, 18 pins right side, 2 GND pads on bottom
;; Pin mapping per Espressif ESP32-WROOM-32E datasheet:
;;   Pin 1  = GND
;;   Pin 2  = 3V3 (VCC)
;;   Pin 3  = EN
;;   Pin 4  = GPIO36 (SENSOR_VP)
;;   Pin 5  = GPIO39 (SENSOR_VN)
;;   Pin 6  = GPIO34
;;   Pin 7  = GPIO35
;;   Pin 8  = GPIO32
;;   Pin 9  = GPIO33
;;   Pin 10 = GPIO25
;;   Pin 11 = GPIO26
;;   Pin 12 = GPIO27
;;   Pin 13 = GPIO14
;;   Pin 14 = GPIO12
;;   Pin 15 = GND
;;   Pin 16 = GPIO13
;;   Pin 17 = GPIO9  (SD2)
;;   Pin 18 = GPIO10 (SD3)
;;   Pin 19 = GPIO11 (CMD)
;;   Pin 20 = VCC (3V3)
;;   Pin 21 = GND
;;   Pin 22 = GPIO6  (CLK)
;;   Pin 23 = GPIO7  (SD0)
;;   Pin 24 = GPIO8  (SD1)
;;   Pin 25 = GPIO15
;;   Pin 26 = GPIO2
;;   Pin 27 = GPIO0
;;   Pin 28 = GPIO4
;;   Pin 29 = GPIO16
;;   Pin 30 = GPIO17
;;   Pin 31 = GPIO5
;;   Pin 32 = GPIO18
;;   Pin 33 = GPIO19
;;   Pin 34 = GND
;;   Pin 35 = GPIO21
;;   Pin 36 = RXD0 (GPIO3)
;;   Pin 37 = TXD0 (GPIO1)
;;   Pin 38 = GPIO22
;;   Pin 39 = GPIO23
;;   GND pad (bottom)
(symbol "AG_ESP32_WROOM_32E"
(pin_names (offset 0.254))
(exclude_from_sim no) (in_bom yes) (on_board yes)
