(wire (pts (xy 152.4 105.41) (xy 152.4 104.775)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000030"))
;; C6 pin 2 (bottom) → GND power symbol
(wire (pts (xy 152.4 110.49) (xy 152.4 113.03)) (stroke (width 0) (type default)) (uuid "e2000c00-0000-0000-0000-000000000031"))

