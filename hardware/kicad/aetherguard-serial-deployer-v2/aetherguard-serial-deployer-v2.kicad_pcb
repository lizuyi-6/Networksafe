(kicad_pcb
	(version 20241209)
	(generator "pcbnew")
	(generator_version "9.0")
	(general
		(thickness 1.6)
		(legacy_teardrops no)
	)
	(paper "A4")
	(title_block
		(title "AetherGuard ESP32 Serial Deployer v2")
		(date "2026-03-28")
		(rev "2.0")
		(company "AetherGuard")
		(comment 1 "2-Layer, 52x29mm, Dual CH340N, WS2812B")
		(comment 2 "Cost-Optimized Design for JLCPCB/PCBWay")
	)
	(layers
		(0 "F.Cu" signal)
		(31 "B.Cu" signal)
		(32 "B.Adhes" user "B.Adhesive")
		(33 "F.Adhes" user "F.Adhesive")
		(34 "B.Paste" user)
		(35 "F.Paste" user)
		(36 "B.SilkS" user "B.Silkscreen")
		(37 "F.SilkS" user "F.Silkscreen")
		(38 "B.Mask" user)
		(39 "F.Mask" user)
		(40 "Dwgs.User" user "User.Drawings")
		(41 "Cmts.User" user "User.Comments")
		(42 "Eco1.User" user "User.Eco1")
		(43 "Eco2.User" user "User.Eco2")
		(44 "Edge.Cuts" user)
		(45 "Margin" user)
		(46 "B.CrtYd" user "B.Courtyard")
		(47 "F.CrtYd" user "F.Courtyard")
		(48 "B.Fab" user)
		(49 "F.Fab" user)
	)
	(setup
		(pad_to_mask_clearance 0.05)
		(allow_soldermask_bridges_in_footprints no)
		(pcbplotparams
			(layerselection 0x00010fc_ffffffff)
			(plot_on_all_layers_selection 0x0000000_00000000)
			(disableapertmacros no)
			(usegerberextensions no)
			(usegerberattributes yes)
			(usegerberadvancedattributes yes)
			(creategerberjobfile yes)
			(dashed_line_dash_ratio 12.000000)
			(dashed_line_gap_ratio 3.000000)
			(svgprecision 4)
			(plotframeref no)
			(viasonmask no)
			(mode 1)
			(useauxorigin no)
			(hpglpennumber 1)
			(hpglpenspeed 20)
			(hpglpendiameter 15.000000)
			(pdf_front_fp_property_popups yes)
			(pdf_back_fp_property_popups yes)
			(dxfpolygonmode yes)
			(dxfimperialobjects yes)
			(dxfusepcbnewfont yes)
			(psnegative no)
			(psa4output no)
			(plotreference yes)
			(plotvalue yes)
			(plotfptext yes)
			(plotinvisibletext no)
			(sketchpadsonfab no)
			(subtractmaskfromsilk no)
			(outputformat 1)
			(mirror no)
			(drillshape 1)
			(scaleselection 1)
			(outputdirectory "")
		)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "3V3")
	(net 3 "USB_VBUS")
	(net 4 "USB_D_P")
	(net 5 "USB_D_N")
	(net 6 "SERVICE_UART_TX")
	(net 7 "SERVICE_UART_RX")
	(net 8 "HOST_UART_TX")
	(net 9 "HOST_UART_RX")
	(net 10 "HOST_D_P")
	(net 11 "HOST_D_N")
	(net 12 "GPIO0")
	(net 13 "EN")
	(net 14 "GPIO4")
	(net 15 "GPIO13")
	(net 16 "GPIO14")
	(net 17 "GPIO21_SDA")
	(net 18 "GPIO22_SCL")
	(net 19 "GPIO25")
	(net 20 "GPIO27")
	(net 21 "DTR#")
	(net 22 "RTS#")
	(net 23 "USB_VBUS_RAW")
	(net 24 "USB_VBUS_FUSED")
	(net 25 "I2C_SDA")
	(net 26 "I2C_SCL")
	(net 27 "WS2812B_DIN")
	(net 28 "BUZZER_DRV")
	(net 29 "BTN_OK")
	(net 30 "BTN_NEXT")
	(net 31 "BTN_BACK")
	(net 32 "Net-(Q1-D)")
	(net 33 "Net-(Q2-D)")
	(net 34 "Net-(Q3-C)")
	(net 35 "unconnected-(GPIO2)")
	(net 36 "unconnected-(GPIO5)")
	(net 37 "unconnected-(GPIO12)")
	(net 38 "unconnected-(GPIO15)")
	(net 39 "unconnected-(GPIO18)")
	(net 40 "unconnected-(GPIO19)")
	(net 41 "unconnected-(GPIO23)")
	(net 42 "unconnected-(GPIO26)")
	(net 43 "unconnected-(WS2812B-DOUT)")

	(net_class "Default"
		(clearance 0.2)
		(trace_width 0.25)
		(via_dia 0.6)
		(via_drill 0.3)
		(uvia_dia 0.3)
		(uvia_drill 0.1)
		(diff_pair_gap 0.25)
		(diff_pair_width 0.2)
	)
	(net_class "Power"
		(clearance 0.2)
		(trace_width 0.4)
		(via_dia 0.6)
		(via_drill 0.3)
		(uvia_dia 0.3)
		(uvia_drill 0.1)
		(diff_pair_gap 0.25)
		(diff_pair_width 0.2)
	)
	(net_class "USB_Diff"
		(clearance 0.2)
		(trace_width 0.2)
		(via_dia 0.6)
		(via_drill 0.3)
		(uvia_dia 0.3)
		(uvia_drill 0.1)
		(diff_pair_gap 0.15)
		(diff_pair_width 0.2)
	)

	;; Board outline 52x29mm
	(gr_rect
		(start 0 0)
		(end 52 29)
		(stroke (width 0.05) (type solid))
		(fill none)
		(layer "Edge.Cuts")
		(uuid "e0000001-0000-0000-0000-000000000001")
	)

	;; Silkscreen
	(gr_text "AetherGuard v2"
		(at 26 14.5 0)
		(layer "F.SilkS")
		(uuid "e0000002-0000-0000-0000-000000000001")
		(effects (font (size 1.0 1.0) (thickness 0.15)) (justify center))
	)
	(gr_text "2026-03"
		(at 26 16.0 0)
		(layer "F.SilkS")
		(uuid "e0000003-0000-0000-0000-000000000001")
		(effects (font (size 0.7 0.7) (thickness 0.1)) (justify center))
	)

	;; Layout zone annotations on Dwgs.User
	(gr_text "LAYOUT ZONES:"
		(at 26 1.5 0)
		(layer "Dwgs.User")
		(uuid "e0000080-0000-0000-0000-000000000001")
		(effects (font (size 0.8 0.8) (thickness 0.1)))
	)
	(gr_text "L: USB-C J1(5,14.5) LDO(25,24) CH340N-S(10,14.5) TVS1(8,8)"
		(at 26 2.5 0)
		(layer "Dwgs.User")
		(uuid "e0000081-0000-0000-0000-000000000001")
		(effects (font (size 0.5 0.5) (thickness 0.08)))
	)
	(gr_text "C: ESP32(26,14.5) Q1,Q2(18,10) Caps(26,7) TPs(26,3)"
		(at 26 3.2 0)
		(layer "Dwgs.User")
		(uuid "e0000082-0000-0000-0000-000000000001")
		(effects (font (size 0.5 0.5) (thickness 0.08)))
	)
	(gr_text "R: USB-A J2(47,14.5) CH340N-H(42,14.5) TVS2(44,8)"
		(at 26 3.9 0)
		(layer "Dwgs.User")
		(uuid "e0000083-0000-0000-0000-000000000001")
		(effects (font (size 0.5 0.5) (thickness 0.08)))
	)
	(gr_text "B: OLED(10,3) SW1-5(15-20,3) WS2812B(35,3) BZ1(45,3)"
		(at 26 4.6 0)
		(layer "Dwgs.User")
		(uuid "e0000084-0000-0000-0000-000000000001")
		(effects (font (size 0.5 0.5) (thickness 0.08)))
	)

	;; Mounting Holes M2 at corners
	(footprint "aetherguard-serial-deployer-v2:MountingHole_2.2mm_M2"
		(at 3 3)
		(layer "F.Cu")
		(uuid "e0000010-0000-0000-0000-000000000001")
		(property "Reference" "H1" (at 0 -3.0 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(property "Value" "MountingHole" (at 0 3.0 0) (layer "F.Fab") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask") (uuid "e0000011-0000-0000-0000-000000000001"))
	)
	(footprint "aetherguard-serial-deployer-v2:MountingHole_2.2mm_M2"
		(at 49 3)
		(layer "F.Cu")
		(uuid "e0000010-0000-0000-0000-000000000002")
		(property "Reference" "H2" (at 0 -3.0 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(property "Value" "MountingHole" (at 0 3.0 0) (layer "F.Fab") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask") (uuid "e0000011-0000-0000-0000-000000000002"))
	)
	(footprint "aetherguard-serial-deployer-v2:MountingHole_2.2mm_M2"
		(at 3 26)
		(layer "F.Cu")
		(uuid "e0000010-0000-0000-0000-000000000003")
		(property "Reference" "H3" (at 0 -3.0 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(property "Value" "MountingHole" (at 0 3.0 0) (layer "F.Fab") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask") (uuid "e0000011-0000-0000-0000-000000000003"))
	)
	(footprint "aetherguard-serial-deployer-v2:MountingHole_2.2mm_M2"
		(at 49 26)
		(layer "F.Cu")
		(uuid "e0000010-0000-0000-0000-000000000004")
		(property "Reference" "H4" (at 0 -3.0 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(property "Value" "MountingHole" (at 0 3.0 0) (layer "F.Fab") (effects (font (size 1.0 1.0) (thickness 0.15))))
		(pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask") (uuid "e0000011-0000-0000-0000-000000000004"))
	)

	;; B.Cu Ground Pour Zone
	(zone
		(net 1)
		(net_name "GND")
		(layer "B.Cu")
		(uuid "e0000090-0000-0000-0000-000000000001")
		(hatch edge 0.5)
		(priority 1)
		(connect_pads
			(clearance 0.3)
		)
		(min_thickness 0.2)
		(filled_areas_thickness no)
		(fill
			(thermal_gap 0.3)
			(thermal_bridge_width 0.4)
			(island_removal_mode 1)
			(island_area_min 10)
		)
		(polygon
			(pts
				(xy 0.3 0.3) (xy 51.7 0.3) (xy 51.7 28.7) (xy 0.3 28.7)
			)
		)
	)

	;; F.Cu Ground Pour Zone (secondary, lower priority)
	(zone
		(net 1)
		(net_name "GND")
		(layer "F.Cu")
		(uuid "e0000090-0000-0000-0000-000000000002")
		(hatch edge 0.5)
		(priority 2)
		(connect_pads
			(clearance 0.3)
		)
		(min_thickness 0.2)
		(filled_areas_thickness no)
		(fill
			(thermal_gap 0.3)
			(thermal_bridge_width 0.4)
			(island_removal_mode 1)
			(island_area_min 10)
		)
		(polygon
