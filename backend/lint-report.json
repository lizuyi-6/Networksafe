"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .socket on an `any` value.","line":208,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":208,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .trim on an `any` value.","line":211,"column":5,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":211,"endColumn":9}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Rate Limiting Middleware\r\n *\r\n * SECURITY FIX for RISK-001: IP Spoofing Bypass\r\n *\r\n * Provides multi-dimensional rate limiting for API endpoints\r\n */\r\n\r\nimport { Request, Response, NextFunction } from 'express';\r\nimport enhancedRateLimiter from '../security/enhanced-rate-limiter.service';\r\nimport {\r\n  apiRateLimitEngineService,\r\n  hashRateLimitFingerprint\r\n} from '../services/api-rate-limit-engine.service';\r\nimport logger from '../utils/logger';\r\n\r\nexport interface RateLimitMiddlewareOptions {\r\n  maxRequests?: number;\r\n  windowMs?: number;\r\n  skipSuccessfulRequests?: boolean;\r\n  skipFailedRequests?: boolean;\r\n  keyGenerator?: (req: Request) => string;\r\n  handler?: (req: Request, res: Response) => void;\r\n}\r\n\r\n/**\r\n * Default rate limit handler\r\n */\r\nfunction defaultHandler(req: Request, res: Response): void {\r\n  res.status(429).json({\r\n    error: 'backend.too_many_requests',\r\n    code: 'RATE_LIMIT_EXCEEDED',\r\n    retryAfter: 60, // seconds\r\n  });\r\n}\r\n\r\n/**\r\n * Create rate limit middleware\r\n */\r\nexport function rateLimit(options: RateLimitMiddlewareOptions = {}) {\r\n  const {\r\n    maxRequests = 100,\r\n    windowMs = 60000,\r\n    keyGenerator,\r\n    handler = defaultHandler,\r\n  } = options;\r\n\r\n  return async (req: Request, res: Response, next: NextFunction): Promise<void> => {\r\n    try {\r\n      const identifier = keyGenerator\r\n        ? keyGenerator(req)\r\n        : getDefaultKey(req);\r\n      const ip = getClientIP(req);\r\n      const sessionId = String((req as any).sessionID || req.headers['x-session-id'] || '');\r\n      const forwardedFor = String(req.headers['x-forwarded-for'] || '').trim();\r\n      const realIp = String(req.headers['x-real-ip'] || '').trim();\r\n      const endpoint = `${req.method}:${req.path}`;\r\n      const fingerprint = hashRateLimitFingerprint(buildRequestFingerprint(req, ip));\r\n\r\n      if (isApiRateLimitEngineEnabled()) {\r\n        const engineResult = await apiRateLimitEngineService.check({\r\n          identifier,\r\n          ip,\r\n          endpoint,\r\n          maxRequests,\r\n          windowMs,\r\n          fingerprint,\r\n          forwardedFor,\r\n          realIp,\r\n          sessionId,\r\n          protocol: 'http'\r\n        });\r\n\r\n        if (engineResult) {\r\n          res.setHeader('X-RateLimit-Limit', maxRequests.toString());\r\n          res.setHeader('X-RateLimit-Remaining', engineResult.remaining.toString());\r\n          res.setHeader('X-RateLimit-Reset', Math.floor(engineResult.resetAtMs / 1000).toString());\r\n\r\n          if (!engineResult.allowed) {\r\n            if (isRapidIpRotation(engineResult.reason)) {\r\n              logger.error('IP spoofing detected, blocking request', {\r\n                identifier,\r\n                ip,\r\n                reason: engineResult.reason,\r\n                riskFlags: engineResult.riskFlags\r\n              });\r\n\r\n              res.status(429).json({\r\n                error: 'backend.request_blocked_suspicious_activity_detected',\r\n                code: 'IP_SPOOFING_DETECTED',\r\n              });\r\n              return;\r\n            }\r\n\r\n            const retryAfter = Math.ceil((engineResult.resetAtMs - Date.now()) / 1000);\r\n            res.setHeader('Retry-After', Math.max(retryAfter, 1).toString());\r\n            return handler(req, res);\r\n          }\r\n\r\n          next();\r\n          return;\r\n        }\r\n      }\r\n\r\n      const spoofingCheck = await enhancedRateLimiter.detectIPSpoofing({\r\n        identifier,\r\n        ip,\r\n      });\r\n\r\n      if (spoofingCheck.suspicious) {\r\n        logger.error('IP spoofing detected, blocking request', {\r\n          identifier,\r\n          ip,\r\n          reason: spoofingCheck.reason,\r\n        });\r\n\r\n        res.status(429).json({\r\n          error: 'backend.request_blocked_suspicious_activity_detected',\r\n          code: 'IP_SPOOFING_DETECTED',\r\n        });\r\n        return;\r\n      }\r\n      const result = await enhancedRateLimiter.checkRateLimit({\r\n        identifier,\r\n        ip,\r\n        endpoint,\r\n        config: {\r\n          maxRequests,\r\n          windowMs,\r\n        },\r\n      });\r\n\r\n      res.setHeader('X-RateLimit-Limit', result.limit.toString());\r\n      res.setHeader('X-RateLimit-Remaining', result.remaining.toString());\r\n      res.setHeader('X-RateLimit-Reset', Math.floor(result.resetTime.getTime() / 1000).toString());\r\n\r\n      if (!result.allowed) {\r\n        logger.warn('Rate limit exceeded', {\r\n          identifier,\r\n          ip,\r\n          endpoint: req.path,\r\n          reason: result.reason,\r\n        });\r\n\r\n        const retryAfter = Math.ceil((result.resetTime.getTime() - Date.now()) / 1000);\r\n        res.setHeader('Retry-After', retryAfter.toString());\r\n\r\n        return handler(req, res);\r\n      }\r\n\r\n      next();\r\n    } catch (error) {\r\n      logger.error('Rate limit middleware error', { error });\r\n      // SECURITY FIX: Fail closed - reject request if rate limiter fails\r\n      // This prevents attackers from bypassing rate limits by causing Redis failures\r\n      res.status(503).json({\r\n        error: 'backend.service_temporarily_unavailable',\r\n        code: 'RATE_LIMIT_CHECK_FAILED',\r\n        retryAfter: 5,\r\n      });\r\n    }\r\n  };\r\n}\r\n\r\nfunction buildRequestFingerprint(req: Request, ip: string): string {\r\n  const forwardedFor = String(req.headers['x-forwarded-for'] || '').trim();\r\n  const realIp = String(req.headers['x-real-ip'] || '').trim();\r\n  const userAgent = String(req.headers['user-agent'] || '').trim();\r\n  const acceptLanguage = String(req.headers['accept-language'] || '').trim();\r\n  return [ip, forwardedFor, realIp, userAgent, acceptLanguage].join('|');\r\n}\r\n\r\n/**\r\n * Get default key for rate limiting\r\n * Priority: user ID > session ID > IP\r\n */\r\nfunction getDefaultKey(req: Request): string {\r\n  const user = (req as any).user;\r\n  if (user?.userId) {\r\n    return `user:${user.userId}`;\r\n  }\r\n\r\n  const sessionID = (req as any).sessionID || req.headers['x-session-id'];\r\n  if (sessionID) {\r\n    return `session:${sessionID}`;\r\n  }\r\n\r\n  return `ip:${getClientIP(req)}`;\r\n}\r\n\r\n/**\r\n * Get client IP address with proxy support\r\n */\r\nfunction getClientIP(req: Request): string {\r\n  const trustProxy = process.env.TRUST_PROXY === 'true';\r\n  if (trustProxy) {\r\n    const forwardedFor = req.headers['x-forwarded-for'] as string;\r\n    if (forwardedFor) {\r\n      return forwardedFor.split(',')[0].trim();\r\n    }\r\n    const realIp = req.headers['x-real-ip'] as string;\r\n    if (realIp) {\r\n      return realIp.trim();\r\n    }\r\n  }\r\n  return (\r\n    req.socket.remoteAddress ||\r\n    (req.connection as any)?.socket?.remoteAddress ||\r\n    req.connection?.remoteAddress ||\r\n    'unknown'\r\n  ).trim();\r\n}\r\n\r\nfunction isApiRateLimitEngineEnabled(): boolean {\r\n  const raw = String(process.env.API_RATE_LIMIT_ENGINE || '').trim().toLowerCase();\r\n  return raw === 'redis-lua' || raw === 'true' || raw === '1';\r\n}\r\n\r\nfunction isRapidIpRotation(reason?: string): boolean {\r\n  return String(reason || '').toLowerCase().includes('rapid ip rotation');\r\n}\r\n\r\n/**\r\n * Pre-configured rate limiters for different use cases\r\n */\r\n\r\n// Strict rate limiter for authentication endpoints\r\nexport const authRateLimit = rateLimit({\r\n  maxRequests: 15, // 15 requests per minute (increased from 5 for cold start scenarios)\r\n  windowMs: 60000,\r\n  handler: (req, res) => {\r\n    res.status(429).json({\r\n      error: 'backend.too_many_authentication_attempts_please_try_again_later',\r\n      code: 'AUTH_RATE_LIMIT_EXCEEDED',\r\n      retryAfter: 60,\r\n    });\r\n  },\r\n});\r\n\r\n// Standard rate limiter for general API endpoints\r\nexport const apiRateLimit = rateLimit({\r\n  maxRequests: 100,\r\n  windowMs: 60000,\r\n});\r\n\r\n// Lenient rate limiter for less critical endpoints\r\nexport const lenientRateLimit = rateLimit({\r\n  maxRequests: 300,\r\n  windowMs: 60000,\r\n});\r\n\r\n// Strict rate limiter for admin operations\r\nexport const adminRateLimit = rateLimit({\r\n  maxRequests: 20,\r\n  windowMs: 60000,\r\n  handler: (req, res) => {\r\n    res.status(429).json({\r\n      error: 'backend.too_many_admin_operations_please_slow_down',\r\n      code: 'ADMIN_RATE_LIMIT_EXCEEDED',\r\n      retryAfter: 60,\r\n    });\r\n  },\r\n});\r\n\r\n// WebSocket connection rate limit\r\nexport const wsRateLimit = rateLimit({\r\n  maxRequests: 10,\r\n  windowMs: 60000,\r\n  handler: (req, res) => {\r\n    res.status(429).json({\r\n      error: 'backend.too_many_websocket_connection_attempts',\r\n      code: 'WS_RATE_LIMIT_EXCEEDED',\r\n      retryAfter: 60,\r\n    });\r\n  },\r\n});\r\n\r\nexport default rateLimit;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\validation.middleware.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":7,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":7,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[173,176],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[173,176],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access [field] on an `any` value.","line":16,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":16,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access [field] on an `any` value.","line":16,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":16,"endColumn":62}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { NextFunction, Request, Response } from 'express';\r\n\r\ntype JsonSchema = {\r\n  body?: {\r\n    type?: string;\r\n    required?: string[];\r\n    properties?: Record<string, any>;\r\n  };\r\n};\r\n\r\n// Lightweight request validator used by API routes.\r\nexport function validateRequest(schema: JsonSchema) {\r\n  return (req: Request, res: Response, next: NextFunction): void => {\r\n    const required = schema.body?.required ?? [];\r\n    for (const field of required) {\r\n      if (req.body?.[field] === undefined || req.body?.[field] === null) {\r\n        res.status(400).json({\r\n          success: false,\r\n          error: `Missing required field: ${field}`\r\n        });\r\n        return;\r\n      }\r\n    }\r\n    next();\r\n  };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\modules\\admin\\admin.repository.ts","messages":[],"suppressedMessages":[],"error