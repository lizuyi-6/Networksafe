nt/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":82,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":82,"endColumn":66}],"suppressedMessages":[],"errorCount":25,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Router } from 'express';\r\nimport { authenticate } from '../../middleware/auth.middleware';\r\nimport logger from '../../utils/logger';\r\nimport { getTrafficStats, getAgentSystem } from './ai-system.routes';\r\nimport { isDemoMode } from '../../config/app-mode';\r\n\r\nconst router = Router();\r\n\r\ninterface LogItem {\r\n    id: number;\r\n    time: string;\r\n    type: string;\r\n    level: string;\r\n    message: string;\r\n    ip: string;\r\n    status?: number;\r\n    method?: string;\r\n    path?: string;\r\n}\r\n\r\nlet logCounter = 0;\r\nconst recentLogs: LogItem[] = [];\r\n\r\nexport const addLog = (log: Omit<LogItem, 'id' | 'time'>) => {\r\n    const newLog: LogItem = {\r\n        ...log,\r\n        id: ++logCounter,\r\n        time: new Date().toISOString()\r\n    };\r\n    recentLogs.unshift(newLog);\r\n    if (recentLogs.length > 100) {\r\n        recentLogs.pop();\r\n    }\r\n    return newLog;\r\n};\r\n\r\nrouter.get('/', authenticate, (req, res) => {\r\n    try {\r\n        const trafficStats = getTrafficStats();\r\n        const agentSystem = getAgentSystem();\r\n        const logs: LogItem[] = [...recentLogs];\r\n\r\n        if (agentSystem && agentSystem.isInitialized()) {\r\n            const probeReport = agentSystem.getProbeReport();\r\n            const alerts = probeReport.alerts || [];\r\n\r\n            alerts.forEach((alert: any, index: number) => {\r\n                logs.push({\r\n                    id: logCounter + index + 1,\r\n                    time: alert.timestamp || new Date().toISOString(),\r\n                    type: alert.metadata?.threatType || 'Security',\r\n                    level: alert.severity === 'critical' ? 'ERROR' : 'WARN',\r\n                    message: alert.message || 'Security event detected',\r\n                    ip: alert.metadata?.sourceIP || 'unknown',\r\n                    status: 403,\r\n                    method: alert.metadata?.method || 'POST',\r\n                    path: alert.metadata?.path || '/api/unknown'\r\n                });\r\n            });\r\n        }\r\n\r\n        trafficStats.activeFlows.forEach((flow: any, index: number) => {\r\n            if (flow.state === 'BLOCKED') {\r\n                logs.push({\r\n                    id: logCounter + 1000 + index,\r\n                    time: flow.lastActivity || new Date().toISOString(),\r\n                    type: flow.attackName || 'Blocked',\r\n                    level: 'WARN',\r\n                    message: `Blocked request from ${flow.sourceIP}`,\r\n                    ip: flow.sourceIP,\r\n                    status: 403,\r\n                    method: 'POST',\r\n                    path: '/api/protected'\r\n                });\r\n            }\r\n        });\r\n\r\n        // 无论是否是演示模式，都返回真实数据\r\n        logs.sort((a, b) => new Date(b.time).getTime() - new Date(a.time).getTime());\r\n        res.json(logs.slice(0, 50));\r\n    } catch (error: any) {\r\n        logger.error('Failed to get logs', { error: error.message });\r\n        res.json([]);\r\n    }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\pipeline.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":26,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":26,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[882,885],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[882,885],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":27,"column":68,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":27,"endColumn":75},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":59,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":59,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1837,1840],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1837,1840],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":60,"column":67,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":60,"endColumn":74}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Data Pipeline API Routes\r\n *\r\n * Provides endpoints for health checks and data pipeline verification.\r\n * Ensures all components are working correctly.\r\n */\r\n\r\nimport { Router, Response } from 'express';\r\nimport { authenticate, AuthenticatedRequest } from '../../middleware/auth.middleware';\r\nimport { sendError, sendSuccess } from '../../core/http/api-response';\r\nimport { pipelineDiagnosticsService } from '../../modules/pipeline/pipeline-diagnostics.service';\r\nimport logger from '../../utils/logger';\r\n\r\nconst router = Router();\r\n\r\n// All pipeline routes require authentication\r\nrouter.use(authenticate);\r\n\r\n/**\r\n * GET /api/pipeline/health\r\n * Get health status of all pipeline components\r\n */\r\nrouter.get('/health', (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    return sendSuccess(res, pipelineDiagnosticsService.getHealthStatus());\r\n  } catch (error: any) {\r\n    logger.error('Failed to check pipeline health', { error: error.message });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * GET /api/pipeline/verify\r\n * Verify data pipeline integrity\r\n */\r\nrouter.get('/verify', (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const verifications = pipelineDiagnosticsService.verifyDataPipeline();\r\n\r\n    // Calculate overall status\r\n    const hasFail = verifications.some(v => v.status === 'fail');\r\n    const allSkip = verifications.every(v => v.status === 'skip');\r\n\r\n    let overallStatus: 'pass' | 'fail' | 'skip' = 'pass';\r\n    if (hasFail) {\r\n      overallStatus = 'fail';\r\n    } else if (allSkip) {\r\n      overallStatus = 'skip';\r\n    }\r\n\r\n    return sendSuccess(res, {\r\n      overall: overallStatus,\r\n      verifications,\r\n      timestamp: new Date().toISOString()\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to verify data pipeline', { error: error.message });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\rules.routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\scann