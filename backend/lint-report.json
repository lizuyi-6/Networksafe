-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":124,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":128,"endColumn":8}],"suppressedMessages":[],"errorCount":19,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Bug Investigation Agent Team - Main Entry Point\r\n *\r\n * Provides a comprehensive multi-agent system for investigating complex bugs.\r\n * Coordinates specialized agents to analyze logs, traces, code, and generate solutions.\r\n */\r\n\r\nimport { InvestigationCoordinator } from './coordinator';\r\nimport {\r\n  BugReport,\r\n  InvestigationContext,\r\n  InvestigationResult,\r\n  InvestigationAgentType\r\n} from './types';\r\n\r\nexport class BugInvestigationTeam {\r\n  private static instance: BugInvestigationTeam;\r\n  private coordinator: InvestigationCoordinator;\r\n\r\n  private constructor() {\r\n    this.coordinator = new InvestigationCoordinator();\r\n  }\r\n\r\n  /**\r\n   * Get singleton instance\r\n   */\r\n  public static getInstance(): BugInvestigationTeam {\r\n    if (!BugInvestigationTeam.instance) {\r\n      BugInvestigationTeam.instance = new BugInvestigationTeam();\r\n    }\r\n    return BugInvestigationTeam.instance;\r\n  }\r\n\r\n  /**\r\n   * Start a bug investigation\r\n   */\r\n  public async investigate(bugReport: BugReport, context: InvestigationContext): Promise<InvestigationResult> {\r\n    const investigationId = await this.coordinator.startInvestigation(bugReport, context);\r\n\r\n    // Wait for investigation to complete\r\n    return new Promise((resolve, reject) => {\r\n      const timeout = setTimeout(() => {\r\n        reject(new Error('Investigation timeout'));\r\n      }, 300000); // 5 minute timeout\r\n\r\n      this.coordinator.once('investigation:completed', (data) => {\r\n        if (data.investigationId === investigationId) {\r\n          clearTimeout(timeout);\r\n          resolve(data.result);\r\n        }\r\n      });\r\n\r\n      this.coordinator.once('investigation:failed', (data) => {\r\n        if (data.investigationId === investigationId) {\r\n          clearTimeout(timeout);\r\n          reject(data.error);\r\n        }\r\n      });\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Get investigation status\r\n   */\r\n  public getInvestigationStatus(investigationId: string): any {\r\n    return this.coordinator.getInvestigationStatus(investigationId);\r\n  }\r\n\r\n  /**\r\n   * Get active investigations\r\n   */\r\n  public getActiveInvestigations(): any[] {\r\n    return this.coordinator.getActiveInvestigations();\r\n  }\r\n\r\n  /**\r\n   * Get agent capabilities\r\n   */\r\n  public getAgentCapabilities(): any[] {\r\n    return this.coordinator.getAgentCapabilities();\r\n  }\r\n\r\n  /**\r\n   * Create investigation context from raw data\r\n   */\r\n  public static createContext(data: {\r\n    bugReport: any;\r\n    logs?: any[];\r\n    traces?: any[];\r\n    metrics?: any;\r\n    codeContext?: any;\r\n  }): InvestigationContext {\r\n    return {\r\n      bugReport: data.bugReport,\r\n      systemState: {\r\n        logs: data.logs || [],\r\n        traces: data.traces || [],\r\n        metrics: data.metrics,\r\n        codeContext: data.codeContext\r\n      }\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Create bug report from API request\r\n   */\r\n  public static createBugReport(data: {\r\n    id?: string;\r\n    title: string;\r\n    description: string;\r\n    severity: 'critical' | 'high' | 'medium' | 'low';\r\n    category: 'security' | 'performance' | 'functional' | 'crash' | 'memory' | 'concurrency';\r\n    reproductionSteps?: string[];\r\n    environment?: any;\r\n    reporter?: string;\r\n  }): BugReport {\r\n    return {\r\n      id: data.id || `bug-${Date.now()}`,\r\n      title: data.title,\r\n      description: data.description,\r\n      severity: data.severity,\r\n      category: data.category,\r\n      reproductionSteps: data.reproductionSteps,\r\n      environment: data.environment || {\r\n        os: 'unknown',\r\n        runtime: 'unknown',\r\n        version: 'unknown'\r\n      },\r\n      reporter: data.reporter || 'unknown',\r\n      timestamp: new Date()\r\n    };\r\n  }\r\n}\r\n\r\n// Export for use in routes\r\nexport * from './types';\r\nexport * from './coordinator';\r\nexport * from './agents/base-investigation.agent';\r\nexport * from './agents/log-analysis.agent';\r\nexport * from './agents/trace-analysis.agent';\r\nexport * from './agents/code-analysis.agent';\r\nexport * from './agents/bug-reproduction.agent';\r\nexport * from './agents/root-cause.agent';\r\nexport * from './agents/solution.agent';\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\types.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":43,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":43,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1137,1140],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1137,1140],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":156,"column":9,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":156,"endColumn":12,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3703,3706],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3703,3706],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":173,"column":10,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":173,"endColumn":13,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4132,4135],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4132,4135],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":174,"column":12,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":174,"endColumn":15,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4149,4152],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4149,4152],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Bug Investigation Agent Team\r\n *\r\n * A specialized multi-agent system for complex bug investigation and root cause analysis.\r\n * Extends the existing AI agent framework with investigation-specific capabilities.\r\n */\r\n\r\nexport interface BugReport {\r\n  id: string;\r\n  title: string;\r\n  description: string;\r\n  severity: 'critical' | 'high' | 'medium' | 'low';\r\n  category: 'security' | 'performance' | 'functional' | 'crash' | 'memory' | 'concurrency';\r\n  reproductionSteps?: string[];\r\n  environment: {\r\n    os: string;\r\n    runtime: string;\r\n    version: string;\r\n    region?: string;\r\n  };\r\n  reporter: string;\r\n  timestamp: Date;\r\n  attachments?: string[];\r\n}\r\n\r\nexport interface InvestigationContext {\r\n  bugReport: BugReport;\r\n  systemState: {\r\n    logs: LogEntry[];\r\n    traces: TraceEvent[];\r\n    metrics: SystemMetrics;\r\n    codeContext?: CodeContext;\r\n  };\r\n  relatedIncidents?: string[];\r\n  previousInvestigations?: InvestigationSummary[];\r\n}\r\n\r\nexport interface LogEntry {\r\n  timestamp: Date;\r\n  level: 'debug' | 'info' | 'warn' | 'error' | 'fatal';\r\n  service: string;\r\n  message: string;\r\n  metadata?: Record<string, any>;\r\n  traceId?: string;\r\n}\r\n\r\nexport interface TraceEvent {\r\n  traceId: string;\r\n  spanId: string;\r\n  parentSpanId?: string;\r\n  timestamp: Date;\r\n  duration: number;\r\n  service: string;\r\n  operation: string;\r\n  tags: Record<string, string>;\r\n  status: 'ok' | 'error';\r\n  error?: {\r\n    message: string;\r\n    stackTrace?: string;\r\n  };\r\n}\r\n\r\nexport interface SystemMetrics {\r\n  cpu: {\r\n    usage: number;\r\n    loadAverage: number[];\r\n  };\r\n  memory: {\r\n    used: number;\r\n    total: number;\r\n    percentage: number;\r\n  };\r\n  network?: {\r\n    inbound: number;\r\n    outbound: number;\r\n    connections: number;\r\n  };\r\n  customMetrics?: Record<string, number>;\r\n}\r\n\r\nexport interface CodeContext {\r\n  filePath: string;\r\n  lineNumber: number;\r\n  function: string;\r\n  codeSnippet: string;\r\n  relatedFiles?: string[];\r\n}\r\n\r\nexport interface InvestigationResult {\r\n  investigationId: string;\r\n  bugReportId: string;\r\n  findings: Finding[];\r\n  rootCause?: RootCause;\r\n  reproductionSteps?: ReproductionGuide;\r\n  recommendedSolutions: Solution[];\r\n  confidence: number;\r\n  evidence: Evidence[];\r\n  timestamp: Date;\r\n  investigators: string[];\r\n}\r\n\r\nexport interface Finding {\r\n  type: 'anomaly' | 'error' | 'performance' | 'security' | 'configuration';\r\n  severity: 'critical' | 'high' | 'medium' | 'low';\r\n  description: string;\r\n  location?: string;\r\n  evidence: string[];\r\n  relatedFindings?: string[];\r\n}\r\n\r\nexport interface RootCause {\r\n  category: 'code' | 'configuration' | 'environment' | 'dependency' | 'design' | 'external';\r\n  description: string;\r\n  location: {\r\n    file?: string;\r\n    line?: number;\r\n    function?: string;\r\n    service?: string;\r\n  };\r\n  explanation: string;\r\n  contributingFactors: string[];\r\n}\r\n\r\nexport interface ReproductionGuide {\r\n  steps: string[];\r\n  prerequisites: string[];\r\n  expectedBehavior: string;\r\n  actualBehavior: string;\r\n  successRate: number;\r\n}\r\n\r\nexport interface Solution {\r\n  type: 'hotfix' | 'refactor' | 'configuration' | 'upgrade' | 'workaround';\r\n  priority: 'immediate' | 'urgent' | 'normal' | 'low';\r\n  description: string;\r\n  implementation: string;\r\n  estimatedEffort: string;\r\n  risk: 'low' | 'medium' | 'high';\r\n  sideEffects?: string[];\r\n  codeChanges?: CodeChange[];\r\n}\r\n\r\nexport interface CodeChange {\r\n  filePath: string;\r\n  oldCode?: string;\r\n  newCode: string;\r\n  lineNumber?: number;\r\n  description: string;\r\n}\r\n\r\nexport interface Evidence {\r\n  type: 'log' | 'trace' | 'metric' | 'code' | 'test' | 'screenshot' | 'user_report';\r\n  description: string;\r\n  source: string;\r\n  timestamp: Date;\r\n  data: any;\r\n}\r\n\r\nexport interface InvestigationSummary {\r\n  investigationId: string;\r\n  date: Date;\r\n  outcome: 'resolved' | 'mitigated' | 'investigating' | 'closed';\r\n  summary: string;\r\n}\r\n\r\nexport interface AgentTask {\r\n  taskId: string;\r\n  assignedTo: string;\r\n  taskType: string;\r\n  description: string;\r\n  status: 'pending' | 'in_progress' | 'completed' | 'failed';\r\n  priority: 'critical' | 'high' | 'medium' | 'low';\r\n  input: any;\r\n  output?: any;\r\n  error?: string;\r\n  startedAt?: Date;\r\n  completedAt?: Date;\r\n  duration?: number;\r\n}\r\n\r\nexport enum InvestigationAgentType {\r\n  BUG_REPRODUCTION = 'bug_reproduction',\r\n  CODE_ANALYSIS = 'code_analysis',\r\n  LOG_ANALYSIS = 'log_analysis',\r\n  TRACE_ANALYSIS = 'trace_analysis',\r\n  ROOT_CAUSE = 'root_cause',\r\n  SOLUTION = 'solution',\r\n  COORDINATOR = 'coordinator'\r\n}\r\n\r\nexport interface InvestigationAgentCapabilities {\r\n  agentType: InvestigationAgentType;\r\n  capabilities: string[];\r\n  tools: string[];\r\n  expertise: string[];\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\models\\model-router.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":99,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":99,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3218,3221],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3218,3221],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":100,"column":76,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":100,"endColumn":83},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":124,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":124,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4350,4353],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4350,4353],"text":"never"},"desc":"Use `never` 