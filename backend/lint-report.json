":2,"message":"Unsafe assignment of an `any` value.","line":169,"column":13,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":169,"endColumn":49},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .service on an `any` value.","line":169,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":169,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":179,"column":56,"nodeType":"MemberExpression","messageId":"unsafeReturn","endLine":179,"endColumn":67},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .operation on an `any` value.","line":179,"column":58,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":179,"endColumn":67},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .operation on an `any` value.","line":187,"column":16,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":187,"endColumn":25},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .error on an `any` value.","line":187,"column":32,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":187,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":196,"column":13,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":196,"endColumn":58},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .error on an `any` value.","line":196,"column":25,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":196,"endColumn":30},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":218,"column":38,"nodeType":"TSAnyKeyword","messa