rm on an `any` value.","line":261,"column":41,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":261,"endColumn":49},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .release on an `any` value.","line":261,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":261,"endColumn":71},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .arch on an `any` value.","line":262,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":262,"endColumn":49},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .cpus on an `any` value.","line":263,"column":37,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":263,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .totalMemory on an `any` value.","line":264,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":264,"endColumn":56},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .uptime on an `any` value.","line":265,"column":39,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":265,"endColumn":45},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .webServer on an `any` value.","line":266,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":266,"endColumn":29},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .webServer on an `any` value.","line":267,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":267,"endColumn":54}],"suppressedMessages":[],"errorCount":21,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { PortScanner } from './port-scanner';\r\nimport { SystemScanner } from './system-scanner';\r\nimport { WebScanner } from './web-scanner';\r\nimport { Recommendation, ScanOptions } from '../database/models/scan-result';\r\nimport logger from '../utils/logger';\r\nimport { spawn } from 'child_process';\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-036: Allowed commands whitelist\r\n * Only these commands can be executed automatically\r\n */\r\nconst ALLOWED_COMMANDS: Set<string> = new Set([\r\n  // System management\r\n  'systemctl',\r\n  'service',\r\n  // Firewall\r\n  'ufw',\r\n  'firewall-cmd',\r\n  'iptables',\r\n  // Package management\r\n  'apt',\r\n  'apt-get',\r\n  'yum',\r\n  'dnf',\r\n  // Web servers\r\n  'nginx',\r\n  'apache2',\r\n  'apachectl',\r\n  // Permissions\r\n  'chmod',\r\n  'chown',\r\n  // Network\r\n  'sysctl',\r\n]);\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-036: Validate command against whitelist\r\n */\r\nfunction isCommandAllowed(command: string): boolean {\r\n  const parts = command.trim().split(/\\s+/);\r\n  const baseCommand = parts[0];\r\n\r\n  // Check for shell metacharacters that could lead to injection\r\n  const dangerousChars = /[;&|`$(){}[\\]<>'\"!#%^*?\\n\\r\\\\]/;\r\n  if (dangerousChars.test(command)) {\r\n    logger.warn('Command contains dangerous characters', { command });\r\n    return false;\r\n  }\r\n\r\n  // Check if base command is in whitelist\r\n  if (!ALLOWED_COMMANDS.has(baseCommand)) {\r\n    logger.warn('Command not in whitelist', { baseCommand, command });\r\n    return false;\r\n  }\r\n\r\n  return true;\r\n}\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-036: Safe command execution using spawn\r\n */\r\nasync function safeExecCommand(command: string): Promise<{ stdout: string; stderr: string }> {\r\n  return new Promise((resolve, reject) => {\r\n    const parts = command.trim().split(/\\s+/);\r\n    const cmd = parts[0];\r\n    const args = parts.slice(1);\r\n\r\n    const proc = spawn(cmd, args, {\r\n      timeout: 60000,\r\n      env: { ...process.env, PATH: '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' }\r\n    });\r\n\r\n    let stdout = '';\r\n    let stderr = '';\r\n\r\n    proc.stdout?.on('data', (data) => { stdout += data.toString(); });\r\n    proc.stderr?.on('data', (data) => { stderr += data.toString(); });\r\n\r\n    proc.on('close', (code) => {\r\n      if (code === 0) {\r\n        resolve({ stdout, stderr });\r\n      } else {\r\n        reject(new Error(`Command exited with code ${code}: ${stderr}`));\r\n      }\r\n    });\r\n\r\n    proc.on('error', (err) => {\r\n      reject(err);\r\n    });\r\n  });\r\n}\r\n\r\n/**\r\n * Optimization Engine\r\n * Orchestrates all scanners and generates comprehensive optimization recommendations\r\n */\r\nexport class OptimizationEngine {\r\n  private portScanner: PortScanner;\r\n  private systemScanner: SystemScanner;\r\n  private webScanner: WebScanner;\r\n\r\n  constructor() {\r\n    this.portScanner = new PortScanner();\r\n    this.systemScanner = new SystemScanner();\r\n    this.webScanner = new WebScanner();\r\n  }\r\n\r\n  /**\r\n   * Run full server scan\r\n   */\r\n  async runFullScan(options: ScanOptions = {}): Promise<{\r\n    systemInfo: any;\r\n    recommendations: Recommendation[];\r\n    summary: {\r\n      critical: number;\r\n      high: number;\r\n      medium: number;\r\n      low: number;\r\n    };\r\n  }> {\r\n    const allRecommendations: Recommendation[] = [];\r\n    const systemInfo: any = {};\r\n\r\n    logger.info('Starting full server scan...');\r\n\r\n    // 1. Port scanning\r\n    if (options.scanPorts !== false) {\r\n      logger.info('Running port scan...');\r\n      const portRecs = await this.portScanner.scanCommonPorts();\r\n      allRecommendations.push(...portRecs);\r\n    }\r\n\r\n    // 2. System scanning\r\n    if (options.scanSystem !== false) {\r\n      logger.info('Running system scan...');\r\n      const { info, recommendations } = await this.systemScanner.scanSystem();\r\n      Object.assign(systemInfo, info);\r\n      allRecommendations.push(...recommendations);\r\n    }\r\n\r\n    // 3. Web server scanning\r\n    if (options.scanWebServer !== false) {\r\n      logger.info('Running web server scan...');\r\n      const { server, recommendations } = await this.webScanner.scanWebServer();\r\n      systemInfo.webServer = server;\r\n      allRecommendations.push(...recommendations);\r\n    }\r\n\r\n    // Sort recommendations by priority\r\n    const sortedRecs = this.sortRecommendations(allRecommendations);\r\n\r\n    // Generate summary\r\n    const summary = this.generateSummary(sortedRecs);\r\n\r\n    logger.info('Full server scan complete', { summary });\r\n\r\n    return {\r\n      systemInfo,\r\n      recommendations: sortedRecs,\r\n      summary\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Apply an optimization\r\n   * SECURITY FIX CVE-2026-036: Use command whitelist and safe execution\r\n   */\r\n  async applyOptimization(recommendation: Recommendation): Promise<{ success: boolean; output?: string; error?: string }> {\r\n    if (!recommendation.autoApplicable) {\r\n      return {\r\n        success: false,\r\n        error: 'backend.this_recommendation_cannot_be_automatically_applied'\r\n      };\r\n    }\r\n\r\n    logger.info(`Applying optimization: ${recommendation.title}`);\r\n\r\n    // SECURITY FIX CVE-2026-036: Validate command against whitelist\r\n    if (!isCommandAllowed(recommendation.action)) {\r\n      logger.error(`Command not allowed: ${recommendation.action}`);\r\n      return {\r\n        success: false,\r\n        error: 'backend.command_not_in_allowed_list_or_contains_dangerous_characters'\r\n      };\r\n    }\r\n\r\n    try {\r\n      // SECURITY FIX CVE-2026-036: Use safe command execution with spawn\r\n      const { stdout, stderr } = await safeExecCommand(recommendation.action);\r\n\r\n      logger.info(`Optimization applied successfully`, { output: stdout });\r\n\r\n      return {\r\n        success: true,\r\n        output: stdout || stderr\r\n      };\r\n    } catch (error: any) {\r\n      logger.error(`Failed to apply optimization`, { error });\r\n\r\n      return {\r\n        success: false,\r\n        error: error.message\r\n      };\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Sort recommendations by priority\r\n   */\r\n  private sortRecommendations(recommendations: Recommendation[]): Recommendation[] {\r\n    const priorityOrder = {\r\n      critical: 0,\r\n      high: 1,\r\n      medium: 2,\r\n      low: 3\r\n    };\r\n\r\n    return recommendations.sort((a, b) => {\r\n      return priorityOrder[a.priority] - priorityOrder[b.priority];\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Generate summary statistics\r\n   */\r\n  private generateSummary(recommendations: Recommendation[]): {\r\n    critical: number;\r\n    high: number;\r\n    medium: number;\r\n    low: number;\r\n  } {\r\n    return {\r\n      critical: recommendations.filter(r => r.priority === 'critical').length,\r\n      high: recommendations.filter(r => r.priority === 'high').length,\r\n      medium: recommendations.filter(r => r.priority === 'medium').length,\r\n      low: recommendations.filter(r => r.priority === 'low').length\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Get optimization preview (what would be done)\r\n   */\r\n  async previewOptimizations(recommendations: Recommendation[]): Promise<{\r\n    autoApplicable: Recommendation[];\r\n    manual: Recommendation[];\r\n  }> {\r\n    const autoApplicable = recommendations.filter(r => r.autoApplicable);\r\n    const manual = recommendations.filter(r => !r.autoApplicable);\r\n\r\n    return { autoApplicable, manual };\r\n  }\r\n\r\n  /**\r\n   * Export recommendations as report\r\n   */\r\n  generateReport(systemInfo: any, recommendations: Recommendation[]): string {\r\n    let report = '# NewSecurity Server Optimization Report\\n\\n';\r\n    report += `Generated: ${new Date().toISOString()}\\n\\n`;\r\n\r\n    report += '## System Information\\n\\n';\r\n    report += `- Platform: ${systemInfo.platform} ${systemInfo.release}\\n`;\r\n    report += `- Architecture: ${systemInfo.arch}\\n`;\r\n    report += `- CPUs: ${systemInfo.cpus}\\n`;\r\n    report += `- Total Memory: ${systemInfo.totalMemory}\\n`;\r\n    report += `- Uptime: ${systemInfo.uptime}\\n`;\r\n    if (systemInfo.webServer) {\r\n      report += `- Web Server: ${systemInfo.webServer}\\n`;\r\n    }\r\n    report += '\\n';\r\n\r\n    report += '## Recommendations\\n\\n';\r\n\r\n    const byPriority = recommendations.reduce((acc, rec) => {\r\n      if (!acc[rec.priority]) acc[rec.priority] = [];\r\n      acc[rec.priority].push(rec);\r\n      return acc;\r\n    }, {} as Record<string, Recommendation[]>);\r\n\r\n    const priorities = ['critical', 'high', 'medium', 'low'];\r\n\r\n    for (const priority of priorities) {\r\n      if (byPriority[priority] && byPriority[priority].length > 0) {\r\n        report += `### ${priority.toUpperCase()} Priority (${byPriority[priority].length})\\n\\n`;\r\n\r\n        for (const rec of byPriority[priority]) {\r\n          report += `#### ${rec.title}\\n`;\r\n          report += `- **Category**: ${rec.category}\\n`;\r\n          report += `- **Description**: ${rec.description}\\n`;\r\n          report += `- **Action**: \\`${rec.action}\\`\\n`;\r\n          report += `- **Risk**: ${rec.risk}\\n`;\r\n          report += `- **Auto-Applicable**: ${rec.autoApplicable ? 'Yes' : 'No'}\\n\\n`;\r\n        }\r\n      }\r\n    }\r\n\r\n    report += '\\n---\\n';\r\n    report += 'Generated by NewSecurity v1.0.0\\n';\r\n\r\n    return report;\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\port-scanner.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":41,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":41,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1303,1306],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1303,1306],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { exec } from 'child_process';\r\nimport { promisify } from 'util';\r\nimport logger from '../utils/logger';\r\nimport { Recommendation } from '../database/models/scan-result';\r\n\r\nconst execAsync = promisify(exec);\r\n\r\n/**\r\n * Port Scanner\r\n * Scans for open ports and services\r\n */\r\nexport class PortScanner {\r\n  /**\r\n   * Scan common ports\r\n   */\r\n  async scanCommonPorts(): Promise<Recommendation[]> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      // Common ports to scan\r\n      const commonPorts = [21, 22, 23, 25, 53, 80, 110, 143, 443, 993, 995, 3306, 3389, 5432, 6379, 8000, 8080, 27017];\r\n\r\n      logger.info('Scanning common ports...');\r\n\r\n      // Use netstat to check listening ports\r\n      const { stdout } = await execAsync('netstat -tulpn 2>/dev/null || ss -tulpn 2>/dev/null || lsof -i -P -n | grep LISTEN');\r\n\r\n      const openPorts = this.parseOpenPorts(stdout);\r\n\r\n      // Check for security issues\r\n      for (const port of commonPorts) {\r\n        if (openPorts.includes(port)) {\r\n          const recommendation = this.analyzePort(port);\r\n          if (recommendation) {\r\n            recommendations.push(recommendation);\r\n          }\r\n        }\r\n      }\r\n\r\n      logger.info(`Port scan complete. Found ${openPorts.length} open ports`);\r\n    } catch (error: any) {\r\n      logger.error('Port scan failed', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Parse open ports from netstat output\r\n   */\r\n  private parseOpenPorts(output: string): number[] {\r\n    const ports: number[] = [];\r\n    const lines = output.split('\\n');\r\n\r\n    for (const line of lines) {\r\n      // Match port numbers in the output\r\n      const match = line.match(/:(\\d+)\\s/);\r\n      if (match) {\r\n        const port = parseInt(match[1]);\r\n        if (!ports.includes(port)) {\r\n          ports.push(port);\r\n        }\r\n      }\r\n    }\r\n\r\n    return ports;\r\n  }\r\n\r\n  /**\r\n   * Analyze a specific port and generate recommendation\r\n   */\r\n  private analyzePort(port: number): Recommendation | null {\r\n    const securityRisks: Record<number, Recommendation> = {\r\n      21: {\r\n        category: 'security',\r\n        priority: 'medium',\r\n        title: 'FTP Port (21) is Open',\r\n        description: 'FTP transmits data in plain text and can be a security risk',\r\n        action: 'Consider using SFTP (port 22) or FTPS instead',\r\n        autoApplicable: false,\r\n        risk: 'Credentials and data can be intercepted'\r\n      },\r\n      23: {\r\n        category: 'security',\r\n        priority: 'high',\r\n        title: 'Telnet Port (23) is Open',\r\n        description: 'Telnet is insecure and transmits data in plain text',\r\n        action: 'Disable Telnet and use SSH instead',\r\n        autoApplicable: false,\r\n        risk: 'Credentials can be easily intercepted'\r\n      },\r\n      3306: {\r\n        category: 'security',\r\n        priority: 'high',\r\n        title: 'MySQL Port (3306) Exposed',\r\n        description: 'MySQL database port is accessible from external network',\r\n        action: 'Bind MySQL to localhost (127.0.0.1) or configure firewall',\r\n        autoApplicable: false,\r\n        risk: 'Database can be attacked from external network'\r\n      },\r\n      5432: {\r\n        category: 'security',\r\n        priority: 'high',\r\n        title: 'PostgreSQL Port (5432) Exposed',\r\n        description: 'PostgreSQL database port is accessible from external network',\r\n        action: 'Bind PostgreSQL to localhost or configure firewall',\r\n        autoApplicable: false,\r\n        risk: 'Database can be attacked from external network'\r\n      },\r\n      6379: {\r\n        category: 'security',\r\n        priority: 'critical',\r\n        title: 'Redis Port (6379) Exposed',\r\n        description: 'Redis has no authentication by default and is exposed',\r\n        action: 'Bind Redis to localhost, enable authentication, and configure firewall',\r\n        autoApplicable: false,\r\n        risk: 'Anyone can access and modify your data'\r\n      },\r\n      27017: {\r\n        category: 'security',\r\n        priority: 'high',\r\n        title: 'MongoDB Port (27017) Exposed',\r\n        description: 'MongoDB port is accessible from external network',\r\n        action: 'Bind MongoDB to localhost or enable authentication',\r\n        autoApplicable: false,\r\n        risk: 'Database can be accessed without proper authentication'\r\n      }\r\n    };\r\n\r\n    return securityRisks[port] || null;\r\n  }\r\n\r\n  /**\r\n   * Scan for specific port\r\n   */\r\n  async isPortOpen(port: number): Promise<boolean> {\r\n    try {\r\n      const { stdout } = await execAsync(`netstat -tulpn 2>/dev/null | grep :${port} || ss -tulpn 2>/dev/null | grep :${port}`);\r\n      return stdout.trim().length > 0;\r\n    } catch (error) {\r\n      return false;\r\n    }\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\scan-scheduler.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\smart-fixer.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":54,"column":13,"nodeType":