no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":128,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":128,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3506,3509],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3506,3509],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":129,"column":62,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":129,"endColumn":69},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":133,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":133,"endColumn":29},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":133,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":133,"endColumn":29},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":153,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":153,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4084,4087],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4084,4087],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":154,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":154,"endColumn":71}],"suppressedMessages":[],"errorCount":19,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Seed Data API Routes\r\n *\r\n * Provides endpoints for managing seed data in demo mode.\r\n * All operations are restricted to demo mode for safety.\r\n */\r\n\r\nimport { Router, Response } from 'express';\r\nimport { authenticate, requireRole, AuthenticatedRequest } from '../../middleware/auth.middleware';\r\nimport { SeedManager, SeedOptions, SeedStatus } from '../../database/seeds/seed-manager';\r\nimport logger from '../../utils/logger';\r\n\r\nconst router = Router();\r\n\r\n// All seed routes require authentication and admin role\r\nrouter.use(authenticate);\r\nrouter.use(requireRole('admin'));\r\n\r\n/**\r\n * GET /api/seed/status\r\n * Get current seed status\r\n */\r\nrouter.get('/status', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const status: SeedStatus = SeedManager.status();\r\n\r\n    res.json({\r\n      success: true,\r\n      data: status\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to get seed status', { error: error.message });\r\n    res.status(500).json({\r\n      success: false,\r\n      error: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * POST /api/seed/execute\r\n * Execute database seeding\r\n *\r\n * Request body:\r\n * - clearExisting: boolean - Clear existing data before seeding\r\n * - verbose: boolean - Enable verbose logging\r\n * - force: boolean - Force seeding in production mode (DANGEROUS)\r\n */\r\nrouter.post('/execute', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const { clearExisting = false, verbose = true, force = false } = req.body;\r\n\r\n    const options: SeedOptions = {\r\n      clearExisting,\r\n      verbose,\r\n      force\r\n    };\r\n\r\n    // Check if seeding is allowed\r\n    if (!SeedManager.canSeed() && !force) {\r\n      return res.status(403).json({\r\n        success: false,\r\n        error: 'backend.seeding_not_allowed_in_production_mode',\r\n        message: 'Seeding is not allowed in production mode. Set APP_MODE=demo or use force=true.'\r\n      });\r\n    }\r\n\r\n    // Execute seeding\r\n    await SeedManager.seed(options);\r\n\r\n    logger.info('Database seeding completed', {\r\n      userId: req.user?.userId,\r\n      options\r\n    });\r\n\r\n    res.json({\r\n      success: true,\r\n      message: 'backend.seeding_completed_successfully'\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to execute seeding', { error: error.message });\r\n    res.status(500).json({\r\n      success: false,\r\n      error: 'backend.seeding_failed',\r\n      message: error.message\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * DELETE /api/seed/clear\r\n * Clear all seed data\r\n *\r\n * Request body:\r\n * - force: boolean - Force clearing in production mode (DANGEROUS)\r\n * - verbose: boolean - Enable verbose logging\r\n */\r\nrouter.delete('/clear', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const { force = false, verbose = true } = req.body;\r\n\r\n    const options: SeedOptions = {\r\n      force,\r\n      verbose\r\n    };\r\n\r\n    // Check if clearing is allowed\r\n    if (!SeedManager.canSeed() && !force) {\r\n      return res.status(403).json({\r\n        success: false,\r\n        error: 'backend.clearing_not_allowed_in_production_mode',\r\n        message: 'Clearing is not allowed in production mode. Set APP_MODE=demo or use force=true.'\r\n      });\r\n    }\r\n\r\n    // Execute clearing\r\n    await SeedManager.clear(options);\r\n\r\n    logger.info('Seed data cleared', {\r\n      userId: req.user?.userId,\r\n      options\r\n    });\r\n\r\n    res.json({\r\n      success: true,\r\n      message: 'backend.seed_data_cleared_successfully'\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to clear seed data', { error: error.message });\r\n    res.status(500).json({\r\n      success: false,\r\n      error: 'backend.clearing_failed',\r\n      message: error.message\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * GET /api/seed/check\r\n * Check if database has been seeded\r\n */\r\nrouter.get('/check', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const isSeeded = SeedManager.isSeeded();\r\n\r\n    res.json({\r\n      success: true,\r\n      data: {\r\n        isSeeded,\r\n        canSeed: SeedManager.canSeed()\r\n      }\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to check seed status', { error: error.message });\r\n    res.status(500).json({\r\n      success: false,\r\n      error: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\sites.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":23,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":23,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[904,907],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[904,907],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":27,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":27,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[995,998],"text":"unknown"},"desc":"Use `unknown` instead