ype":"Property","messageId":"anyAssignment","endLine":909,"endColumn":118},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .site on an `any` value.","line":909,"column":35,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":909,"endColumn":39},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":909,"column":55,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":909,"endColumn":73},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .site on an `any` value.","line":909,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":909,"endColumn":68},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":910,"column":13,"nodeType":"Property","messageId":"anyAssignment","endLine":910,"endColumn":168},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .networkProfile on an `any` value.","line":910,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":910,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":910,"column":75,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":910,"endColumn":103},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .networkProfile on an `any` value.","line":910,"column":84,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":910,"endColumn":98},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":911,"column":13,"nodeType":"Property","messageId":"anyAssignment","endLine":911,"endColumn":153},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .scanProfile on an `any` value.","line":911,"column":42,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":911,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":911,"column":69,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":911,"endColumn":94},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .scanProfile on an `any` value.","line":911,"column":78,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":911,"endColumn":89},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":912,"column":13,"nodeType":"Property","messageId":"anyAssignment","endLine":912,"endColumn":100},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .notes on an `any` value.","line":912,"column":36,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":912,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":912,"column":57,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":912,"endColumn":76},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .notes on an `any` value.","line":912,"column":66,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":912,"endColumn":71},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .commandPermissions on an `any` value.","line":913,"column":70,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":913,"endColumn":88},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":914,"column":13,"nodeType":"Property","messageId":"anyAssignment","endLine":914,"endColumn":100},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tags on an `any` value.","line":914,"column":42,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":914,"endColumn":46},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":914,"column":50,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":914,"endColumn":70},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tags on an `any` value.","line":914,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":914,"endColumn":63},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":982,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":982,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[36481,36484],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[36481,36484],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":983,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":983,"endColumn":71},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1020,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1020,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[37760,37763],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[37760,37763],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":1021,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":1021,"endColumn":71},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1088,"column":86,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1088,"endColumn":89,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[40197,40200],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[40197,40200],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":1093,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":1093,"endColumn":16}],"suppressedMessages":[],"errorCount":72,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿﻿﻿﻿/**\r\n * AetherGuard - ESP32 Device Management API\r\n *\r\n * REST API for ESP32 firmware gateway\r\n * SECURITY FIX CVE-2026-031: Added authentication middleware\r\n * SECURITY FIX: Route ordering - static routes before dynamic routes\r\n */\r\n\r\nimport { Router, Request, Response } from 'express';\r\nimport { authenticate, requireRole, AuthenticatedRequest } from '../../middleware/auth.middleware';\nimport logger from '../../utils/logger';\nimport { securityOperationsService } from '../../services/security-operations.service';\nimport auditLogger from '../../security/audit-logger.service';\nimport { commandDispatcherService } from '../../services/command-dispatcher.service';\nimport { PLATFORM_TENANT_ID, resolveRequestTenantContext } from '../../core/tenant/tenant-context';\n\r\nconst router = Router();\r\n\r\n// SECURITY FIX CVE-2026-031: Apply authentication to all routes\r\nrouter.use(authenticate);\r\n\r\n// Device storage (in-memory + can be extended to database)\r\ninterface DeviceInfo {\n    deviceId: string;\n    version: string;\n    chipModel: string;\n    flashSize: number;\r\n    freeHeap: number;\r\n    sdkVersion: string;\r\n    mode: 'online' | 'offline';\r\n    isOnline: boolean;\r\n    lastHeartbeat: Date;\r\n    connectedAgents: string[];\r\n    status?: {\r\n        cpuUsage: number;\r\n        memoryUsage: number;\r\n        uptime: number;\r\n        wifiRssi: number;\r\n    };\r\n    systemInfo?: {\n        hostname: string;\n        os: string;\n        kernel: string;\n        arch: string;\n    };\n    transport?: 'wifi' | 'usb_serial' | 'ethernet' | 'unknown';\n    externalPowerPresent?: boolean;\n    secureElementPresent?: boolean;\n    pendingPhysicalApproval?: boolean;\n    interlockState?: 'disabled' | 'armed' | 'asserted' | 'fault' | 'unknown';\n    hostActionState?: 'idle' | 'running' | 'awaiting_confirmation' | 'completed' | 'failed' | 'unknown';\n    physicalAuth?: {\n        publicKeyPem?: string;\n        monotonicCounter?: number;\n        lastConfirmedAt?: string;\n    };\n}\n\r\ninterface DeviceConfig {\r\n    displayName: string;\r\n    group: string;\r\n    site: string;\r\n    networkProfile: string;\r\n    scanProfile: string;\r\n    notes: string;\r\n    commandPermissions: string[];\r\n    tags: string[];\r\n    updatedAt: string;\r\n}\r\n\r\ninterface DeviceCommandRecord {\r\n    id: string;\r\n    deviceId: string;\r\n    command: string;\r\n    status: 'queued' | 'completed' | 'failed';\r\n    message: string;\r\n    executedBy: string;\r\n    createdAt: string;\r\n    completedAt?: string;\r\n    params?: Record<string, any>;\r\n}\r\n\r\ninterface DeviceEvent {\r\n    id: string;\r\n    deviceId: string;\r\n    type: 'register' | 'heartbeat' | 'data' | 'alert' | 'unknown_error' | 'disconnect' | 'command';\r\n    payload: any;\r\n    timestamp: string;\r\n}\r\n\r\nconst devices = new Map<string, DeviceInfo>();\nconst deviceEvents = new Map<string, DeviceEvent[]>();\nconst deviceConfigs = new Map<string, DeviceConfig>();\nconst deviceCommands = new Map<string, DeviceCommandRecord[]>();\nlet deviceCommandTransport: ((deviceId: string, command: string, params?: Record<string, any>) => Promise<boolean> | boolean) | null = null;\n\nconst ALL_DEVICE_COMMANDS = [\n    'collect',\n    'sync-config',\n    'ota_update',\n    'host_backup',\n    'host_install',\n    'reboot',\n    'host_remove',\n    'recovery_flash',\n    'factory_reset',\n    'diagnostic_unlock',\n    'vehicle_ota_flash',\n    'cellular_breaker_assert',\n    'cellular_breaker_release'\n];\n\r\nfunction resolveActorTenantId(req?: AuthenticatedRequest): string {\r\n    if (!req) {\r\n        return PLATFORM_TENANT_ID;\r\n    }\r\n\r\n    const context = resolveRequestTenantContext(req, {\r\n        allowAdminPlatformFallback: req.user?.role === 'admin'\r\n    });\r\n\r\n    return context?.tenantId || req.user?.tenantId || PLATFORM_TENANT_ID;\r\n}\r\n\r\nfunction safeAuditLog(payload: any): void {\r\n    Promise.resolve(auditLogger.log(payload)).catch((error: any) => {\r\n        logger.warn('Device audit log unavailable', { error: error?.message });\r\n    });\r\n}\r\n\r\n// Codebook\r\nconst codebook: Record<string, string> = {\r\n    'E001': 'Connection refused',\r\n    'E002': 'Permission denied',\r\n    'E003': 'Out of memory',\r\n    'E004': 'Disk full',\r\n    'E005': 'Service unavailable',\r\n    'S001': 'CPU usage critical (>90%)',\r\n    'S002': 'Memory usage critical (>85%)',\r\n    'S003': 'Disk usage critical (>90%)',\r\n    'A001': 'SQL Injection detected',\r\n    'A002': 'XSS attempt blocked',\r\n    'A003': 'Path traversal attempt',\r\n    'A004': 'Command injection detected',\r\n    'A005': 'Brute force attack',\r\n    'A006': 'DDoS pattern detected',\r\n};\r\n\r\nfunction buildDefaultConfig(device: DeviceInfo): DeviceConfig {\n    return {\n        displayName: device.deviceId,\n        group: device.mode === 'online' ? 'core-edge' : 'field-edge',\n        site: device.systemInfo?.hostname || 'unassigned-site',\n        networkProfile: device.mode === 'online' ? 'cloud-mesh' : 'standalone-buffer',\n        scanProfile: device.isOnline ? 'balanced' : 'offline-recovery',\n        notes: `${device.chipModel} running firmware ${device.version}`,\n        commandPermissions: [...ALL_DEVICE_COMMANDS],\n        tags: [device.chipModel.toLowerCase(), device.mode, device.isOnline ? 'online' : 'offline'],\n        updatedAt: new Date().toISOString()\n    };\n}\n\nfunction normalizeCommandPermissions(input: unknown, fallback: string[]): string[] {\n    if (!Array.isArray(input)) {\n        return fallback;\n    }\n\n    const next = input\n        .map((value) => String(value || '').trim())\n        .filter((value, index, list) => value && ALL_DEVICE_COMMANDS.includes(value) && list.indexOf(value) === index);\n\n    return next.length > 0 ? next : fallback;\n}\n\nfunction serializeDevice(device: DeviceInfo) {\n    return {\n        ...device,\n        lastHeartbeat: device.lastHeartbeat.toISOString(),\n        physicalAuth: {\n            hasPublicKey: Boolean(device.physicalAuth?.publicKeyPem),\n            monotonicCounter: device.physicalAuth?.monotonicCounter || 0,\n            lastConfirmedAt: device.physicalAuth?.lastConfirmedAt || null\n        }\n    };\n}\n\r\nfunction ensureDeviceConfig(device: DeviceInfo): DeviceConfig {\r\n    const existing = deviceConfigs.get(device.deviceId);\r\n    if (existing) {\r\n        return existing;\r\n    }\r\n    const next = buildDefaultConfig(device);\r\n    deviceConfigs.set(device.deviceId, next);\r\n    return next;\r\n}\r\n\r\nfunction getDeviceCommandHistory(deviceId: string, limit = 10): DeviceCommandRecord[] {\r\n    return (deviceCommands.get(deviceId) || []).slice(0, limit);\r\n}\r\n\r\nfunction pushDeviceCommand(record: DeviceCommandRecord): void {\n    const rows = deviceCommands.get(record.deviceId) || [];\r\n    rows.unshift(record);\r\n    if (rows.length > 50) {\r\n        rows.length = 50;\r\n    }\r\n    deviceCommands.set(record.deviceId, rows);\n}\n\nfunction getLatestConfirmationSessionSafe(deviceId: string) {\n    try {\n        const { deviceControlService } = require('../../services/device-control.service');\n        return deviceControlService?.getLatestConfirmationSession?.(deviceId) || null;\n    } catch {\n        return null;\n    }\n}\n\r\nexport function getDeviceById(deviceId: string): DeviceInfo | undefined {\n    return devices.get(deviceId);\n}\n\nexport function patchDeviceRuntime(deviceId: string, patch: Partial<DeviceInfo>): void {\n    const device = devices.get(deviceId);\n    if (!device) {\n        return;\n    }\n\n    const next: DeviceInfo = {\n        ...device,\n        ...patch,\n        systemInfo: patch.systemInfo ? { ...(device.systemInfo || {}), ...patch.systemInfo } : device.systemInfo,\n        physicalAuth: patch.physicalAuth ? { ...(device.physicalAuth || {}), ...patch.physicalAuth } : device.physicalAuth\n    };\n\n    devices.set(deviceId, next);\n}\n\r\nexport function setDeviceCommandTransport(\r\n    transport: ((deviceId: string, command: string, params?: Record<string, any>) => Promise<boolean> | boolean) | null\r\n): void {\r\n    deviceCommandTransport = transport;\r\n}\r\n\r\nexport async function executeDeviceCommandInternal(input: {\n    deviceId: string;\r\n    command: string;\r\n    params?: Record<string, any>;\r\n    actorId: string;\r\n    actorEmail?: string;\r\n    actorIp?: string;\r\n    actionId?: string;\r\n}): Promise<{ success: boolean; record?: DeviceCommandRecord; message: string; reason?: string }> {\r\n    const device = devices.get(input.deviceId);\r\n    if (!device) {\r\n        return { success: false, message: 'Device not found.', reason: 'device_not_found' };\r\n    }\r\n\r\n    const config = ensureDeviceConfig(device);\r\n    if (!config.commandPermissions.includes(input.command)) {\r\n        return { success: false, message: `Command ${input.command} is not permitted for this device.`, reason: 'command_not_permitted' };\r\n    }\r\n\r\n    if (!device.isOnline) {\r\n        return { success: false, message: 'Device is offline.', reason: 'device_offline' };\r\n    }\r\n\r\n    if (deviceCommandTransport) {\r\n        const accepted = await Promise.resolve(deviceCommandTransport(input.deviceId, input.command, input.params || {}));\r\n        if (!accepted) {\r\n            return { success: false, message: `Device gateway rejected command ${input.command}.`, reason: 'device_gateway_rejected' };\r\n        }\r\n    }\r\n\r\n    const now = new Date().toISOString();\n    const commandMessages: Record<string, string> = {\n        collect: `Telemetry collection completed on ${input.deviceId}`,\n        'sync-config': `Configuration synchronized on ${input.deviceId}`,\n        ota_update: `OTA workflow acknowledged on ${input.deviceId}`,\n        host_backup: `Host backup requested on ${input.deviceId}`,\n        host_install: `Host install workflow queued on ${input.deviceId}`,\n        reboot: `Reboot command executed on ${input.deviceId}`,\n        host_remove: `Host removal workflow queued on ${input.deviceId}`,\n        recovery_flash: `Recovery flash workflow queued on ${input.deviceId}`,\n        factory_reset: `Factory reset workflow queued on ${input.deviceId}`,\n        diagnostic_unlock: `Diagnostic unlock workflow queued on ${input.deviceId}`,\n        vehicle_ota_flash: `Vehicle OTA flash workflow queued on ${input.deviceId}`,\n        cellular_breaker_assert: `Cellular breaker asserted on ${input.deviceId}`,\n        cellular_breaker_release: `Cellular breaker released on ${input.deviceId}`\n    };\n    const record: DeviceCommandRecord = {\n        id: input.actionId || `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,\n        deviceId: input.deviceId,\n        command: input.command,\n        status: 'completed',\n        message: commandMessages[input.command] || `Command \"${input.command}\" executed successfully on ${input.deviceId}`,\n        executedBy: input.actorEmail || input.actorId || 'unknown',\n        createdAt: now,\n        completedAt: now,\n        params: input.params || {}\n    };\n\r\n    pushDeviceCommand(record);\r\n    addDeviceEvent(input.deviceId, 'command', {\r\n        action: input.command,\r\n        params: input.params || {},\r\n        status: record.status,\r\n        message: record.message,\r\n        queuedBy: record.executedBy,\r\n        actionId: input.actionId || null\r\n    });\r\n\r\n    if (input.command === 'collect') {\r\n        device.lastHeartbeat = new Date();\r\n        device.freeHeap = Math.max(64_000, device.freeHeap - 2_048);\r\n    }\r\n\r\n    if (input.command === 'reboot') {\n        device.lastHeartbeat = new Date();\n        device.status = device.status\n            ? { ...device.status, uptime: 0, cpuUsage: Math.max(5, Math.round(device.status.cpuUsage * 0.6)) }\n            : device.status;\n        device.pendingPhysicalApproval = false;\n        device.hostActionState = 'completed';\n    }\n\n    if (input.command === 'host_backup') {\n        device.hostActionState = 'running';\n    }\n\n    if (['host_install', 'host_remove', 'recovery_flash', 'factory_reset'].includes(input.command)) {\n        device.pendingPhysicalApproval = false;\n        device.hostActionState = 'running';\n    }\n\n    if (['diagnostic_unlock', 'vehicle_ota_flash'].includes(input.command)) {\n        device.pendingPhysicalApproval = false;\n        device.hostActionState = 'running';\n    }\n\n    if (input.command === 'cellular_breaker_assert') {\n        device.pendingPhysicalApproval = false;\n        device.hostActionState = 'completed';\n        device.interlockState = 'asserted';\n    }\n\n    if (input.command === 'cellular_breaker_release') {\n        device.pendingPhysicalApproval = false;\n        device.hostActionState = 'completed';\n        device.interlockState = device.externalPowerPresent ? 'armed' : 'disabled';\n    }\n\n    devices.set(input.deviceId, device);\n    try {\r\n        const asset = ensureDeviceAsset(device);\r\n        syncDeviceSignals(device, asset.assetId);\r\n    } catch {\r\n        // Ignore when operations database is unavailable.\r\n    }\r\n\r\n    logger.info('Command sent to device', {\r\n        deviceId: input.deviceId,\r\n        command: input.command,\r\n        params: input.params || {},\r\n        actionId: input.actionId || null\r\n    });\r\n\r\n    return {\r\n        success: true,\r\n        record,\r\n        message: record.message\r\n    };\r\n}\r\n\r\ncommandDispatcherService.setDeviceAdapter({\r\n    getDevice: getDeviceById,\r\n    executeCommand: executeDeviceCommandInternal\r\n});\r\n\r\nfunction ensureDeviceAsset(device: DeviceInfo) {\r\n    const config = ensureDeviceConfig(device);\r\n    return securityOperationsService.upsertAsset({\r\n        tenantId: PLATFORM_TENANT_ID,\r\n        assetType: 'device',\r\n        externalRef: device.deviceId,\r\n        displayName: config.displayName || device.deviceId,\r\n        primaryAddress: device.systemInfo?.hostname,\r\n        status: device.isOnline ? 'online' : 'offline',\r\n        metadata: {\r\n            chipModel: device.chipModel,\r\n            firmwareVersion: device.version,\r\n            group: config.group,\r\n            site: config.site,\r\n            networkProfile: config.networkProfile,\r\n            scanProfile: config.scanProfile,\r\n            tags: config.tags\r\n        }\r\n    });\r\n}\r\n\r\nfunction syncDeviceSignals(device: DeviceInfo, assetId?: string): void {\r\n    const target = device.systemInfo?.hostname || device.deviceId;\r\n    const heartbeatAgeMs = Date.now() - device.lastHeartbeat.getTime();\r\n    const staleHeartbeat = device.isOnline && heartbeatAgeMs > 15 * 60 * 1000;\r\n\r\n    securityOperationsService.syncSignalFinding({\r\n        tenantId: PLATFORM_TENANT_ID,\r\n        active: !device.isOnline || staleHeartbeat,\r\n        assetId,\r\n        sourceType: 'device-health',\r\n        sourceRef: device.deviceId,\r\n        target,\r\n        category: 'device-health',\r\n        severity: 'high',\r\n        title: !device.isOnline ? 'Device Offline' : 'Device Heartbeat Stale',\r\n        description: !device.isOnline\r\n            ? `Device ${device.deviceId} is offline and not reporting telemetry.`\r\n            : `Device ${device.deviceId} has not reported for more than 15 minutes.`,\r\n        evidence: {\r\n            deviceId: device.deviceId,\r\n            lastHeartbeat: device.lastHeartbeat.toISOString(),\r\n            isOnline: device.isOnline,\r\n            staleHeartbeat\r\n        },\r\n        remediation: {\r\n            title: 'Recover device connectivity',\r\n            owner: 'operations',\r\n            priority: 'high',\r\n            suggestedSteps: [\r\n                'Check the device power and network connectivity.',\r\n                'Verify the gateway can still reach the device.',\r\n                'Reboot or re-enroll the device if telemetry does not resume.'\r\n            ]\r\n        },\r\n        fingerprint: `device:${device.deviceId}:health:availability`,\r\n        createAlert: true,\r\n        alertType: 'system'\r\n    });\r\n\r\n    securityOperationsService.syncSignalFinding({\r\n        tenantId: PLATFORM_TENANT_ID,\r\n        active: Boolean(device.status && device.status.cpuUsage >= 90),\r\n        assetId,\r\n        sourceType: 'device-health',\r\n        sourceRef: device.deviceId,\r\n        target,\r\n        category: 'device-health',\r\n        severity: 'high',\r\n        title: 'Device CPU Saturation',\r\n        description: `Device ${device.deviceId} CPU usage is ${device.status?.cpuUsage || 0}%.`,\r\n        evidence: {\r\n            deviceId: device.deviceId,\r\n            cpuUsage: device.status?.cpuUsage || 0\r\n        },\r\n        remediation: {\r\n            title: 'Reduce device CPU pressure',\r\n            owner: 'operations',\r\n            priority: 'high',\r\n            suggestedSteps: [\r\n                'Inspect the running workload and recent commands.',\r\n                'Reduce concurrent collection tasks or reboot the device.',\r\n                'Validate CPU returns to a stable baseline after mitigation.'\r\n            ]\r\n        },\r\n        fingerprint: `device:${device.deviceId}:health:cpu`,\r\n        createAlert: true,\r\n        alertType: 'system'\r\n    });\r\n\r\n    securityOperationsService.syncSignalFinding({\r\n        tenantId: PLATFORM_TENANT_ID,\r\n        active: Boolean(device.status && device.status.memoryUsage >= 85),\r\n        assetId,\r\n        sourceType: 'device-health',\r\n        sourceRef: device.deviceId,\r\n        target,\r\n        category: 'device-health',\r\n        severity: 'medium',\r\n        title: 'Device Memory Pressure',\r\n        description: `Device ${device.deviceId} memory usage is ${device.status?.memoryUsage || 0}%.`,\r\n        evidence: {\r\n            deviceId: device.deviceId,\r\n            memoryUsage: device.status?.memoryUsage || 0,\r\n            freeHeap: device.freeHeap\r\n        },\r\n        remediation: {\r\n            title: 'Stabilize device memory usage',\r\n            owner: 'operations',\r\n            priority: 'medium',\r\n            suggestedSteps: [\r\n                'Collect a fresh heap snapshot from the device.',\r\n                'Reduce the active workload or restart memory-heavy modules.',\r\n                'Confirm free heap recovers after the change.'\r\n            ]\r\n        },\r\n        fingerprint: `device:${device.deviceId}:health:memory`,\r\n        createAlert: false,\r\n        alertType: 'system'\r\n    });\r\n\r\n    securityOperationsService.syncSignalFinding({\r\n        tenantId: PLATFORM_TENANT_ID,\r\n        active: Boolean(device.status && device.status.wifiRssi <= -80),\r\n        assetId,\r\n        sourceType: 'device-health',\r\n        sourceRef: device.deviceId,\r\n        target,\r\n        category: 'device-connectivity',\r\n        severity: 'medium',\r\n        title: 'Device Signal Weak',\r\n        description: `Device ${device.deviceId} signal strength dropped to ${device.status?.wifiRssi || 0} dBm.`,\r\n        evidence: {\r\n            deviceId: device.deviceId,\r\n            wifiRssi: device.status?.wifiRssi || 0\r\n        },\r\n        remediation: {\r\n            title: 'Improve device link quality',\r\n            owner: 'operations',\r\n            priority: 'medium',\r\n            suggestedSteps: [\r\n                'Validate access point proximity and interference.',\r\n                'Move the device or reassign the wireless profile if needed.',\r\n                'Confirm telemetry stability after the signal recovers.'\r\n            ]\r\n        },\r\n        fingerprint: `device:${device.deviceId}:health:wifi`,\r\n        createAlert: false,\r\n        alertType: 'system'\r\n    });\r\n}\r\n\r\nfunction recordDeviceAction(device: DeviceInfo, input: { title: string; status: 'pending' | 'running' | 'completed' | 'failed'; operator: string; rollbackNotes?: string; runLog?: Record<string, any>[]; }): void {\r\n    try {\r\n        const asset = ensureDeviceAsset(device);\r\n        securityOperationsService.recordActionRun({\r\n            tenantId: PLATFORM_TENANT_ID,\r\n            assetId: asset.assetId,\r\n            title: input.title,\r\n            status: input.status,\r\n            operator: input.operator,\r\n            rollbackNotes: input.rollbackNotes,\r\n            runLog: input.runLog\r\n        });\r\n    } catch {\r\n        // Ignore when operations database is unavailable in lightweight tests.\r\n    }\r\n}\r\n\r\nfunction summarizeSecurity(device: DeviceInfo) {\r\n    const commandHistory = getDeviceCommandHistory(device.deviceId, 5);\r\n    try {\r\n        const asset = ensureDeviceAsset(device);\r\n        if (device.systemInfo?.hostname) {\r\n            securityOperationsService.upsertAsset({\r\n                tenantId: PLATFORM_TENANT_ID,\r\n                assetType: 'host',\r\n                externalRef: device.systemInfo.hostname,\r\n                displayName: device.systemInfo.hostname,\r\n                primaryAddress: device.systemInfo.hostname,\r\n                status: device.isOnline ? 'online' : 'offline',\r\n                metadata: {\r\n                    deviceId: device.deviceId,\r\n                    chipModel: device.chipModel\r\n                }\r\n            });\r\n        }\r\n        syncDeviceSignals(device, asset.assetId);\r\n        const context = securityOperationsService.getOperationalContextForExternalRefs(\r\n            PLATFORM_TENANT_ID,\r\n            [device.deviceId, device.systemInfo?.hostname || ''],\r\n            ['device', 'host']\r\n        );\r\n        return {\r\n            asset: context.assets.find((item) => item.assetId === asset.assetId) || context.assets[0] || asset,\r\n            findings: context.findings,\r\n            alerts: context.alerts,\r\n            actions: context.actions,\r\n            recentScans: context.scanRuns,\r\n            serviceExposure: context.serviceExposure,\r\n            relatedSessions: context.trafficSessions,\r\n            latestCommand: commandHistory[0] || null\r\n        };\r\n    } catch {\r\n        return {\r\n            asset: null,\r\n            findings: [],\r\n            alerts: [],\r\n            actions: [],\r\n            recentScans: [],\r\n            serviceExposure: [],\r\n            relatedSessions: [],\r\n            latestCommand: commandHistory[0] || null\r\n        };\r\n    }\r\n}\r\n\r\n/**\r\n * GET /api/devices\r\n * Get all ESP32 device list\r\n */\r\nrouter.get('/', (_req: Request, res: Response) => {\r\n    try {\r\n        const deviceList = Array.from(devices.values()).map(device => ({\n            ...(() => {\n                const config = ensureDeviceConfig(device);\n                try {\r\n                    securityOperationsService.upsertAsset({\r\n                        tenantId: PLATFORM_TENANT_ID,\r\n                        assetType: 'device',\r\n                        externalRef: device.deviceId,\r\n                        displayName: device.deviceId,\r\n                        primaryAddress: device.systemInfo?.hostname,\r\n                        status: device.isOnline ? 'online' : 'offline',\r\n                        metadata: {\r\n                            chipModel: device.chipModel,\r\n                            firmwareVersion: device.version,\r\n                            group: config.group,\r\n                            site: config.site\r\n                        }\r\n                    });\r\n                } catch {\r\n                    // Ignore when operations database is not initialized.\r\n                }\n                return {};\n            })(),\n            ...serializeDevice(device),\n            config: ensureDeviceConfig(device),\n            securitySummary: summarizeSecurity(device),\n            latestConfirmationSession: getLatestConfirmationSessionSafe(device.deviceId)\n        }));\n\r\n        res.json({\r\n            success: true,\r\n            total: deviceList.length,\r\n            online: deviceList.filter(d => d.isOnline).length,\r\n            devices: deviceList,\r\n        });\r\n    } catch (error: any) {\r\n        logger.error('Failed to get devices', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n/**\r\n * GET /api/devices/codebook\r\n * NOTE: This static route must be defined BEFORE /:id routes\r\n */\r\nrouter.get('/codebook', (_req: Request, res: Response) => {\r\n    res.json({\r\n        success: true,\r\n        codebook,\r\n    });\r\n});\r\n\r\n/**\r\n * POST /api/devices/codebook\r\n * NOTE: This static route must be defined BEFORE /:id routes\r\n */\r\nrouter.post('/codebook', (req: Request, res: Response) => {\r\n    try {\r\n        const { entries } = req.body;\r\n\r\n        if (!entries || typeof entries !== 'object') {\r\n            return res.status(400).json({ success: false, error: 'backend.invalid_entries' });\r\n        }\r\n\r\n        const maxEntries = 1000;\r\n        const currentEntries = Object.keys(codebook).length;\r\n        const newEntriesCount = Object.keys(entries).length;\r\n\r\n        if (currentEntries + newEntriesCount > maxEntries) {\r\n            return res.status(400).json({\r\n                success: false,\r\n                error: `Too many entries. Maximum ${maxEntries} entries allowed.`\r\n            });\r\n        }\r\n\r\n        for (const [key, value] of Object.entries(entries)) {\r\n            if (!/^[A-Z0-9_-]+$/.test(key)) {\r\n                return res.status(400).json({\r\n                    success: false,\r\n                    error: `Invalid key format: ${key}. Only uppercase letters, numbers, underscore and hyphen allowed.`\r\n                });\r\n            }\r\n\r\n            if (typeof value !== 'string') {\r\n                return res.status(400).json({\r\n                    success: false,\r\n                    error: `Value for key ${key} must be a string`\r\n                });\r\n            }\r\n\r\n            if (value.length > 500) {\r\n                return res.status(400).json({\r\n                    success: false,\r\n                    error: `Value for key ${key} is too long. Maximum 500 characters allowed.`\r\n                });\r\n            }\r\n\r\n            const dangerousPatterns = [\r\n                /<script/i,\r\n                /javascript:/i,\r\n                /on\\w+\\s*=/i,\r\n                /<iframe/i,\r\n                /<object/i,\r\n                /<embed/i\r\n            ];\r\n\r\n            for (const pattern of dangerousPatterns) {\r\n                if (pattern.test(value)) {\r\n                    logger.warn('Blocked malicious codebook entry', { key, pattern: pattern.source });\r\n                    return res.status(400).json({\r\n                        success: false,\r\n                        error: `Invalid value for key ${key}: potentially malicious content detected`\r\n                    });\r\n                }\r\n            }\r\n        }\r\n\r\n        Object.assign(codebook, entries);\r\n\r\n        logger.info('Codebook updated', { entriesAdded: Object.keys(entries).length });\r\n\r\n        res.json({\r\n            success: true,\r\n            totalEntries: Object.keys(codebook).length,\r\n        });\r\n    } catch (error: any) {\r\n        logger.error('Failed to update codebook', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n/**\r\n * GET /api/devices/:id/events\r\n */\r\nrouter.get('/:id/events', (req: Request, res: Response) => {\r\n    try {\r\n        const { id } = req.params;\r\n        const limitRaw = Number(req.query.limit || 100);\r\n        const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(500, limitRaw)) : 100;\r\n        const events = deviceEvents.get(id) || [];\r\n\r\n        res.json({\r\n            success: true,\r\n            deviceId: id,\r\n            events: events.slice(-limit).reverse()\r\n        });\r\n    } catch (error: any) {\r\n        logger.error('Failed to get device events', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\nrouter.get('/:id/config', (req: Request, res: Response) => {\r\n    try {\r\n        const device = devices.get(req.params.id);\r\n        if (!device) {\r\n            return res.status(404).json({ success: false, error: 'backend.device_not_found' });\r\n        }\r\n\r\n        res.json({\n            success: true,\n            config: ensureDeviceConfig(device),\n            commandHistory: getDeviceCommandHistory(device.deviceId, 10),\n            device: {\n                ...serializeDevice(device),\n                latestConfirmationSession: getLatestConfirmationSessionSafe(device.deviceId)\n            }\n        });\n    } catch (error: any) {\r\n        logger.error('Failed to get device config', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n/**\r\n * GET /api/devices/:id\r\n * Get single device details\r\n */\r\nrouter.get('/:id', (req: Request, res: Response) => {\r\n    try {\r\n        const device = devices.get(req.params.id);\r\n\r\n        if (!device) {\r\n            return res.status(404).json({ success: false, error: 'backend.device_not_found' });\r\n        }\r\n\r\n        try {\r\n                    securityOperationsService.upsertAsset({\r\n                        tenantId: PLATFORM_TENANT_ID,\r\n                assetType: 'device',\r\n                externalRef: device.deviceId,\r\n                displayName: device.deviceId,\r\n                primaryAddress: device.systemInfo?.hostname,\r\n                status: device.isOnline ? 'online' : 'offline',\r\n                metadata: {\r\n                    chipModel: device.chipModel,\r\n                    firmwareVersion: device.version\r\n                }\r\n            });\r\n        } catch {\r\n            // Ignore when operations database is not initialized.\r\n        }\r\n\r\n        res.json({\n            success: true,\n            device: {\n                ...serializeDevice(device),\n                config: ensureDeviceConfig(device),\n                securitySummary: summarizeSecurity(device),\n                latestConfirmationSession: getLatestConfirmationSessionSafe(device.deviceId)\n            },\n        });\n    } catch (error: any) {\r\n        logger.error('Failed to get device', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n/**\r\n * POST /api/devices/:id/cmd\r\n * Send command to device\r\n * SECURITY FIX: Require admin role for command execution\r\n */\r\nrouter.post('/:id/cmd', requireRole('admin'), (req: AuthenticatedRequest, res: Response) => {\r\n    (async () => {\r\n        try {\r\n        const { id } = req.params;\r\n        const { command, params } = req.body;\r\n        const device = devices.get(id);\r\n        if (!device) {\r\n            return res.status(404).json({ success: false, error: 'backend.device_not_found' });\r\n        }\r\n\r\n        const result = await commandDispatcherService.dispatchDeviceCommand({\r\n            deviceId: id,\r\n            commandType: String(command || '').trim(),\r\n            payload: params || {},\r\n            actor: {\r\n                tenantId: resolveActorTenantId(req),\r\n                userId: req.user?.userId || 'unknown',\r\n                email: req.user?.email,\r\n                ip: req.ip\r\n            },\r\n            approved: Boolean(req.body?.approved)\r\n        });\r\n\r\n        if (!result.success && result.status === 'failed') {\r\n            const errorCode =\r\n                result.reason === 'device_offline'\r\n                    ? 'backend.device_is_offline'\r\n                    : result.reason === 'device_not_found' || result.reason === 'device_not_available'\r\n                        ? 'backend.device_not_found'\r\n                        : result.reason === 'command_not_permitted'\r\n                            ? 'backend.device_command_not_permitted'\r\n                            : 'backend.device_command_failed';\r\n            const statusCode =\r\n                result.reason === 'device_not_found' || result.reason === 'device_not_available'\r\n                    ? 404\r\n                    : 400;\r\n\r\n            return res.status(statusCode).json({\r\n                success: false,\r\n                error: errorCode,\r\n                message: result.message,\r\n                status: result.status,\r\n                actionId: result.actionId\r\n            });\r\n        }\r\n\r\n        return res.json({\r\n            success: true,\r\n            message: result.message,\r\n            status: result.status,\r\n            actionId: result.actionId,\r\n            command: result.record || null,\r\n            latestCommand: result.record || null\r\n        });\r\n        } catch (error: any) {\r\n            logger.error('Failed to send command', { error: error.message });\r\n            return res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n        }\r\n    })();\r\n});\r\n\r\n/**\r\n * PUT /api/devices/:id\r\n * Update device configuration\r\n */\r\nrouter.put('/:id', requireRole('admin'), (req: AuthenticatedRequest, res: Response) => {\r\n    try {\r\n        const { id } = req.params;\r\n        const device = devices.get(id);\r\n\r\n        if (!device) {\r\n            return res.status(404).json({ success: false, error: 'backend.device_not_found' });\r\n        }\r\n\r\n        if (req.body.connectedAgents) {\r\n            device.connectedAgents = req.body.connectedAgents;\r\n        }\r\n\r\n        const currentConfig = ensureDeviceConfig(device);\r\n        const nextConfig: DeviceConfig = {\r\n            ...currentConfig,\r\n            displayName: typeof req.body.displayName === 'string' ? req.body.displayName.trim() || currentConfig.displayName : currentConfig.displayName,\r\n            group: typeof req.body.group === 'string' ? req.body.group.trim() || currentConfig.group : currentConfig.group,\n            site: typeof req.body.site === 'string' ? req.body.site.trim() || currentConfig.site : currentConfig.site,\n            networkProfile: typeof req.body.networkProfile === 'string' ? req.body.networkProfile.trim() || currentConfig.networkProfile : currentConfig.networkProfile,\n            scanProfile: typeof req.body.scanProfile === 'string' ? req.body.scanProfile.trim() || currentConfig.scanProfile : currentConfig.scanProfile,\n            notes: typeof req.body.notes === 'string' ? req.body.notes.trim() : currentConfig.notes,\n            commandPermissions: normalizeCommandPermissions(req.body.commandPermissions, currentConfig.commandPermissions),\n            tags: Array.isArray(req.body.tags) ? req.body.tags.filter(Boolean) : currentConfig.tags,\n            updatedAt: new Date().toISOString()\n        };\n        deviceConfigs.set(id, nextConfig);\r\n        addDeviceEvent(id, 'command', {\r\n            action: 'sync-config',\r\n            status: 'completed',\r\n            message: 'Device configuration updated',\r\n            updatedBy: req.user?.email || req.user?.userId || 'unknown',\r\n            config: nextConfig\r\n        });\r\n\r\n        devices.set(id, device);\r\n        try {\r\n            const asset = ensureDeviceAsset(device);\r\n            syncDeviceSignals(device, asset.assetId);\r\n        } catch {\r\n            // Ignore when operations database is unavailable.\r\n        }\r\n        recordDeviceAction(device, {\r\n            title: 'Device configuration updated',\r\n            status: 'completed',\r\n            operator: req.user?.email || req.user?.userId || 'unknown',\r\n            rollbackNotes: 'Restore the previous configuration if the device stops reporting after the change.',\r\n            runLog: [\r\n                {\r\n                    at: nextConfig.updatedAt,\r\n                    actor: req.user?.email || req.user?.userId || 'unknown',\r\n                    message: 'Applied device configuration update.',\r\n                    config: {\r\n                        displayName: nextConfig.displayName,\r\n                        group: nextConfig.group,\r\n                        site: nextConfig.site,\r\n                        networkProfile: nextConfig.networkProfile,\r\n                        scanProfile: nextConfig.scanProfile\r\n                    }\r\n                }\r\n            ]\r\n        });\r\n\r\n        logger.info('Device updated', { deviceId: id });\r\n        safeAuditLog({\r\n            tenantId: resolveActorTenantId(req),\r\n            eventType: 'device_config_updated',\r\n            category: 'system',\r\n            severity: 'warning',\r\n            actor: { type: 'user', id: req.user?.userId || 'unknown', email: req.user?.email, ip: req.ip },\r\n            target: { type: 'server', id },\r\n            action: 'update_device_config',\r\n            details: {\r\n                deviceId: id,\r\n                displayName: nextConfig.displayName,\r\n                group: nextConfig.group,\r\n                site: nextConfig.site,\r\n                scanProfile: nextConfig.scanProfile\r\n            },\r\n            status: 'success'\r\n        });\r\n\r\n        res.json({\r\n            success: true,\r\n            device: {\n                ...serializeDevice(device),\n                config: nextConfig\n            },\n            config: nextConfig,\r\n            commandHistory: getDeviceCommandHistory(id, 10)\r\n        });\r\n    } catch (error: any) {\r\n        logger.error('Failed to update device', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n/**\r\n * DELETE /api/devices/:id\r\n * Unregister device\r\n * SECURITY FIX: Require admin role for device deletion\r\n */\r\nrouter.delete('/:id', requireRole('admin'), (req: AuthenticatedRequest, res: Response) => {\r\n    try {\r\n        const { id } = req.params;\r\n\r\n        if (!devices.has(id)) {\r\n            return res.status(404).json({ success: false, error: 'backend.device_not_found' });\r\n        }\r\n\r\n        devices.delete(id);\r\n\r\n        logger.info('Device unregistered', { deviceId: id });\r\n        safeAuditLog({\r\n            tenantId: resolveActorTenantId(req),\r\n            eventType: 'device_deleted',\r\n            category: 'system',\r\n            severity: 'critical',\r\n            actor: { type: 'user', id: req.user?.userId || 'unknown', email: req.user?.email, ip: req.ip },\r\n            target: { type: 'server', id },\r\n            action: 'delete_device',\r\n            details: { deviceId: id },\r\n            status: 'success'\r\n        });\r\n\r\n        res.json({\r\n            success: true,\r\n            message: `Device ${id} unregistered`,\r\n        });\r\n    } catch (error: any) {\r\n        logger.error('Failed to delete device', { error: error.message });\r\n        res.status(500).json({ success: false, error: 'backend.internal_server_error' });\r\n    }\r\n});\r\n\r\n// Export device management functions for WebSocket Gateway\r\nexport function registerDevice(info: Omit<DeviceInfo, 'isOnline' | 'lastHeartbeat' | 'connectedAgents'>): void {\n    const device: DeviceInfo = {\n        ...info,\n        isOnline: true,\n        lastHeartbeat: new Date(),\n        connectedAgents: [],\n        transport: info.transport || 'unknown',\n        interlockState: info.interlockState || 'unknown',\n        hostActionState: info.hostActionState || 'idle',\n        pendingPhysicalApproval: info.pendingPhysicalApproval || false\n    };\n    devices.set(info.deviceId, device);\n    ensureDeviceConfig(device);\n    try {\r\n        const asset = ensureDeviceAsset(device);\r\n        syncDeviceSignals(device, asset.assetId);\r\n    } catch {\r\n        //