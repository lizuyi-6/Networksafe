ssage":"Unexpected any. Specify a different type.","line":256,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":256,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9015,9018],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9015,9018],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":258,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":258,"endColumn":71},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":258,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":258,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9095,9098],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9095,9098],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .preliminaryRootCause on an `any` value.","line":258,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":258,"endColumn":71},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":259,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":259,"endColumn":55},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":259,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":259,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9157,9160],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9157,9160],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .solutions on an `any` value.","line":259,"column":40,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":259,"endColumn":49},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of type `any[]` to a variable of type `Finding[]`.","line":264,"column":7,"nodeType":"Property","messageId":"unsafeAssignment","endLine":264,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":265,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":265,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":266,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":266,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of type `any[]` to a variable of type `Evidence[]`.","line":268,"column":7,"nodeType":"Property","messageId":"unsafeAssignment","endLine":268,"endColumn":46},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":277,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":277,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9660,9663],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9660,9663],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .severity on an `any` value.","line":287,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":287,"endColumn":61},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":296,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":296,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10313,10316],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10313,10316],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":297,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":297,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10342,10345],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10342,10345],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":327,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":327,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11049,11052],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11049,11052],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .investigationId on an `any` value.","line":334,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":334,"endColumn":43},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":365,"column":34,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":365,"endColumn":37,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12131,12134],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12131,12134],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":368,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":368,"endColumn":52},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":368,"column":21,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":368,"endColumn":42},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .getCapabilities on an `any` value.","line":368,"column":27,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":368,"endColumn":42}],"suppressedMessages":[],"errorCount":52,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Investigation Coordinator\r\n *\r\n * Orchestrates the bug investigation process by coordinating multiple specialized agents.\r\n * Implements the investigation workflow and manages agent communication.\r\n */\r\n\r\nimport { EventEmitter } from 'events';\r\nimport { v4 as uuidv4 } from 'uuid';\r\nimport {\r\n  BugReport,\r\n  InvestigationContext,\r\n  InvestigationResult,\r\n  AgentTask,\r\n  InvestigationAgentType,\r\n  InvestigationSummary\r\n} from './types';\r\nimport { AgentConfig, MessageBus } from '../core';\r\nimport { BugReproductionAgent } from './agents/bug-reproduction.agent';\r\nimport { CodeAnalysisAgent } from './agents/code-analysis.agent';\r\nimport { LogAnalysisAgent } from './agents/log-analysis.agent';\r\nimport { TraceAnalysisAgent } from './agents/trace-analysis.agent';\r\nimport { RootCauseAgent } from './agents/root-cause.agent';\r\nimport { SolutionAgent } from './agents/solution.agent';\r\n\r\nexport class InvestigationCoordinator extends EventEmitter {\r\n  private agents: Map<string, any>;\r\n  private activeInvestigations: Map<string, InvestigationContext>;\r\n  private taskQueue: AgentTask[];\r\n  private completedTasks: Map<string, AgentTask>;\r\n  private messageBus: MessageBus;\r\n\r\n  constructor(messageBus?: MessageBus) {\r\n    super();\r\n    this.agents = new Map();\r\n    this.activeInvestigations = new Map();\r\n    this.taskQueue = [];\r\n    this.completedTasks = new Map();\r\n    this.messageBus = messageBus || new MessageBus();\r\n    this.initializeAgents();\r\n  }\r\n\r\n  private initializeAgents(): void {\r\n    // Create base agent config for investigation agents\r\n    const baseConfig: AgentConfig = {\r\n      identity: {\r\n        id: 'investigation-coordinator',\r\n        role: 'orchestrator',\r\n        team: 'analyst',\r\n        name: 'Investigation Coordinator',\r\n        description: 'Coordinates bug investigation across multiple specialized agents',\r\n        capabilities: ['coordination', 'task_distribution', 'result_aggregation']\r\n      },\r\n      modelConfig: {\r\n        provider: 'ollama',\r\n        model: 'llama3:8b',\r\n        temperature: 0.3,\r\n        maxTokens: 2000\r\n      },\r\n      timeout: 30000,\r\n      maxRetries: 2\r\n    };\r\n\r\n    // Initialize specialized investigation agents\r\n    this.agents.set(InvestigationAgentType.BUG_REPRODUCTION, new BugReproductionAgent(baseConfig, this.messageBus));\r\n    this.agents.set(InvestigationAgentType.CODE_ANALYSIS, new CodeAnalysisAgent(baseConfig, this.messageBus));\r\n    this.agents.set(InvestigationAgentType.LOG_ANALYSIS, new LogAnalysisAgent(baseConfig, this.messageBus));\r\n    this.agents.set(InvestigationAgentType.TRACE_ANALYSIS, new TraceAnalysisAgent(baseConfig, this.messageBus));\r\n    this.agents.set(InvestigationAgentType.ROOT_CAUSE, new RootCauseAgent(baseConfig, this.messageBus));\r\n    this.agents.set(InvestigationAgentType.SOLUTION, new SolutionAgent(baseConfig, this.messageBus));\r\n\r\n    console.log('[InvestigationCoordinator] All investigation agents initialized');\r\n  }\r\n\r\n  /**\r\n   * Start a new bug investigation\r\n   */\r\n  public async startInvestigation(bugReport: BugReport, context: InvestigationContext): Promise<string> {\r\n    const investigationId = uuidv4();\r\n    context.bugReport = bugReport;\r\n\r\n    this.activeInvestigations.set(investigationId, context);\r\n\r\n    console.log(`[InvestigationCoordinator] Starting investigation ${investigationId} for bug ${bugReport.id}`);\r\n    this.emit('investigation:started', { investigationId, bugReport });\r\n\r\n    // Execute investigation workflow\r\n    try {\r\n      const result = await this.executeInvestigationWorkflow(investigationId, context);\r\n      this.emit('investigation:completed', { investigationId, result });\r\n      return investigationId;\r\n    } catch (error) {\r\n      console.error(`[InvestigationCoordinator] Investigation ${investigationId} failed:`, error);\r\n      this.emit('investigation:failed', { investigationId, error });\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Execute the investigation workflow\r\n   */\r\n  private async executeInvestigationWorkflow(\r\n    investigationId: string,\r\n    context: InvestigationContext\r\n  ): Promise<InvestigationResult> {\r\n    const workflow: InvestigationAgentType[] = [\r\n      InvestigationAgentType.LOG_ANALYSIS,\r\n      InvestigationAgentType.TRACE_ANALYSIS,\r\n      InvestigationAgentType.BUG_REPRODUCTION,\r\n      InvestigationAgentType.CODE_ANALYSIS,\r\n      InvestigationAgentType.ROOT_CAUSE,\r\n      InvestigationAgentType.SOLUTION\r\n    ];\r\n\r\n    const investigators: string[] = [];\r\n    const allFindings: any[] = [];\r\n\r\n    // Execute workflow stages\r\n    for (const agentType of workflow) {\r\n      const agent = this.agents.get(agentType);\r\n      if (!agent) {\r\n        console.warn(`[InvestigationCoordinator] Agent ${agentType} not found, skipping`);\r\n        continue;\r\n      }\r\n\r\n      console.log(`[InvestigationCoordinator] Executing stage: ${agentType}`);\r\n      this.emit('stage:started', { investigationId, stage: agentType });\r\n\r\n      try {\r\n        const task = await this.createTask(investigationId, agentType, context);\r\n        const result = await this.executeTask(task);\r\n\r\n        if (result.output) {\r\n          // Accumulate findings from each stage\r\n          if (result.output.findings) {\r\n            allFindings.push(...result.output.findings);\r\n          }\r\n          // Update context with results\r\n          this.updateContext(context, agentType, result.output);\r\n        }\r\n\r\n        investigators.push(agentType);\r\n        this.emit('stage:completed', { investigationId, stage: agentType, result });\r\n      } catch (error) {\r\n        console.error(`[InvestigationCoordinator] Stage ${agentType} failed:`, error);\r\n        this.emit('stage:failed', { investigationId, stage: agentType, error });\r\n        // Continue workflow even if one stage fails\r\n      }\r\n    }\r\n\r\n    // Compile final investigation result\r\n    return this.compileInvestigationResult(investigationId, context, investigators, allFindings);\r\n  }\r\n\r\n  /**\r\n   * Create a task for an agent\r\n   */\r\n  private async createTask(\r\n    investigationId: string,\r\n    agentType: InvestigationAgentType,\r\n    context: InvestigationContext\r\n  ): Promise<AgentTask> {\r\n    const task: AgentTask = {\r\n      taskId: uuidv4(),\r\n      assignedTo: agentType,\r\n      taskType: agentType,\r\n      description: `${agentType} investigation for bug ${context.bugReport.id}`,\r\n      status: 'pending',\r\n      priority: context.bugReport.severity,\r\n      input: {\r\n        investigationId,\r\n        context\r\n      }\r\n    };\r\n\r\n    this.taskQueue.push(task);\r\n    return task;\r\n  }\r\n\r\n  /**\r\n   * Execute a task on an agent\r\n   */\r\n  private async executeTask(task: AgentTask): Promise<AgentTask> {\r\n    task.status = 'in_progress';\r\n    task.startedAt = new Date();\r\n\r\n    const agent = this.agents.get(task.assignedTo);\r\n    if (!agent) {\r\n      throw new Error(`Agent ${task.assignedTo} not found`);\r\n    }\r\n\r\n    try {\r\n      const result = await agent.analyze(task.input.context);\r\n      task.output = result;\r\n      task.status = 'completed';\r\n      task.completedAt = new Date();\r\n      task.duration = task.completedAt.getTime() - task.startedAt.getTime();\r\n\r\n      this.completedTasks.set(task.taskId, task);\r\n      return task;\r\n    } catch (error) {\r\n      task.status = 'failed';\r\n      task.error = error instanceof Error ? error.message : String(error);\r\n      task.completedAt = new Date();\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Update investigation context with agent results\r\n   */\r\n  private updateContext(\r\n    context: InvestigationContext,\r\n    agentType: InvestigationAgentType,\r\n    output: any\r\n  ): void {\r\n    // Each agent type may update different parts of the context\r\n    switch (agentType) {\r\n      case InvestigationAgentType.LOG_ANALYSIS:\r\n        context.systemState.logs = output.analyzedLogs || context.systemState.logs;\r\n        break;\r\n      case InvestigationAgentType.TRACE_ANALYSIS:\r\n        context.systemState.traces = output.analyzedTraces || context.systemState.traces;\r\n        break;\r\n      case InvestigationAgentType.BUG_REPRODUCTION:\r\n        // Add reproduction information\r\n        if (output.reproductionInfo) {\r\n          (context as any).reproductionInfo = output.reproductionInfo;\r\n        }\r\n        break;\r\n      case InvestigationAgentType.CODE_ANALYSIS:\r\n        // Add code analysis results\r\n        if (output.codeIssues) {\r\n          (context as any).codeIssues = output.codeIssues;\r\n        }\r\n        break;\r\n      case InvestigationAgentType.ROOT_CAUSE:\r\n        // Root cause will be in the final result\r\n        if (output.rootCause) {\r\n          (context as any).preliminaryRootCause = output.rootCause;\r\n        }\r\n        break;\r\n      case InvestigationAgentType.SOLUTION:\r\n        // Solutions will be in the final result\r\n        break;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Compile final investigation result\r\n   */\r\n  private compileInvestigationResult(\r\n    investigationId: string,\r\n    context: InvestigationContext,\r\n    investigators: string[],\r\n    allFindings: any[]\r\n  ): InvestigationResult {\r\n    const preliminaryRootCause = (context as any).preliminaryRootCause;\r\n    const solutions = (context as any).solutions || [];\r\n\r\n    return {\r\n      investigationId,\r\n      bugReportId: context.bugReport.id,\r\n      findings: allFindings,\r\n      rootCause: preliminaryRootCause,\r\n      recommendedSolutions: solutions,\r\n      confidence: this.calculateConfidence(allFindings, investigators),\r\n      evidence: this.collectEvidence(context),\r\n      timestamp: new Date(),\r\n      investigators\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Calculate investigation confidence score\r\n   */\r\n  private calculateConfidence(findings: any[], investigators: string[]): number {\r\n    let confidence = 0.5; // Base confidence\r\n\r\n    // More investigators = higher confidence\r\n    confidence += Math.min(investigators.length * 0.05, 0.2);\r\n\r\n    // More findings = higher confidence\r\n    confidence += Math.min(findings.length * 0.03, 0.15);\r\n\r\n    // Critical findings increase confidence\r\n    const criticalFindings = findings.filter(f => f.severity === 'critical').length;\r\n    confidence += Math.min(criticalFindings * 0.05, 0.1);\r\n\r\n    return Math.min(confidence, 1.0);\r\n  }\r\n\r\n  /**\r\n   * Collect evidence from context\r\n   */\r\n  private collectEvidence(context: InvestigationContext): any[] {\r\n    const evidence: any[] = [];\r\n\r\n    // Add log evidence\r\n    context.systemState.logs.forEach(log => {\r\n      evidence.push({\r\n        type: 'log',\r\n        description: `Log from ${log.service}`,\r\n        source: log.service,\r\n        timestamp: log.timestamp,\r\n        data: log\r\n      });\r\n    });\r\n\r\n    // Add trace evidence\r\n    context.systemState.traces.forEach(trace => {\r\n      evidence.push({\r\n        type: 'trace',\r\n        description: `Trace: ${trace.operation}`,\r\n        source: trace.service,\r\n        timestamp: trace.timestamp,\r\n        data: trace\r\n      });\r\n    });\r\n\r\n    return evidence;\r\n  }\r\n\r\n  /**\r\n   * Get investigation status\r\n   */\r\n  public getInvestigationStatus(investigationId: string): any {\r\n    const context = this.activeInvestigations.get(investigationId);\r\n    if (!context) {\r\n      return { status: 'not_found' };\r\n    }\r\n\r\n    const tasks = Array.from(this.completedTasks.values())\r\n      .filter(t => t.input.investigationId === investigationId);\r\n\r\n    return {\r\n      investigationId,\r\n      bugReport: context.bugReport,\r\n      tasksCompleted: tasks.length,\r\n      tasksTotal: this.agents.size,\r\n      status: tasks.length === this.agents.size ? 'completed' : 'in_progress',\r\n      tasks: tasks.map(t => ({\r\n        type: t.assignedTo,\r\n        status: t.status,\r\n        duration: t.duration\r\n      }))\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Get active investigations\r\n   */\r\n  public getActiveInvestigations(): InvestigationSummary[] {\r\n    return Array.from(this.activeInvestigations.entries()).map(([id, context]) => ({\r\n      investigationId: id,\r\n      date: context.bugReport.timestamp,\r\n      outcome: 'investigating',\r\n      summary: context.bugReport.description\r\n    }));\r\n  }\r\n\r\n  /**\r\n   * Get agent capabilities\r\n   */\r\n  public getAgentCapabilities(): any[] {\r\n    return Array.from(this.agents.entries()).map(([type, agent]) => ({\r\n      agentType: type,\r\n      capabilities: agent.getCapabilities?.() || [],\r\n      status: 'active'\r\n    }));\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\examples.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":337,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":337,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .status on an `any` value.","line":339,"column":16,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":339,"endColumn":22},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .status on an `any` value.","line":342,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":342,"endColumn":29},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tasksCompleted on an `any` value.","line":343,"column":39,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":343,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tasksTotal on an `any` value.","line":343,"column":67,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":343,"endColumn":77},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .status on an `any` value.","line":344,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":344,"endColumn":29},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":407,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":407,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":435,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":442,"endColumn":5},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":435,"column":26,"nodeType":"Identifier","messageId":"unsafeCall","endLine":435,"endColumn":31},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":444,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":444,"endColumn":39},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":444,"column":24,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":444,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .json on an `any` value.","line":444,"column":33,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":444,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .data on an `any` value.","line":445,"column":48,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":445,"endColumn":52},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":447,"column":3,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":447,"endColumn":17}],"suppressedMessages":[],"errorCount":14,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Bug Investigation Agent Team - Usage Examples\r\n *\r\n * Practical examples of using the bug investigation agent team.\r\n */\r\n\r\nimport { BugInvestigationTeam } from './index';\r\nimport { BugReport, InvestigationContext, InvestigationResult } from './types';\r\n\r\n// ============================================\r\n// Example 1: Basic Bug Investigation\r\n// ============================================\r\n\r\nasync function basicInvestigationExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  // Create bug report\r\n  const bugReport = BugInvestigationTeam.createBugReport({\r\n    title: 'Payment service timeout',\r\n    description: 'Payment service times out after 30 seconds when processing bulk payments',\r\n    severity: 'high',\r\n    category: 'performance',\r\n    reproductionSteps: [\r\n      'Create bulk payment with 100+ items',\r\n      'Submit payment request',\r\n      'Request times out after 30 seconds'\r\n    ],\r\n    environment: {\r\n      os: 'Ubuntu 22.04',\r\n      runtime: 'Node.js v18.17.0',\r\n      version: '2.1.0'\r\n    },\r\n    reporter: 'john.doe@example.com'\r\n  });\r\n\r\n  // Create investigation context\r\n  const context = BugInvestigationTeam.createContext({\r\n    bugReport,\r\n    logs: [\r\n      {\r\n        timestamp: new Date('2024-01-15T10:30:00Z'),\r\n        level: 'error',\r\n        service: 'payment-service',\r\n        message: 'backend.request_timeout_operation_timed_out_after_30000ms',\r\n        metadata: {\r\n          requestId: 'req-123',\r\n          userId: 'user-456'\r\n        },\r\n        traceId: 'trace-abc-123'\r\n      },\r\n      {\r\n        timestamp: new Date('2024-01-15T10:30:05Z'),\r\n        level: 'warn',\r\n        service: 'payment-service',\r\n        message: 'backend.database_query_took_25000ms',\r\n        metadata: {\r\n          query: 'SELECT * FROM payments WHERE status = \"pending\"',\r\n          duration: 25000\r\n        }\r\n      }\r\n    ],\r\n    traces: [\r\n      {\r\n        traceId: 'trace-abc-123',\r\n        spanId: 'span-1',\r\n        timestamp: new Date('2024-01-15T10:30:00Z'),\r\n        duration: 30000,\r\n        service: 'payment-service',\r\n        operation: 'processBulkPayment',\r\n        tags: {\r\n          'payment.count': '100',\r\n          'user.id': 'user-456'\r\n        },\r\n        status: 'error',\r\n        error: {\r\n          message: 'backend.operation_timed_out'\r\n        }\r\n      }\r\n    ],\r\n    metrics: {\r\n      cpu: {\r\n        usage: 85,\r\n        loadAverage: [2.5, 2.3, 2.1]\r\n      },\r\n      memory: {\r\n        used: 2048,\r\n        total: 4096,\r\n        percentage: 50\r\n      },\r\n      network: {\r\n        inbound: 1024000,\r\n        outbound: 512000,\r\n        connections: 50\r\n      }\r\n    }\r\n  });\r\n\r\n  // Start investigation\r\n  console.log('Starting investigation...');\r\n  const result = await team.investigate(bugReport, context);\r\n\r\n  console.log('Investigation completed:', result.investigationId);\r\n  console.log('Findings:', result.findings.length);\r\n  console.log('Root cause:', result.rootCause?.description);\r\n  console.log('Solutions:', result.recommendedSolutions.length);\r\n  console.log('Confidence:', result.confidence);\r\n\r\n  return result;\r\n}\r\n\r\n// ============================================\r\n// Example 2: Security Bug Investigation\r\n// ============================================\r\n\r\nasync function securityInvestigationExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  const bugReport = BugInvestigationTeam.createBugReport({\r\n    title: 'SQL injection vulnerability in user search',\r\n    description: 'User search endpoint vulnerable to SQL injection attacks',\r\n    severity: 'critical',\r\n    category: 'security',\r\n    reproductionSteps: [\r\n      'Navigate to user search endpoint',\r\n      'Enter search query: \\' OR \"1\"=\"1',\r\n      'System returns all users instead of filtered results'\r\n    ],\r\n    environment: {\r\n      os: 'Ubuntu 22.04',\r\n      runtime: 'Node.js v18.17.0',\r\n      version: '2.1.0'\r\n    },\r\n    reporter: 'security-team@example.com'\r\n  });\r\n\r\n  const context = BugInvestigationTeam.createContext({\r\n    bugReport,\r\n    logs: [\r\n      {\r\n        timestamp: new Date(),\r\n        level: 'error',\r\n        service: 'api-gateway',\r\n        message: 'backend.potential_sql_injection_detected',\r\n        metadata: {\r\n          query: 'SELECT * FROM users WHERE name = \\'\\' OR \"1\"=\"1\\'',\r\n          ip: '192.168.1.100'\r\n        }\r\n      }\r\n    ],\r\n    codeContext: {\r\n      filePath: 'src/api/users.controller.ts',\r\n      lineNumber: 42,\r\n      function: 'searchUsers',\r\n      codeSnippet: `\r\n        const query = \\`SELECT * FROM users WHERE name = '\\${req.params.query}'\\`;\r\n        const results = await database.execute(query);\r\n      `\r\n    }\r\n  });\r\n\r\n  const result = await team.investigate(bugReport, context);\r\n\r\n  console.log('Security investigation results:');\r\n  console.log('- Severity:', result.rootCause?.category);\r\n  console.log('- Affected file:', result.rootCause?.location.file);\r\n  console.log('- Solutions:', result.recommendedSolutions);\r\n\r\n  return result;\r\n}\r\n\r\n// ============================================\r\n// Example 3: Memory Leak Investigation\r\n// ============================================\r\n\r\nasync function memoryLeakInvestigationExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  const bugReport = BugInvestigationTeam.createBugReport({\r\n    title: 'Memory leak in WebSocket connection handler',\r\n    description: 'Memory usage increases over time as WebSocket connections are established and closed',\r\n    severity: 'high',\r\n    category: 'memory',\r\n    reproductionSteps: [\r\n      'Establish WebSocket connection',\r\n      'Send and receive messages',\r\n      'Close connection',\r\n      'Monitor memory - not released'\r\n    ],\r\n    environment: {\r\n      os: 'Alpine Linux',\r\n      runtime: 'Node.js v20.5.0',\r\n      version: '3.0.0'\r\n    },\r\n    reporter: 'monitoring-system'\r\n  });\r\n\r\n  const context = BugInvestigationTeam.createContext({\r\n    bugReport,\r\n    logs: [\r\n      {\r\n        timestamp: new Date(),\r\n        level: 'error',\r\n        service: 'websocket-gateway',\r\n        message: 'backend.outofmemoryerror_javascript_heap_out_of_memory',\r\n        metadata: {\r\n          heapUsed: '4096MB',\r\n          heapTotal: '4096MB',\r\n          connections: 10000\r\n        }\r\n      }\r\n    ],\r\n    metrics: {\r\n      cpu: {\r\n        usage: 60,\r\n        loadAverage: [1.5, 1.4, 1.3]\r\n      },\r\n      memory: {\r\n        used: 4096,\r\n        total: 4096,\r\n        percentage: 100\r\n      },\r\n      customMetrics: {\r\n        activeConnections: 10000,\r\n        memoryPerConnection: 0.41\r\n      }\r\n    }\r\n  });\r\n\r\n  const result = await team.investigate(bugReport, context);\r\n\r\n  console.log('Memory leak investigation:');\r\n  console.log('- Root cause:', result.rootCause?.description);\r\n  console.log('- Contributing factors:', result.rootCause?.contributingFactors);\r\n  console.log('- Recommended solutions:');\r\n  result.recommendedSolutions.forEach((solution, index) => {\r\n    console.log(`  ${index + 1}. [${solution.priority}] ${solution.description}`);\r\n    console.log(`     Risk: ${solution.risk}, Effort: ${solution.estimatedEffort}`);\r\n  });\r\n\r\n  return result;\r\n}\r\n\r\n// ============================================\r\n// Example 4: Crash Investigation\r\n// ============================================\r\n\r\nasync function crashInvestigationExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  const bugReport = BugInvestigationTeam.createBugReport({\r\n    title: 'Application crashes when processing invalid JSON',\r\n    description: 'Application crashes with unhandled exception when receiving malformed JSON',\r\n    severity: 'critical',\r\n    category: 'crash',\r\n    reproductionSteps: [\r\n      'Send POST request with invalid JSON',\r\n      'Application crashes immediately'\r\n    ],\r\n    environment: {\r\n      os: 'Debian 11',\r\n      runtime: 'Node.js v18.17.0',\r\n      version: '2.1.0'\r\n    },\r\n    reporter: 'api-monitor'\r\n  });\r\n\r\n  const context = BugInvestigationTeam.createContext({\r\n    bugReport,\r\n    logs: [\r\n      {\r\n        timestamp: new Date(),\r\n        level: 'fatal',\r\n        service: 'api-server',\r\n        message: 'backend.unhandledpromiserejection_syntaxerror_unexpected_token',\r\n        metadata: {\r\n          stackTrace: 'at JSON.parse (<anonymous>)\\n' +\r\n                     'at parseBody (/app/src/middleware/body-parser.ts:42:15)',\r\n          requestBody: '{\"name\": \"test\", \"data\": }}'\r\n        }\r\n      }\r\n    ],\r\n    codeContext: {\r\n      filePath: 'src/middleware/body-parser.ts',\r\n      lineNumber: 42,\r\n      function: 'parseBody',\r\n      codeSnippet: 'const parsed = JSON.parse(req.body);'\r\n    }\r\n  });\r\n\r\n  const result = await team.investigate(bugReport, context);\r\n\r\n  console.log('Crash investigation:');\r\n  console.log('- Root cause:', result.rootCause?.description);\r\n  console.log('- Location:', result.rootCause?.location);\r\n  console.log('- Fix:', result.recommendedSolutions[0]?.implementation);\r\n\r\n  return result;\r\n}\r\n\r\n// ============================================\r\n// Example 5: Monitoring Investigation Status\r\n// ============================================\r\n\r\nasync function monitoringExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  // Start an investigation\r\n  const bugReport = BugInvestigationTeam.createBugReport({\r\n    title: 'Test bug for monitoring',\r\n    description: 'Testing investigation monitoring',\r\n    severity: 'medium',\r\n    category: 'functional'\r\n  });\r\n\r\n  const context = BugInvestigationTeam.createContext({\r\n    bugReport,\r\n    logs: [],\r\n    traces: []\r\n  });\r\n\r\n  // Investigation runs asynchronously\r\n  team.investigate(bugReport, context)\r\n    .then(result => {\r\n      console.log('Investigation completed!');\r\n      console.log('ID:', result.investigationId);\r\n      console.log('Confidence:', result.confidence);\r\n    })\r\n    .catch(error => {\r\n      console.error('Investigation failed:', error);\r\n    });\r\n\r\n  // Monitor status\r\n  const investigationId = 'pending-investigation-id'; // Would get from initial response\r\n  console.log('Monitoring investigation...');\r\n\r\n  const interval = setInterval(() => {\r\n    const status = team.getInvestigationStatus(investigationId);\r\n\r\n    if (status.status === 'completed') {\r\n      clearInterval(interval);\r\n      console.log('Investigation completed!');\r\n    } else if (status.status === 'in_progress') {\r\n      console.log('Progress:', status.tasksCompleted, '/', status.tasksTotal);\r\n    } else if (status.status === 'failed') {\r\n      clearInterval(interval);\r\n      console.log('Investigation failed');\r\n    }\r\n  }, 5000);\r\n}\r\n\r\n// ============================================\r\n// Example 6: Batch Investigation\r\n// ============================================\r\n\r\nasync function batchInvestigationExample() {\r\n  const team = BugInvestigationTeam.getInstance();\r\n\r\n  const bugReports = [\r\n    BugInvestigationTeam.createBugReport({\r\n      title: 'Bug 1',\r\n      description: 'First bug',\r\n      severity: 'medium',\r\n      category: 'functional'\r\n    }),\r\n    BugInvestigationTeam.createBugReport({\r\n      title: 'Bug 2',\r\n      description: 'Second bug',\r\n      severity: 'high',\r\n      category: 'performance'\r\n    }),\r\n    BugInvestigationTeam.createBugReport({\r\n      title: 'Bug 3',\r\n      description: 'Third bug',\r\n      severity: 'low',\r\n      category: 'functional'\r\n    })\r\n  ];\r\n\r\n  // Investigate in parallel (with concurrency limit)\r\n  const maxConcurrent = 3;\r\n  const results: InvestigationResult[] = [];\r\n\r\n  for (let i = 0; i < bugReports.length; i += maxConcurrent) {\r\n    const batch = bugReports.slice(i, i + maxConcurrent);\r\n    const batchResults = await Promise.all(\r\n      batch.map(bugReport => {\r\n        const context = BugInvestigationTeam.createContext({\r\n          bugReport,\r\n          logs: [],\r\n          traces: []\r\n        });\r\n        return team.investigate(bugReport, context);\r\n      })\r\n    );\r\n    results.push(...batchResults);\r\n  }\r\n\r\n  console.log(`Completed ${results.length} investigations`);\r\n  return results;\r\n}\r\n\r\n// ============================================\r\n// Example 7: Using with Express API\r\n// ============================================\r\n\r\nasync function apiIntegrationExample() {\r\n  const fetch = require('node-fetch');\r\n\r\n  const investigationData = {\r\n    title: 'API timeout error',\r\n    description: 'API endpoint /api/users times out intermittently',\r\n    severity: 'high',\r\n    category: 'performance',\r\n    reproductionSteps: [\r\n      'Call GET /api/users',\r\n      'Wait 30+ seconds',\r\n      'Receive timeout error'\r\n    ],\r\n    environment: {\r\n      os: 'Ubuntu',\r\n      runtime: 'Node.js v18',\r\n      version: '1.0.0'\r\n    },\r\n    logs: [\r\n      {\r\n        timestamp: new Date().toISOString(),\r\n        level: 'error',\r\n        service: 'api-server',\r\n        message: 'backend.request_timeout',\r\n        traceId: 'trace-123'\r\n      }\r\n    ]\r\n  };\r\n\r\n  const response = await fetch('http://localhost:3000/api/investigation/start', {\r\n    method: 'POST',\r\n    headers: {\r\n      'Content-Type': 'application/json',\r\n      'Authorization': 'Bearer your-agent-token'\r\n    },\r\n    body: JSON.stringify(investigationData)\r\n  });\r\n\r\n  const result = await response.json();\r\n  console.log('Investigation started:', result.data.investigationId);\r\n\r\n  return result;\r\n}\r\n\r\n// ============================================\r\n// Run Examples\r\n// ============================================\r\n\r\nasync function main() {\r\n  console.log('=== Bug Investigation Agent Team Examples ===\\n');\r\n\r\n  try {\r\n    console.log('Example 1: Basic Investigation');\r\n    await basicInvestigationExample();\r\n    console.log('\\n');\r\n\r\n    // Uncomment to run other examples\r\n    // console.log('Example 2: Security Investigation');\r\n    // await securityInvestigationExample();\r\n    // console.log('\\n');\r\n\r\n    // console.log('Example 3: Memory Leak Investigation');\r\n    // await memoryLeakInvestigationExample();\r\n    // console.log('\\n');\r\n\r\n    // console.log('Example 4: Crash Investigation');\r\n    // await crashInvestigationExample();\r\n    // console.log('\\n');\r\n\r\n  } catch (error) {\r\n    console.error('Example failed:', error);\r\n  }\r\n}\r\n\r\n// Run if executed directly\r\nif (require.main === module) {\r\n  main();\r\n}\r\n\r\nexport {\r\n  basicInvestigationExample,\r\n  securityInvestigationExample,\r\n  memoryLeakInvestigationExample,\r\n  crashInvestigationExample,\r\n  monitoringExample,\r\n  batchInvestigationExample,\r\n  apiIntegrationExample\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .investigationId on an `any` value.","line":47,"column":18,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":47,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .result on an `any` value.","line":49,"column":24,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":49,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .investigationId on an `any` value.","line":54,"column":18,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":54,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .error on an `any` value.","line":56,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":56,"endColumn":28},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":65,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":65,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1934,1937],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1934,1937],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":72,"colu