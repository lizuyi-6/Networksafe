eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":377,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":377,"endColumn":35},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":379,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":386,"endColumn":6},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":379,"column":28,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":379,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .post on an `any` value.","line":379,"column":34,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":379,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":388,"column":5,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":388,"endColumn":35},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .data on an `any` value.","line":388,"column":21,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":388,"endColumn":25},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":401,"column":9,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":401,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":405,"column":7,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":405,"endColumn":35},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":464,"column":159,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":464,"endColumn":202},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":464,"column":210,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":464,"endColumn":330},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe construction of an `any` typed value.","line":464,"column":219,"nodeType":"NewExpression","messageId":"unsafeNew","endLine":464,"endColumn":330},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":464,"column":332,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":464,"endColumn":386},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":464,"column":345,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":464,"endColumn":370},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .generateCompletion on an `any` value.","line":464,"column":352,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":464,"endColumn":370}],"suppressedMessages":[],"errorCount":38,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * AI Engine - LLM Integration\r\n * Integrates with various LLM providers for intelligent problem analysis and fixing\r\n */\r\n\r\nexport interface AIProvider {\r\n  name: 'openai' | 'anthropic' | 'ollama' | 'zhipu' | 'custom';\r\n  apiKey?: string;\r\n  baseURL?: string;\r\n  model: string;\r\n}\r\n\r\nexport interface AIMessage {\r\n  role: 'system' | 'user' | 'assistant';\r\n  content: string;\r\n}\r\n\r\nexport interface AIAnalysisRequest {\r\n  problem: {\r\n    title: string;\r\n    description: string;\r\n    category: string;\r\n    priority: string;\r\n  };\r\n  context: {\r\n    systemInfo: any;\r\n    logs: string[];\r\n    configFiles: Record<string, string>;\r\n    commandOutput?: string;\r\n    errorOutput?: string;\r\n  };\r\n  previousAttempts?: Array<{\r\n    solution: string;\r\n    output: string;\r\n    error: string;\r\n  }>;\r\n}\r\n\r\nexport interface AIAnalysisResponse {\r\n  diagnosis: {\r\n    rootCause: string;\r\n    severity: 'low' | 'medium' | 'high' | 'critical';\r\n    confidence: number; // 0-1\r\n  };\r\n  solutions: Array<{\r\n    command: string;\r\n    explanation: string;\r\n    riskLevel: 'low' | 'medium' | 'high';\r\n    estimatedSuccess: number; // 0-100\r\n    prerequisites?: string[]; // Commands to run first\r\n  }>;\r\n  alternativeApproaches?: string[];\r\n  warnings?: string[];\r\n}\r\n\r\nexport class AIEngine {\r\n  private provider: AIProvider;\r\n\r\n  constructor(provider: AIProvider) {\r\n    this.provider = provider;\r\n  }\r\n\r\n  /**\r\n   * Analyze a problem and suggest solutions using AI\r\n   */\r\n  async analyzeProblem(request: AIAnalysisRequest): Promise<AIAnalysisResponse> {\r\n    const prompt = this.buildAnalysisPrompt(request);\r\n\r\n    try {\r\n      const response = await this.callLLM(prompt);\r\n\r\n      return this.parseResponse(response);\r\n    } catch (error: any) {\r\n      console.error('AI analysis failed:', error);\r\n\r\n      // Fallback to rule-based analysis\r\n      return this.fallbackAnalysis(request);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get AI suggestion when a command fails\r\n   */\r\n  async diagnoseFailure(\r\n    originalProblem: any,\r\n    attemptedSolution: string,\r\n    commandOutput: string,\r\n    errorOutput: string\r\n  ): Promise<{\r\n    diagnosis: string;\r\n    alternativeSolution: string;\r\n    explanation: string;\r\n  }> {\r\n    const prompt = `\r\nOriginal Problem:\r\n${JSON.stringify(originalProblem, null, 2)}\r\n\r\nAttempted Solution:\r\n${attemptedSolution}\r\n\r\nCommand Output:\r\n${commandOutput}\r\n\r\nError Output:\r\n${errorOutput}\r\n\r\nThe command failed. Please:\r\n1. Diagnose why it failed\r\n2. Suggest an alternative approach\r\n3. Explain what went wrong\r\n\r\nProvide your response in JSON format:\r\n{\r\n  \"diagnosis\": \"why it failed\",\r\n  \"alternativeSolution\": \"alternative command or approach\",\r\n  \"explanation\": \"detailed explanation\"\r\n}\r\n`;\r\n\r\n    try {\r\n      const response = await this.callLLM(prompt);\r\n      return JSON.parse(response);\r\n    } catch (error: any) {\r\n      console.error('AI diagnosis failed:', error);\r\n\r\n      return {\r\n        diagnosis: 'Command failed with unknown error',\r\n        alternativeSolution: 'Check system logs for more details',\r\n        explanation: 'AI analysis unavailable, manual intervention required'\r\n      };\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Monitor execution and provide real-time suggestions\r\n   */\r\n  async analyzeExecutionOutput(\r\n    command: string,\r\n    output: string,\r\n    isComplete: boolean\r\n  ): Promise<{\r\n    status: 'normal' | 'warning' | 'error' | 'success';\r\n    message: string;\r\n    suggestions?: string[];\r\n    shouldAbort?: boolean;\r\n  }> {\r\n    const prompt = `\r\nCommand Being Executed:\r\n${command}\r\n\r\nCurrent Output:\r\n${output}\r\n\r\nExecution Status: ${isComplete ? 'Complete' : 'In Progress'}\r\n\r\nAnalyze the output and provide:\r\n1. Status assessment (normal/warning/error/success)\r\n2. Brief message explaining what's happening\r\n3. Suggestions if there are issues\r\n4. Whether to abort if critical error detected\r\n\r\nResponse in JSON format:\r\n{\r\n  \"status\": \"normal|warning|error|success\",\r\n  \"message\": \"what's happening\",\r\n  \"suggestions\": [\"suggestion1\", \"suggestion2\"],\r\n  \"shouldAbort\": false\r\n}\r\n`;\r\n\r\n    try {\r\n      const response = await this.callLLM(prompt);\r\n      return JSON.parse(response);\r\n    } catch (error: any) {\r\n      // Simple fallback analysis\r\n      if (output.toLowerCase().includes('error')) {\r\n        return {\r\n          status: 'error',\r\n          message: 'backend.error_detected_in_output',\r\n          suggestions: ['Check error messages', 'Review logs']\r\n        };\r\n      }\r\n\r\n      return {\r\n        status: 'normal',\r\n        message: isComplete ? 'Command completed' : 'Command running...'\r\n      };\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Build prompt for AI analysis\r\n   */\r\n  private buildAnalysisPrompt(request: AIAnalysisRequest): string {\r\n    const { problem, context, previousAttempts } = request;\r\n\r\n    let prompt = `You are an expert Linux system administrator and DevOps engineer. Analyze this problem and suggest solutions.\r\n\r\nPROBLEM:\r\nTitle: ${problem.title}\r\nDescription: ${problem.description}\r\nCategory: ${problem.category}\r\nPriority: ${problem.priority}\r\n\r\nSYSTEM CONTEXT:\r\n`;\r\n\r\n    // Add system info\r\n    if (context.systemInfo) {\r\n      prompt += `\r\nOS: ${context.systemInfo.platform} ${context.systemInfo.release}\r\nCPUs: ${context.systemInfo.cpus}\r\nMemory: ${context.systemInfo.totalMemory}\r\nUptime: ${context.systemInfo.uptime}\r\n`;\r\n    }\r\n\r\n    // Add previous attempts\r\n    if (previousAttempts && previousAttempts.length > 0) {\r\n      prompt += `\r\nPREVIOUS ATTEMPTS (all failed):\r\n`;\r\n      previousAttempts.forEach((attempt, i) => {\r\n        prompt += `\r\nAttempt ${i + 1}:\r\nSolution: ${attempt.solution}\r\nOutput: ${attempt.output}\r\nError: ${attempt.error}\r\n`;\r\n      });\r\n    }\r\n\r\n    // Add relevant logs\r\n    if (context.logs && context.logs.length > 0) {\r\n      prompt += `\r\nRELEVANT LOGS:\r\n${context.logs.join('\\n')}\r\n`;\r\n    }\r\n\r\n    // Add command output if available\r\n    if (context.commandOutput) {\r\n      prompt += `\r\nCOMMAND OUTPUT:\r\n${context.commandOutput}\r\n`;\r\n    }\r\n\r\n    if (context.errorOutput) {\r\n      prompt += `\r\nERROR OUTPUT:\r\n${context.errorOutput}\r\n`;\r\n    }\r\n\r\n    prompt += `\r\nPlease analyze and provide:\r\n1. Root cause diagnosis\r\n2. Severity assessment\r\n3. Multiple solutions (from safest to most aggressive)\r\n4. Risk level for each solution\r\n5. Estimated success rate\r\n6. Any warnings\r\n\r\nResponse in JSON format:\r\n{\r\n  \"diagnosis\": {\r\n    \"rootCause\": \"primary cause\",\r\n    \"severity\": \"low|medium|high|critical\",\r\n    \"confidence\": 0.85\r\n  },\r\n  \"solutions\": [\r\n    {\r\n      \"command\": \"exact command to execute\",\r\n      \"explanation\": \"why this will work\",\r\n      \"riskLevel\": \"low|medium|high\",\r\n      \"estimatedSuccess\": 85,\r\n      \"prerequisites\": [\"commands to run first\"]\r\n    }\r\n  ],\r\n  \"alternativeApproaches\": [\"alternative 1\", \"alternative 2\"],\r\n  \"warnings\": [\"warning 1\", \"warning 2\"]\r\n}\r\n`;\r\n\r\n    return prompt;\r\n  }\r\n\r\n  /**\r\n   * Call LLM API\r\n   */\r\n  private async callLLM(prompt: string): Promise<string> {\r\n    const { name, apiKey, baseURL, model } = this.provider;\r\n\r\n    switch (name) {\r\n      case 'openai':\r\n        return this.callOpenAI(prompt, model, apiKey);\r\n      case 'anthropic':\r\n        return this.callAnthropic(prompt, model, apiKey);\r\n      case 'ollama':\r\n        return this.callOllama(prompt, model, baseURL);\r\n      case 'zhipu':\r\n        return this.callZhipu(prompt, model, apiKey, baseURL);\r\n      default:\r\n        throw new Error(`Unsupported AI provider: ${name}`);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Call OpenAI API\r\n   */\r\n  private async callOpenAI(prompt: string, model: string, apiKey?: string): Promise<string> {\r\n    const axios = require('axios');\r\n\r\n    const response = await axios.post(\r\n      'https://api.openai.com/v1/chat/completions',\r\n      {\r\n        model: model || 'gpt-4',\r\n        messages: [\r\n          {\r\n            role: 'system',\r\n            content: 'You are an expert Linux system administrator. Always respond with valid JSON.'\r\n          },\r\n          {\r\n            role: 'user',\r\n            content: prompt\r\n          }\r\n        ],\r\n        temperature: 0.3,\r\n        max_tokens: 2000\r\n      },\r\n      {\r\n        headers: {\r\n          'Authorization': `Bearer ${apiKey || process.env.OPENAI_API_KEY}`,\r\n          'Content-Type': 'application/json'\r\n        }\r\n      }\r\n    );\r\n\r\n    return response.data.choices[0].message.content;\r\n  }\r\n\r\n  /**\r\n   * Call Anthropic Claude API\r\n   */\r\n  private async callAnthropic(prompt: string, model: string, apiKey?: string): Promise<string> {\r\n    const axios = require('axios');\r\n\r\n    const response = await axios.post(\r\n      'https://api.anthropic.com/v1/messages',\r\n      {\r\n        model: model || 'claude-3-sonnet-20240229',\r\n        max_tokens: 2000,\r\n        messages: [\r\n          {\r\n            role: 'user',\r\n            content: prompt\r\n          }\r\n        ]\r\n      },\r\n      {\r\n        headers: {\r\n          'x-api-key': apiKey || process.env.ANTHROPIC_API_KEY,\r\n          'Content-Type': 'application/json',\r\n          'anthropic-version': '2023-06-01'\r\n        }\r\n      }\r\n    );\r\n\r\n    return response.data.content[0].text;\r\n  }\r\n\r\n  /**\r\n   * Call Ollama (local LLM)\r\n   */\r\n  private async callOllama(prompt: string, model: string, baseURL?: string): Promise<string> {\r\n    const axios = require('axios');\r\n\r\n    const response = await axios.post(\r\n      `${baseURL || 'http://localhost:11434'}/api/generate`,\r\n      {\r\n        model: model || 'llama2',\r\n        prompt: prompt,\r\n        stream: false\r\n      }\r\n    );\r\n\r\n    return response.data.response;\r\n  }\r\n\r\n  /**\r\n   * Parse AI response\r\n   */\r\n  private parseResponse(response: string): AIAnalysisResponse {\r\n    try {\r\n      // Try to extract JSON from markdown code blocks\r\n      const jsonMatch = response.match(/```json\\s*([\\s\\S]*?)\\s*```/) ||\r\n        response.match(/```\\s*([\\s\\S]*?)\\s*```/);\r\n\r\n      if (jsonMatch) {\r\n        return JSON.parse(jsonMatch[1]);\r\n      }\r\n\r\n      // Try parsing directly\r\n      return JSON.parse(response);\r\n    } catch (error) {\r\n      console.error('Failed to parse AI response:', error);\r\n      throw new Error('Invalid JSON response from AI');\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Fallback analysis when AI is unavailable\r\n   */\r\n  private fallbackAnalysis(request: AIAnalysisRequest): AIAnalysisResponse {\r\n    const { problem } = request;\r\n\r\n    // Simple rule-based analysis\r\n    const solutions: Array<{\r\n      command: string;\r\n      explanation: string;\r\n      riskLevel: 'low' | 'medium' | 'high';\r\n      estimatedSuccess: number;\r\n    }> = [];\r\n\r\n    // Add common solutions based on problem category\r\n    if (problem.category === 'security') {\r\n      if (problem.title.toLowerCase().includes('firewall')) {\r\n        solutions.push({\r\n          command: 'sudo ufw enable',\r\n          explanation: 'Enable UFW firewall',\r\n          riskLevel: 'low',\r\n          estimatedSuccess: 90\r\n        });\r\n      }\r\n    }\r\n\r\n    if (problem.category === 'performance') {\r\n      if (problem.title.toLowerCase().includes('file descriptor')) {\r\n        solutions.push({\r\n          command: 'ulimit -n 65535',\r\n          explanation: 'Increase file descriptor limit',\r\n          riskLevel: 'low',\r\n          estimatedSuccess: 85\r\n        });\r\n      }\r\n    }\r\n\r\n    return {\r\n      diagnosis: {\r\n        rootCause: 'Unable to determine without AI',\r\n        severity: problem.priority === 'critical' ? 'critical' : 'medium',\r\n        confidence: 0.5\r\n      },\r\n      solutions: solutions.length > 0 ? solutions : [{\r\n        command: '# Manual intervention required',\r\n        explanation: 'AI analysis unavailable, please review logs',\r\n        riskLevel: 'medium',\r\n        estimatedSuccess: 50\r\n      }],\r\n      warnings: ['AI analysis unavailable, using rule-based fallback']\r\n    };\r\n  }\r\n/**   * Call Zhipu AI (BigModel) API   */  private async callZhipu(prompt: string, model: string, apiKey?: string, baseURL?: string): Promise<string> { const { ZhipuClient } = require(\"./zhipu-client\"); const client = new ZhipuClient(apiKey || process.env.ZHIPU_API_KEY || \"\", baseURL || \"https://open.bigmodel.cn/api/anthropic\"); return await client.generateCompletion(prompt, model); }\r\n}\r\n\r\n// Singleton instances for different providers\r\nexport const createAIEngine = (provider: AIProvider): AIEngine => {\r\n  return new AIEngine(provider);\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\execution-monitor.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":79,"column":16,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":79,"endColumn":19,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1964,1967],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1964,1967],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":85,"column":9,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":85,"endColumn":12,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2131,2134],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2131,2134],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":151,"column":15,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":151,"endColumn":39},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":151,"column":24,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":151,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .toString on an `any` value.","line":151,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":151,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":153,"column":36,"nodeType":"Property","messageId":"anyAssignment","endLine":153,"endColumn":57},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":153,"column":44,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":153,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .trim on an `any` value.","line":153,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":153,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":163,"column":15,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":163,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":163,"column":23,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":163,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .toString on an `any` value.","line":163,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":163,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":165,"column":36,"nodeType":"Property","messageId":"anyAssignment","endLine":165,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":165,"column":43,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":165,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .trim on an `any` value.","line":165,"column":49,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":165,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":193,"column":13,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":193,"endColumn":85},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":334,"column":103,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":334,"endColumn":106,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9586,9589],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9586,9589],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":385,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":385,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10675,10678],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10675,10678],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { spawn, ChildProcess } from 'child_process';\r\nimport { EventEmitter } from 'events';\r\nimport { AIEngine } from './ai-engine';\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-034: Safe command parsing\r\n * Parse command string into command and arguments array safely\r\n */\r\nfunction parseCommand(command: string): { cmd: string; args: string[] } {\r\n  const parts: string[] = [];\r\n  let current = '';\r\n  let inQuote = false;\r\n  let quoteChar = '';\r\n\r\n  for (let i = 0; i < command.length; i++) {\r\n    const char = command[i];\r\n\r\n    if ((char === '\"' || char === \"'\") && !inQuote) {\r\n      inQuote = true;\r\n      quoteChar = char;\r\n    } else if (char === quoteChar && inQuote) {\r\n      inQuote = false;\r\n      quoteChar = '';\r\n    } else if (char === ' ' && !inQuote) {\r\n      if (current.length > 0) {\r\n        parts.push(current);\r\n        current = '';\r\n      }\r\n    } else {\r\n      current += char;\r\n    }\r\n  }\r\n\r\n  if (current.length > 0) {\r\n    parts.push(current);\r\n  }\r\n\r\n  const [cmd, ...args] = parts;\r\n  return { cmd: cmd || '', args };\r\n}\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-034: Validate command before execution\r\n */\r\nfunction isCommandSafe(command: string): boolean {\r\n  // Check for dangerous shell metacharacters\r\n  const dangerousPatterns = /[;&|`$(){}[\\]<>!#%^*?\\n\\r\\\\]/;\r\n\r\n  // Allow quotes for proper argument parsing\r\n  const commandWithoutQuotes = command.replace(/[\"']/g, '');\r\n\r\n  if (dangerousPatterns.test(commandWithoutQuotes)) {\r\n    return false;\r\n  }\r\n\r\n  return true;\r\n}\r\n\r\n/**\r\n * Execution Monitor\r\n * Real-time monitoring of command execution with AI-powered analysis\r\n */\r\n\r\nexport interface ExecutionOptions {\r\n  timeout?: number; // milliseconds\r\n  env?: Record<string, string>;\r\n  cwd?: string;\r\n  aiEngine?: AIEngine;\r\n  enableAIMonitoring?: boolean;\r\n}\r\n\r\nexport interface ExecutionResult {\r\n  command: string;\r\n  exitCode: number | null;\r\n  stdout: string;\r\n  stderr: string;\r\n  duration: number;\r\n  success: boolean;\r\n  aiAnalysis?: any;\r\n}\r\n\r\nexport interface ExecutionEvent {\r\n  type: 'start' | 'stdout' | 'stderr' | 'ai-analysis' | 'complete' | 'error' | 'timeout';\r\n  timestamp: number;\r\n  data: any;\r\n}\r\n\r\nexport class ExecutionMonitor extends EventEmitter {\r\n  private currentProcess: ChildProcess | null = null;\r\n  private startTime: number = 0;\r\n  private stdoutBuffer: string[] = [];\r\n  private stderrBuffer: string[] = [];\r\n  private aiAnalysisInterval: NodeJS.Timeout | null = null;\r\n  private executionId: string;\r\n\r\n  constructor() {\r\n    super();\r\n    this.executionId = `exec-${Date.now()}`;\r\n  }\r\n\r\n  /**\r\n   * Execute command with real-time monitoring\r\n   */\r\n  async execute(command: string, options: ExecutionOptions = {}): Promise<ExecutionResult> {\r\n    const {\r\n      timeout = 300000, // 5 minutes default\r\n      env = process.env,\r\n      cwd = process.cwd(),\r\n      aiEngine,\r\n      enableAIMonitoring = false\r\n    } = options;\r\n\r\n    return new Promise((resolve, reject) => {\r\n      this.startTime = Date.now();\r\n      this.stdoutBuffer = [];\r\n      this.stderrBuffer = [];\r\n\r\n      // Emit start event\r\n      this.emitEvent('start', { command, executionId: this.executionId });\r\n\r\n      // SECURITY FIX CVE-2026-034: Validate command before execution\r\n      if (!isCommandSafe(command)) {\r\n        const error = new Error('Command contains dangerous characters');\r\n        this.emitEvent('error', { error: error.message });\r\n        reject({\r\n          command,\r\n          exitCode: 1,\r\n          stdout: '',\r\n          stderr: 'Command rejected: contains dangerous shell metacharacters',\r\n          duration: 0,\r\n          success: false\r\n        });\r\n        return;\r\n      }\r\n\r\n      // SECURITY FIX CVE-2026-034: Use safe command parsing\r\n      const { cmd, args } = parseCommand(command);\r\n      this.currentProcess = spawn(cmd, args, {\r\n        env,\r\n        cwd,\r\n        timeout\r\n      });\r\n\r\n      // Setup AI monitoring if enabled\r\n      if (enableAIMonitoring && aiEngine) {\r\n        this.startAIMonitoring(command, aiEngine);\r\n      }\r\n\r\n      // Collect stdout\r\n      this.currentProcess.stdout?.on('data', (data) => {\r\n        const output = data.toString();\r\n        this.stdoutBuffer.push(output);\r\n        this.emitEvent('stdout', { output: output.trim() });\r\n\r\n        // Real-time AI analysis on suspicious output\r\n        if (enableAIMonitoring && aiEngine) {\r\n          this.analyzeOutputInRealTime(command, output, aiEngine);\r\n        }\r\n      });\r\n\r\n      // Collect stderr\r\n      this.currentProcess.stderr?.on('data', (data) => {\r\n        const error = data.toString();\r\n        this.stderrBuffer.push(error);\r\n        this.emitEvent('stderr', { error: error.trim() });\r\n\r\n        // AI analysis on errors\r\n        if (enableAIMonitoring && aiEngine) {\r\n          this.analyzeErrorInRealTime(command, error, aiEngine);\r\n        }\r\n      });\r\n\r\n      // Handle process exit\r\n      this.currentProcess.on('close', async (code) => {\r\n        this.stopAIMonitoring();\r\n\r\n        const duration = Date.now() - this.startTime;\r\n        const stdout = this.stdoutBuffer.join('\\n');\r\n        const stderr = this.stderrBuffer.join('\\n');\r\n\r\n        const result: ExecutionResult = {\r\n          command,\r\n          exitCode: code,\r\n          stdout,\r\n          stderr,\r\n          duration,\r\n          success: code === 0\r\n        };\r\n\r\n        // Final AI analysis if enabled\r\n        if (enableAIMonitoring && aiEngine && !result.success) {\r\n          try {\r\n            result.aiAnalysis = await this.analyzeFailure(command, result, aiEngine);\r\n          } catch (error) {\r\n            console.error('Final AI analysis failed:', error);\r\n          }\r\n        }\r\n\r\n        this.emitEvent('complete', result);\r\n\r\n        if (result.success) {\r\n          resolve(result);\r\n        } else {\r\n          reject(result);\r\n        }\r\n      });\r\n\r\n      // Handle error\r\n      this.currentProcess.on('error', (error) => {\r\n        this.stopAIMonitoring();\r\n        this.emitEvent('error', { error: error.message });\r\n        reject({\r\n          command,\r\n          exitCode: null,\r\n          stdout: this.stdoutBuffer.join('\\n'),\r\n          stderr: this.stderrBuffer.join('\\n'),\r\n          duration: Date.now() - this.startTime,\r\n          success: false,\r\n          error: error.message\r\n        });\r\n      });\r\n\r\n      // Handle timeout\r\n      if (timeout) {\r\n        setTimeout(() => {\r\n          if (this.currentProcess && !this.currentProcess.killed) {\r\n            this.currentProcess.kill('SIGTERM');\r\n            this.emitEvent('timeout', { timeout });\r\n            this.stopAIMonitoring();\r\n          }\r\n        }, timeout);\r\n      }\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Start periodic AI monitoring\r\n   */\r\n  private startAIMonitoring(command: string, aiEngine: AIEngine): void {\r\n    // Analyze execution every 10 seconds\r\n    this.aiAnalysisInterval = setInterval(async () => {\r\n      const currentOutput = this.stdoutBuffer.join('\\n');\r\n      const currentError = this.stderrBuffer.join('\\n');\r\n\r\n      if (currentOutput || currentError) {\r\n        try {\r\n          const analysis = await aiEngine.analyzeExecutionOutput(\r\n            command,\r\n            currentOutput + '\\n' + currentError,\r\n            false // Not complete yet\r\n          );\r\n\r\n          this.emitEvent('ai-analysis', analysis);\r\n\r\n          // Abort if AI recommends it\r\n          if (analysis.shouldAbort) {\r\n            console.warn('AI recommends aborting execution:', analysis.message);\r\n            this.abortExecution();\r\n          }\r\n        } catch (error) {\r\n          console.error('Real-time AI analysis failed:', error);\r\n        }\r\n      }\r\n    }, 10000);\r\n  }\r\n\r\n  /**\r\n   * Stop AI monitoring\r\n   */\r\n  private stopAIMonitoring(): void {\r\n    if (this.aiAnalysisInterval) {\r\n      clearInterval(this.aiAnalysisInterval);\r\n      this.aiAnalysisInterval = null;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Real-time analysis of output\r\n   */\r\n  private async analyzeOutputInRealTime(command: string, output: string, aiEngine: AIEngine): Promise<void> {\r\n    try {\r\n      const analysis = await aiEngine.analyzeExecutionOutput(command, output, false);\r\n\r\n      if (analysis.status === 'warning' || analysis.status === 'error') {\r\n        this.emitEvent('ai-analysis', {\r\n          type: 'warning',\r\n          message: analysis.message,\r\n          suggestions: analysis.suggestions\r\n        });\r\n      }\r\n    } catch (error) {\r\n      // Silently fail for real-time analysis\r\n      console.debug('Real-time output analysis failed:', error);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Real-time analysis of errors\r\n   */\r\n  private async analyzeErrorInRealTime(command: string, error: string, aiEngine: AIEngine): Promise<void> {\r\n    try {\r\n      // Check if error looks critical\r\n      const criticalPatterns = [\r\n        'permission denied',\r\n        'access denied',\r\n        'no space left',\r\n        'segmentation fault',\r\n        'killed'\r\n      ];\r\n\r\n      const isCritical = criticalPatterns.some(pattern =>\r\n        error.toLowerCase().includes(pattern)\r\n      );\r\n\r\n      if (isCritical) {\r\n        this.emitEvent('ai-analysis', {\r\n          type: 'critical-error',\r\n          message: 'backend.critical_error_detected',\r\n          error: error.trim(),\r\n          shouldAbort: true\r\n        });\r\n\r\n        // Optionally abort on critical errors\r\n        // this.abortExecution();\r\n      }\r\n    } catch (error) {\r\n      console.debug('Real-time error analysis failed:', error);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Analyze failure after execution completes\r\n   */\r\n  private async analyzeFailure(command: string, result: ExecutionResult, aiEngine: AIEngine): Promise<any> {\r\n    try {\r\n      return await aiEngine.diagnoseFailure(\r\n        { command },\r\n        command,\r\n        result.stdout,\r\n        result.stderr\r\n      );\r\n    } catch (error) {\r\n      console.error('Failure analysis failed:', error);\r\n      return null;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Abort current execution\r\n   */\r\n  abortExecution(): void {\r\n    if (this.currentProcess && !this.currentProcess.killed) {\r\n      this.currentProcess.kill('SIGKILL');\r\n      this.emitEvent('error', { message: 'backend.execution_aborted' });\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get execution ID\r\n   */\r\n  getExecutionId(): string {\r\n    return this.executionId;\r\n  }\r\n\r\n  /**\r\n   * Check if process is running\r\n   */\r\n  isRunning(): boolean {\r\n    return this.currentProcess !== null && !this.currentProcess.killed;\r\n  }\r\n\r\n  /**\r\n   * Get current output\r\n   */\r\n  getCurrentOutput(): { stdout: string; stderr: string } {\r\n    return {\r\n      stdout: this.stdoutBuffer.join('\\n'),\r\n      stderr: this.stderrBuffer.join('\\n')\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Emit event\r\n   */\r\n  private emitEvent(type: string, data: any): void {\r\n    this.emit('execution-event', {\r\n      type,\r\n      timestamp: Date.now(),\r\n      executionId: this.executionId,\r\n      ...data\r\n    } as ExecutionEvent);\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\nuclei-scanner.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":98,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":98,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3131,3134],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3131,3134],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":99,"column":71,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":99,"endColumn":78},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":204,"column":31,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":204,"endColumn":56},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":205,"column":36,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":205,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":207,"column":33,"nodeType":"Property","messageId":"anyAssignment","endLine":207,"endColumn":87},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access ['template-id'] on an `any` value.","line":207,"column":52,"nodeType":"Literal","messageId":"unsafeMemberExpression","endLine":207,"endColumn":65},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .templateID on an `any` value.",