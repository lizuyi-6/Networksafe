nst signature = crypto\r\n      .createHmac('sha256', secretKey)\r\n      .update(message)\r\n      .digest('hex');\r\n\r\n    logger.debug(`Command signed for ${agentId}: ${commandType}`, {\r\n      timestamp: command.timestamp,\r\n      nonce: command.nonce.substring(0, 8) + '...'\r\n    });\r\n\r\n    return {\r\n      command,\r\n      signature,\r\n      agentId\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Verify a signed command\r\n   * Used by agents to verify commands from server\r\n   */\r\n  async verifyCommand(signedCommand: SignedCommand, secretKey: string): Promise<CommandValidationResult> {\r\n    const { command, signature, agentId } = signedCommand;\r\n\r\n    // Recreate signature\r\n    const message = JSON.stringify(command);\r\n    const expectedSignature = crypto\r\n      .createHmac('sha256', secretKey)\r\n      .update(message)\r\n      .digest('hex');\r\n\r\n    // Verify signature using constant-time comparison\r\n    try {\r\n      const isValid = crypto.timingSafeEqual(\r\n        Buffer.from(signature, 'hex'),\r\n        Buffer.from(expectedSignature, 'hex')\r\n      );\r\n\r\n      if (!isValid) {\r\n        logger.warn(`Invalid command signature from ${agentId}`);\r\n        return {\r\n          valid: false,\r\n          error: 'backend.invalid_signature'\r\n        };\r\n      }\r\n    } catch {\r\n      return {\r\n        valid: false,\r\n        error: 'backend.signature_verification_failed'\r\n      };\r\n    }\r\n\r\n    // Check timestamp (prevent replay attacks)\r\n    // SECURITY FIX CVE-2026-202: Reduced to 30 seconds from 5 minutes\r\n    const now = Date.now();\r\n    const commandAge = now - command.timestamp;\r\n    const MAX_AGE = 30 * 1000; // SECURITY FIX: 30 seconds (was 5 minutes)\r\n\r\n    if (commandAge > MAX_AGE) {\r\n      logger.warn(`Stale command received from ${agentId}`, {\r\n        age: commandAge,\r\n        timestamp: command.timestamp\r\n      });\r\n      return {\r\n        valid: false,\r\n        error: 'backend.command_expired'\r\n      };\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-202: Reduced clock skew tolerance from 60s to 5s\r\n    if (command.timestamp > now + 5000) {\r\n      logger.warn(`Future timestamp in command from ${agentId}`);\r\n      return {\r\n        valid: false,\r\n        error: 'backend.invalid_timestamp'\r\n      };\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-204: Check nonce to prevent replay\r\n    // SECURITY FIX RISK-002: Use nonce manager with Redis + memory fallback\r\n    const nonceIsValid = await nonceManager.checkAndUseNonce(command.nonce, 600);\r\n\r\n    if (!nonceIsValid) {\r\n      logger.warn(`Replay attack detected - duplicate nonce from ${agentId}`);\r\n      return {\r\n        valid: false,\r\n        error: 'backend.duplicate_nonce'\r\n      };\r\n    }\r\n\r\n    logger.debug(`Command verified for ${agentId}: ${command.type}`);\r\n\r\n    return {\r\n      valid: true,\r\n      command\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Generate admin signature for critical operations\r\n   */\r\n  signAdminCommand(command: any, adminSecret: string): string {\r\n    const message = JSON.stringify({\r\n      ...command,\r\n      timestamp: Date.now(),\r\n      nonce: crypto.randomBytes(16).toString('hex')\r\n    });\r\n\r\n    return crypto\r\n      .createHmac('sha256', adminSecret)\r\n      .update(message)\r\n      .digest('hex');\r\n  }\r\n}\r\n\r\nexport default new CommandSigningService();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\concurrency.middleware.ts","messages":[{"ruleId":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\security\\concurrency.middleware.ts","nodeType":null}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Request, Response, NextFunction } from 'express';\r\nimport { CONCURRENCY, MONITORING } from '../config';\r\nimport logger from '../utils/logger';\r\nimport redisService from './redis.service';\r\n\r\n/**\r\n * Concurrency control middleware for high-traffic scenarios\r\n * Prevents server overload and ensures fair resource allocation\r\n */\r\n\r\ninterface QueueItem {\r\n  resolve: () => void;\r\n  reject: (error: any) => void;\r\n  timestamp: number;\r\n}\r\n\r\nclass ConcurrencyController {\r\n  private userQueues = new Map<string, QueueItem[]>();\r\n  private activeRequests = new Map<string, number>();\r\n  // Use locks to prevent race conditions\r\n  private locks = new Map<string, Promise<void>>();\r\n\r\n  /**\r\n   * Acquire request slot for user (thread-safe)\r\n   */\r\n  async acquireSlot(userId: string): Promise<void> {\r\n    // Wait for any existing operation on this user to complete\r\n    let existingLock = this.locks.get(userId);\r\n    while (existingLock) {\r\n      await existingLock;\r\n      existingLock = this.locks.get(userId);\r\n    }\r\n\r\n    // Create a new lock for this operation\r\n    let resolveLock: (() => void) | undefined;\r\n    const lockPromise = new Promise<void>(resolve => { resolveLock = resolve; });\r\n    this.locks.set(userId, lockPromise);\r\n\r\n    try {\r\n      const active = this.activeRequests.get(userId) || 0;\r\n\r\n      if (active < CONCURRENCY.MAX_CONCURRENT_REQUESTS_PER_USER) {\r\n        // Slot available - atomic increment\r\n        this.activeRequests.set(userId, active + 1);\r\n        return;\r\n      }\r\n\r\n      // Wait in queue\r\n      return new Promise((resolve, reject) => {\r\n        let queue = this.userQueues.get(userId);\r\n\r\n        if (!queue) {\r\n          queue = [];\r\n          this.userQueues.set(userId, queue);\r\n        }\r\n\r\n        // Check queue size limit\r\n        if (queue.length >= CONCURRENCY.MAX_QUEUE_SIZE) {\r\n          reject(new Error('Request queue full'));\r\n          return;\r\n        }\r\n\r\n        queue.push({\r\n          resolve: resolve as () => void,\r\n          reject,\r\n          timestamp: Date.now(),\r\n        });\r\n      });\r\n    } finally {\r\n      // Release the lock\r\n      if (resolveLock) {\r\n        resolveLock();\r\n      }\r\n      this.locks.delete(userId);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Release request slot for user\r\n   */\r\n  releaseSlot(userId: string): void {\r\n    const active = this.activeRequests.get(userId) || 0;\r\n\r\n    if (active > 0) {\r\n      this.activeRequests.set(userId, active - 1);\r\n    }\r\n\r\n    // Process next request in queue\r\n    const queue = this.userQueues.get(userId);\r\n\r\n    if (queue && queue.length > 0) {\r\n      const next = queue.shift();\r\n      this.activeRequests.set(userId, (this.activeRequests.get(userId) || 0) + 1);\r\n      next?.resolve();\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get current statistics\r\n   */\r\n  getStats(userId: string) {\r\n    return {\r\n      active: this.activeRequests.get(userId) || 0,\r\n      queued: (this.userQueues.get(userId) || []).length,\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Cleanup inactive users to prevent memory leaks\r\n   */\r\n  cleanup(): void {\r\n    const now = Date.now();\r\n    const staleThreshold = now - (60 * 60 * 1000); // 1 hour\r\n\r\n    for (const [userId, queue] of this.userQueues.entries()) {\r\n      const active = this.activeRequests.get(userId) || 0;\r\n      const hasStaleRequests = queue.some(item => item.timestamp < staleThreshold);\r\n\r\n      // Clean up if no active requests and only stale queued requests\r\n      if (active === 0 && hasStaleRequests) {\r\n        this.userQueues.delete(userId);\r\n        this.activeRequests.delete(userId);\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\nconst controller = new ConcurrencyController();\r\n\r\n/**\r\n * Concurrency limiting middleware\r\n */\r\nexport const concurrencyLimit = async (\r\n  req: Request,\r\n  res: Response,\r\n  next: NextFunction\r\n): Promise<void> => {\r\n  const userId = (req as any).user?.userId || 'anonymous';\r\n\r\n  try {\r\n    // Acquire slot\r\n    await controller.acquireSlot(userId);\r\n\r\n    logger.debug('Request slot acquired', { userId });\r\n\r\n    // Release slot after response\r\n    res.on('finish', () => {\r\n      controller.releaseSlot(userId);\r\n      logger.debug('Request slot released', { userId });\r\n    });\r\n\r\n    next();\r\n  } catch (error) {\r\n    logger.warn('Concurrency limit exceeded', { userId, error });\r\n\r\n    res.status(429).json({\r\n      success: false,\r\n      error: {\r\n        message: 'backend.too_many_concurrent_requests_please_retry_later',\r\n        type: 'concurrency_limit_exceeded',\r\n      },\r\n    });\r\n  }\r\n};\r\n\r\n/**\r\n * Performance monitoring middleware\r\n */\r\nexport const performanceMonitor = async (\r\n  req: Request,\r\n  res: Response,\r\n  next: NextFunction\r\n): Promise<void> => {\r\n  if (!MONITORING.ENABLE_PERFORMANCE_TRACKING) {\r\n    next();\r\n    return;\r\n  }\r\n\r\n  const startTime = Date.now();\r\n  const startMemory = process.memoryUsage();\r\n\r\n  // Track response\r\n  const originalJson = res.json.bind(res);\r\n\r\n  res.json = function (body: any) {\r\n    const endTime = Date.now();\r\n    const duration = endTime - startTime;\r\n    const endMemory = process.memoryUsage();\r\n    const memoryUsed = (endMemory.heapUsed - startMemory.heapUsed) / 1024 / 1024; // MB\r\n\r\n    // Log slow requests\r\n    if (duration > MONITORING.SLOW_QUERY_THRESHOLD) {\r\n      logger.warn('Slow request detected', {\r\n        url: req.url,\r\n        method: req.method,\r\n        duration,\r\n        memoryUsed: `${memoryUsed.toFixed(2)}MB`,\r\n      });\r\n    } else {\r\n      logger.debug('Request completed', {\r\n        url: req.url,\r\n        method: req.method,\r\n        duration,\r\n        memoryUsed: `${memoryUsed.toFixed(2)}MB`,\r\n      });\r\n    }\r\n\r\n    // Add performance headers\r\n    res.setHeader('X-Response-Time', `${duration}ms`);\r\n\r\n    return originalJson(body);\r\n  };\r\n\r\n  next();\r\n};\r\n\r\n// Store timer IDs for cleanup\r\nlet memoryMonitorInterval: NodeJS.Timeout | null = null;\r\nlet cpuMonitorInterval: NodeJS.Timeout | null = null;\r\n\r\n/**\r\n * Memory usage monitoring\r\n */\r\nexport function startMemoryMonitoring(): void {\r\n  // Clear existing interval if any\r\n  if (memoryMonitorInterval) {\r\n    clearInterval(memoryMonitorInterval);\r\n  }\r\n\r\n  memoryMonitorInterval = setInterval(() => {\r\n    const memory = process.memoryUsage();\r\n    const heapUsedMB = memory.heapUsed / 1024 / 1024;\r\n\r\n    if (heapUsedMB > MONITORING.MEMORY_WARNING_THRESHOLD) {\r\n      logger.warn('High memory usage detected', {\r\n        heapUsed: `${heapUsedMB.toFixed(2)}MB`,\r\n        heapTotal: `${(memory.heapTotal / 1024 / 1024).toFixed(2)}MB`,\r\n        external: `${(memory.external / 1024 / 1024).toFixed(2)}MB`,\r\n      });\r\n    }\r\n  }, 30000); // Check every 30 seconds\r\n}\r\n\r\n/**\r\n * CPU usage monitoring\r\n */\r\nexport function startCPUMonitoring(): void {\r\n  // Clear existing interval if any\r\n  if (cpuMonitorInterval) {\r\n    clearInterval(cpuMonitorInterval);\r\n  }\r\n\r\n  // Reset baseline each time monitoring starts\r\n  let startUsage = process.cpuUsage();\r\n\r\n  cpuMonitorInterval = setInterval(() => {\r\n    const usage = process.cpuUsage(startUsage);\r\n    const userUsage = usage.user / 1000000; // Convert to seconds\r\n    const systemUsage = usage.system / 1000000;\r\n\r\n    logger.debug('CPU usage', {\r\n      user: `${userUsage.toFixed(2)}s`,\r\n      system: `${systemUsage.toFixed(2)}s`,\r\n    });\r\n\r\n    // Reset baseline for next interval\r\n    startUsage = process.cpuUsage();\r\n  }, 30000); // Check every 30 seconds\r\n}\r\n\r\n/**\r\n * Stop all monitoring intervals (for cleanup)\r\n */\r\nexport function stopMonitoring(): void {\r\n  if (memoryMonitorInterval) {\r\n    clearInterval(memoryMonitorInterval);\r\n    memoryMonitorInterval = null;\r\n  }\r\n  if (cpuMonitorInterval) {\r\n    clearInterval(cpuMonitorInterval);\r\n    cpuMonitorInterval = null;\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\config.ts","messages":[{"ruleId":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\security\\config.ts","nodeType":null}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// Default Configuration\r\n\r\nimport { SecurityConfig } from './types';\r\n\r\nexport const defaultConfig: SecurityConfig = {\r\n  env: (process.env.NODE_ENV as SecurityConfig['env']) || 'development',\r\n\r\n  rateLimit: {\r\n    requestsPerMinute: 60,\r\n    windowSeconds: 60,\r\n  },\r\n\r\n  antiBot: {\r\n    enabled: true,\r\n    requestThreshold: 100,\r\n    fastRequestThreshold: 10,\r\n    blockDuration: 3600,\r\n    allowKnownBots: true,\r\n  },\r\n\r\n  concurrency: {\r\n    maxConcurrentRequestsPerUser: 5,\r\n    maxQueueSize: 20,\r\n  },\r\n\r\n  authSecurity: {\r\n    maxLoginAttempts: 5,\r\n    lockoutDuration: 900,\r\n    attemptWindow: 300,\r\n    passwordPolicy: {\r\n      minLength: 8,\r\n      requireUppercase: true,\r\n      requireLowercase: true,\r\n      requireNumbers: true,\r\n      requireSpecialChars: true,\r\n      maxLength: 128,\r\n    },\r\n  },\r\n\r\n  monitoring: {\r\n    enablePerformanceTracking: true,\r\n    slowQueryThreshold: 1000,\r\n    memoryWarningThreshold: 500,\r\n  },\r\n};\r\n\r\n// HTTP Status Codes\r\nexport const HTTP_STATUS = {\r\n  OK: 200,\r\n  CREATED: 201,\r\n  BAD_REQUEST: 400,\r\n  UNAUTHORIZED: 401,\r\n  FORBIDDEN: 403,\r\n  NOT_FOUND: 404,\r\n  TOO_MANY_REQUESTS: 429,\r\n  INTERNAL_SERVER_ERROR: 500,\r\n};\r\n\r\n// Redis Keys\r\nexport const REDIS_KEYS = {\r\n  RATE_LIMIT_PREFIX: 'ratelimit',\r\n  REQUEST_COUNT_SUFFIX: 'requests',\r\n  LIMIT_SUFFIX: 'limit',\r\n  WINDOW_SUFFIX: 'window',\r\n  ANTIBOT_PREFIX: 'antibot',\r\n  AUTH_PREFIX: 'auth',\r\n};\r\n\r\n// Performance Constants\r\nexport const CONCURRENCY = {\r\n  MAX_CONCURRENT_REQUESTS_PER_USER: 5,\r\n  MAX_QUEUE_SIZE: 20,\r\n};\r\n\r\nexport const MONITORING = {\r\n  ENABLE_PERFORMANCE_TRACKING: true,\r\n  SLOW_QUERY_THRESHOLD: 1000,\r\n  MEMORY_WARNING_THRESHOLD: 500,\r\n};\r\n\r\nexport const RATE_LIMIT = {\r\n  WINDOW_SECONDS: 60,\r\n  DEFAULT_REQUESTS_PER_MINUTE: 60,\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\enhanced-rate-limiter.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":202,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":202,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6244,6247],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6244,6247],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":204,"column":13,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":204,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":204,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":204,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":310,"column":17,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":310,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .ip on an `any` value.","line":311,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":311,"endColumn":25},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":329,"column":19,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":329,"endColumn":43},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .ip on an `any` value.","line":330,"column":32,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":330,"endColumn":34}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Enhanced Rate Limiter Service\r\n *\r\n * SECURITY FIX for RISK-001: IP Spoofing Bypass\r\n *\r\n * Features:\r\n * - Multi-dimensional rate limiting (user + IP)\r\n * - IP spoofing detection and prevention\r\n * - Distributed coordination via Redis\r\n * - Memory fallback for Redis failures\r\n * - Configurable limits per endpoint\r\n */\r\n\r\nimport logger from '../utils/logger';\r\nimport redisService from './redis.service';\r\n\r\n// SECURITY FIX: Lua script for atomic rate limit check and increment\r\n// This prevents race conditions between get() and incr() operations\r\nconst RATE_LIMIT_SCRIPT = `\r\nlocal key = KEYS[1]\r\nlocal resetKey = KEYS[2]\r\nlocal limit = tonumber(ARGV[1])\r\nlocal windowMs = tonumber(ARGV[2])\r\nlocal resetTime = tonumber(ARGV[3])\r\n\r\nlocal current = tonumber(redis.call('GET', key))\r\nif current == nil then\r\n    redis.call('SETEX', key, math.ceil(windowMs / 1000), '1')\r\n    redis.call('SETEX', resetKey, math.ceil(windowMs / 1000), tostring(resetTime))\r\n    return {1, limit - 1, resetTime}\r\nend\r\n\r\nif current >= limit then\r\n    local storedReset = tonumber(redis.call('GET', resetKey)) or resetTime\r\n    return {0, 0, storedReset}\r\nend\r\n\r\nlocal newCount = redis.call('INCR', key)\r\nreturn {1, limit - newCount, resetTime}\r\n`;\r\n\r\n// Cache for compiled Lua script SHA\r\nlet rateLimitScriptSha: string | null = null;\r\n\r\nexport interface RateLimitConfig {\r\n  maxRequests: number;\r\n  windowMs: number;\r\n  skipSuccessfulRequests?: boolean;\r\n  skipFailedRequests?: boolean;\r\n}\r\n\r\nexport interface RateLimitResult {\r\n  allowed: boolean;\r\n  limit: number;\r\n  remaining: number;\r\n  resetTime: Date;\r\n  reason?: string;\r\n}\r\n\r\ninterface RateLimitInfo {\r\n  count: number;\r\n  resetTime: number;\r\n}\r\n\r\nexport class EnhancedRateLimiter {\r\n  private memoryFallback: Map<string, RateLimitInfo> = new Map();\r\n  // SECURITY FIX: Lock for memory fallback to prevent race conditions\r\n  private memoryLocks: Map<string, Promise<void>> = new Map();\r\n  private readonly DEFAULT_LIMITS: RateLimitConfig = {\r\n    maxRequests: 100,\r\n    windowMs: 60000,\r\n  };\r\n\r\n  /**\r\n   * SECURITY FIX: Load and cache the Lua script for atomic rate limiting\r\n   */\r\n  private async loadRateLimitScript(): Promise<string> {\r\n    if (rateLimitScriptSha) {\r\n      return rateLimitScriptSha;\r\n    }\r\n\r\n    try {\r\n      const client = redisService.getClient();\r\n      const sha = await client.script('LOAD', RATE_LIMIT_SCRIPT);\r\n      rateLimitScriptSha = typeof sha === 'string' ? sha : String(sha);\r\n      logger.info('Rate limit Lua script loaded', { sha: rateLimitScriptSha });\r\n      return rateLimitScriptSha;\r\n    } catch (error) {\r\n      logger.error('Failed to load rate limit Lua script', { error });\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  async checkRateLimit(params: {\r\n    identifier: string;\r\n    ip: string;\r\n    endpoint?: string;\r\n    config?: Partial<RateLimitConfig>;\r\n  }): Promise<RateLimitResult> {\r\n    const { identifier, ip, endpoint, config } = params;\r\n    const finalConfig = { ...this.DEFAULT_LIMITS, ...config };\r\n\r\n    const now = Date.now();\r\n    const resetTime = now + finalConfig.windowMs;\r\n\r\n    const userKey = `ratelimit:user:${identifier}`;\r\n    const ipKey = `ratelimit:ip:${ip}`;\r\n    const endpointKey = endpoint ? `ratelimit:endpoint:${endpoint}:${identifier}` : null;\r\n    const combinedKey = `ratelimit:combined:${identifier}:${ip}`;\r\n\r\n    try {\r\n      const results = await Promise.all([\r\n        this.checkDimension(userKey, finalConfig.maxRequests, finalConfig.windowMs),\r\n        this.checkDimension(ipKey, Math.floor(finalConfig.maxRequests * 2), finalConfig.windowMs),\r\n        endpointKey ? this.checkDimension(endpointKey, Math.floor(finalConfig.maxRequests / 2), finalConfig.windowMs) : null,\r\n        this.checkDimension(combinedKey, finalConfig.maxRequests, finalConfig.windowMs),\r\n      ]);\r\n\r\n      const userResult = results[0];\r\n      const ipResult = results[1];\r\n      const endpointResult = results[2];\r\n      const combinedResult = results[3];\r\n\r\n      if (!userResult.allowed) {\r\n        return {\r\n          ...userResult,\r\n          reason: 'User rate limit exceeded',\r\n        };\r\n      }\r\n\r\n      if (!ipResult.allowed) {\r\n        logger.warn('IP rate limit exceeded', {\r\n          ip,\r\n          identifier,\r\n          endpoint,\r\n        });\r\n        return {\r\n          ...ipResult,\r\n          reason: 'IP rate limit exceeded',\r\n        };\r\n      }\r\n\r\n      if (endpointResult && !endpointResult.allowed) {\r\n        return {\r\n          ...endpointResult,\r\n          reason: 'Endpoint rate limit exceeded',\r\n        };\r\n      }\r\n\r\n      if (!combinedResult.allowed) {\r\n        return {\r\n          ...combinedResult,\r\n          reason: 'Combined rate limit exceeded',\r\n        };\r\n      }\r\n\r\n      return combinedResult;\r\n\r\n    } catch (error) {\r\n      logger.error('Rate limit check failed', { error, identifier, ip });\r\n      // SECURITY FIX: Fail closed - reject request if rate limit check fails\r\n      // This prevents attackers from bypassing rate limits by causing failures\r\n      return {\r\n        allowed: false,\r\n        limit: finalConfig.maxRequests,\r\n        remaining: 0,\r\n        resetTime: new Date(resetTime),\r\n        reason: 'Rate limit check failed - request rejected for security',\r\n      };\r\n    }\r\n  }\r\n\r\n  private async checkDimension(\r\n    key: string,\r\n    limit: number,\r\n    windowMs: number\r\n  ): Promise<RateLimitResult> {\r\n    const now = Date.now();\r\n    const resetTime = now + windowMs;\r\n\r\n    if (!redisService.isAvailable()) {\r\n      return this.checkDimensionMemoryWithLock(key, limit, windowMs);\r\n    }\r\n\r\n    try {\r\n      const client = redisService.getClient();\r\n      const resetKey = `${key}:reset`;\r\n\r\n      // SECURITY FIX: Use atomic Lua script to prevent race conditions\r\n      try {\r\n        const sha = await this.loadRateLimitScript();\r\n        const result = await client.evalsha(sha, 2, key, resetKey, limit.toString(), windowMs.toString(), resetTime.toString()) as [number, number, number];\r\n\r\n        const [allowed, remaining, actualResetTime] = result;\r\n\r\n        return {\r\n          allowed: allowed === 1,\r\n          limit,\r\n          remaining: Math.max(remaining, 0),\r\n          resetTime: new Date(actualResetTime),\r\n        };\r\n      } catch (evalError: any) {\r\n        // If script not found (NOSCRIPT), reload it\r\n        if (evalError.message?.includes('NOSCRIPT')) {\r\n          rateLimitScriptSha = null;\r\n          const sha = await this.loadRateLimitScript();\r\n          const result = await client.evalsha(sha, 2, key, resetKey, limit.toString(), windowMs.toString(), resetTime.toString()) as [number, number, number];\r\n\r\n          const [allowed, remaining, actualResetTime] = result;\r\n\r\n          return {\r\n            allowed: allowed === 1,\r\n            limit,\r\n            remaining: Math.max(remaining, 0),\r\n            resetTime: new Date(actualResetTime),\r\n          };\r\n        }\r\n        throw evalError;\r\n      }\r\n\r\n    } catch (error) {\r\n      logger.warn('Redis rate limit failed, using memory fallback', { error, key });\r\n      return this.checkDimensionMemoryWithLock(key, limit, windowMs);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * SECURITY FIX: Memory fallback with proper locking to prevent race conditions\r\n   */\r\n  private async checkDimensionMemoryWithLock(\r\n    key: string,\r\n    limit: number,\r\n    windowMs: number\r\n  ): Promise<RateLimitResult> {\r\n    // Wait for any existing lock on this key\r\n    while (this.memoryLocks.has(key)) {\r\n      await this.memoryLocks.get(key);\r\n    }\r\n\r\n    // Create lock for this operation\r\n    let lockResolver: () => void;\r\n    const lockPromise = new Promise<void>(resolve => { lockResolver = resolve; });\r\n    this.memoryLocks.set(key, lockPromise);\r\n\r\n    try {\r\n      return this.checkDimensionMemory(key, limit, windowMs);\r\n    } finally {\r\n      this.memoryLocks.delete(key);\r\n      lockResolver!();\r\n    }\r\n  }\r\n\r\n  private checkDimensionMemory(\r\n    key: string,\r\n    limit: number,\r\n    windowMs: number\r\n  ): RateLimitResult {\r\n    const now = Date.now();\r\n    const info = this.memoryFallback.get(key);\r\n\r\n    if (!info || now > info.resetTime) {\r\n      this.memoryFallback.set(key, {\r\n        count: 1,\r\n        resetTime: now + windowMs,\r\n      });\r\n\r\n      return {\r\n        allowed: true,\r\n        limit,\r\n        remaining: limit - 1,\r\n        resetTime: new Date(now + windowMs),\r\n      };\r\n    }\r\n\r\n    if (info.count >= limit) {\r\n      return {\r\n        allowed: false,\r\n        limit,\r\n        remaining: 0,\r\n        resetTime: new Date(info.resetTime),\r\n      };\r\n    }\r\n\r\n    info.count++;\r\n    return {\r\n      allowed: true,\r\n      limit,\r\n      remaining: limit - info.count,\r\n      resetTime: new Date(info.resetTime),\r\n    };\r\n  }\r\n\r\n  async detectIPSpoofing(params: {\r\n    identifier: string;\r\n    ip: string;\r\n  }): Promise<{ suspicious: boolean; reason?: string }> {\r\n    const { identifier, ip } = params;\r\n\r\n    if (!redisService.isAvailable()) {\r\n      return { suspicious: false };\r\n    }\r\n\r\n    const key = `ips:user:${identifier}`;\r\n\r\n    try {\r\n      const recentIPs = await redisService.getClient().lrange(key, 0, -1);\r\n\r\n      const ipExists = recentIPs.some((entry: string) => {\r\n        try {\r\n          const data = JSON.parse(entry);\r\n          return data.ip === ip;\r\n        } catch {\r\n          return false;\r\n        }\r\n      });\r\n\r\n      await redisService.getClient().lpush(key, JSON.stringify({\r\n        ip,\r\n        timestamp: Date.now(),\r\n      }));\r\n\r\n      await redisService.getClient().ltrim(key, 0, 9);\r\n      await redisService.getClient().expire(key, 3600);\r\n\r\n      if (recentIPs.length >= 5) {\r\n        const uniqueIPs = new Set();\r\n        recentIPs.forEach((entry: string) => {\r\n          try {\r\n            const data = JSON.parse(entry);\r\n            uniqueIPs.add(data.ip);\r\n          } catch {}\r\n        });\r\n\r\n        if (uniqueIPs.size >= 5 && !ipExists) {\r\n          logger.error('IP spoofing detected - rapid IP rotation', {\r\n            identifier,\r\n            uniqueIPCount: uniqueIPs.size,\r\n            currentIP: ip,\r\n          });\r\n\r\n          return {\r\n            suspicious: true,\r\n            reason: `Rapid IP rotation detected: ${uniqueIPs.size} different IPs in 1 hour`,\r\n          };\r\n        }\r\n      }\r\n\r\n      return { suspicious: false };\r\n\r\n    } catch (error) {\r\n      logger.error('IP spoofing detection failed', { error });\r\n      return { suspicious: false };\r\n    }\r\n  }\r\n\r\n  cleanup(): void {\r\n    if (!this.memoryFallback) {\r\n      return;\r\n    }\r\n    const now = Date.now();\r\n    for (const [key, info] of this.memoryFallback.entries()) {\r\n      if (now > info.resetTime) {\r\n        this.memoryFallback.delete(key);\r\n      }\r\n    }\r\n  }\r\n\r\n  async resetRateLimit(identifier: string): Promise<void> {\r\n    const pattern = `ratelimit:*:${identifier}*`;\r\n    try {\r\n      logger.info('Rate limit reset requested', { identifier, pattern });\r\n    } catch (error) {\r\n      logger.error('Failed to reset rate limit', { error, identifier });\r\n    }\r\n  }\r\n\r\n  async getStats(identifier: string): Promise<{\r\n    userLimit: { used: number; limit: number };\r\n    ipLimit?: { used: number; limit: number };\r\n  }> {\r\n    return {\r\n      userLimit: { used: 0, limit: 100 },\r\n    };\r\n  }\r\n}\r\n\r\nconst enhancedRateLimiterInstance = new EnhancedRateLimiter();\r\nexport default enhancedRateLimiterInstance;\r\n\r\nsetInterval(() => {\r\n  enhancedRateLimiterInstance.cleanup();\r\n}, 5 * 60 * 1000);\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\env-validator.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\input-validator.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":822,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":822,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[28092,28095],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[28092,28095],"tex