SERIAL_DEVICE = process.env.DEVICE_COMPANION_SERIAL_DEVICE || '/dev/ttyACM0';\nconst SERIAL_BAUD = String(process.env.DEVICE_COMPANION_SERIAL_BAUD || '115200');\nconst SERIAL_REOPEN_DELAY_MS = Number(process.env.DEVICE_COMPANION_SERIAL_REOPEN_DELAY_MS || 3000);\nconst HEARTBEAT_INTERVAL_MS = Number(process.env.DEVICE_COMPANION_HEARTBEAT_INTERVAL_MS || 5000);\nconst DEVICE_ID = process.env.DEVICE_COMPANION_DEVICE_ID || hostname();\nconst DEVICE_API_KEY = process.env.DEVICE_COMPANION_DEVICE_API_KEY || process.env.DEVICE_SMOKE_API_KEY || 'dev-device-key-2026';\nconst DEVICE_VERSION = process.env.DEVICE_COMPANION_DEVICE_VERSION || 'v1-companion';\nconst CHIP_MODEL = process.env.DEVICE_COMPANION_CHIP_MODEL || 'ESP32-S3-WROOM-1';\nconst SDK_VERSION = process.env.DEVICE_COMPANION_SDK_VERSION || 'aetherguard-companion';\nconst DEVICE_FLASH_SIZE = Number(process.env.DEVICE_COMPANION_FLASH_SIZE || 8 * 1024 * 1024);\nconst PUBLIC_KEY_FILE = process.env.DEVICE_COMPANION_PUBLIC_KEY_FILE || '';\n\nconst DEFAULT_BACKUP_CMD = process.env.AETHERGUARD_BACKUP_CMD || 'ts=$(date +%Y%m%d%H%M%S); backup_dir=/tmp/aetherguard_backup_$ts; mkdir -p \"$backup_dir\" && tar -czf \"$backup_dir/etc_aetherguard.tgz\" /etc/AetherGuard /etc/hosts 2>/dev/null';\nconst DEFAULT_INSTALL_CMD = process.env.AETHERGUARD_INSTALL_CMD || '';\nconst DEFAULT_REMOVE_CMD = process.env.AETHERGUARD_REMOVE_CMD || 'rm -rf /opt/AetherGuard';\nconst DEFAULT_RECOVERY_FLASH_CMD = process.env.AETHERGUARD_RECOVERY_FLASH_CMD || '';\nconst DEFAULT_FACTORY_RESET_CMD = process.env.AETHERGUARD_FACTORY_RESET_CMD || '';\nconst DEFAULT_DIAGNOSTIC_UNLOCK_CMD = process.env.AETHERGUARD_DIAGNOSTIC_UNLOCK_CMD || '';\nconst DEFAULT_VEHICLE_OTA_FLASH_CMD = process.env.AETHERGUARD_VEHICLE_OTA_FLASH_CMD || '';\n\nlet socket: Socket | null = null;\nlet serialReader: Interface | null = null;\nlet serialWriter: NodeJS.WritableStream | null = null;\nlet heartbeatTimer: NodeJS.Timeout | null = null;\nlet serialReconnectTimer: NodeJS.Timeout | null = null;\nlet isRegistered = false;\n\nconst boardState: BoardState = {\n  version: DEVICE_VERSION,\n  chipModel: CHIP_MODEL,\n  flashSize: DEVICE_FLASH_SIZE,\n  freeHeap: 196608,\n  sdkVersion: SDK_VERSION,\n  cpuUsage: 4,\n  memoryUsage: 18,\n  uptime: 0,\n  transport: 'usb_serial',\n  externalPowerPresent: false,\n  secureElementPresent: Boolean(PUBLIC_KEY_FILE),\n  pendingPhysicalApproval: false,\n  interlockState: 'disabled',\n  hostActionState: 'idle',\n  systemInfo: {\n    hostname: hostname(),\n    os: 'linux',\n    kernel: process.env.DEVICE_COMPANION_KERNEL || 'unknown',\n    arch: process.arch\n  },\n  physicalAuth: PUBLIC_KEY_FILE && existsSync(PUBLIC_KEY_FILE)\n    ? { publicKeyPem: readFileSync(PUBLIC_KEY_FILE, 'utf8') }\n    : undefined\n};\n\nfunction log(message: string, details?: Record<string, any>): void {\n  const suffix = details ? ` ${JSON.stringify(details)}` : '';\n  process.stdout.write(`[device-companion] ${message}${suffix}\\n`);\n}\n\nfunction configureSerialDevice(): Promise<void> {\n  return new Promise((resolve, reject) => {\n    const child = spawn('stty', [\n      '-F',\n      SERIAL_DEVICE,\n      SERIAL_BAUD,\n      'raw',\n      '-echo',\n      '-echoe',\n      '-echok',\n      '-echoctl',\n      '-echoke',\n      'cs8',\n      '-cstopb',\n      '-parenb',\n      '-ixon',\n      '-ixoff',\n      '-crtscts'\n    ], { stdio: 'ignore' });\n\n    child.once('exit', (code) => {\n      if (code === 0) {\n        resolve();\n        return;\n      }\n      reject(new Error(`stty exited with code ${code}`));\n    });\n    child.once('error', reject);\n  });\n}\n\nfunction writeSerialFrame(frame: SerialFrame): void {\n  if (!serialWriter) {\n    return;\n  }\n  serialWriter.write(`${JSON.stringify(frame)}\\n`);\n}\n\nfunction emitBoardSnapshot(): void {\n  if (!socket?.connected) {\n    return;\n  }\n\n  socket.emit('data', {\n    timestamp: new Date().toISOString(),\n    payload: {\n      transport: boardState.transport,\n      externalPowerPresent: boardState.externalPowerPresent,\n      secureElementPresent: boardState.secureElementPresent,\n      pendingPhysicalApproval: boardState.pendingPhysicalApproval,\n      interlockState: boardState.interlockState,\n      hostActionState: boardState.hostActionState,\n      systemInfo: boardState.systemInfo,\n      physicalAuth: boardState.physicalAuth,\n      freeHeap: boardState.freeHeap\n    }\n  });\n}\n\nfunction sendRegister(): void {\n  if (!socket?.connected || isRegistered) {\n    return;\n  }\n\n  socket.emit('register', {\n    device_id: DEVICE_ID,\n    version: boardState.version,\n    chip_model: boardState.chipModel,\n    flash_size: boardState.flashSize,\n    free_heap: boardState.freeHeap,\n    sdk_version: boardState.sdkVersion,\n    api_key: DEVICE_API_KEY\n  });\n}\n\nfunction emitHeartbeat(): void {\n  if (!socket?.connected || !isRegistered) {\n    return;\n  }\n\n  boardState.uptime += Math.max(1, Math.floor(HEARTBEAT_INTERVAL_MS / 1000));\n  socket.emit('heartbeat', {\n    cpu_usage: boardState.cpuUsage,\n    memory_usage: boardState.memoryUsage,\n    uptime: boardState.uptime,\n    wifi_rssi: 0,\n    free_heap: boardState.freeHeap\n  });\n}\n\nfunction ensureHeartbeat(): void {\n  if (heartbeatTimer) {\n    clearInterval(heartbeatTimer);\n  }\n  heartbeatTimer = setInterval(() => emitHeartbeat(), HEARTBEAT_INTERVAL_MS);\n}\n\nfunction getHostActionCommand(action: HostActionName): string {\n  switch (action) {\n    case 'host_backup':\n      return DEFAULT_BACKUP_CMD;\n    case 'host_install':\n      return DEFAULT_INSTALL_CMD;\n    case 'host_remove':\n      return DEFAULT_REMOVE_CMD;\n    case 'recovery_flash':\n      return DEFAULT_RECOVERY_FLASH_CMD;\n    case 'factory_reset':\n      return DEFAULT_FACTORY_RESET_CMD;\n    case 'diagnostic_unlock':\n      return DEFAULT_DIAGNOSTIC_UNLOCK_CMD;\n    case 'vehicle_ota_flash':\n      return DEFAULT_VEHICLE_OTA_FLASH_CMD;\n    default:\n      return '';\n  }\n}\n\nfunction runHostAction(action: HostActionName, params?: Record<string, any>): void {\n  const command = getHostActionCommand(action);\n  if (!command) {\n    socket?.emit('alert', {\n      alert_type: 'host_action_unconfigured',\n      message: `${action} is not configured on this host`,\n      timestamp: new Date().toISOString()\n    });\n    return;\n  }\n\n  boardState.hostActionState = 'running';\n  emitBoardSnapshot();\n\n  const child = spawn('bash', ['-lc', command], {\n    env: {\n      ...process.env,\n      AETHERGUARD_ACTION: action,\n      AETHERGUARD_ACTION_PARAMS: JSON.stringify(params || {})\n    }\n  });\n\n  const output: string[] = [];\n  child.stdout.on('data', (data) => output.push(String(data)));\n  child.stderr.on('data', (data) => output.push(String(data)));\n  child.once('exit', (code) => {\n    const success = code === 0;\n    boardState.hostActionState = success ? 'completed' : 'failed';\n    emitBoardSnapshot();\n    socket?.emit('data', {\n      timestamp: new Date().toISOString(),\n      payload: {\n        hostActionState: boardState.hostActionState,\n        lastHostAction: {\n          action,\n          success,\n          output: output.join('').slice(-4000)\n        }\n      }\n    });\n  });\n}\n\nfunction handleSocketCommand(rawPayload: Record<string, any>): void {\n  const command = rawPayload?.command && typeof rawPayload.command === 'object'\n    ? rawPayload.command\n    : rawPayload;\n  const commandType = String(command?.cmd || rawPayload?.cmd || '').trim();\n  const params = command?.params || rawPayload?.params || {};\n\n  if (!commandType) {\n    return;\n  }\n\n  if (commandType === 'physical_confirmation_required') {\n    boardState.pendingPhysicalApproval = true;\n    boardState.hostActionState = 'awaiting_confirmation';\n    emitBoardSnapshot();\n  }\n\n  if (['host_backup', 'host_install', 'host_remove', 'recovery_flash', 'factory_reset', 'diagnostic_unlock', 'vehicle_ota_flash'].includes(commandType)) {\n    runHostAction(commandType as HostActionName, params);\n    return;\n  }\n\n  if (commandType === 'cellular_breaker_assert') {\n    boardState.pendingPhysicalApproval = false;\n    boardState.interlockState = 'asserted';\n    boardState.hostActionState = 'completed';\n    emitBoardSnapshot();\n    socket?.emit('data', {\n      timestamp: new Date().toISOString(),\n      payload: {\n        interlockState: boardState.interlockState,\n        hostActionState: boardState.hostActionState,\n        cellularBreaker: 'asserted'\n      }\n    });\n    return;\n  }\n\n  if (commandType === 'cellular_breaker_release') {\n    boardState.pendingPhysicalApproval = false;\n    boardState.interlockState = boardState.externalPowerPresent ? 'armed' : 'disabled';\n    boardState.hostActionState = 'completed';\n    emitBoardSnapshot();\n    socket?.emit('data', {\n      timestamp: new Date().toISOString(),\n      payload: {\n        interlockState: boardState.interlockState,\n        hostActionState: boardState.hostActionState,\n        cellularBreaker: 'released'\n      }\n    });\n    return;\n  }\n\n  writeSerialFrame({\n    op: 'command',\n    deviceId: DEVICE_ID,\n    command: commandType,\n    params,\n    envelope: rawPayload\n  });\n}\n\nfunction updateBoardState(input: Record<string, any>): void {\n  const next = input.state && typeof input.state === 'object' ? input.state : input;\n  boardState.version = String(next.version || boardState.version);\n  boardState.chipModel = String(next.chipModel || next.chip_model || boardState.chipModel);\n  boardState.flashSize = Number(next.flashSize || next.flash_size || boardState.flashSize);\n  boardState.freeHeap = Number(next.freeHeap || next.free_heap || boardState.freeHeap);\n  boardState.sdkVersion = String(next.sdkVersion || next.sdk_version || boardState.sdkVersion);\n  boardState.externalPowerPresent = Boolean(next.externalPowerPresent ?? next.external_power_present ?? boardState.externalPowerPresent);\n  boardState.secureElementPresent = Boolean(next.secureElementPresent ?? next.secure_element_present ?? boardState.secureElementPresent);\n  boardState.pendingPhysicalApproval = Boolean(next.pendingPhysicalApproval ?? next.pending_physical_approval ?? boardState.pendingPhysicalApproval);\n  boardState.interlockState = String(next.interlockState || next.interlock_state || boardState.interlockState);\n  boardState.hostActionState = String(next.hostActionState || next.host_action_state || boardState.hostActionState);\n\n  const publicKeyPem = next.publicKeyPem || next.public_key_pem || next?.physicalAuth?.publicKeyPem || next?.physicalAuth?.public_key_pem;\n  const monotonicCounter = Number(next.monotonicCounter || next.monotonic_counter || next?.physicalAuth?.monotonicCounter || next?.physicalAuth?.monotonic_counter);\n  if (publicKeyPem || Number.isFinite(monotonicCounter)) {\n    boardState.physicalAuth = {\n      ...(boardState.physicalAuth || {}),\n      ...(publicKeyPem ? { publicKeyPem: String(publicKeyPem) } : {}),\n      ...(Number.isFinite(monotonicCounter) ? { monotonicCounter } : {})\n    };\n  }\n}\n\nfunction handleSerialFrame(frame: SerialFrame): void {\n  const op = String(frame?.op || '').trim();\n\n  switch (op) {\n    case 'hello':\n    case 'state':\n      updateBoardState(frame);\n      emitBoardSnapshot();\n      sendRegister();\n      break;\n    case 'heartbeat':\n      updateBoardState(frame);\n      boardState.cpuUsage = Number(frame.cpuUsage || frame.cpu_usage || boardState.cpuUsage);\n      boardState.memoryUsage = Number(frame.memoryUsage || frame.memory_usage || boardState.memoryUsage);\n      boardState.freeHeap = Number(frame.freeHeap || frame.free_heap || boardState.freeHeap);\n      emitHeartbeat();\n      emitBoardSnapshot();\n      break;\n    case 'telemetry':\n      updateBoardState(frame);\n      socket?.emit('data', {\n        timestamp: frame.timestamp || new Date().toISOString(),\n        payload: {\n          ...frame.payload,\n          transport: 'usb_serial',\n          externalPowerPresent: boardState.externalPowerPresent,\n          secureElementPresent: boardState.secureElementPresent,\n          pendingPhysicalApproval: boardState.pendingPhysicalApproval,\n          interlockState: boardState.interlockState,\n          hostActionState: boardState.hostActionState,\n          systemInfo: boardState.systemInfo,\n          physicalAuth: boardState.physicalAuth\n        }\n      });\n      break;\n    case 'alert':\n      socket?.emit('alert', {\n        alert_type: frame.alert_type || frame.alertType || 'board_alert',\n        message: frame.message || 'Board alert',\n        timestamp: frame.timestamp || new Date().toISOString()\n      });\n      break;\n    case 'ota_status':\n      socket?.emit('ota_status', {\n        ...frame,\n        timestamp: frame.timestamp || new Date().toISOString()\n      });\n      break;\n    case 'physical_confirmation_ack':\n      boardState.pendingPhysicalApproval = false;\n      boardState.hostActionState = Boolean(frame.confirmed) ? 'running' : 'failed';\n      updateBoardState(frame);\n      emitBoardSnapshot();\n      socket?.emit('physical_confirmation_ack', {\n        ...frame,\n        confirmationSessionId: frame.confirmationSessionId,\n        timestamp: frame.timestamp || Date.now()\n      });\n      break;\n    default:\n      log('ignored serial frame', { op });\n      break;\n  }\n}\n\nfunction scheduleSerialReconnect(): void {\n  if (serialReconnectTimer) {\n    return;\n  }\n  serialReconnectTimer = setTimeout(() => {\n    serialReconnectTimer = null;\n    void openSerial();\n  }, SERIAL_REOPEN_DELAY_MS);\n}\n\nasync function openSerial(): Promise<void> {\n  if (!existsSync(SERIAL_DEVICE)) {\n    log('serial device not present', { serialDevice: SERIAL_DEVICE });\n    scheduleSerialReconnect();\n    return;\n  }\n\n  try {\n    await configureSerialDevice();\n  } catch (error: any) {\n    log('failed to configure serial device', { message: error?.message || String(error) });\n    scheduleSerialReconnect();\n    return;\n  }\n\n  const readStream = createReadStream(SERIAL_DEVICE, { flags: 'r+' });\n  const writeStream = createWriteStream(SERIAL_DEVICE, { flags: 'r+' });\n  serialWriter = writeStream;\n  serialReader = createInterface({ input: readStream, crlfDelay: Infinity });\n\n  serialReader.on('line', (line) => {\n    const trimmed = line.trim();\n    if (!trimmed) {\n      return;\n    }\n    try {\n      handleSerialFrame(JSON.parse(trimmed));\n    } catch (error: any) {\n      log('failed to parse serial frame', { line: trimmed, message: error?.message || String(error) });\n    }\n  });\n\n  readStream.on('error', () => scheduleSerialReconnect());\n  writeStream.on('error', () => scheduleSerialReconnect());\n  readStream.on('close', () => scheduleSerialReconnect());\n\n  writeSerialFrame({\n    op: 'hello',\n    deviceId: DEVICE_ID,\n    request: 'state'\n  });\n  log('serial link opened', { serialDevice: SERIAL_DEVICE, serialBaud: SERIAL_BAUD });\n}\n\nfunction connectSocket(): void {\n  socket = io(CONTROL_PLANE_URL, {\n    path: DEVICE_GATEWAY_PATH,\n    transports: ['websocket'],\n    reconnection: true,\n    reconnectionDelay: 2000,\n    reconnectionDelayMax: 8000\n  });\n\n  socket.on('connect', () => {\n    isRegistered = false;\n    sendRegister();\n    emitBoardSnapshot();\n    log('connected to control plane', { url: CONTROL_PLANE_URL, path: DEVICE_GATEWAY_PATH });\n  });\n\n  socket.on('register_success', () => {\n    isRegistered = true;\n    emitBoardSnapshot();\n    emitHeartbeat();\n  });\n\n  socket.on('register_error', (payload) => {\n    log('registration failed', payload);\n  });\n\n  socket.on('command', (payload) => handleSocketCommand(payload));\n  socket.on('disconnect', (reason) => {\n    isRegistered = false;\n    log('control plane disconnected', { reason });\n  });\n  socket.on('connect_error', (error) => {\n    log('control plane connection error', { message: error.message });\n  });\n}\n\nasync function main(): Promise<void> {\n  connectSocket();\n  ensureHeartbeat();\n  await openSerial();\n}\n\nprocess.on('SIGINT', () => process.exit(0));\nprocess.on('SIGTERM', () => process.exit(0));\n\nvoid main();\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\app-mode.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\database.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\platform-runtime.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\runtime-capabilities.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\config\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\core\\health\\runtime-health.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":15,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn"