onse<any, Record<string, any>>` from function with return type `Response<ApiSuccessEnvelope<T>, Record<string, any>>`.","line":48,"column":3,"nodeType":"ReturnStatement","messageId":"unsafeReturnAssignment","endLine":48,"endColumn":44},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":57,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":57,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1121,1124],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1121,1124],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of type `Response<any, Record<string, any>>` from function with return type `Response<ApiErrorEnvelope, Record<string, any>>`.","line":73,"column":3,"nodeType":"ReturnStatement","messageId":"unsafeReturnAssignment","endLine":73,"endColumn":44}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Response } from 'express';\r\n\r\nexport interface ApiSuccessEnvelope<T> {\r\n  success: true;\r\n  data: T;\r\n  error: null;\r\n  meta?: Record<string, any>;\r\n}\r\n\r\nexport interface ApiErrorDetails {\r\n  code: string;\r\n  message: string;\r\n  details?: unknown;\r\n}\r\n\r\nexport interface ApiErrorEnvelope {\r\n  success: false;\r\n  data: null;\r\n  error: ApiErrorDetails;\r\n  meta?: Record<string, any>;\r\n}\r\n\r\ninterface ResponseOptions {\r\n  meta?: Record<string, any>;\r\n  legacy?: Record<string, any>;\r\n}\r\n\r\nexport function sendSuccess<T>(\r\n  res: Response,\r\n  data: T,\r\n  options: ResponseOptions = {},\r\n  statusCode = 200\r\n): Response<ApiSuccessEnvelope<T>> {\r\n  const body: Record<string, any> = {\r\n    success: true,\r\n    data,\r\n    error: null\r\n  };\r\n\r\n  if (options.meta) {\r\n    body.meta = options.meta;\r\n  }\r\n\r\n  if (options.legacy) {\r\n    Object.assign(body, options.legacy);\r\n  }\r\n\r\n  return res.status(statusCode).json(body);\r\n}\r\n\r\nexport function sendError(\r\n  res: Response,\r\n  statusCode: number,\r\n  error: ApiErrorDetails,\r\n  options: ResponseOptions = {}\r\n): Response<ApiErrorEnvelope> {\r\n  const body: Record<string, any> = {\r\n    success: false,\r\n    data: null,\r\n    error,\r\n    code: error.code,\r\n    message: error.message\r\n  };\r\n\r\n  if (options.meta) {\r\n    body.meta = options.meta;\r\n  }\r\n\r\n  if (options.legacy) {\r\n    Object.assign(body, options.legacy);\r\n  }\r\n\r\n  return res.status(statusCode).json(body);\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\core\\tenant\\tenant-context.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":19,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":22,"endColumn":23},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tenantId on an `any` value.","line":22,"column":15,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":22,"endColumn":23}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { AuthenticatedRequest, AuthenticatedUser } from '../../middleware/auth.middleware';\r\n\r\nexport const PLATFORM_TENANT_ID = 'platform';\r\n\r\nexport type TenantSource =\r\n  | 'user'\r\n  | 'request'\r\n  | 'agent'\r\n  | 'device'\r\n  | 'platform';\r\n\r\nexport interface TenantContext {\r\n  tenantId: string;\r\n  source: TenantSource;\r\n  reason?: string;\r\n}\r\n\r\nfunction readRequestedTenantId(req: AuthenticatedRequest): string | undefined {\r\n  const rawValue =\r\n    req.params?.tenantId ||\r\n    req.query?.tenantId ||\r\n    req.body?.tenantId;\r\n\r\n  if (typeof rawValue !== 'string') {\r\n    return undefined;\r\n  }\r\n\r\n  const normalized = rawValue.trim();\r\n  return normalized || undefined;\r\n}\r\n\r\nexport function normalizeTenantId(value?: string | null): string | undefined {\r\n  if (typeof value !== 'string') {\r\n    return undefined;\r\n  }\r\n\r\n  const normalized = value.trim();\r\n  return normalized || undefined;\r\n}\r\n\r\nexport function buildPlatformTenantContext(reason: string): TenantContext {\r\n  return {\r\n    tenantId: PLATFORM_TENANT_ID,\r\n    source: 'platform',\r\n    reason\r\n  };\r\n}\r\n\r\nexport function resolveUserTenantContext(\r\n  user: AuthenticatedUser | undefined,\r\n  options: {\r\n    requestedTenantId?: string;\r\n    allowAdminPlatformFallback?: boolean;\r\n  } = {}\r\n): TenantContext | null {\r\n  if (!user) {\r\n    return null;\r\n  }\r\n\r\n  const requestedTenantId = normalizeTenantId(options.requestedTenantId);\r\n  if (requestedTenantId) {\r\n    return {\r\n      tenantId: requestedTenantId,\r\n      source: 'request'\r\n    };\r\n  }\r\n\r\n  const userTenantId = normalizeTenantId(user.tenantId);\r\n  if (userTenantId) {\r\n    return {\r\n      tenantId: userTenantId,\r\n      source: 'user'\r\n    };\r\n  }\r\n\r\n  if (user.role === 'admin' && options.allowAdminPlatformFallback) {\r\n    return buildPlatformTenantContext('admin-platform-fallback');\r\n  }\r\n\r\n  return null;\r\n}\r\n\r\nexport function resolveRequestTenantContext(\r\n  req: AuthenticatedRequest,\r\n  options: {\r\n    allowAdminPlatformFallback?: boolean;\r\n  } = {}\r\n): TenantContext | null {\r\n  if (req.tenantContext) {\r\n    return req.tenantContext;\r\n  }\r\n\r\n  const context = resolveUserTenantContext(req.user, {\r\n    requestedTenantId: readRequestedTenantId(req),\r\n    allowAdminPlatformFallback: options.allowAdminPlatformFallback\r\n  });\r\n\r\n  if (context) {\r\n    req.tenantContext = context;\r\n  }\r\n\r\n  return context;\r\n}\r\n\r\nexport function resolveAgentTenantContext(\r\n  tenantId: string | undefined,\r\n  reason = 'agent-connection'\r\n): TenantContext | null {\r\n  const normalized = normalizeTenantId(tenantId);\r\n  if (!normalized) {\r\n    return null;\r\n  }\r\n\r\n  return {\r\n    tenantId: normalized,\r\n    source: 'agent',\r\n    reason\r\n  };\r\n}\r\n\r\nexport function resolveDeviceTenantContext(explicitTenantId?: string): TenantContext {\r\n  const normalized = normalizeTenantId(explicitTenantId);\r\n  if (normalized) {\r\n    return {\r\n      tenantId: normalized,\r\n      source: 'device'\r\n    };\r\n  }\r\n\r\n  return buildPlatformTenantContext('device-platform-scope');\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\database\\init.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":57,"column":31,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":57,"endColumn":34,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1505,1508],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1505,1508],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":58,"column":26,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":58,"endColumn":91},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":58,"column":26,"nodeType":"MemberExpression","messageId":"unsafeC