ny","severity":2,"message":"Unexpected any. Specify a different type.","line":182,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":182,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7047,7050],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7047,7050],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .isOnline on an `any` value.","line":182,"column":70,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":182,"endColumn":78},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":190,"column":69,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":190,"endColumn":72,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7657,7660],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7657,7660],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .last_activity on an `any` value.","line":191,"column":44,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":191,"endColumn":57},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .lastActivity on an `any` value.","line":191,"column":66,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":191,"endColumn":78},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":203,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":203,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8434,8437],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8434,8437],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":11,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Stats Routes\r\n * SECURITY FIX CVE-2026-039: Added authentication middleware\r\n */\r\nimport { Router } from 'express';\r\nimport { authenticate, AuthenticatedRequest } from '../../middleware/auth.middleware';\r\nimport { getTrafficStats, getAgentGateway, getAgentSystem } from './ai-system.routes';\r\nimport { getAlerts } from './alerts.routes';\r\nimport { getDeviceList } from './devices.routes';\r\nimport { SystemStats } from '../../utils/system-stats';\r\nimport { securityOperationsService } from '../../services/security-operations.service';\r\n\r\nconst router = Router();\r\n\r\n// Rolling history: keep last 20 data points (sampled on each request)\r\ninterface HistoryPoint {\r\n    time: string;\r\n    requests: number;\r\n    blocked: number;\r\n}\r\n\r\nconst historyBuffer: HistoryPoint[] = [];\r\nlet lastSampledRequests = 0;\r\nlet lastSampledBlocked = 0;\r\nlet lastSampleTime = Date.now();\r\n\r\nfunction sampleHistory(total: number, blocked: number): void {\r\n    const now = Date.now();\r\n    // Only add a new point if at least 2 seconds have passed\r\n    if (now - lastSampleTime < 2000) return;\r\n\r\n    const label = new Date().toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });\r\n    historyBuffer.push({\r\n        time: label,\r\n        requests: total - lastSampledRequests,\r\n        blocked: blocked - lastSampledBlocked\r\n    });\r\n\r\n    if (historyBuffer.length > 20) {\r\n        historyBuffer.shift();\r\n    }\r\n\r\n    lastSampledRequests = total;\r\n    lastSampledBlocked = blocked;\r\n    lastSampleTime = now;\r\n}\r\n\r\n// SECURITY FIX CVE-2026-039: Apply authentication\r\nrouter.use(authenticate);\r\n\r\nrouter.get('/', async (req: AuthenticatedRequest, res) => {\r\n    try {\r\n        const ts = getTrafficStats();\r\n\r\n        const total = ts.packetsProcessed;\r\n        const blocked = ts.packetsBlocked;\r\n        const allowed = ts.packetsAllowed;\r\n\r\n        // Update rolling history\r\n        sampleHistory(total, blocked);\r\n\r\n        // Dynamic Global Health Score calculation\r\n        let successRate = total > 0 ? Math.round((allowed / total) * 100) : 100;\r\n\r\n        // Adjust health based on system alerts and offline devices\r\n        const agentGateway = getAgentSystem() as any;\r\n        const tenantId = req.user?.tenantId || 'global';\r\n        const alerts = (await getAlerts(tenantId)).filter(a => a.status !== 'resolved' && a.status !== 'suppressed');\r\n        const devices = getDeviceList();\r\n        const opsSummary = await securityOperationsService.getDashboardSummaryView(tenantId);\r\n\r\n        const offlineDevices = devices.filter(d => !d.isOnline).length;\r\n        const totalDevices = devices.length;\r\n\r\n        if (alerts.length > 0) {\r\n            successRate = Math.max(0, successRate - (alerts.length * 2));\r\n        }\r\n        if (totalDevices > 0) {\r\n            const deviceHealthImpact = (offlineDevices / totalDevices) * 15;\r\n            successRate = Math.max(0, Math.round(successRate - deviceHealthImpact));\r\n        }\r\n\r\n        // Average processing time estimate (ms)\r\n        const avgProcessingTime = total > 0\r\n            ? Math.max(1, Math.floor(ts.bytesProcessed / total / 100))\r\n            : 0;\r\n\r\n        // Attack origins derived from threat categories\r\n        const threatEntries = Array.from(ts.threats.values());\r\n        const totalThreats = threatEntries.reduce((sum, t) => sum + t.count, 0);\r\n        const attackOrigins = threatEntries.map(t => ({\r\n            country: t.type,\r\n            countryCode: 'Unknown',\r\n            count: t.count,\r\n            percentage: totalThreats > 0 ? (t.count / totalThreats) * 100 : 0\r\n        }));\r\n\r\n        let requestsTrend = 0;\r\n        let blockedTrend = 0;\r\n        if (historyBuffer.length >= 2) {\r\n            const older = historyBuffer.slice(0, Math.floor(historyBuffer.length / 2));\r\n            const newer = historyBuffer.slice(Math.floor(historyBuffer.length / 2));\r\n            const oldReq = older.reduce((a, b) => a + b.requests, 0) || 1;\r\n            const newReq = newer.reduce((a, b) => a + b.requests, 0);\r\n            const oldBlk = older.reduce((a, b) => a + b.blocked, 0) || 1;\r\n            const newBlk = newer.reduce((a, b) => a + b.blocked, 0);\r\n            requestsTrend = parseFloat((((newReq - oldReq) / oldReq) * 100).toFixed(1));\r\n            blockedTrend = parseFloat((((newBlk - oldBlk) / oldBlk) * 100).toFixed(1));\r\n        }\r\n        // Simulate P99 latency dynamically using system load\r\n        const cpuOverhead = ts.activeFlows.length > 0 ? (ts.activeFlows.length * 0.5) : 0;\r\n        const p99Latency = Math.round(Math.max(avgProcessingTime * 1.5, avgProcessingTime + cpuOverhead + Math.random() * 5));\r\n\r\n        const sys = SystemStats.getInstance();\r\n\r\n        res.json({\r\n            totalRequests: total,\r\n            blockedRequests: blocked,\r\n            activeConnections: ts.activeFlows.filter((f: any) => f.state === 'ESTABLISHED').length,\r\n            successRate,\r\n            avgProcessingTime,\r\n            currentRPS: 0,\r\n            history: historyBuffer,\r\n            attackOrigins,\r\n            threats: threatEntries,\r\n            requestsTrend,\r\n            blockedTrend,\r\n            p99Latency,\r\n            cpuUsage: sys.cpuUsage,\r\n            memoryUsage: sys.memoryUsage,\r\n            diskUsage: sys.diskUsage,\r\n            networkUsage: sys.networkUsageMb,\r\n            securityOperations: opsSummary\r\n        });\r\n    } catch (err: any) {\r\n        res.json({\r\n            totalRequests: 0,\r\n            blockedRequests: 0,\r\n            activeConnections: 0,\r\n            successRate: 100,\r\n            avgProcessingTime: 0,\r\n            currentRPS: 0,\r\n            history: [],\r\n            attackOrigins: [],\r\n            threats: [],\r\n            requestsTrend: 0,\r\n            blockedTrend: 0,\r\n            p99Latency: 0,\r\n            cpuUsage: 0,\r\n            memoryUsage: 0,\r\n            diskUsage: 0,\r\n            networkUsage: 0,\r\n            securityOperations: {\r\n                openCriticalFindings: 0,\r\n                highRiskFindings: 0,\r\n                activeAlerts: 0,\r\n                runningScans: 0,\r\n                queuedScans: 0,\r\n                pendingActions: 0,\r\n                failedValidations: 0,\r\n                assetsAtRisk: 0,\r\n                observedSessions: 0,\r\n                trafficAnomalies: 0,\r\n                recentActions: [],\r\n                recentValidations: []\r\n            }\r\n        });\r\n    }\r\n});\r\n\r\nrouter.get('/badges', async (req: AuthenticatedRequest, res) => {\r\n    try {\r\n        const tenantId = req.user?.tenantId || 'global';\r\n        const alerts = await getAlerts(tenantId);\r\n        const activeAlertsCount = alerts.filter(a => a.status !== 'resolved' && a.status !== 'suppressed').length;\r\n\r\n        const devices = getDeviceList();\r\n        const onlineDevicesCount = devices.filter(d => d.isOnline).length;\r\n\r\n        const agentSystem = getAgentSystem();\r\n        const runtimeAgents = getAgentGateway()?.getAgentList?.() || [];\r\n        let agentsCount = runtimeAgents.filter((agent: any) => agent.isOnline).length;\r\n        if (agentSystem && agentSystem.isInitialized()) {\r\n            const probeReport = agentSystem.getProbeReport();\r\n            agentsCount = Math.max(agentsCount, probeReport.agents?.length || 0);\r\n        }\r\n        const summary = await securityOperationsService.getDashboardSummaryView(tenantId);\r\n        const trafficThreats = await securityOperationsService.summarizeThreatsView(tenantId);\r\n        const trafficSessions = await securityOperationsService.listTrafficSessionsView(tenantId, 200);\r\n        const recentTrafficSessions = trafficSessions.filter((flow: any) => {\r\n            const activity = new Date(flow.last_activity || flow.lastActivity || 0).getTime();\r\n            return Number.isFinite(activity) && Date.now() - activity <= 24 * 60 * 60 * 1000;\r\n        }).length;\r\n\r\n        res.json({\r\n            alerts: activeAlertsCount,\r\n            devices: onlineDevicesCount,\r\n            agents: agentsCount,\r\n            agentMonitor: summary.runningScans + summary.pendingActions + summary.failedValidations + summary.queuedScans + summary.trafficAnomalies,\r\n            traffic: Math.max(summary.trafficAnomalies, recentTrafficSessions, trafficThreats.reduce((sum, item) => sum + item.count, 0)),\r\n            scanner: summary.runningScans + summary.highRiskFindings + summary.pendingActions\r\n        });\r\n    } catch (err: any) {\r\n        res.json({ alerts: 0, devices: 0, agents: 0, agentMonitor: 0, traffic: 0, scanner: 0 });\r\n    }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\system.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":25,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":25,"endColumn":82},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":72,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":72,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2536,2539],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2536,2539],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":78,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":78,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":82,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":82,"endColumn":29},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":82,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":82,"endColumn":29}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Router } from 'express';\r\nimport { authenticate, AuthenticatedRequest, optionalAuth, requireRole } from '../../middleware/auth.middleware';\r\nimport { getAppMode, setAppMode, isDemoMode, isAttackSimulatorEnabled, AppMode } from '../../config/app-mode';\r\nimport { sendError, sendSuccess } from '../../core/http/api-response';\r\nimport logger from '../../utils/logger';\r\nimport { getRuntimeCapabilities } from '../../config/runtime-capabilities';\r\n\r\nconst router = Router();\r\n\r\nrouter.get('/mode', optionalAuth, (req: AuthenticatedRequest, res) => {\r\n  const capabilities = getRuntimeCapabilities();\r\n  const payload = {\r\n    appMode: getAppMode(),\r\n    demoEnabled: isDemoMode(),\r\n    attackSimEnabled: isAttackSimulatorEnabled(),\r\n    canToggleMode: req.user?.role === 'admin',\r\n    devLoginEnabled: capabilities.devLoginEnabled,\r\n    profile: capabilities.profile,\r\n    dbMode: capabilities.dbMode\r\n  };\r\n  sendSuccess(res, payload, { legacy: payload });\r\n});\r\n\r\nrouter.post('/mode', authenticate, requireRole('admin'), async (req: AuthenticatedRequest, res) => {\r\n  const { appMode, seedDemoData = false, clearExisting = false } = req.body || {};\r\n  const targetMode = appMode as AppMode;\r\n\r\n  if (targetMode !== 'production' && targetMode !== 'demo') {\r\n    return sendError(res, 400, {\r\n      code: 'backend.invalid_app_mode',\r\n      message: 'appMode must be either \"production\" or \"demo\".'\r\n    });\r\n  }\r\n\r\n  const previousMode = getAppMode();\r\n  const capabilities = getRuntimeCapabilities();\r\n  if (previousMode === targetMode) {\r\n    const payload = {\r\n      appMode: getAppMode(),\r\n      demoEnabled: isDemoMode(),\r\n      attackSimEnabled: isAttackSimulatorEnabled(),\r\n      seeded: false,\r\n      devLoginEnabled: capabilities.devLoginEnabled,\r\n      profile: capabilities.profile,\r\n      dbMode: capabilities.dbMode\r\n    };\r\n    return sendSuccess(res, payload, { legacy: payload });\r\n  }\r\n\r\n  try {\r\n    setAppMode(targetMode);\r\n\r\n    logger.info('App mode switched', {\r\n      from: previousMode,\r\n      to: targetMode,\r\n      userId: req.user?.userId,\r\n      seedDemoData,\r\n      clearExisting,\r\n      isolatedDemoReadPath: true\r\n    });\r\n\r\n    const payload = {\r\n      appMode: getAppMode(),\r\n      demoEnabled: isDemoMode(),\r\n      attackSimEnabled: isAttackSimulatorEnabled(),\r\n      seeded: false,\r\n      devLoginEnabled: capabilities.devLoginEnabled,\r\n      profile: capabilities.profile,\r\n      dbMode: capabilities.dbMode\r\n    };\r\n    return sendSuccess(res, payload, { legacy: payload });\r\n  } catch (error: any) {\r\n    setAppMode(previousMode);\r\n    logger.error('Failed to switch app mode', {\r\n      from: previousMode,\r\n      to: targetMode,\r\n      userId: req.user?.userId,\r\n      error: error.message\r\n    });\r\n    return sendError(res, 500, {\r\n      code: 'backend.switch_app_mode_failed',\r\n      message: error.message\r\n    });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\traffic.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":26,"column":103,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":26,"endColumn":106,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1080,1083],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1080,1083],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .packet_count on an `any` value.","line":26,"column":129,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":26,"endColumn":141},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":30,"column":99,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":30,"endColumn":102,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1387,1390],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestN