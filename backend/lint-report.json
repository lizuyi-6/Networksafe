ne":170,"column":8,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":170,"endColumn":11},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":183,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":183,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":185,"column":5,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":185,"endColumn":11},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .run on an `any` value.","line":185,"column":8,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":185,"endColumn":11}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":20,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":23,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2002,2005],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2002,2005],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":38,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * Investigation Service\r\n *\r\n * Handles persistence and retrieval of investigation data.\r\n */\r\n\r\nimport Database, { Database as SqlJsDatabase } from 'better-sqlite3';\r\nimport {\r\n  BugReport,\r\n  InvestigationContext,\r\n  InvestigationResult\r\n} from '../ai-agents/investigation/types';\r\nimport { getDatabase, initDatabase } from '../config/database';\r\nimport logger from '../utils/logger';\r\n\r\nexport interface InvestigationRecord {\r\n  investigationId: string;\r\n  bugReportId: string;\r\n  bugReport: BugReport;\r\n  context: InvestigationContext;\r\n  result?: InvestigationResult;\r\n  createdAt: Date;\r\n  status: 'in_progress' | 'completed' | 'failed';\r\n}\r\n\r\ntype RawRow = Record<string, unknown>;\r\n\r\nexport class InvestigationService {\r\n  private initialized = false;\r\n  private initPromise: Promise<void> | null = null;\r\n\r\n  private async ensureInitialized(): Promise<void> {\r\n    if (this.initialized) {\r\n      return;\r\n    }\r\n\r\n    if (!this.initPromise) {\r\n      this.initPromise = this.initialize();\r\n    }\r\n\r\n    await this.initPromise;\r\n  }\r\n\r\n  private async initialize(): Promise<void> {\r\n    await initDatabase();\r\n    const db = this.getDb();\r\n\r\n    db.run(`\r\n      CREATE TABLE IF NOT EXISTS investigations (\r\n        investigation_id TEXT PRIMARY KEY,\r\n        bug_report_id TEXT NOT NULL,\r\n        bug_report TEXT NOT NULL,\r\n        context TEXT NOT NULL,\r\n        result TEXT,\r\n        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\r\n        status TEXT NOT NULL,\r\n        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\r\n      )\r\n    `);\r\n\r\n    db.run(`\r\n      CREATE INDEX IF NOT EXISTS idx_investigations_created_at\r\n      ON investigations(created_at)\r\n    `);\r\n\r\n    db.run(`\r\n      CREATE INDEX IF NOT EXISTS idx_investigations_status\r\n      ON investigations(status)\r\n    `);\r\n\r\n    this.persist();\r\n    this.initialized = true;\r\n    logger.info('InvestigationService storage initialized');\r\n  }\r\n\r\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\r\n  private getDb(): any {\r\n    return getDatabase().getDb();\r\n  }\r\n\r\n  private persist(): void {\r\n    getDatabase().save();\r\n  }\r\n\r\n  /**\r\n   * Save investigation to database\r\n   */\r\n  public async saveInvestigation(data: InvestigationRecord): Promise<void> {\r\n    await this.ensureInitialized();\r\n    const db = this.getDb();\r\n\r\n    db.run(\r\n      `\r\n      INSERT OR REPLACE INTO investigations\r\n      (investigation_id, bug_report_id, bug_report, context, result, created_at, status, updated_at)\r\n      VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))\r\n      `,\r\n      [\r\n        data.investigationId,\r\n        data.bugReportId,\r\n        JSON.stringify(data.bugReport),\r\n        JSON.stringify(data.context),\r\n        data.result ? JSON.stringify(data.result) : null,\r\n        data.createdAt.toISOString(),\r\n        data.status\r\n      ]\r\n    );\r\n\r\n    this.persist();\r\n    logger.info(`[InvestigationService] Saved investigation ${data.investigationId}`);\r\n  }\r\n\r\n  /**\r\n   * Get investigation by ID\r\n   */\r\n  public async getInvestigation(investigationId: string): Promise<InvestigationRecord | null> {\r\n    await this.ensureInitialized();\r\n    const db = this.getDb();\r\n    const stmt = db.prepare('SELECT * FROM investigations WHERE investigation_id = ? LIMIT 1');\r\n\r\n    stmt.bind([investigationId]);\r\n    const row = stmt.step() ? (stmt.getAsObject() as RawRow) : null;\r\n    stmt.free();\r\n\r\n    return row ? this.deserializeRow(row) : null;\r\n  }\r\n\r\n  /**\r\n   * Get investigation history\r\n   */\r\n  public async getInvestigationHistory(options: {\r\n    limit?: number;\r\n    offset?: number;\r\n    severity?: string;\r\n    category?: string;\r\n  }): Promise<{ investigations: InvestigationRecord[]; total: number }> {\r\n    await this.ensureInitialized();\r\n    const db = this.getDb();\r\n    const stmt = db.prepare('SELECT * FROM investigations ORDER BY created_at DESC');\r\n\r\n    const rows: InvestigationRecord[] = [];\r\n    while (stmt.step()) {\r\n      rows.push(this.deserializeRow(stmt.getAsObject() as RawRow));\r\n    }\r\n    stmt.free();\r\n\r\n    let filtered = rows;\r\n    if (options.severity) {\r\n      filtered = filtered.filter(r => r.bugReport.severity === options.severity);\r\n    }\r\n    if (options.category) {\r\n      filtered = filtered.filter(r => r.bugReport.category === options.category);\r\n    }\r\n\r\n    const total = filtered.length;\r\n    const offset = Math.max(0, options.offset || 0);\r\n    const limit = Math.max(1, options.limit || 50);\r\n    const investigations = filtered.slice(offset, offset + limit);\r\n\r\n    return { investigations, total };\r\n  }\r\n\r\n  /**\r\n   * Delete investigation\r\n   */\r\n  public async deleteInvestigation(investigationId: string): Promise<void> {\r\n    await this.ensureInitialized();\r\n    const db = this.getDb();\r\n\r\n    db.run('DELETE FROM investigations WHERE investigation_id = ?', [investigationId]);\r\n    this.persist();\r\n    logger.info(`[InvestigationService] Deleted investigation ${investigationId}`);\r\n  }\r\n\r\n  /**\r\n   * Update investigation status\r\n   */\r\n  public async updateInvestigationStatus(\r\n    investigationId: string,\r\n    status: 'in_progress' | 'completed' | 'failed'\r\n  ): Promise<void> {\r\n    await this.ensureInitialized();\r\n    const db = this.getDb();\r\n\r\n    db.run(\r\n      `\r\n      UPDATE investigations\r\n      SET status = ?, updated_at = datetime('now')\r\n      WHERE investigation_id = ?\r\n      `,\r\n      [status, investigationId]\r\n    );\r\n\r\n    this.persist();\r\n  }\r\n\r\n  /**\r\n   * Deserialize database row to InvestigationRecord\r\n   */\r\n  private deserializeRow(row: RawRow): InvestigationRecord {\r\n    const bugReport = this.parseJson<BugReport>(row.bug_report);\r\n    const context = this.parseJson<InvestigationContext>(row.context);\r\n    const result = this.parseJson<InvestigationResult | undefined>(row.result);\r\n\r\n    return {\r\n      investigationId: String(row.investigation_id || ''),\r\n      bugReportId: String(row.bug_report_id || bugReport?.id || ''),\r\n      bugReport,\r\n      context,\r\n      result,\r\n      createdAt: new Date(String(row.created_at || new Date().toISOString())),\r\n      status: this.parseStatus(row.status)\r\n    };\r\n  }\r\n\r\n  private parseStatus(status: unknown): 'in_progress' | 'completed' | 'failed' {\r\n    if (status === 'in_progress' || status === 'completed' || status === 'failed') {\r\n      return status;\r\n    }\r\n    return 'in_progress';\r\n  }\r\n\r\n  private parseJson<T>(value: unknown): T {\r\n    if (typeof value !== 'string' || value.length === 0) {\r\n      return {} as T;\r\n    }\r\n\r\n    try {\r\n      return JSON.parse(value) as T;\r\n    } catch {\r\n      return {} as T;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Flush pending changes; database lifecycle is owned by global DatabaseManager.\r\n   */\r\n  public close(): void {\r\n    if (!this.initialized) {\r\n      return;\r\n    }\r\n    this.persist();\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\services\\job-queue.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":35,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":35,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1053,1056],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1053,1056],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":39,"column":25,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":39,"endColumn":32},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":72,"column":23,"nodeType":"