g(item || '').trim())\n    .filter((item, index, list) => item && list.indexOf(item) === index);\n}\n\nfunction ensureRecord(value: unknown): Record<string, any> {\n  return value && typeof value === 'object' && !Array.isArray(value)\n    ? { ...(value as Record<string, any>) }\n    : {};\n}\n\nfunction emptyModuleFinops(raw?: Partial<EdgeFinopsModuleStats> | null): EdgeFinopsModuleStats {\n  const savedBytes = Math.max(0, Number(raw?.savedBytes || 0));\n  const savedMessages = Math.max(0, Number(raw?.savedMessages || 0));\n  return {\n    savedBytes,\n    savedMessages,\n    estimatedSavedMb: estimatedSavedMb(savedBytes),\n  };\n}\n\ninterface ProtocolModuleAdapter {\n  manifest: ProtocolModuleManifest;\n  defaultPolicy(): Record<string, any>;\n  emptyStats(): ProtocolModuleStats;\n  normalizePolicy(raw: any, fallback?: Record<string, any>): Record<string, any>;\n  reduceStats(current: ProtocolModuleStats, context: ProtocolObservationContext): ProtocolModuleStats;\n  finopsDelta(context: ProtocolObservationContext): EdgeFinopsModuleStats;\n  translateFindings(context: ProtocolObservationContext & { moduleStats: ProtocolModuleStats }): ProtocolFindingSignal[];\n}\n\nfunction emptyModuleStats(seed?: Partial<ProtocolModuleStats>): ProtocolModuleStats {\n  return {\n    evaluations: Math.max(0, Number(seed?.evaluations || 0)),\n    findings: Math.max(0, Number(seed?.findings || 0)),\n    counters: ensureRecord(seed?.counters),\n    findingsByCode: ensureRecord(seed?.findingsByCode),\n    lastEventAt: typeof seed?.lastEventAt === 'string' ? seed.lastEventAt : null,\n    lastFindingAt: typeof seed?.lastFindingAt === 'string' ? seed.lastFindingAt : null,\n  };\n}\n\nconst HTTP_PROTOCOL_ADAPTER: ProtocolModuleAdapter = {\n  manifest: BUILTIN_EDGE_AUTO_MODULE_MANIFESTS.find((item) => item.kind === 'protocol' && item.moduleId === 'http') as ProtocolModuleManifest,\n  defaultPolicy: () => ({}),\n  emptyStats: () => emptyModuleStats({\n    counters: {\n      blockedRequests: 0,\n    },\n  }),\n  normalizePolicy: () => ({}),\n  reduceStats: (current, context) => {\n    const next = emptyModuleStats(current);\n    next.evaluations += 1;\n    next.lastEventAt = context.timestamp || new Date().toISOString();\n    if (Array.isArray(context.response?.findings) && context.response?.findings.length > 0) {\n      next.findings += context.response.findings.length;\n      next.lastFindingAt = next.lastEventAt;\n      for (const finding of context.response.findings) {\n        next.findingsByCode[finding.code] = Number(next.findingsByCode[finding.code] || 0) + 1;\n      }\n    }\n    if (context.response?.verdict === 'block') {\n      next.counters.blockedRequests = Number(next.counters.blockedRequests || 0) + 1;\n    }\n    return next;\n  },\n  finopsDelta: () => emptyModuleFinops(),\n  translateFindings: () => [],\n};\n\nconst MQTT_PROTOCOL_ADAPTER: ProtocolModuleAdapter = {\n  manifest: BUILTIN_EDGE_AUTO_MODULE_MANIFESTS.find((item) => item.kind === 'protocol' && item.moduleId === 'mqtt') as ProtocolModuleManifest,\n  defaultPolicy: () => cloneJson(DEFAULT_AGENT_PROTOCOL_POLICY.modules.mqtt),\n  emptyStats: () => emptyModuleStats({\n    counters: {\n      messages: 0,\n      suppressedMessages: 0,\n      blockedMessages: 0,\n      savedBytes: 0,\n    },\n  }),\n  normalizePolicy: (raw, fallback = DEFAULT_AGENT_PROTOCOL_POLICY.modules.mqtt) => ({\n    relayEnabled: typeof raw?.relayEnabled === 'boolean' ? raw.relayEnabled : Boolean(raw?.mqttRelayEnabled ?? fallback.relayEnabled),\n    suppressHighFrequency: typeof raw?.suppressHighFrequency === 'boolean'\n      ? raw.suppressHighFrequency\n      : Boolean(raw?.mqttSuppressHighFrequency ?? fallback.suppressHighFrequency),\n    heartbeatTopics: uniqueStrings(raw?.heartbeatTopics ?? raw?.mqttHeartbeatTopics, fallback.heartbeatTopics),\n    heartbeatMinIntervalMs: clampNumber(\n      raw?.heartbeatMinIntervalMs ?? raw?.mqttHeartbeatMinIntervalMs,\n      Number(fallback.heartbeatMinIntervalMs || 1000),\n      100,\n      60000,\n    ),\n  }),\n  reduceStats: (current, context) => {\n    const next = emptyModuleStats(current);\n    next.evaluations += 1;\n    next.counters.messages = Number(next.counters.messages || 0) + 1;\n    next.lastEventAt = context.timestamp || new Date().toISOString();\n    if (context.response?.action === 'suppress') {\n      next.counters.suppressedMessages = Number(next.counters.suppressedMessages || 0) + Number(context.response.costMetrics?.suppressedMessages || 0);\n      next.counters.savedBytes = Number(next.counters.savedBytes || 0) + Number(context.response.costMetrics?.savedBytes || 0);\n    }\n    if (context.response?.action === 'block') {\n      next.counters.blockedMessages = Number(next.counters.blockedMessages || 0) + 1;\n    }\n    if (Array.isArray(context.response?.findings) && context.response.findings.length > 0) {\n      next.findings += context.response.findings.length;\n      next.lastFindingAt = next.lastEventAt;\n      for (const finding of context.response.findings) {\n        next.findingsByCode[finding.code] = Number(next.findingsByCode[finding.code] || 0) + 1;\n      }\n    }\n    return next;\n  },\n  finopsDelta: (context) => emptyModuleFinops({\n    savedBytes: Number(context.response?.costMetrics?.savedBytes || 0),\n    savedMessages: Number(context.response?.costMetrics?.suppressedMessages || 0),\n  }),\n  translateFindings: () => [],\n};\n\nconst ROS2_PROTOCOL_ADAPTER: ProtocolModuleAdapter = {\n  manifest: BUILTIN_EDGE_AUTO_MODULE_MANIFESTS.find((item) => item.kind === 'protocol' && item.moduleId === 'ros2_cyberrt') as ProtocolModuleManifest,\n  defaultPolicy: () => cloneJson(DEFAULT_AGENT_PROTOCOL_POLICY.modules.ros2_cyberrt),\n  emptyStats: () => emptyModuleStats({\n    counters: {\n      events: 0,\n      unauthorizedRpcFindings: 0,\n    },\n  }),\n  normalizePolicy: (raw, fallback = DEFAULT_AGENT_PROTOCOL_POLICY.modules.ros2_cyberrt) => ({\n    observerEnabled: typeof raw?.observerEnabled === 'boolean' ? raw.observerEnabled : Boolean(raw?.ros2ObserverEnabled ?? fallback.observerEnabled),\n    allowlist: uniqueStrings(raw?.allowlist ?? raw?.ros2Allowlist, fallback.allowlist),\n  }),\n  reduceStats: (current, context) => {\n    const next = emptyModuleStats(current);\n    next.evaluations += 1;\n    next.counters.events = Number(next.counters.events || 0) + 1;\n    next.lastEventAt = context.timestamp || new Date().toISOString();\n    if (Array.isArray(context.response?.findings) && context.response.findings.length > 0) {\n      next.findings += context.response.findings.length;\n      next.lastFindingAt = next.lastEventAt;\n      for (const finding of context.response.findings) {\n        next.findingsByCode[finding.code] = Number(next.findingsByCode[finding.code] || 0) + 1;\n        if (finding.code === 'unauthorized_vehicle_rpc') {\n          next.counters.unauthorizedRpcFindings = Number(next.counters.unauthorizedRpcFindings || 0) + 1;\n        }\n      }\n    }\n    return next;\n  },\n  finopsDelta: () => emptyModuleFinops(),\n  translateFindings: (context) => {\n    if (!Array.isArray(context.response?.findings) || !context.response.findings.some((finding) => finding.code === 'unauthorized_vehicle_rpc')) {\n      return [];\n    }\n    return [\n      {\n        code: 'unauthorized_vehicle_rpc',\n        severity: 'high',\n        title: 'Unauthorized vehicle RPC observed',\n        description: 'ROS2 / Cyber RT observer detected a vehicle RPC outside the configured allowlist.',\n        category: 'vehicle-rpc',\n        fingerprint: `ros2:${String(context.channel || 'unknown')}:unauthorized_vehicle_rpc`,\n        createAlert: true,\n        alertType: 'security',\n        remediationTitle: 'Restrict ROS2 / Cyber RT RPC exposure',\n        remediationOwner: 'vehicle-security',\n        remediationPriority: 'high',\n        remediationSteps: [\n          'Review the per-node allowlist configured for this ROS2 / Cyber RT observer.',\n          'Identify the process or app issuing the RPC and remove unintended access.',\n          'Keep the observer enabled until the unexpected publisher is fully isolated.',\n        ],\n      },\n    ];\n  },\n};\n\nclass ProtocolModuleRegistryService {\n  private readonly manifests = cloneJson(BUILTIN_EDGE_AUTO_MODULE_MANIFESTS);\n  private readonly protocolAdapters = new Map<string, ProtocolModuleAdapter>([\n    ['http', HTTP_PROTOCOL_ADAPTER],\n    ['mqtt', MQTT_PROTOCOL_ADAPTER],\n    ['ros2_cyberrt', ROS2_PROTOCOL_ADAPTER],\n  ]);\n\n  listManifests(kind?: EdgeAutoModuleKind): EdgeAutoModuleManifest[] {\n    return this.manifests\n      .filter((item) => !kind || item.kind === kind)\n      .map((item) => cloneJson(item));\n  }\n\n  listProtocolManifests(): ProtocolModuleManifest[] {\n    return this.listManifests('protocol') as ProtocolModuleManifest[];\n  }\n\n  getProtocolAdapter(moduleId: string): ProtocolModuleAdapter | undefined {\n    return this.protocolAdapters.get(moduleId);\n  }\n\n  getModuleIdForProtocol(protocol: string): string {\n    const normalized = String(protocol || '').trim().toLowerCase();\n    return this.protocolAdapters.has(normalized) ? normalized : normalized;\n  }\n\n  defaultProtocolPolicyEnvelope(): ProtocolModulePolicyEnvelope {\n    return cloneJson(DEFAULT_AGENT_PROTOCOL_POLICY);\n  }\n\n  normalizePolicyEnvelope(raw: any, fallback: ProtocolModulePolicyEnvelope = DEFAULT_AGENT_PROTOCOL_POLICY): ProtocolModulePolicyEnvelope {\n    const fallbackEnvelope = cloneJson(fallback);\n    const rawModules = ensureRecord(raw?.modules);\n    const modules: Record<string, Record<string, any>> = {};\n\n    for (const manifest of this.listProtocolManifests()) {\n      const adapter = this.getProtocolAdapter(manifest.moduleId);\n      if (!adapter) {\n        continue;\n      }\n      const source = ensureRecord(rawModules[manifest.moduleId]);\n      modules[manifest.moduleId] = adapter.normalizePolicy(\n        Object.keys(source).length > 0 ? source : raw,\n        ensureRecord(fallbackEnvelope.modules?.[manifest.moduleId]),\n      );\n    }\n\n    for (const [moduleId, value] of Object.entries(rawModules)) {\n      if (!(moduleId in modules)) {\n        modules[moduleId] = ensureRecord(value);\n      }\n    }\n\n    const envelope: ProtocolModulePolicyEnvelope = {\n      modules,\n      legacy: toLegacyProtocolPolicy({ modules }),\n    };\n\n    return envelope;\n  }\n\n  emptyStatsEnvelope(): ProtocolModuleStatsEnvelope {\n    return cloneJson(DEFAULT_AGENT_PROTOCOL_STATS);\n  }\n\n  normalizeStatsEnvelope(raw: any, fallback: ProtocolModuleStatsEnvelope = DEFAULT_AGENT_PROTOCOL_STATS): ProtocolModuleStatsEnvelope {\n    const fallbackEnvelope = cloneJson(fallback);\n    const rawModules = ensureRecord(raw?.modules);\n    const modules: Record<string, ProtocolModuleStats> = {};\n\n    for (const manifest of this.listProtocolManifests()) {\n      const adapter = this.getProtocolAdapter(manifest.moduleId);\n      const base = ensureRecord(rawModules[manifest.moduleId]);\n      modules[manifest.moduleId] = adapter\n        ? emptyModuleStats({\n            ...(fallbackEnvelope.modules?.[manifest.moduleId] || adapter.emptyStats()),\n            ...base,\n          })\n        : emptyModuleStats(base);\n    }\n\n    for (const [moduleId, value] of Object.entries(rawModules)) {\n      if (!(moduleId in modules)) {\n        modules[moduleId] = emptyModuleStats(value as Partial<ProtocolModuleStats>);\n      }\n    }\n\n    const envelope: ProtocolModuleStatsEnvelope = {\n      totalEvaluations: Math.max(0, Number(raw?.totalEvaluations ?? (fallbackEnvelope.totalEvaluations || 0))),\n      protocolErrors: Math.max(0, Number(raw?.protocolErrors ?? (fallbackEnvelope.protocolErrors || 0))),\n      modules,\n    };\n    envelope.legacy = toLegacyProtocolStats(envelope);\n    return envelope;\n  }\n\n  normalizeFinopsStats(raw: any, fallback: EdgeFinopsStats = DEFAULT_EDGE_FINOPS_STATS): EdgeFinopsStats {\n    const fallbackValue = cloneJson(fallback);\n    const rawModules = ensureRecord(raw?.modules);\n    const modules: Record<string, EdgeFinopsModuleStats> = {};\n\n    for (const manifest of this.listProtocolManifests()) {\n      modules[manifest.moduleId] = emptyModuleFinops({\n        ...(fallbackValue.modules?.[manifest.moduleId] || {}),\n        ...(ensureRecord(rawModules[manifest.moduleId]) || {}),\n      });\n    }\n\n    for (const [moduleId, value] of Object.entries(rawModules)) {\n      if (!(moduleId in modules)) {\n        modules[moduleId] = emptyModuleFinops(value as Partial<EdgeFinopsModuleStats>);\n      }\n    }\n\n    const savedBytes = Math.max(0, Number(raw?.savedBytes ?? (fallbackValue.savedBytes || 0)));\n    const savedMessages = Math.max(0, Number(raw?.savedMessages ?? (fallbackValue.savedMessages || 0)));\n    const computedSavedBytes = Object.values(modules).reduce((sum, item) => sum + item.savedBytes, 0);\n    const computedSavedMessages = Object.values(modules).reduce((sum, item) => sum + item.savedMessages, 0);\n\n    return {\n      savedBytes: savedBytes || computedSavedBytes,\n      savedMessages: savedMessages || computedSavedMessages,\n      estimatedSavedMb: estimatedSavedMb(savedBytes || computedSavedBytes),\n      modules,\n    };\n  }\n\n  applyObservation(\n    moduleId: string,\n    stats: ProtocolModuleStatsEnvelope,\n    finops: EdgeFinopsStats,\n    context: ProtocolObservationContext,\n  ): {\n    protocolStats: ProtocolModuleStatsEnvelope;\n    finopsStats: EdgeFinopsStats;\n    translatedFindings: ProtocolFindingSignal[];\n  } {\n    const normalizedStats = this.normalizeStatsEnvelope(stats);\n    const normalizedFinops = this.normalizeFinopsStats(finops);\n    const adapter = this.getProtocolAdapter(moduleId);\n\n    normalizedStats.totalEvaluations += 1;\n    if (!context.response) {\n      normalizedStats.protocolErrors += 1;\n      return {\n        protocolStats: this.normalizeStatsEnvelope(normalizedStats),\n        finopsStats: normalizedFinops,\n        translatedFindings: [],\n      };\n    }\n\n    const currentModuleStats = adapter\n      ? normalizedStats.modules[moduleId] || adapter.emptyStats()\n      : emptyModuleStats(normalizedStats.modules[moduleId]);\n    const nextModuleStats = adapter\n      ? adapter.reduceStats(currentModuleStats, context)\n      : emptyModuleStats({\n          ...currentModuleStats,\n          evaluations: Number(currentModuleStats.evaluations || 0) + 1,\n          lastEventAt: context.timestamp || new Date().toISOString(),\n        });\n\n    normalizedStats.modules[moduleId] = nextModuleStats;\n\n    const finopsDelta = adapter ? adapter.finopsDelta(context) : emptyModuleFinops();\n    const currentModuleFinops = normalizedFinops.modules[moduleId] || emptyModuleFinops();\n    normalizedFinops.modules[moduleId] = emptyModuleFinops({\n      savedBytes: currentModuleFinops.savedBytes + finopsDelta.savedBytes,\n      savedMessages: currentModuleFinops.savedMessages + finopsDelta.savedMessages,\n    });\n    normalizedFinops.savedBytes = Object.values(normalizedFinops.modules).reduce((sum, item) => sum + item.savedBytes, 0);\n    normalizedFinops.savedMessages = Object.values(normalizedFinops.modules).reduce((sum, item) => sum + item.savedMessages, 0);\n    normalizedFinops.estimatedSavedMb = estimatedSavedMb(normalizedFinops.savedBytes);\n\n    return {\n      protocolStats: this.normalizeStatsEnvelope(normalizedStats),\n      finopsStats: this.normalizeFinopsStats(normalizedFinops),\n      translatedFindings: adapter ? adapter.translateFindings({ ...context, moduleStats: nextModuleStats }) : [],\n    };\n  }\n\n  summarizeModules(\n    stats: ProtocolModuleStatsEnvelope,\n    finops: EdgeFinopsStats,\n  ): Record<string, EdgeAutoDashboardModuleSummary> {\n    const normalizedStats = this.normalizeStatsEnvelope(stats);\n    const normalizedFinops = this.normalizeFinopsStats(finops);\n    const summaries: Record<string, EdgeAutoDashboardModuleSummary> = {};\n\n    for (const manifest of this.listProtocolManifests()) {\n      const moduleStats = normalizedStats.modules[manifest.moduleId] || emptyModuleStats();\n      const moduleFinops = normalizedFinops.modules[manifest.moduleId] || emptyModuleFinops();\n      summaries[manifest.moduleId] = {\n        moduleId: manifest.moduleId,\n        evaluations: Number(moduleStats.evaluations || 0),\n        findings: Number(moduleStats.findings || 0),\n        counters: Object.entries(moduleStats.counters || {}).reduce<Record<string, number>>((acc, [key, value]) => {\n          acc[key] = Number(value || 0);\n          return acc;\n        }, {}),\n        savedBytes: Number(moduleFinops.savedBytes || 0),\n        savedMessages: Number(moduleFinops.savedMessages || 0),\n        estimatedSavedMb: Number(moduleFinops.estimatedSavedMb || 0),\n        lastEventAt: moduleStats.lastEventAt || null,\n        lastFindingAt: moduleStats.lastFindingAt || null,\n      };\n    }\n\n    return summaries;\n  }\n}\n\nexport const protocolModuleRegistryService = new ProtocolModuleRegistryService();\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\services\\runtime-emulator.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":490,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":490,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[13806,13809],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[13806,13809],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of type `any[]` to a variable of type `JsonObject[]`.","line":576,"c