y`.","line":79,"column":7,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":79,"endColumn":44},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .content on an `any` value.","line":79,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":79,"endColumn":35},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":80,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":80,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2042,2045],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2042,2045],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .response on an `any` value.","line":81,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":81,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":81,"column":75,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":81,"endColumn":82},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":133,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":133,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3277,3280],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3277,3280],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":136,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":136,"endColumn":52},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":136,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":136,"endColumn":29}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import axios from 'axios';\r\n\r\n/**\r\n * Zhipu AI (BigModel) Client\r\n * GLM-4 series models\r\n */\r\n\r\nexport class ZhipuClient {\r\n  private apiKey: string;\r\n  private baseURL: string;\r\n\r\n  constructor(apiKey: string, baseURL: string = 'https://open.bigmodel.cn/api/anthropic') {\r\n    this.apiKey = apiKey;\r\n    this.baseURL = baseURL;\r\n  }\r\n\r\n  /**\r\n   * Generate completion using GLM model\r\n   */\r\n  async generateCompletion(prompt: string, model: string = 'glm-4'): Promise<string> {\r\n    try {\r\n      const response = await axios.post(\r\n        `${this.baseURL}/v1/messages`,\r\n        {\r\n          model: model,\r\n          max_tokens: 2000,\r\n          messages: [\r\n            {\r\n              role: 'user',\r\n              content: prompt\r\n            }\r\n          ]\r\n        },\r\n        {\r\n          headers: {\r\n            'Authorization': `Bearer ${this.apiKey}`,\r\n            'Content-Type': 'application/json'\r\n          },\r\n          timeout: 60000 // 60 seconds timeout\r\n        }\r\n      );\r\n\r\n      // Extract response text\r\n      if (response.data && response.data.content && response.data.content[0]) {\r\n        return response.data.content[0].text;\r\n      }\r\n\r\n      throw new Error('Invalid response format from Zhipu AI');\r\n    } catch (error: any) {\r\n      console.error('Zhipu AI API error:', error.response?.data || error.message);\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Chat completion with conversation history\r\n   */\r\n  async chatCompletion(\r\n    messages: Array<{ role: string; content: string }>,\r\n    model: string = 'glm-4'\r\n  ): Promise<string> {\r\n    try {\r\n      const response = await axios.post(\r\n        `${this.baseURL}/v1/messages`,\r\n        {\r\n          model: model,\r\n          max_tokens: 2000,\r\n          messages: messages\r\n        },\r\n        {\r\n          headers: {\r\n            'Authorization': `Bearer ${this.apiKey}`,\r\n            'Content-Type': 'application/json'\r\n          },\r\n          timeout: 60000\r\n        }\r\n      );\r\n\r\n      return response.data.content[0].text;\r\n    } catch (error: any) {\r\n      console.error('Zhipu AI chat error:', error.response?.data || error.message);\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Test API connection\r\n   */\r\n  async testConnection(): Promise<boolean> {\r\n    try {\r\n      const response = await this.generateCompletion('Hello', 'glm-4');\r\n      return !!response;\r\n    } catch (error) {\r\n      return false;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get available models\r\n   */\r\n  getAvailableModels(): string[] {\r\n    return [\r\n      'glm-4',           // Latest GLM-4 model\r\n      'glm-4-flash',     // Faster version\r\n      'glm-4-air',       // Lightweight version\r\n      'glm-4-plus',      // Enhanced version\r\n      'glm-3-turbo'      // Previous generation\r\n    ];\r\n  }\r\n}\r\n\r\n/**\r\n * Quick test function\r\n */\r\nexport async function testZhipuAI(apiKey: string): Promise<{\r\n  success: boolean;\r\n  message: string;\r\n  latency?: number;\r\n}> {\r\n  const startTime = Date.now();\r\n\r\n  try {\r\n    const client = new ZhipuClient(apiKey);\r\n    const response = await client.generateCompletion('你好，请简单介绍一下自己。');\r\n\r\n    const latency = Date.now() - startTime;\r\n\r\n    return {\r\n      success: true,\r\n      message: 'backend.zhipu_ai_connection_successful',\r\n      latency\r\n    };\r\n  } catch (error: any) {\r\n    return {\r\n      success: false,\r\n      message: error.message || 'Connection failed'\r\n    };\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\zhipu-integration.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":25,"column":81,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":25,"endColumn":84,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[650,653],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[650,653],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":54,"column":13,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":54,"endColumn":16,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1250,1253],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1250,1253],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":62,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":65,"endColumn":4},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":67,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":67,"endColumn":58},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":67,"column":24,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":67,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .fixProblem on an `any` value.","line":67,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":67,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":69,"column":3,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":69,"endColumn":17}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { AIEngine, AIProvider } from './ai-engine';\r\nimport { SmartFixer } from './smart-fixer';\r\nimport logger from '../utils/logger';\r\n\r\n/**\r\n * Smart Fixer with Zhipu AI (BigModel) Integration\r\n */\r\n\r\nexport interface SmartFixerOptionsZhipu {\r\n  maxAttempts?: number;\r\n  enableAI?: boolean;\r\n  aiProvider?: {\r\n    name: 'openai' | 'anthropic' | 'ollama' | 'zhipu';\r\n    apiKey?: string;\r\n    baseURL?: string;\r\n    model: string;\r\n  };\r\n  executionTimeout?: number;\r\n  enableRealTimeMonitoring?: boolean;\r\n}\r\n\r\n/**\r\n * Create Smart Fixer optimized for Zhipu AI\r\n */\r\nexport function createZhipuSmartFixer(apiKey: string, model: string = 'glm-4'): any {\r\n\r\n\r\n  return new SmartFixer({\r\n    enableAI: true,\r\n    aiProvider: {\r\n      name: 'zhipu',\r\n      apiKey: apiKey,\r\n      baseURL: 'https://open.bigmodel.cn/api/anthropic',\r\n      model: model\r\n    },\r\n    maxAttempts: 3,\r\n    executionTimeout: 60000,\r\n    enableRealTimeMonitoring: true\r\n  });\r\n}\r\n\r\n/**\r\n * Example: Quick fix using Zhipu AI\r\n * SECURITY FIX CVE-2026-003: Removed hardcoded API key\r\n */\r\nexport async function quickFixWithZhipu(\r\n  problem: {\r\n    title: string;\r\n    description: string;\r\n    category: string;\r\n    priority: string;\r\n    action: string;\r\n  },\r\n  context?: any\r\n) {\r\n  // SECURITY FIX CVE-2026-003: API key must come from environment variable\r\n  const apiKey = process.env.ZHIPU_API_KEY;\r\n  if (!apiKey) {\r\n    throw new Error('ZHIPU_API_KEY environment variable is required');\r\n  }\r\n\r\n  const fixer = createZhipuSmartFixer(\r\n    apiKey,\r\n    process.env.ZHIPU_MODEL || 'glm-4'\r\n  );\r\n\r\n  const result = await fixer.fixProblem(problem, context);\r\n\r\n  return result;\r\n}\r\n\r\n// Export for convenience\r\nexport { SmartFixer } from './smart-fixer';\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\agent-auth.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":113,"column":80,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":113,"endColumn":83,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3652,3655],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3652,3655],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .name on an `any` value.","line":114,"column":70,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":114,"endColumn":74},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":264,"column":9,"nodeType":"ReturnStatement","messageI