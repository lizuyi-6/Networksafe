r\n      rows.push(normalizedId);\r\n    }\r\n  }\r\n\r\n  async drain(queue: QueueName, limit = 100): Promise<string[]> {\r\n    const safeLimit = Math.max(1, Math.min(limit, 500));\r\n\r\n    if (redisService.isAvailable()) {\r\n      try {\r\n        const client = redisService.getClient();\r\n        const queueKey = `job-queue:${queue}`;\r\n        const memberKey = `job-queue:${queue}:members`;\r\n        const drained: string[] = [];\r\n\r\n        for (let index = 0; index < safeLimit; index += 1) {\r\n          const next = await client.lpop(queueKey);\r\n          if (!next) {\r\n            break;\r\n          }\r\n          await client.srem(memberKey, next);\r\n          drained.push(next);\r\n        }\r\n\r\n        if (drained.length > 0) {\r\n          return drained;\r\n        }\r\n      } catch (error: any) {\r\n        logger.warn('Redis queue drain failed, falling back to memory queue', {\r\n          queue,\r\n          error: error?.message\r\n        });\r\n      }\r\n    }\r\n\r\n    const rows = this.getMemoryQueue(queue);\r\n    return rows.splice(0, safeLimit);\r\n  }\r\n\r\n  async remove(queue: QueueName, jobId: string): Promise<void> {\r\n    const normalizedId = String(jobId || '').trim();\r\n    if (!normalizedId) {\r\n      return;\r\n    }\r\n\r\n    if (redisService.isAvailable()) {\r\n      try {\r\n        const client = redisService.getClient();\r\n        const queueKey = `job-queue:${queue}`;\r\n        const memberKey = `job-queue:${queue}:members`;\r\n        await client.lrem(queueKey, 0, normalizedId);\r\n        await client.srem(memberKey, normalizedId);\r\n      } catch (error: any) {\r\n        logger.warn('Redis queue remove failed, falling back to memory queue', {\r\n          queue,\r\n          jobId: normalizedId,\r\n          error: error?.message\r\n        });\r\n      }\r\n    }\r\n\r\n    const rows = this.getMemoryQueue(queue);\r\n    const filtered = rows.filter((item) => item !== normalizedId);\r\n    this.memoryQueues.set(queue, filtered);\r\n  }\r\n\r\n  async size(queue: QueueName): Promise<number> {\r\n    if (redisService.isAvailable()) {\r\n      try {\r\n        const client = redisService.getClient();\r\n        const size = await client.llen(`job-queue:${queue}`);\r\n        return Number(size || 0);\r\n      } catch (error: any) {\r\n        logger.warn('Redis queue size failed, falling back to memory queue', {\r\n          queue,\r\n          error: error?.message\r\n        });\r\n      }\r\n    }\r\n\r\n    return this.getMemoryQueue(queue).length;\r\n  }\r\n\r\n  backend(): 'redis' | 'memory' {\r\n    return redisService.isAvailable() ? 'redis' : 'memory';\r\n  }\r\n}\r\n\r\nexport const jobQueueService = new JobQueueService();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\services\\notification-dispatcher.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":129,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":129,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4384,4387],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4384,4387],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":133,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":133,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":239,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":239,"endColumn":35},{"ruleId":"@typescrip