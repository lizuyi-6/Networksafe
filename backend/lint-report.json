Id":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":190,"column":66,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":190,"endColumn":69,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6995,6998],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6995,6998],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .destPort on an `any` value.","line":190,"column":72,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":190,"endColumn":80},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":247,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":247,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9011,9014],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9011,9014],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .sourcePort on an `any` value.","line":247,"column":46,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":247,"endColumn":56},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":248,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":248,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9074,9077],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9074,9077],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .destPort on an `any` value.","line":248,"column":46,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":248,"endColumn":54}],"suppressedMessages":[],"errorCount":30,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Agent Bridge - Integration with the rule-first detection pipeline\r\n */\r\n\r\nimport {\r\n    Verdict,\r\n    InterceptionResult,\r\n    AnalysisResult,\r\n    ThreatEvent,\r\n    ParsedPacket\r\n} from '../core/types';\r\nimport { Packet } from '../core/packet';\r\nimport { ProtocolParser } from '../processing/protocol-parser';\r\nimport { FlowManager } from '../core/flow';\r\nimport { detectionPipelineService } from '../../services/detection-pipeline.service';\r\nimport logger from '../../utils/logger';\r\n\r\nexport interface AgentBridgeConfig {\r\n    enabled: boolean;\r\n    batchSize: number;\r\n    timeout: number;\r\n    fallbackVerdict: Verdict;\r\n    cacheResults: boolean;\r\n    cacheTTL: number;\r\n}\r\n\r\nconst DEFAULT_CONFIG: AgentBridgeConfig = {\r\n    enabled: true,\r\n    batchSize: 10,\r\n    timeout: 5000,\r\n    fallbackVerdict: 'allow',\r\n    cacheResults: true,\r\n    cacheTTL: 60000\r\n};\r\n\r\nexport class AgentBridge {\r\n    private config: AgentBridgeConfig;\r\n    private protocolParser: ProtocolParser;\r\n    private flowManager: FlowManager;\r\n    private verdictCache: Map<string, { verdict: Verdict; timestamp: number }>;\r\n    private stats = {\r\n        totalAnalyzed: 0,\r\n        cacheHits: 0,\r\n        cacheMisses: 0,\r\n        timeouts: 0,\r\n        errors: 0,\r\n        avgLatency: 0\r\n    };\r\n\r\n    constructor(\r\n        flowManager: FlowManager,\r\n        config: Partial<AgentBridgeConfig> = {}\r\n    ) {\r\n        this.config = { ...DEFAULT_CONFIG, ...config };\r\n        this.protocolParser = new ProtocolParser();\r\n        this.flowManager = flowManager;\r\n        this.verdictCache = new Map();\r\n    }\r\n\r\n    async initialize(): Promise<void> {\r\n        if (!this.config.enabled) {\r\n            logger.info('Agent bridge disabled');\r\n            return;\r\n        }\r\n\r\n        logger.info('Agent bridge initialized successfully');\r\n    }\r\n\r\n    async analyzePacket(packet: Packet): Promise<InterceptionResult> {\r\n        const startTime = Date.now();\r\n        const packetId = packet.id;\r\n\r\n        try {\r\n            const parsed = packet.parsed;\r\n\r\n            const cacheKey = this.generateCacheKey(parsed);\r\n            if (this.config.cacheResults) {\r\n                const cached = this.verdictCache.get(cacheKey);\r\n                if (cached && Date.now() - cached.timestamp < this.config.cacheTTL) {\r\n                    this.stats.cacheHits++;\r\n                    return {\r\n                        packetId,\r\n                        verdict: cached.verdict,\r\n                        processingTime: Date.now() - startTime,\r\n                        matchedRule: 'cache'\r\n                    };\r\n                }\r\n                this.stats.cacheMisses++;\r\n            }\r\n\r\n            const analysisResult = await this.performDetectionPipelineAnalysis(parsed);\r\n\r\n            const verdict = this.mapAnalysisVerdict(analysisResult);\r\n\r\n            if (this.config.cacheResults) {\r\n                this.verdictCache.set(cacheKey, { verdict, timestamp: Date.now() });\r\n            }\r\n\r\n            this.updateStats(Date.now() - startTime);\r\n\r\n            return {\r\n                packetId,\r\n                verdict,\r\n                processingTime: Date.now() - startTime,\r\n                matchedRule: analysisResult.threatType,\r\n                inspectionData: {\r\n                    confidence: analysisResult.confidence,\r\n                    threatLevel: analysisResult.threatLevel,\r\n                    reasoning: analysisResult.reasoning\r\n                }\r\n            };\r\n\r\n        } catch (error: any) {\r\n            this.stats.errors++;\r\n            logger.error('Packet analysis failed', { \r\n                packetId, \r\n                error: error.message \r\n            });\r\n\r\n            return {\r\n                packetId,\r\n                verdict: this.config.fallbackVerdict,\r\n                processingTime: Date.now() - startTime\r\n            };\r\n        }\r\n    }\r\n\r\n    private async performDetectionPipelineAnalysis(parsed: ParsedPacket): Promise<AnalysisResult> {\r\n        try {\r\n            const protocolResult = this.protocolParser.parse(parsed.payload);\r\n            const existingSignals = protocolResult.threats.map((threat) => ({\r\n                source: 'existing_signal' as const,\r\n                key: `protocol:${threat.type}`,\r\n                score: threat.severity === 'critical' ? 1 : threat.severity === 'high' ? 0.8 : 0.55,\r\n                severity: threat.severity,\r\n                description: threat.description\r\n            }));\r\n\r\n            const decision = await Promise.race([\r\n                detectionPipelineService.evaluateRequest({\r\n                    tenantId: 'global',\r\n                    channel: 'packet',\r\n                    requestId: parsed.id,\r\n                    timestamp: new Date().toISOString(),\r\n                    sourceIp: parsed.ipHeader?.sourceIP || '',\r\n                    method: parsed.protocol.toUpperCase(),\r\n                    path: this.extractPath(parsed),\r\n                    headers: {},\r\n                    body: parsed.payload.toString('utf-8'),\r\n                    evidence: protocolResult.threats.map((threat) => threat.description).join('\\n'),\r\n                    protocol: parsed.protocol,\r\n                    rawPayload: parsed.raw.toString('utf-8'),\r\n                    existingSignals,\r\n                    metadata: {\r\n                        destIP: parsed.ipHeader?.destIP || '',\r\n                        sourcePort: (parsed.transportHeader as any)?.sourcePort || 0,\r\n                        destPort: (parsed.transportHeader as any)?.destPort || 0,\r\n                        direction: parsed.metadata.direction,\r\n                        flowId: this.flowManager.getOrCreateFlow(parsed)?.id || ''\r\n                    }\r\n                }),\r\n                this.createTimeoutPromise<any>()\r\n            ]);\r\n\r\n            return {\r\n                packetId: parsed.id,\r\n                verdict: decision.verdict === 'allow' ? 'allow' :\r\n                         decision.verdict === 'block' ? 'block' : 'monitor',\r\n                confidence: decision.aiConfidence ?? decision.riskScore,\r\n                threatType: decision.attackFamily !== 'benign' ? decision.attackFamily : undefined,\r\n                threatLevel: decision.verdict === 'block'\r\n                    ? 'high'\r\n                    : decision.verdict === 'monitor'\r\n                        ? 'medium'\r\n                        : undefined,\r\n                reasoning: decision.decisionSource\r\n            };\r\n        } catch (error: any) {\r\n            this.stats.timeouts++;\r\n            logger.warn('Deep analysis timeout or error', { error: error.message });\r\n            return this.fallbackAnalysis(parsed);\r\n        }\r\n    }\r\n\r\n    private extractPath(parsed: ParsedPacket): string {\r\n        const appLayer = parsed.applicationLayer;\r\n        if (appLayer?.parsed && 'path' in appLayer.parsed) {\r\n            return appLayer.parsed.path;\r\n        }\r\n        return `/${parsed.protocol}/${(parsed.transportHeader as any)?.destPort || 0}`;\r\n    }\r\n\r\n    private createTimeoutPromise<T = AnalysisResult>(): Promise<T> {\r\n        return new Promise((_, reject) => {\r\n            setTimeout(() => reject(new Error('Analysis timeout')), this.config.timeout);\r\n        });\r\n    }\r\n\r\n    private fallbackAnalysis(parsed: ParsedPacket): AnalysisResult {\r\n        const protocolResult = this.protocolParser.parse(parsed.payload);\r\n        \r\n        let verdict: 'allow' | 'block' | 'monitor' = 'allow';\r\n        let confidence = 0.5;\r\n        let threatType: string | undefined;\r\n        let threatLevel: 'low' | 'medium' | 'high' | 'critical' | undefined;\r\n\r\n        if (protocolResult.threats.length > 0) {\r\n            const maxSeverity = Math.max(\r\n                ...protocolResult.threats.map(t => \r\n                    ({ low: 1, medium: 2, high: 3, critical: 4 })[t.severity]\r\n                )\r\n            );\r\n\r\n            if (maxSeverity >= 4) {\r\n                verdict = 'block';\r\n                confidence = 0.9;\r\n                threatLevel = 'critical';\r\n            } else if (maxSeverity >= 3) {\r\n                verdict = 'block';\r\n                confidence = 0.8;\r\n                threatLevel = 'high';\r\n            } else {\r\n                verdict = 'monitor';\r\n                confidence = 0.6;\r\n                threatLevel = 'medium';\r\n            }\r\n\r\n            threatType = protocolResult.threats[0].type;\r\n        }\r\n\r\n        return {\r\n            packetId: parsed.id,\r\n            verdict,\r\n            confidence,\r\n            threatType,\r\n            threatLevel,\r\n            reasoning: protocolResult.threats.length > 0\r\n                ? `Detected ${protocolResult.threats.length} threat indicator(s)`\r\n                : 'No threats detected in fallback analysis'\r\n        };\r\n    }\r\n\r\n    private generateCacheKey(parsed: ParsedPacket): string {\r\n        const parts = [\r\n            parsed.ipHeader?.sourceIP || '',\r\n            parsed.ipHeader?.destIP || '',\r\n            (parsed.transportHeader as any)?.sourcePort || 0,\r\n            (parsed.transportHeader as any)?.destPort || 0,\r\n            parsed.protocol\r\n        ];\r\n        return parts.join(':');\r\n    }\r\n\r\n    private mapAnalysisVerdict(result: AnalysisResult): Verdict {\r\n        switch (result.verdict) {\r\n            case 'allow': return 'allow';\r\n            case 'block': return 'block';\r\n            default: return 'inspect';\r\n        }\r\n    }\r\n\r\n    private updateStats(latency: number): void {\r\n        this.stats.totalAnalyzed++;\r\n        const total = this.stats.totalAnalyzed;\r\n        this.stats.avgLatency = (this.stats.avgLatency * (total - 1) + latency) / total;\r\n    }\r\n\r\n    async analyzeBatch(packets: Packet[]): Promise<InterceptionResult[]> {\r\n        const results: InterceptionResult[] = [];\r\n\r\n        for (const packet of packets) {\r\n            const result = await this.analyzePacket(packet);\r\n            results.push(result);\r\n        }\r\n\r\n        return results;\r\n    }\r\n\r\n    getStats(): typeof this.stats & { cacheSize: number; pendingCount: number } {\r\n        return {\r\n            ...this.stats,\r\n            cacheSize: this.verdictCache.size,\r\n            pendingCount: 0\r\n        };\r\n    }\r\n\r\n    clearCache(): void {\r\n        this.verdictCache.clear();\r\n    }\r\n\r\n    async shutdown(): Promise<void> {\r\n        this.verdictCache.clear();\r\n        logger.info('Agent bridge shutdown complete');\r\n    }\r\n}\r\n\r\nexport default AgentBridge;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\traffic-interceptor\\processing\\protocol-parser.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":22,"column":11,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":22,"endColumn":14,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[432,435],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[432,435],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":162,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":162,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5339,5342],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5339,5342],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":163,"column":63,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":163,"endColumn":70},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":324,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":324,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11351,11354],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11351,11354],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":325,"column":62,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":325,"endColumn":69}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Protocol Parser - Fast protocol detection and parsing\r\n */\r\n\r\nimport {\r\n    ParsedPacket,\r\n    HTTPRequest,\r\n    DNSQuery,\r\n    TLSHandshake\r\n} from '../core/types';\r\nimport logger from '../../utils/logger';\r\n\r\nexport interface ProtocolDetectionResult {\r\n    protocol: string;\r\n    confidence: number;\r\n    isEncrypted: boolean;\r\n    isRequest: boolean;\r\n}\r\n\r\nexport interface ParsedProtocol {\r\n    type: string;\r\n    data: any;\r\n    threats: ThreatIndicator[];\r\n}\r\n\r\nexport interface ThreatIndicator {\r\n    type: string;\r\n    severity: 'low' | 'medium' | 'high' | 'critical';\r\n    description: string;\r\n    location: { start: number; end: number };\r\n}\r\n\r\nexport class ProtocolParser {\r\n    private static readonly HTTP_METHODS = [\r\n        'GET ', 'POST', 'PUT ', 'DELE', 'HEAD', 'OPTI', 'PATC', 'TRAC', 'CONN'\r\n    ];\r\n\r\n    private static readonly SQL_KEYWORDS = [\r\n        'SELECT', 'INSERT', 'UPDATE', 'DELETE', 'DROP', 'UNION', 'EXEC',\r\n        'EXECUTE', 'DECLARE', 'CAST', 'CONVERT', 'CONCAT', 'CHAR',\r\n        'NCHAR', 'VARCHAR', 'NVARCHAR', 'ALTER', 'CREATE', 'TRUNCATE'\r\n    ];\r\n\r\n    private static readonly XSS_PATTERNS = [\r\n        /<script[\\s\\S]*?>/gi,\r\n        /javascript:/gi,\r\n        /on\\w+\\s*=/gi,\r\n        /<iframe[\\s\\S]*?>/gi,\r\n        /<object[\\s\\S]*?>/gi,\r\n        /<embed[\\s\\S]*?>/gi,\r\n        /expression\\s*\\(/gi,\r\n        /vbscript:/gi,\r\n        /data:\\s*text\\/html/gi\r\n    ];\r\n\r\n    private static readonly PATH_TRAVERSAL_PATTERNS = [\r\n        /\\.\\.[\\/\\\\]/g,\r\n        /%2e%2e[%\\/\\\\]/gi,\r\n        /\\.\\.%2f/gi,\r\n        /%2e%2e\\//gi,\r\n        /\\.\\.%5c/gi\r\n    ];\r\n\r\n    detectProtocol(payload: Buffer): ProtocolDetectionResult {\r\n        if (payload.length < 4) {\r\n            return { protocol: 'unknown', confidence: 0, isEncrypted: false, isRequest: false };\r\n        }\r\n\r\n        const firstBytes = payload.subarray(0, 4);\r\n        const first4Str = firstBytes.toString('ascii');\r\n\r\n        if (this.isHTTP(first4Str)) {\r\n            return { protocol: 'http', confidence: 0.95, isEncrypted: false, isRequest: true };\r\n        }\r\n\r\n        if (this.isTLS(firstBytes)) {\r\n            return { protocol: 'tls', confidence: 0.95, isEncrypted: true, isRequest: false };\r\n        }\r\n\r\n        if (this.isDNS(payload)) {\r\n            return { protocol: 'dns', confidence: 0.9, isEncrypted: false, isRequest: true };\r\n        }\r\n\r\n        if (this.isSSH(firstBytes)) {\r\n            return { protocol: 'ssh', confidence: 0.95, isEncrypted: true, isRequest: false };\r\n        }\r\n\r\n        if (this.isSMTP(first4Str)) {\r\n            return { protocol: 'smtp', confidence: 0.9, isEncrypted: false, isRequest: false };\r\n        }\r\n\r\n        return { protocol: 'unknown', confidence: 0.5, isEncrypted: false, isRequest: false };\r\n    }\r\n\r\n    private isHTTP(first4: string): boolean {\r\n        return ProtocolParser.HTTP_METHODS.some(method => first4.startsWith(method));\r\n    }\r\n\r\n    private isTLS(firstBytes: Buffer): boolean {\r\n        const contentType = firstBytes[0];\r\n        const version = (firstBytes[1] << 8) | firstBytes[2];\r\n        \r\n        return contentType >= 20 && contentType <= 23 &&\r\n               (version === 0x0301 || version === 0x0302 || \r\n                version === 0x0303 || version === 0x0300);\r\n    }\r\n\r\n    private isDNS(payload: Buffer): boolean {\r\n        if (payload.length < 12) return false;\r\n\r\n        const flags = payload.readUInt16BE(2);\r\n        const qr = (flags >> 15) & 1;\r\n        const opcode = (flags >> 11) & 0xF;\r\n        const qdcount = payload.readUInt16BE(4);\r\n        const ancount = payload.readUInt16BE(6);\r\n\r\n        return opcode <= 2 && qdcount <= 10 && ancount <= 100;\r\n    }\r\n\r\n    private isSSH(firstBytes: Buffer): boolean {\r\n        return firstBytes.toString('ascii').startsWith('SSH-');\r\n    }\r\n\r\n    private isSMTP(first4: string): boolean {\r\n        return first4.startsWith('220 ') || \r\n               first4.startsWith('EHLO') ||\r\n               first4.startsWith('HELO') ||\r\n               first4.startsWith('MAIL') ||\r\n               first4.startsWith('RCPT');\r\n    }\r\n\r\n    parseHTTP(payload: Buffer): { request: HTTPRequest | null; threats: ThreatIndicator[] } {\r\n        const threats: ThreatIndicator[] = [];\r\n        let request: HTTPRequest | null = null;\r\n\r\n        try {\r\n            const headerEnd = this.findHeaderEnd(payload);\r\n            if (headerEnd === -1) {\r\n                return { request: null, threats };\r\n            }\r\n\r\n            const headerStr = payload.subarray(0, headerEnd).toString('utf-8');\r\n            const lines = headerStr.split('\\r\\n');\r\n            const [method, path, version] = (lines[0] || '').split(' ');\r\n\r\n            const headers: Record<string, string> = {};\r\n            for (let i = 1; i < lines.length; i++) {\r\n                const colonIndex = lines[i].indexOf(':');\r\n                if (colonIndex !== -1) {\r\n                    const key = lines[i].substring(0, colonIndex).trim().toLowerCase();\r\n                    const value = lines[i].substring(colonIndex + 1).trim();\r\n                    headers[key] = value;\r\n                }\r\n            }\r\n\r\n            const body = payload.subarray(headerEnd + 4);\r\n\r\n            request = { method, path, version, headers, body };\r\n\r\n            threats.push(...this.detectHTTPThreats(request, payload));\r\n\r\n        } catch (error: any) {\r\n            logger.debug('HTTP parsing error', { error: error.message });\r\n        }\r\n\r\n        return { request, threats };\r\n    }\r\n\r\n    private detectHTTPThreats(request: HTTPRequest, payload: Buffer): ThreatIndicator[] {\r\n        const threats: ThreatIndicator[] = [];\r\n        const fullRequest = payload.toString('utf-8');\r\n\r\n        const sqlInjection = this.detectSQLInjection(fullRequest);\r\n        threats.push(...sqlInjection);\r\n\r\n        const xss = this.detectXSS(fullRequest);\r\n        threats.push(...xss);\r\n\r\n        const pathTraversal = this.detectPathTraversal(request.path || '');\r\n        threats.push(...pathTraversal);\r\n\r\n        const headerInjection = this.detectHeaderInjection(request.headers);\r\n        threats.push(...headerInjection);\r\n\r\n        return threats;\r\n    }\r\n\r\n    private detectSQLInjection(content: string): ThreatIndicator[] {\r\n        const threats: ThreatIndicator[] = [];\r\n        const upperContent = content.toUpperCase();\r\n\r\n        for (const keyword of ProtocolParser.SQL_KEYWORDS) {\r\n            let pos = 0;\r\n            while ((pos = upperContent.indexOf(keyword, pos)) !== -1) {\r\n                const context = content.substring(Math.max(0, pos - 5), pos + keyword.length + 5);\r\n                \r\n                if (this.isSQLContext(context)) {\r\n                    threats.push({\r\n                        type: 'sql_injection',\r\n                        severity: 'high',\r\n                        description: `SQL keyword detected: ${keyword}`,\r\n                        location: { start: pos, end: pos + keyword.length }\r\n                    });\r\n                }\r\n                pos++;\r\n            }\r\n        }\r\n\r\n        const injectionPatterns = [\r\n            { pattern: /'\\s*(OR|AND)\\s+['\\d]/gi, type: 'sql_injection', severity: 'critical' as const },\r\n            { pattern: /;\\s*(DROP|DELETE|UPDATE|INSERT)/gi, type: 'sql_injection', severity: 'critical' as const },\r\n            { pattern: /UNION\\s+(ALL\\s+)?SELECT/gi, type: 'sql_injection', severity: 'critical' as const },\r\n            { pattern: /--\\s*$/gm, type: 'sql_injection', severity: 'high' as const },\r\n            { pattern: /\\/\\*[\\s\\S]*?\\*\\//g, type: 'sql_injection', severity: 'medium' as const }\r\n        ];\r\n\r\n        for (const { pattern, type, severity } of injectionPatterns) {\r\n            let match;\r\n            while ((match = pattern.exec(content)) !== null) {\r\n                threats.push({\r\n                    type,\r\n                    severity,\r\n                    description: `SQL injection pattern: ${match[0].substring(0, 50)}`,\r\n                    location: { start: match.index, end: match.index + match[0].length }\r\n                });\r\n            }\r\n        }\r\n\r\n        return threats;\r\n    }\r\n\r\n    private isSQLContext(context: string): boolean {\r\n        const suspiciousChars = [\"'\", '\"', '=', '(', ')', ';', ' '];\r\n        return suspiciousChars.some(c => context.includes(c));\r\n    }\r\n\r\n    private detectXSS(content: string): ThreatIndicator[] {\r\n        const threats: ThreatIndicator[] = [];\r\n\r\n        for (const pattern of ProtocolParser.XSS_PATTERNS) {\r\n            let match;\r\n            while ((match = pattern.exec(content)) !== null) {\r\n                threats.push({\r\n                    type: 'xss',\r\n                    severity: 'high',\r\n                    description: `XSS pattern detected: ${match[0].substring(0, 50)}`,\r\n                    location: { start: match.index, end: match.index + match[0].length }\r\n                });\r\n            }\r\n        }\r\n\r\n        return threats;\r\n    }\r\n\r\n    private detectPathTraversal(path: string): ThreatIndicator[] {\r\n        const threats: ThreatIndicator[] = [];\r\n\r\n        for (const pattern of ProtocolParser.PATH_TRAVERSAL_PATTERNS) {\r\n            let match;\r\n            while ((match = pattern.exec(path)) !== null) {\r\n                threats.push({\r\n                    type: 'path_traversal',\r\n                    severity: 'high',\r\n                    description: `Path traversal attempt: ${match[0]}`,\r\n                    location: { start: match.index, end: match.index + match[0].length }\r\n                });\r\n            }\r\n        }\r\n\r\n        return threats;\r\n    }\r\n\r\n    private detectHeaderInjection(headers: Record<string, string>): ThreatIndicator[] {\r\n        const threats: ThreatIndicator[] = [];\r\n\r\n        for (const [key, value] of Object.entries(headers)) {\r\n            if (value.includes('\\r\\n')) {\r\n                threats.push({\r\n                    type: 'header_injection',\r\n                    severity: 'high',\r\n                    description: `Header injection in ${key}`,\r\n                    location: { start: 0, end: value.length }\r\n                });\r\n            }\r\n        }\r\n\r\n        return threats;\r\n    }\r\n\r\n    parseDNS(payload: Buffer): { query: DNSQuery | null; threats: ThreatIndicator[] } {\r\n        const threats: ThreatIndicator[] = [];\r\n        let query: DNSQuery | null = null;\r\n\r\n        try {\r\n            if (payload.length < 12) {\r\n                return { query: null, threats };\r\n            }\r\n\r\n            const transactionId = payload.readUInt16BE(0);\r\n            const flags = payload.readUInt16BE(2);\r\n            const qdcount = payload.readUInt16BE(4);\r\n            const ancount = payload.readUInt16BE(6);\r\n\r\n            const questions = this.parseDNSQuestions(payload, 12, qdcount);\r\n\r\n            query = {\r\n                transactionId,\r\n                flags,\r\n                questions,\r\n                answers: []\r\n            };\r\n\r\n            for (const q of questions) {\r\n                if (this.isSuspiciousDomain(q.name)) {\r\n                    threats.push({\r\n                        type: 'dns_exfil',\r\n                        severity: 'medium',\r\n                        description: `Suspicious DNS query: ${q.name}`,\r\n                        location: { start: 0, end: q.name.length }\r\n                    });\r\n                }\r\n            }\r\n\r\n        } catch (error: any) {\r\n            logger.debug('DNS parsing error', { error: error.message });\r\n        }\r\n\r\n        return { query, threats };\r\n    }\r\n\r\n    private parseDNSQuestions(payload: Buffer, offset: number, count: number): { name: string; type: number; class: number }[] {\r\n        const questions: { name: string; type: number; class: number }[] = [];\r\n\r\n        for (let i = 0; i < count && offset < payload.length; i++) {\r\n            const name = this.readDNSName(payload, offset);\r\n            offset += name.length + 2;\r\n\r\n            if (offset + 4 > payload.length) break;\r\n\r\n            const type = payload.readUInt16BE(offset);\r\n            const cls = payload.readUInt16BE(offset + 2);\r\n            offset += 4;\r\n\r\n            questions.push({ name, type, class: cls });\r\n        }\r\n\r\n        return questions;\r\n    }\r\n\r\n    private readDNSName(payload: Buffer, offset: number): string {\r\n        const labels: string[] = [];\r\n        let pos = offset;\r\n        let jumped = false;\r\n        const maxJumps = 10;\r\n        let jumps = 0;\r\n\r\n        while (pos < payload.length) {\r\n            const len = payload[pos];\r\n\r\n            if (len === 0) {\r\n                break;\r\n            }\r\n\r\n            if ((len & 0xC0) === 0xC0) {\r\n                if (!jumped) {\r\n                    jumped = true;\r\n                }\r\n                const jumpOffset = ((len & 0x3F) << 8) | payload[pos + 1];\r\n                pos = jumpOffset;\r\n                jumps++;\r\n      