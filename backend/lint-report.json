dAny","endLine":304,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9265,9268],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9265,9268],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":304,"column":45,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":304,"endColumn":48,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9281,9284],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9281,9284],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":304,"column":77,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":304,"endColumn":80,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9313,9316],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9313,9316],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":305,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":305,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9339,9342],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9339,9342],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":306,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":306,"endColumn":24},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .spanId on an `any` value.","line":310,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":310,"endColumn":35},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .parentSpanId on an `any` value.","line":313,"column":48,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":313,"endColumn":60},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .spanId on an `any` value.","line":313,"column":73,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":313,"endColumn":79},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":316,"column":9,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":316,"endColumn":30},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":337,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":337,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10112,10115],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10112,10115],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .status on an `any` value.","line":338,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":338,"endColumn":51},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":339,"column":51,"nodeType":"BinaryExpression","messageId":"unsafeReturn","endLine":339,"endColumn":67},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .duration on an `any` value.","line":339,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":339,"endColumn":67}],"suppressedMessages":[],"errorCount":51,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * Trace Analysis Agent\r\n *\r\n * Specializes in analyzing distributed traces to identify performance bottlenecks,\r\n * failure points, and service dependencies.\r\n */\r\n\r\nimport { BaseInvestigationAgent } from './base-investigation.agent';\r\nimport { InvestigationContext, InvestigationAgentType, Finding } from '../types';\r\nimport { AgentConfig, MessageBus } from '../../core';\r\n\r\nexport class TraceAnalysisAgent extends BaseInvestigationAgent {\r\n  constructor(config: AgentConfig, messageBus: MessageBus) {\r\n    super(config, messageBus, InvestigationAgentType.TRACE_ANALYSIS, [\r\n      'performance_analysis',\r\n      'bottleneck_detection',\r\n      'failure_analysis',\r\n      'dependency_mapping',\r\n      'latency_analysis',\r\n      'trace_correlation'\r\n    ]);\r\n  }\r\n\r\n  /**\r\n   * Get system prompt for AI model\r\n   */\r\n  public getSystemPrompt(): string {\r\n    return `You are a Trace Analysis Agent specializing in:\r\n- Performance bottleneck identification in distributed systems\r\n- Failure point analysis from trace data\r\n- Service dependency mapping\r\n- Latency analysis and optimization recommendations\r\n- Trace correlation and pattern detection\r\n\r\nYour goal is to identify performance and reliability issues from trace data.`;\r\n  }\r\n\r\n  /**\r\n   * Analyze traces for performance and failure issues\r\n   */\r\n  public async analyzeInvestigation(context: InvestigationContext): Promise<any> {\r\n    console.log('[TraceAnalysisAgent] Starting trace analysis...');\r\n\r\n    const traces = context.systemState.traces;\r\n\r\n    if (!traces || traces.length === 0) {\r\n      return {\r\n        findings: [],\r\n        analyzedTraces: [],\r\n        summary: 'No traces available for analysis'\r\n      };\r\n    }\r\n\r\n    const findings: Finding[] = [];\r\n\r\n    // Extract error traces\r\n    const errorTraces = this.extractErrorTraces(traces);\r\n\r\n    // Analyze performance\r\n    const performanceIssues = await this.analyzePerformance(traces);\r\n    findings.push(...performanceIssues);\r\n\r\n    // Analyze failures\r\n    const failurePatterns = this.analyzeFailures(errorTraces);\r\n    findings.push(...failurePatterns);\r\n\r\n    // Build dependency map\r\n    const dependencyMap = this.buildDependencyMap(traces);\r\n\r\n    // Detect anomalies\r\n    const anomalies = this.detectAnomalies(traces);\r\n    findings.push(...anomalies);\r\n\r\n    // Correlate traces\r\n    const traceChains = this.buildTraceChains(traces);\r\n\r\n    // AI-powered analysis\r\n    let aiAnalysis: any = {};\r\n    if (errorTraces.length > 0 || performanceIssues.length > 0) {\r\n      aiAnalysis = await this.analyzeWithAI(\r\n        'Analyze these traces to identify performance bottlenecks, failure patterns, and service dependencies.',\r\n        { traces: traces.slice(0, 100), errorTraces: errorTraces.slice(0, 20) }\r\n      );\r\n    }\r\n\r\n    return {\r\n      findings,\r\n      analyzedTraces: traces,\r\n      errorTraces,\r\n      performanceIssues,\r\n      failurePatterns,\r\n      dependencyMap,\r\n      anomalies,\r\n      traceChains,\r\n      aiAnalysis,\r\n      summary: this.generateSummary(findings, traces)\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Analyze performance issues\r\n   */\r\n  private async analyzePerformance(traces: any[]): Promise<Finding[]> {\r\n    const findings: Finding[] = [];\r\n\r\n    // Group traces by operation\r\n    const operations = new Map<string, any[]>();\r\n    traces.forEach(trace => {\r\n      const key = `${trace.service}:${trace.operation}`;\r\n      if (!operations.has(key)) {\r\n        operations.set(key, []);\r\n      }\r\n      operations.get(key)!.push(trace);\r\n    });\r\n\r\n    // Find slow operations\r\n    operations.forEach((opTraces, operation) => {\r\n      const durations = opTraces.map(t => t.duration);\r\n      const avgDuration = durations.reduce((a, b) => a + b, 0) / durations.length;\r\n      const maxDuration = Math.max(...durations);\r\n      const p95Duration = this.percentile(durations, 95);\r\n\r\n      if (avgDuration > 1000) {\r\n        findings.push({\r\n          type: 'performance',\r\n          severity: avgDuration > 5000 ? 'critical' : 'medium',\r\n          description: `Operation ${operation} has high latency: avg ${avgDuration.toFixed(2)}ms, p95 ${p95Duration.toFixed(2)}ms, max ${maxDuration}ms`,\r\n          location: operation,\r\n          evidence: [\r\n            `Average: ${avgDuration.toFixed(2)}ms`,\r\n            `P95: ${p95Duration.toFixed(2)}ms`,\r\n            `Max: ${maxDuration}ms`,\r\n            `Samples: ${durations.length}`\r\n          ],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      // Detect outliers\r\n      const outliers = durations.filter(d => d > p95Duration * 2);\r\n      if (outliers.length > 0 && outliers.length < durations.length * 0.1) {\r\n        findings.push({\r\n          type: 'performance',\r\n          severity: 'medium',\r\n          description: `Operation ${operation} has ${outliers.length} outlier traces (>2x P95)`,\r\n          location: operation,\r\n          evidence: [`Outliers: ${outliers.length}/${durations.length}`],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    });\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Analyze failure patterns\r\n   */\r\n  private analyzeFailures(errorTraces: any[]): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    if (errorTraces.length === 0) {\r\n      return findings;\r\n    }\r\n\r\n    // Group errors by service\r\n    const errorsByService = new Map<string, any[]>();\r\n    errorTraces.forEach(trace => {\r\n      const service = trace.service || 'unknown';\r\n      if (!errorsByService.has(service)) {\r\n        errorsByService.set(service, []);\r\n      }\r\n      errorsByService.get(service)!.push(trace);\r\n    });\r\n\r\n    // Identify services with high failure rates\r\n    errorsByService.forEach((errors, service) => {\r\n      const errorCount = errors.length;\r\n      const uniqueOperations = new Set(errors.map(e => e.operation)).size;\r\n\r\n      findings.push({\r\n        type: 'error',\r\n        severity: errorCount > 10 ? 'critical' : 'high',\r\n        description: `Service ${service} has ${errorCount} failed traces across ${uniqueOperations} operations`,\r\n        location: service,\r\n        evidence: errors.slice(0, 5).map(e =>\r\n          `${e.operation}: ${e.error?.message || 'Unknown error'}`\r\n        ),\r\n        relatedFindings: []\r\n      });\r\n    });\r\n\r\n    // Identify common failure patterns\r\n    const errorMessages = new Map<string, number>();\r\n    errorTraces.forEach(trace => {\r\n      const msg = trace.error?.message || 'Unknown error';\r\n      errorMessages.set(msg, (errorMessages.get(msg) || 0) + 1);\r\n    });\r\n\r\n    errorMessages.forEach((count, message) => {\r\n      if (count > 3) {\r\n        findings.push({\r\n          type: 'error',\r\n          severity: 'high',\r\n          description: `Common error pattern: \"${message}\" occurred ${count} times`,\r\n          evidence: [message],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    });\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Build service dependency map\r\n   */\r\n  private buildDependencyMap(traces: any[]): Map<string, Set<string>> {\r\n    const dependencies = new Map<string, Set<string>>();\r\n\r\n    traces.forEach(trace => {\r\n      const service = trace.service;\r\n\r\n      if (trace.parentSpanId) {\r\n        // Find parent service\r\n        const parentTrace = traces.find(t => t.spanId === trace.parentSpanId);\r\n        if (parentTrace) {\r\n          const parentService = parentTrace.service;\r\n\r\n          if (!dependencies.has(parentService)) {\r\n            dependencies.set(parentService, new Set());\r\n          }\r\n          dependencies.get(parentService)!.add(service);\r\n        }\r\n      }\r\n    });\r\n\r\n    return dependencies;\r\n  }\r\n\r\n  /**\r\n   * Detect anomalies in traces\r\n   */\r\n  private detectAnomalies(traces: any[]): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    // Check for orphan traces (no parent but should have one)\r\n    const potentialOrphans = traces.filter(t =>\r\n      t.parentSpanId &&\r\n      !traces.find(pt => pt.spanId === t.parentSpanId)\r\n    );\r\n\r\n    if (potentialOrphans.length > 5) {\r\n      findings.push({\r\n        type: 'anomaly',\r\n        severity: 'medium',\r\n        description: `Found ${potentialOrphans.length} orphan traces (missing parent spans)`,\r\n        evidence: [`Orphan count: ${potentialOrphans.length}`],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    // Check for very long trace chains\r\n    const traceChains = this.buildTraceChains(traces);\r\n    traceChains.forEach(chain => {\r\n      if (chain.length > 20) {\r\n        findings.push({\r\n          type: 'performance',\r\n          severity: 'low',\r\n          description: `Long trace chain detected: ${chain.length} spans`,\r\n          evidence: [`Chain length: ${chain.length}`],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    });\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Build trace chains (complete request paths)\r\n   */\r\n  private buildTraceChains(traces: any[]): any[][] {\r\n    const chains: any[][] = [];\r\n    const processed = new Set<string>();\r\n\r\n    traces.forEach(trace => {\r\n      if (processed.has(trace.spanId)) {\r\n        return;\r\n      }\r\n\r\n      const chain = this.buildChain(trace, traces, processed);\r\n      if (chain.length > 0) {\r\n        chains.push(chain);\r\n      }\r\n    });\r\n\r\n    return chains;\r\n  }\r\n\r\n  /**\r\n   * Recursively build trace chain\r\n   */\r\n  private buildChain(trace: any, allTraces: any[], processed: Set<string>): any[] {\r\n    const chain: any[] = [];\r\n    let current = trace;\r\n\r\n    while (current) {\r\n      chain.push(current);\r\n      processed.add(current.spanId);\r\n\r\n      // Find children\r\n      const children = allTraces.filter(t => t.parentSpanId === current.spanId);\r\n      if (children.length > 0) {\r\n        // Process first child\r\n        current = children[0];\r\n      } else {\r\n        break;\r\n      }\r\n    }\r\n\r\n    return chain;\r\n  }\r\n\r\n  /**\r\n   * Calculate percentile\r\n   */\r\n  private percentile(values: number[], p: number): number {\r\n    const sorted = values.slice().sort((a, b) => a - b);\r\n    const index = Math.ceil((p / 100) * sorted.length) - 1;\r\n    return sorted[index] || 0;\r\n  }\r\n\r\n  /**\r\n   * Generate analysis summary\r\n   */\r\n  private generateSummary(findings: Finding[], traces: any[]): string {\r\n    const errorCount = traces.filter(t => t.status === 'error').length;\r\n    const avgDuration = traces.reduce((sum, t) => sum + t.duration, 0) / traces.length;\r\n\r\n    return `Analyzed ${traces.length} traces: ${errorCount} errors, avg duration ${avgDuration.toFixed(2)}ms. ` +\r\n      `Found ${findings.length} issues.`;\r\n  }\r\n}\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\coordinator.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":27,"column":31,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":27,"endColumn":34,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[987,990],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[987,990],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":116,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":116,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4506,4509],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4506,4509],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":120,"column":13,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":120,"endColumn":47},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .findings on an `any` value.","line":135,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":135,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .findings on an `any` value.","line":136,"column":47,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":136,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":187,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":187,"endColumn":51},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":193,"column":13,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":193,"endColumn":61},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":193,"column":28,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":193,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .analyze on an `any` value.","line":193,"column":34,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":193,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .context on an `any` value.","line":193,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":193,"endColumn":60},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":194,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":194,"endColumn":27},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":215,"column":13,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":215,"endColumn":16,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7596,7599],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7596,7599],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":220,"column":9,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":220,"endColumn":83},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .analyzedLogs on an `any` value.","line":220,"column":43,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":220,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":223,"column":9,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":223,"endColumn":89},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .analyzedTraces on an `any` value.","line":223,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":223,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproductionInfo on an `any` value.","line":227,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":227,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":228,"column":11,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":228,"endColumn":70},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":228,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":228,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8170,8173],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8170,8173],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproductionInfo on an `any` value.","line":228,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":228,"endColumn":44},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproductionInfo on an `any` value.","line":228,"column":54,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":228,"endColumn":70},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .codeIssues on an `any` value.","line":233,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":233,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":234,"column":11,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":234,"endColumn":58},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":234,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":234,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8391,8394],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8391,8394],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .codeIssues on an `any` value.","line":234,"column