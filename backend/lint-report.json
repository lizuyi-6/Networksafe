","severity":2,"message":"Unexpected any. Specify a different type.","line":235,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":235,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7833,7836],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7833,7836],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":264,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":264,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8695,8698],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8695,8698],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { exec } from 'child_process';\r\nimport { promisify } from 'util';\r\nimport os from 'os';\r\nimport logger from '../utils/logger';\r\nimport { Recommendation } from '../database/models/scan-result';\r\n\r\nconst execAsync = promisify(exec);\r\n\r\n/**\r\n * System Scanner\r\n * Scans system configuration and vulnerabilities\r\n */\r\nexport class SystemScanner {\r\n  /**\r\n   * Scan system information\r\n   */\r\n  async scanSystem(): Promise<{ info: any; recommendations: Recommendation[] }> {\r\n    const recommendations: Recommendation[] = [];\r\n    const info: any = {};\r\n\r\n    try {\r\n      // Get OS information\r\n      info.platform = os.platform();\r\n      info.arch = os.arch();\r\n      info.release = os.release();\r\n      info.cpus = os.cpus().length;\r\n      info.totalMemory = `${Math.round(os.totalmem() / 1024 / 1024 / 1024)}GB`;\r\n      info.uptime = `${Math.round(os.uptime() / 3600)}h`;\r\n\r\n      // Check system updates\r\n      const updateRecommendations = await this.checkSystemUpdates();\r\n      recommendations.push(...updateRecommendations);\r\n\r\n      // Check system limits\r\n      const limitRecommendations = await this.checkSystemLimits();\r\n      recommendations.push(...limitRecommendations);\r\n\r\n      // Check disk space\r\n      const diskRecommendations = await this.checkDiskSpace();\r\n      recommendations.push(...diskRecommendations);\r\n\r\n      // Check firewall status\r\n      const firewallRecommendations = await this.checkFirewall();\r\n      recommendations.push(...firewallRecommendations);\r\n\r\n      logger.info('System scan complete');\r\n    } catch (error: any) {\r\n      logger.error('System scan failed', { error });\r\n    }\r\n\r\n    return { info, recommendations };\r\n  }\r\n\r\n  /**\r\n   * Check for system updates\r\n   */\r\n  private async checkSystemUpdates(): Promise<Recommendation[]> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      if (os.platform() === 'linux') {\r\n        // Check for Debian/Ubuntu updates\r\n        try {\r\n          const { stdout } = await execAsync('apt list --upgradable 2>/dev/null | grep -c \"upgradable\" || echo \"0\"');\r\n          const updateCount = parseInt(stdout.trim());\r\n\r\n          if (updateCount > 0) {\r\n            recommendations.push({\r\n              category: 'security',\r\n              priority: 'high',\r\n              title: `${updateCount} System Updates Available`,\r\n              description: 'Your system has pending security updates',\r\n              action: 'sudo apt update && sudo apt upgrade -y',\r\n              autoApplicable: true,\r\n              risk: 'Security vulnerabilities may be exposed'\r\n            });\r\n          }\r\n        } catch (error) {\r\n          // apt not available, might be different distro\r\n        }\r\n\r\n        // Check for RHEL/CentOS updates\r\n        try {\r\n          const { stdout } = await execAsync('yum check-update 2>/dev/null | grep -c \"^\" || echo \"0\"');\r\n          const updateCount = parseInt(stdout.trim());\r\n\r\n          if (updateCount > 10) {\r\n            recommendations.push({\r\n              category: 'security',\r\n              priority: 'high',\r\n              title: 'System Updates Available',\r\n              description: 'Your system has pending updates',\r\n              action: 'sudo yum update -y',\r\n              autoApplicable: true,\r\n              risk: 'Security vulnerabilities may be exposed'\r\n            });\r\n          }\r\n        } catch (error) {\r\n          // yum not available\r\n        }\r\n      }\r\n    } catch (error: any) {\r\n      logger.error('Failed to check system updates', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Check system limits\r\n   */\r\n  private async checkSystemLimits(): Promise<Recommendation[]> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      // Check file descriptor limit\r\n      const { stdout: ulimitOutput } = await execAsync('ulimit -n');\r\n      const fileDescriptorLimit = parseInt(ulimitOutput.trim());\r\n\r\n      if (fileDescriptorLimit < 65535) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'medium',\r\n          title: 'File Descriptor Limit Too Low',\r\n          description: `Current limit: ${fileDescriptorLimit}, Recommended: 65535`,\r\n          action: 'ulimit -n 65535 (add to /etc/security/limits.conf for permanent)',\r\n          autoApplicable: false,\r\n          risk: 'May hit \"too many open files\" error under high load'\r\n        });\r\n      }\r\n\r\n      // Check max user processes\r\n      const { stdout: uLimitOutput } = await execAsync('ulimit -u');\r\n      const maxProcesses = parseInt(uLimitOutput.trim());\r\n\r\n      if (maxProcesses < 4096) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'low',\r\n          title: 'Max User Processes Limit',\r\n          description: `Current limit: ${maxProcesses}, Recommended: 4096+`,\r\n          action: 'ulimit -u 4096',\r\n          autoApplicable: false,\r\n          risk: 'May prevent spawning new processes under load'\r\n        });\r\n      }\r\n    } catch (error: any) {\r\n      logger.error('Failed to check system limits', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Check disk space\r\n   */\r\n  private async checkDiskSpace(): Promise<Recommendation[]> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      const { stdout } = await execAsync('df -h / | tail -1');\r\n\r\n      const parts = stdout.split(/\\s+/);\r\n      const usedPercent = parseInt(parts[4].replace('%', ''));\r\n\r\n      if (usedPercent > 80) {\r\n        recommendations.push({\r\n          category: 'reliability',\r\n          priority: 'critical',\r\n          title: 'Disk Space Almost Full',\r\n          description: `Root partition is ${usedPercent}% full`,\r\n          action: 'Clean up logs, remove old backups, or expand disk',\r\n          autoApplicable: false,\r\n          risk: 'System may crash when disk is full'\r\n        });\r\n      } else if (usedPercent > 60) {\r\n        recommendations.push({\r\n          category: 'reliability',\r\n          priority: 'medium',\r\n          title: 'Disk Space Warning',\r\n          description: `Root partition is ${usedPercent}% full`,\r\n          action: 'Monitor disk usage and plan cleanup',\r\n          autoApplicable: false,\r\n          risk: 'System may run out of disk space soon'\r\n        });\r\n      }\r\n    } catch (error: any) {\r\n      logger.error('Failed to check disk space', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Check firewall status\r\n   */\r\n  private async checkFirewall(): Promise<Recommendation[]> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      // Check if UFW is installed (Ubuntu/Debian)\r\n      try {\r\n        const { stdout } = await execAsync('ufw status');\r\n        if (stdout.includes('inactive')) {\r\n          recommendations.push({\r\n            category: 'security',\r\n            priority: 'high',\r\n            title: 'Firewall is Inactive',\r\n            description: 'UFW firewall is not enabled',\r\n            action: 'sudo ufw enable',\r\n            autoApplicable: true,\r\n            risk: 'Server is exposed to all incoming connections'\r\n          });\r\n        }\r\n      } catch (error) {\r\n        // UFW not installed\r\n        recommendations.push({\r\n          category: 'security',\r\n          priority: 'high',\r\n          title: 'No Firewall Detected',\r\n          description: 'Consider installing and configuring a firewall',\r\n          action: 'sudo apt install ufw && sudo ufw enable',\r\n          autoApplicable: true,\r\n          risk: 'Server is exposed to all incoming connections'\r\n        });\r\n      }\r\n\r\n      // Check if firewalld is running (RHEL/CentOS)\r\n      try {\r\n        await execAsync('firewall-cmd --state 2>/dev/null');\r\n        // firewalld is active, good\r\n      } catch (error) {\r\n        // firewalld not active\r\n      }\r\n    } catch (error: any) {\r\n      logger.error('Failed to check firewall', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Get installed software packages\r\n   */\r\n  async getInstalledPackages(): Promise<string[]> {\r\n    const packages: string[] = [];\r\n\r\n    try {\r\n      if (os.platform() === 'linux') {\r\n        // Try dpkg (Debian/Ubuntu)\r\n        try {\r\n          const { stdout } = await execAsync(\"dpkg -l | grep '^ii' | awk '{print $2}'\");\r\n          packages.push(...stdout.split('\\n').filter(p => p.trim()));\r\n        } catch (error) {\r\n          // Try rpm (RHEL/CentOS)\r\n          try {\r\n            const { stdout } = await execAsync('rpm -qa');\r\n            packages.push(...stdout.split('\\n').filter(p => p.trim()));\r\n          } catch (error) {\r\n            // Neither dpkg nor rpm available\r\n          }\r\n        }\r\n      }\r\n    } catch (error: any) {\r\n      logger.error('Failed to get installed packages', { error });\r\n    }\r\n\r\n    return packages;\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\web-scanner.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2211,2214],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2211,2214],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":163,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":163,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5339,5342],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5339,5342],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":211,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":211,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6847,6850],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6847,6850],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":268,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":268,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8984,8987],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8984,8987],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { exec } from 'child_process';\r\nimport { promisify } from 'util';\r\nimport fs from 'fs/promises';\r\nimport logger from '../utils/logger';\r\nimport { Recommendation } from '../database/models/scan-result';\r\n\r\nconst execAsync = promisify(exec);\r\n\r\n/**\r\n * Web Server Scanner\r\n * Scans Nginx/Apache configuration\r\n */\r\nexport class WebScanner {\r\n  /**\r\n   * Scan web server configuration\r\n   */\r\n  async scanWebServer(): Promise<{ server: string | null; recommendations: Recommendation[] }> {\r\n    const recommendations: Recommendation[] = [];\r\n    let server: string | null = null;\r\n\r\n    // Check for Nginx\r\n    const nginxRecs = await this.checkNginx();\r\n    if (nginxRecs) {\r\n      server = 'nginx';\r\n      recommendations.push(...nginxRecs);\r\n    }\r\n\r\n    // Check for Apache\r\n    const apacheRecs = await this.checkApache();\r\n    if (apacheRecs) {\r\n      server = server === null ? 'apache' : 'both';\r\n      recommendations.push(...apacheRecs);\r\n    }\r\n\r\n    logger.info(`Web server scan complete. Detected: ${server || 'none'}`);\r\n\r\n    return { server, recommendations };\r\n  }\r\n\r\n  /**\r\n   * Check Nginx configuration\r\n   */\r\n  private async checkNginx(): Promise<Recommendation[] | null> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      // Check if Nginx is installed\r\n      await execAsync('which nginx');\r\n    } catch (error) {\r\n      return null; // Nginx not installed\r\n    }\r\n\r\n    try {\r\n      // Check Nginx version\r\n      const { stdout: versionOutput } = await execAsync('nginx -v 2>&1');\r\n      const version = versionOutput.match(/nginx\\/(\\d+\\.\\d+\\.\\d+)/)?.[1];\r\n\r\n      // Check if running\r\n      try {\r\n        await execAsync('pgrep nginx');\r\n      } catch (error) {\r\n        recommendations.push({\r\n          category: 'reliability',\r\n          priority: 'high',\r\n          title: 'Nginx is Not Running',\r\n          description: 'Nginx is installed but not running',\r\n          action: 'sudo systemctl start nginx',\r\n          autoApplicable: true,\r\n          risk: 'Web server is not serving content'\r\n        });\r\n        return recommendations;\r\n      }\r\n\r\n      // Test configuration\r\n      try {\r\n        await execAsync('nginx -t');\r\n      } catch (error: any) {\r\n        recommendations.push({\r\n          category: 'reliability',\r\n          priority: 'critical',\r\n          title: 'Nginx Configuration Error',\r\n          description: 'Nginx configuration test failed',\r\n          action: 'Check nginx -t output and fix configuration',\r\n          autoApplicable: false,\r\n          risk: 'Nginx may fail to reload'\r\n        });\r\n      }\r\n\r\n      // Check if gzip is enabled\r\n      const { stdout: config } = await execAsync('cat /etc/nginx/nginx.conf');\r\n      if (!config.includes('gzip on')) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'medium',\r\n          title: 'Gzip Compression Not Enabled',\r\n          description: 'Enabling gzip can significantly reduce bandwidth',\r\n          action: 'Add \"gzip on;\" to nginx.conf',\r\n          autoApplicable: true,\r\n          risk: 'Increased bandwidth usage'\r\n        });\r\n      }\r\n\r\n      // Check if HTTP/2 is enabled\r\n      if (!config.includes('http2')) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'low',\r\n          title: 'HTTP/2 Not Enabled',\r\n          description: 'HTTP/2 improves performance for modern browsers',\r\n          action: 'Add \"http2\" to listen directive',\r\n          autoApplicable: false,\r\n          risk: 'Suboptimal performance'\r\n        });\r\n      }\r\n\r\n      // Check worker processes\r\n      const workerMatch = config.match(/worker_processes\\s+(\\d+|auto);/);\r\n      if (workerMatch) {\r\n        const workers = workerMatch[1];\r\n        if (workers !== 'auto' && parseInt(workers) < 4) {\r\n          recommendations.push({\r\n            category: 'performance',\r\n            priority: 'low',\r\n            title: 'Nginx Worker Processes',\r\n            description: `Current: ${workers}, Recommended: auto`,\r\n            action: 'Set \"worker_processes auto;\" in nginx.conf',\r\n            autoApplicable: true,\r\n            risk: 'Suboptimal performance'\r\n          });\r\n        }\r\n      }\r\n\r\n      // Check client body size limit\r\n      if (!config.includes('client_max_body_size')) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'low',\r\n          title: 'Missing Client Body Size Limit',\r\n          description: 'No limit on upload file size',\r\n          action: 'Add \"client_max_body_size 100M;\" to http block',\r\n          autoApplicable: true,\r\n          risk: 'Potential disk space exhaustion from large uploads'\r\n        });\r\n      }\r\n\r\n      // Check keepalive timeout\r\n      const keepaliveMatch = config.match(/keepalive_timeout\\s+(\\d+);/);\r\n      if (keepaliveMatch) {\r\n        const timeout = parseInt(keepaliveMatch[1]);\r\n        if (timeout > 75) {\r\n          recommendations.push({\r\n            category: 'performance',\r\n            priority: 'low',\r\n            title: 'Keepalive Timeout Too High',\r\n            description: `Current: ${timeout}s, Recommended: 65s`,\r\n            action: 'Set \"keepalive_timeout 65;\"',\r\n            autoApplicable: true,\r\n            risk: 'Connections may stay open too long'\r\n          });\r\n        }\r\n      }\r\n\r\n    } catch (error: any) {\r\n      logger.error('Error checking Nginx', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Check Apache configuration\r\n   */\r\n  private async checkApache(): Promise<Recommendation[] | null> {\r\n    const recommendations: Recommendation[] = [];\r\n\r\n    try {\r\n      // Check if Apache is installed\r\n      await execAsync('which apachectl || which apache2');\r\n    } catch (error) {\r\n      return null; // Apache not installed\r\n    }\r\n\r\n    try {\r\n      // Check Apache version\r\n      const { stdout: versionOutput } = await execAsync('apachectl -v 2>/dev/null || apache2 -v 2>/dev/null');\r\n      const version = versionOutput.match(/Apache\\/(\\d+\\.\\d+\\.\\d+)/)?.[1];\r\n\r\n      // Check if running\r\n      try {\r\n        await execAsync('pgrep apache');\r\n      } catch (error) {\r\n        try {\r\n          await execAsync('pgrep httpd');\r\n        } catch (error2) {\r\n          recommendations.push({\r\n            category: 'reliability',\r\n            priority: 'high',\r\n            title: 'Apache is Not Running',\r\n            description: 'Apache is installed but not running',\r\n            action: 'sudo systemctl start apache2 || sudo systemctl start httpd',\r\n            autoApplicable: true,\r\n            risk: 'Web server is not serving content'\r\n          });\r\n          return recommendations;\r\n        }\r\n      }\r\n\r\n      // Test configuration\r\n      try {\r\n        await execAsync('apachectl configtest 2>/dev/null || apache2ctl configtest 2>/dev/null');\r\n      } catch (error: any) {\r\n        recommendations.push({\r\n          category: 'reliability',\r\n          priority: 'critical',\r\n          title: 'Apache Configuration Error',\r\n          description: 'Apache configuration test failed',\r\n          action: 'Check configtest output and fix configuration',\r\n          autoApplicable: false,\r\n          risk: 'Apache may fail to reload'\r\n        });\r\n      }\r\n\r\n      // Check for mod_deflate (compression)\r\n      try {\r\n        await execAsync('apachectl -M 2>/dev/null | grep deflate || apache2ctl -M 2>/dev/null | grep deflate');\r\n      } catch (error) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'medium',\r\n          title: 'Mod Deflate Not Enabled',\r\n          description: 'Compression module not enabled',\r\n          action: 'sudo a2enmod deflate && sudo systemctl restart apache',\r\n          autoApplicable: true,\r\n          risk: 'Increased bandwidth usage'\r\n        });\r\n      }\r\n\r\n      // Check for mod_http2\r\n      try {\r\n        await execAsync('apachectl -M 2>/dev/null | grep http2 || apache2ctl -M 2>/dev/null | grep http2');\r\n      } catch (error) {\r\n        recommendations.push({\r\n          category: 'performance',\r\n          priority: 'low',\r\n          title: 'HTTP/2 Not Enabled',\r\n          description: 'HTTP/2 module not enabled',\r\n          action: 'sudo a2enmod http2 && sudo systemctl restart apache',\r\n          autoApplicable: true,\r\n          risk: 'Suboptimal performance for modern browsers'\r\n        });\r\n      }\r\n\r\n      // Check for mod_security\r\n      try {\r\n        await execAsync('apachectl -M 2>/dev/null | grep security || apache2ctl -M 2>/dev/null | grep security');\r\n      } catch (error) {\r\n        recommendations.push({\r\n          category: 'security',\r\n          priority: 'medium',\r\n          title: 'Mod Security Not Installed',\r\n          description: 'Web Application Firewall (WAF) not enabled',\r\n          action: 'sudo a2enmod security2 && sudo systemctl restart apache',\r\n          autoApplicable: true,\r\n          risk: 'Increased vulnerability to web attacks'\r\n        });\r\n      }\r\n\r\n    } catch (error: any) {\r\n      logger.error('Error checking Apache', { error });\r\n    }\r\n\r\n    return recommendations;\r\n  }\r\n\r\n  /**\r\n   * Get Nginx configuration\r\n   */\r\n  async getNginxConfig(): Promise<string | null> {\r\n    try {\r\n      const { stdout } = await execAsync('cat /etc/nginx/nginx.conf');\r\n      return stdout;\r\n    } catch (error) {\r\n      return null;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get Apache configuration\r\n   */\r\n  async getApacheConfig(): Promise<string | null> {\r\n    try {\r\n      const { stdout } = await execAsync('cat /etc/apache2/apache2.conf 2>/dev/null || cat /etc/httpd/conf/httpd.conf 2>/dev/null');\r\n      return stdout;\r\n    } catch (error) {\r\n      return null;\r\n    }\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\zhipu-client.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .content on an `any` value.","line":44,"column":42,