from 'http';\r\nimport { closeDatabase } from './config/database';\r\nimport { getRuntimeDescriptor } from './config/platform-runtime';\r\nimport { bootstrapPersistence } from './bootstrap/persistence';\r\nimport { createControlPlaneApp } from './bootstrap/control-plane-app';\r\nimport { validateRuntimeEnvironment } from './bootstrap/runtime-env';\r\nimport logger from './utils/logger';\r\nimport { AgentGateway } from './websocket/agent-gateway';\r\nimport { DeviceGateway } from './websocket/device-gateway';\r\nimport { setAgentGateway } from './api/routes/agents.routes';\nimport { setDashboardAgentGateway } from './api/routes/dashboard.routes';\nimport {\n  initializeAgentSystem,\r\n  setAgentGateway as setAISystemAgentGateway\r\n} from './api/routes/ai-system.routes';\r\nimport {\r\n  getDeviceById,\r\n  executeDeviceCommandInternal,\r\n  setDeviceCommandTransport\r\n} from './api/routes/devices.routes';\r\nimport { scannerTaskService } from './services/scanner-task.service';\r\nimport { runtimeEmulatorService } from './services/runtime-emulator.service';\r\nimport { commandDispatcherService } from './services/command-dispatcher.service';\r\nimport { postgresShadowStoreService } from './services/postgres-shadow-store.service';\r\nimport { notificationDispatcherService } from './services/notification-dispatcher.service';\r\nimport { deviceControlService } from './services/device-control.service';\r\nimport { artifactStoreService } from './services/artifact-store.service';\r\nimport { jobQueueService } from './services/job-queue.service';\r\nimport { dashboardBroadcastService } from './services/dashboard-broadcast.service';\r\n\r\nconst runtime = getRuntimeDescriptor();\r\nlet agentGateway: AgentGateway | null = null;\r\nlet deviceGateway: DeviceGateway | null = null;\r\n\r\nconst app = createControlPlaneApp({\r\n  runtime,\r\n  getAgentCount: () => agentGateway?.getOnlineCount() || 0\r\n});\r\nconst httpServer = createServer(app);\r\n\r\nfunction configureRealtimeRuntime(): void {\r\n  if (runtime.gatewayEnabled) {\r\n    agentGateway = new AgentGateway(httpServer);\r\n    deviceGateway = new DeviceGateway(httpServer);\r\n    dashboardBroadcastService.setBroadcaster((event, data) => {\r\n      agentGateway?.broadcastToDashboards(event, data);\r\n    });\r\n    deviceGateway.setDashboardBroadcaster((event, data) => {\r\n      dashboardBroadcastService.broadcast(event, data);\r\n    });\r\n    deviceControlService.setGatewayEmitter((deviceId, command, params) =>\r\n      deviceGateway!.sendCommand(deviceId, command, params)\r\n    );\r\n\r\n    setAgentGateway(agentGateway);\n    setDashboardAgentGateway(agentGateway);\n    setAISystemAgentGateway(agentGateway);\n    commandDispatcherService.setAgentGateway(agentGateway);\r\n    commandDispatcherService.setDeviceAdapter({\r\n      getDevice: getDeviceById,\r\n      executeCommand: executeDeviceCommandInternal\r\n    });\r\n    setDeviceCommandTransport((deviceId, command, params) =>\r\n      deviceGateway!.sendCommand(deviceId, command, params)\r\n    );\r\n    scannerTaskService.setBroadcaster((event, data) => {\r\n      dashboardBroadcastService.broadcast(event, data);\r\n    });\r\n\r\n    if (runtime.emulatorEnabled) {\r\n      runtimeEmulatorService.start(agentGateway);\r\n    } else {\r\n      runtimeEmulatorService.stop();\r\n    }\r\n    return;\r\n  }\r\n\r\n  setAgentGateway(null);\n  setDashboardAgentGateway(null);\n  setAISystemAgentGateway(null as any);\n  commandDispatcherService.setAgentGateway(null);\r\n  commandDispatcherService.setDeviceAdapter(null);\r\n  setDeviceCommandTransport(null);\r\n  deviceControlService.setGatewayEmitter(null);\r\n  dashboardBroadcastService.setBroadcaster(null);\r\n  scannerTaskService.setBroadcaster(() => undefined);\r\n  runtimeEmulatorService.stop();\r\n}\r\n\r\nasync function start(): Promise<void> {\r\n  const port = Number(process.env.PORT || 8080);\r\n\r\n  try {\r\n    const envReport = validateRuntimeEnvironment();\r\n    await bootstrapPersistence();\r\n    configureRealtimeRuntime();\r\n\r\n    if (runtime.workerEnabled) {\r\n      await scannerTaskService.startWorker();\r\n    }\r\n\r\n    notificationDispatcherService.startWorker();\r\n\r\n    if (runtime.schedulerEnabled) {\r\n      postgresShadowStoreService.startResyncLoop();\r\n    }\r\n\r\n    if (runtime.apiEnabled) {\r\n      try {\r\n        await initializeAgentSystem();\r\n        logger.info('Multi-Agent Decision System initialized');\r\n      } catch (agentError: any) {\r\n        logger.warn('Multi-Agent System initialization failed, continuing without AI agents', {\r\n          error: agentError.message\r\n        });\r\n      }\r\n    }\r\n\r\n    httpServer.listen(port, () => {\r\n      logger.info('AetherGuard Control Platform started', {\r\n        port,\r\n        runtime,\r\n        queueBackend: jobQueueService.backend(),\r\n        artifactStore: artifactStoreService.describe(),\r\n        shadowStore: postgresShadowStoreService.describe(),\r\n        envWarnings: envReport.warnings\r\n      });\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to start server', { error: error?.message || error });\r\n    process.exit(1);\r\n  }\r\n}\r\n\r\nasync function shutdown(): Promise<void> {\r\n  logger.info('Shutting down...');\r\n\r\n  try {\r\n    scannerTaskService.stopWorker();\r\n    notificationDispatcherService.stopWorker();\r\n\r\n    if (agentGateway) {\r\n      agentGateway.close();\r\n      agentGateway = null;\r\n    }\r\n    if (deviceGateway) {\r\n      deviceGateway.close();\r\n      deviceGateway = null;\r\n    }\r\n    dashboardBroadcastService.setBroadcaster(null);\r\n\r\n    runtimeEmulatorService.stop();\r\n\r\n    await new Promise<void>((resolve, reject) => {\r\n      httpServer.close((error) => {\r\n        if (error) {\r\n          reject(error);\r\n          return;\r\n        }\r\n        resolve();\r\n      });\r\n    }).catch(() => undefined);\r\n\r\n    await postgresShadowStoreService.close();\r\n    closeDatabase();\r\n\r\n    logger.info('Shutdown complete');\r\n  } catch (error: any) {\r\n    logger.error('Error during shutdown', { error: error?.message || error });\r\n  }\r\n\r\n  process.exit(0);\r\n}\r\n\r\nprocess.on('SIGTERM', () => {\r\n  void shutdown();\r\n});\r\nprocess.on('SIGINT', () => {\r\n  void shutdown();\r\n});\r\n\r\nvoid start();\r\n\r\nexport default app;\r\nexport { agentGateway, start };\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\api-traffic-shadow.middleware.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":32,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":32,"endColumn":47}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { randomUUID } from 'crypto';\nimport { NextFunction, Request, Response } from 'express';\nimport { AuthenticatedRequest, verifyToken } from './auth.middleware';\nimport { DetectionDecision, detectionPipelineService } from '../services/detection-pipeline.service';\nimport { fastpathTrafficShadowService } from '../services/fastpath-traffic-shadow.service';\nimport { PLATFORM_TENANT_ID } from '../core/tenant/tenant-context';\nimport logger from '../utils/logger';\n\ninterface ShadowRequest extends AuthenticatedRequest {\n  rawBody?: Buffer;\n  detectionDecision?: DetectionDecision;\n}\n\r\nfunction normalizeHeaderValue(value: unknown): string {\r\n  if (Array.isArray(value)) {\r\n    return value.map((item) => String(item ?? '')).join(', ');\r\n  }\r\n  return String(value ?? '');\r\n}\r\n\r\nfunction normalizeHeaders(headers: Record<string, unknown>): Record<string, string> {\r\n  return Object.entries(headers || {}).reduce<Record<string, string>>((acc, [key, value]) => {\r\n    if (!key) {\r\n      return acc;\r\n    }\r\n    acc[key.toLowerCase()] = normalizeHeaderValue(value);\r\n    return acc;\r\n  }, {});\r\n}\r\n\r\nfunction tokenFromRequest(req: ShadowRequest): string | null {\n  const cookieToken = req.cookies?.accessToken;\n  if (typeof cookieToken === 'string' && cookieToken.trim()) {\r\n    return cookieToken.trim();\r\n  }\r\n\r\n  const authHeader = req.headers.authorization;\r\n  if (typeof authHeader === 'string' && authHeader.startsWith('Bearer ')) {\r\n    const bearer = authHeader.slice('Bearer '.length).trim();\r\n    return bearer || null;\r\n  }\r\n\r\n  return null;\r\n}\r\n\r\nfunction resolveTenantId(req: ShadowRequest): string {\n  const token = tokenFromRequest(req);\r\n  if (token) {\r\n    const user = verifyToken(token);\r\n    if (user?.tenantId?.trim()) {\r\n      return user.tenantId.trim();\r\n    }\r\n  }\r\n\r\n  return String(\n    req.tenantContext?.tenantId ||\n    req.user?.tenantId ||\n    req.headers['x-tenant-id'] ||\n    PLATFORM_TENANT_ID\n  ).trim() || PLATFORM_TENANT_ID;\n}\n\nfunction resolveRequestBody(req: ShadowRequest): string {\n  if (Buffer.isBuffer(req.rawBody)) {\n    return Buffer.from(req.rawBody).toString('utf8');\n  }\r\n  if (typeof req.body === 'string') {\r\n    return req.body;\r\n  }\r\n  if (Buffer.isBuffer(req.body)) {\r\n    return req.body.toString('utf8');\r\n  }\r\n  if (req.body && typeof req.body === 'object') {\r\n    return JSON.stringify(req.body);\r\n  }\r\n  return '';\r\n}\r\n\r\nfunction safeDecodeTransportValue(value: string): string {\r\n  let decoded = String(value || '');\r\n  for (let attempt = 0; attempt < 2; attempt += 1) {\r\n    const normalized = decoded.replace(/\\+/g, '%20');\r\n    try {\r\n      const next = decodeURIComponent(normalized);\r\n      if (next === decoded) {\r\n        break;\r\n      }\r\n      decoded = next;\r\n    } catch {\r\n      decoded = decoded.replace(/\\+/g, ' ');\r\n      break;\r\n    }\r\n  }\r\n\r\n  return decoded.replace(/\\+/g, ' ');\r\n}\r\n\r\nfunction flattenValue(value: unknown): string {\r\n  if (Array.isArray(value)) {\r\n    return value.map((item) => flattenValue(item)).join(', ');\r\n  }\r\n  if (value && typeof value === 'object') {\r\n    return JSON.stringify(value);\r\n  }\r\n  return String(value ?? '');\r\n}\r\n\r\nfunction resolveUrlShape(rawUrl: string): {\r\n  decodedPath: string;\r\n  query: string;\r\n  decodedQuery: string;\r\n  parsedQuery: string;\r\n} {\r\n  try {\r\n    const parsed = new URL(rawUrl || '/', 'http://detector.local');\r\n    const query = parsed.search.startsWith('?') ? parsed.search.slice(1) : '';\r\n    const parsedQuery = Array.from(parsed.searchParams.entries())\r\n      .flatMap(([key, value]) => [`${key}=${value}`, value])\r\n      .join('\\n');\r\n\r\n    return {\r\n      decodedPath: safeDecodeTransportValue(rawUrl || '/'),\r\n      query,\r\n      decodedQuery: safeDecodeTransportValue(query),\r\n      parsedQuery\r\n    };\r\n  } catch {\r\n    return {\r\n      decodedPath: safeDecodeTransportValue(rawUrl || '/'),\r\n      query: '',\r\n      decodedQuery: '',\r\n      parsedQuery: ''\r\n    };\r\n  }\r\n}\r\n\r\nfunction resolveStructuredBody(body: unknown): string {\r\n  if (!body || typeof body !== 'object' || Buffer.isBuffer(body)) {\r\n    return '';\r\n  }\r\n\r\n  return Object.entries(body as Record<string, unknown>)\r\n    .flatMap(([key, value]) => {\r\n      const flattened = flattenValue(value);\r\n      return [`${key}=${flattened}`, flattened];\r\n    })\r\n    .join('\\n');\r\n}\r\n\r\nfunction resolveNormalizedBody(req: Request, headers: Record<string, string>, rawBody: string): {\r\n  normalizedBody: string;\r\n  parsedBody: string;\r\n} {\r\n  const contentType = String(headers['content-type'] || '').toLowerCase();\r\n  const normalizedBody = safeDecodeTransportValue(rawBody || '');\r\n\r\n  if (contentType.includes('application/x-www-form-urlencoded')) {\r\n    try {\r\n      const parsed = new URLSearchParams(rawBody || '');\r\n      const parsedBody = Array.from(parsed.entries())\r\n        .flatMap(([key, value]) => [`${key}=${value}`, value])\r\n        .join('\\n');\r\n\r\n      return {\r\n        normalizedBody,\r\n        parsedBody\r\n      };\r\n    } catch {\r\n      return {\r\n        normalizedBody,\r\n        parsedBody: normalizedBody\r\n      };\r\n    }\r\n  }\r\n\r\n  if (contentType.includes('application/json') || typeof req.body === 'object') {\r\n    const parsedBody = resolveStructuredBody(req.body) || normalizedBody;\r\n    return {\r\n      normalizedBody,\r\n      parsedBody\r\n    };\r\n  }\r\n\r\n  return {\r\n    normalizedBody,\r\n    parsedBody: normalizedBody\r\n  };\r\n}\r\n\r\nexport async function apiTrafficShadowMiddleware(req: Request, res: Response, next: NextFunction): Promise<void> {\n  fastpathTrafficShadowService.submitFromRequest(req);\r\n\r\n  if (req.method === 'OPTIONS' || req.path === '/health' || req.path === '/api/health') {\r\n    next();\r\n    return;\r\n  }\r\n\r\n  const shadowRequest = req as ShadowRequest;\n\n  try {\n    const headers = normalizeHeaders(req.headers as Record<string, unknown>);\n    const rawUrl = shadowRequest.originalUrl || shadowRequest.url || '/';\n    const rawBody = resolveRequestBody(shadowRequest);\n    const urlShape = resolveUrlShape(rawUrl);\r\n    const bodyShape = resolveNormalizedBody(req, headers, rawBody);\r\n    const rawPayload = [\r\n      rawUrl,\r\n      urlShape.decodedPath,\r\n      urlShape.query,\r\n      urlShape.decodedQuery,\r\n      urlShape.parsedQuery,\r\n      rawBody,\r\n      bodyShape.normalizedBody,\r\n      bodyShape.parsedBody\r\n    ].filter(Boolean).join('\\n');\r\n    const decision = await detectionPipelineService.evaluateRequest({\r\n      tenantId: resolveTenantId(shadowRequest),\n      channel: 'http_api',\r\n      requestId: String(req.headers['x-request-id'] || randomUUID()),\r\n      timestamp: new Date().toISOString(),\r\n      sourceIp: String(shadowRequest.ip || shadowRequest.socket?.remoteAddress || '').trim(),\n      method: shadowRequest.method,\n      path: rawUrl,\n      decodedPath: urlShape.decodedPath,\r\n      query: urlShape.query,\r\n      decodedQuery: urlShape.decodedQuery,\r\n      parsedQuery: urlShape.parsedQuery,\r\n      headers,\r\n      body: rawBody,\r\n      normalizedBody: bodyShape.normalizedBody,\r\n      parsedBody: bodyShape.parsedBody,\r\n      userAgent: headers['user-agent'] || '',\r\n      evidence: '',\r\n      protocol: `HTTP/${shadowRequest.httpVersion || '1.1'}`,\n      rawPayload,\r\n      metadata: {\r\n        contentType: headers['content-type'] || '',\r\n        route: shadowRequest.path\n      }\n    });\n\n    shadowRequest.detectionDecision = decision;\n\r\n    if (decision.verdict === 'block') {\r\n      res.status(403).json({\r\n        success: false,\r\n        error: {\r\n          code: 'backend.request_blocked_by_detection_pipeline',\r\n          message: 'Request blocked by rule-first detection pipeline',\r\n          decisionSource: decision.decisionSource,\r\n          matchedRuleIds: decision.matchedRuleIds,\r\n          riskScore: decision.riskScore,\r\n          aiVerdict: decision.aiVerdict || null\r\n        }\r\n      });\r\n      return;\r\n    }\r\n\r\n    next();\r\n  } catch (error: unknown) {\n    logger.warn('HTTP detection pipeline failed, continuing request', {\n      path: req.originalUrl || req.url,\n      error: error instanceof Error ? error.message : String(error)\n    });\n    next();\n  }\n}\n\r\nexport default apiTrafficShadowMiddleware;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\auth.middleware.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":196,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":196,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":236,"column":9,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":236,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tenantId on an `any` value.","line":314,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":314,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tenantId on an `any` value.","line":315,"column":18,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":315,"endColumn":26}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * JWT Authentication Middleware\r\n *\r\n * Provides secure authentication for AetherGuard API endpoints\r\n * SECURITY FIX: Enhanced environment variable validation\r\n */\r\n\r\nimport { Request, Response, NextFunction } from 'express';\r\nimport jwt from 'jsonwebtoken';\r\nimport crypto from 'crypto';\r\nimport logger from '../utils/logger';\r\nimport redisService from '../security/redis.service';\r\nimport EnvValidator from '../security/env-validator.service';\r\nimport { resolveRequestTenantContext, TenantContext } from '../core/tenant/tenant-context';\r\n\r\n// Validate environment variables at module load\r\ntry {\r\n  EnvValidator.require('JWT_SECRET', {\r\n    minLength: 32,\r\n    description: 'JWT signing secret'\r\n  });\r\n} catch (error) {\r\n  // Re-throw with clearer message\r\n  throw new Error('FATAL: JWT_SECRET environment variable is required (minimum 32 characters). Server cannot start without it.');\r\n}\r\n\r\nconst JWT_SECRET: string = process.env.JWT_SECRET!;\r\nconst JWT_EXPIRES_IN = EnvValidator.optional('JWT_EXPIRES_IN', '24h');\r\nconst JWT_REFRESH_EXPIRES_IN = EnvValidator.optional('JWT_REFRESH_EXPIRES_IN', '7d');\r\n\r\n/**\r\n * Authenticated user payload stored in JWT\r\n */\r\nexport interface AuthenticatedUser {\r\n    userId: string;\r\n    email: string;\r\n    username: string;\r\n    role: 'admin' | 'tenant' | 'viewer';\r\n    plan?: 'starter' | 'pro' | 'ultra';\r\n    tenantId?: string;\r\n}\r\n\r\n/**\r\n * Extended Express Request with user info\r\n */\r\nexport interface AuthenticatedRequest extends Request {\r\n    user?: AuthenticatedUser;\r\n    tenantContext?: TenantContext;\r\n}\r\n\r\n/**\r\n * Token pair for authentication\r\n */\r\nexport interface TokenPair {\r\n    accessToken: string;\r\n    refreshToken: string;\r\n    expiresIn: number;\r\n}\r\n\r\n/**\r\n * Generate JWT token pair\r\n * SECURITY FIX: Explicitly specify algorithm for token generation\r\n */\r\nexport function generateTokens(user: AuthenticatedUser): TokenPair {\r\n    const accessToken = jwt.sign(user, JWT_SECRET, { expiresIn: JWT_EXPIRES_IN, algorithm: 'HS256' } as jwt.SignOptions);\r\n    const refreshToken = jwt.sign(\r\n        { userId: user.userId, type: 'refresh' },\r\n        JWT_SECRET,\r\n        { expiresIn: JWT_REFRESH_EXPIRES_IN, algorithm: 'HS256' } as jwt.SignOptions\r\n    );\r\n\r\n    // Calculate expiration in seconds\r\n    const decoded = jwt.decode(accessToken) as jwt.JwtPayload;\r\n    const expiresIn = (decoded?.exp || 0) - Math.floor(Date.now() / 1000);\r\n\r\n    return { accessToken, refreshToken, expiresIn };\r\n}\r\n\r\n/**\r\n * Verify and decode JWT token\r\n * SECURITY FIX CVE-2026-001: Now checks Redis blacklist for logged-out tokens\r\n * SECURITY FIX: Explicitly specify allowed algorithms to prevent algorithm confusion attacks\r\n */\r\nexport function verifyToken(token: string): AuthenticatedUser | null {\r\n    try {\r\n        const decoded = jwt.verify(token, JWT_SECRET, { algorithms: ['HS256'] }) as AuthenticatedUser;\r\n        return decoded;\r\n    } catch (error) {\r\n        return null;\r\n    }\r\n}\r\n\r\n/**\r\n * Async version of verifyToken that checks Redis blacklist\r\n * SECURITY FIX CVE-2026-001: Check if token is blacklisted before accepting\r\n * SECURITY FIX: Fail secure when Redis is unavailable - reject tokens if we can't verify blacklist\r\n * SECURITY FIX: Explicitly specify allowed algorithms to prevent algorithm confusion attacks\r\n */\r\nexport async function verifyTokenAsync(token: string): Promise<AuthenticatedUser | null> {\r\n    let isRedisAvailable = false;\r\n\r\n    // First verify JWT is valid\r\n    let decoded: AuthenticatedUser;\r\n    try {\r\n        decoded = jwt.verify(token, JWT_SECRET, { algorithms: ['HS256'] }) as AuthenticatedUser;\r\n    } catch (error) {\r\n        return null;\r\n    }\r\n\r\n    // Try to check blacklist - fail secure if Redis unavailable\r\n    try {\r\n        isRedisAvailable = redisService.isAvailable();\r\n    } catch (error) {\r\n        isRedisAvailable = false;\r\n    }\r\n\r\n    if (isRedisAvailable) {\r\n        try {\r\n            const isBlacklisted = await redisService.exists(`token:blacklist:${token}`);\r\n            if (isBlacklisted) {\r\n                logger.warn('Attempted use of blacklisted token');\r\n                return null;\r\n            }\r\n        } catch (error) {\r\n            // Redis error during blacklist check - fail secure\r\n            logger.error('Token blacklist check failed due to Redis error, rejecting token for security');\r\n            return null;\r\n        }\r\n    } else {\r\n        // Fail secure by default. Development bypass must be explicitly enabled.\r\n        const allowInsecureBypass =\r\n            process.env.NODE_ENV === 'test' ||\r\n            (process.env.ALLOW_INSECURE_AUTH_WHEN_REDIS_DOWN === 'true' &&\r\n             process.env.NODE_ENV !== 'production');\r\n\r\n        if (!allowInsecureBypass) {\r\n            logger.warn('Redis unavailable, rejecting token for security (fail-secure)');\r\n            return null;\r\n        }\r\n\r\n        logger.warn('Redis unavailable, allowing token due to ALLOW_INSECURE_AUTH_WHEN_REDIS_DOWN=true');\r\n    }\r\n\r\n    return decoded;\r\n}\r\n\r\n/**\r\n * Verify refresh token\r\n * SECURITY FIX: Explicitly specify allowed algorithms to prevent algorithm confusion attacks\r\n */\r\nexport function verifyRefreshToken(token: string): { userId: string } | null {\r\n    try {\r\n        const decoded = jwt.verify(token, JWT_SECRET, { algorithms: ['HS256'] }) as { userId: string; type: string };\r\n        if (decoded.type !== 'refresh') {\r\n            return null;\r\n        }\r\n        return { userId: decoded.userId };\r\n    } catch (error) {\r\n        return null;\r\n    }\r\n}\r\n\r\n/**\r\n * SECURITY FIX: Cookie configuration for httpOnly tokens\r\n * SECURITY FIX: Changed sameSite from 'lax' to 'strict' for better security\r\n */\r\nconst COOKIE_MAX_AGE = 24 * 60 * 60 * 1000;\r\nconst REFRESH_COOKIE_MAX_AGE = 7 * 24 * 60 * 60 * 1000;\r\n\r\nconst isHttpsRequest = (req: Request): boolean => {\r\n    const forwardedProto = req.headers['x-forwarded-proto'];\r\n    const proto = Array.isArray(forwardedProto) ? forwardedProto[0] : forwardedProto;\r\n    return req.secure || proto === 'https';\r\n};\r\n\r\nexport const buildCookieOptions = (req: Request) => ({\r\n    httpOnly: true,\r\n    secure: isHttpsRequest(req),\r\n    sameSite: 'strict' as const,\r\n    path: '/',\r\n    maxAge: COOKIE_MAX_AGE // 24 hours\r\n});\r\n\r\nexport const buildRefreshCookieOptions = (req: Request) => ({\r\n    ...buildCookieOptions(req),\r\n    maxAge: REFRESH_COOKIE_MAX_AGE // 7 days\r\n});\r\n\r\n/**\r\n * Authentication middleware - requires valid JWT token\r\n * SECURITY FIX: Now checks httpOnly cookie first, then Authorization header\r\n * SECURITY FIX CVE-2026-001: Now checks Redis blacklist for logged-out tokens\r\n */\r\nexport async function authenticate(req: AuthenticatedRequest, res: Response, next: NextFunction): Promise<void> {\r\n    // SECURITY FIX: Check httpOnly cookie first\r\n    let token = req.cookies?.accessToken;\r\n\r\n    // Fallback to Authorization header for API clients\r\n    if (!token) {\r\n        const authHeader = req.headers.authorization;\r\n        if (authHeader && authHeader.startsWith('Bearer ')) {\r\n            token = authHeader.split(' ')[1];\r\n        }\r\n    }\r\n\r\n    if (!token) {\r\n        res.status(401).json({\r\n            error: 'backend.authentication_required',\r\n            code: 'AUTH_TOKEN_MISSING'\r\n        });\r\n        return;\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-001: Use async version with blacklist check\r\n    const user = await verifyTokenAsync(token);\r\n\r\n    if (!user) {\r\n        res.status(401).json({\r\n            error: 'backend.invalid_or_expired_token',\r\n            code: 'AUTH_TOKEN_INVALID'\r\n        });\r\n        return;\r\n    }\r\n\r\n    req.user = user;\r\n    logger.debug(`Authenticated user: ${user.email}`);\r\n    next();\r\n}\r\n\r\n/**\r\n * Optional authentication - attaches user if token present, continues otherwise\r\n * SECURITY FIX: Now uses async blacklist check\r\n */\r\nexport async function optionalAuth(req: AuthenticatedRequest, res: Response, next: NextFunction): Promise<void> {\r\n    // Check cookie first, then header\r\n    let token = req.cookies?.accessToken;\r\n\r\n    if (!token) {\r\n        const authHeader = req.headers.authorization;\r\n        if (authHeader && authHeader.startsWith('Bearer ')) {\r\n            token = authHeader.split(' ')[1];\r\n        }\r\n    }\r\n\r\n    if (token) {\r\n        // SECURITY FIX: Use async version with blacklist check\r\n        const user = await verifyTokenAsync(token);\r\n        if (user) {\r\n            req.user = user;\r\n        }\r\n    }\r\n\r\n    next();\r\n}\r\n\r\n/**\r\n * Role-based access control middleware\r\n */\r\nexport function requireRole(...allowedRoles: Array<'admin' | 'tenant' | 'viewer'>) {\r\n    return (req: AuthenticatedRequest, res: Response, next: NextFunction): void => {\r\n        if (!req.user) {\r\n            res.status(401).json({\r\n                error: 'backend.authentication_required',\r\n                code: 'AUTH_REQUIRED'\r\n            });\r\n            return;\r\n        }\r\n\r\n        if (!allowedRoles.includes(req.user.role)) {\r\n            logger.warn(`Access denied for user ${req.user.email} (role: ${req.user.role}), required: ${allowedRoles.join('/')}`);\r\n            res.status(403).json({\r\n                error: 'backend.insufficient_permissions',\r\n                code: 'AUTH_FORBIDDEN',\r\n                requiredRoles: allowedRoles\r\n            });\r\n            return;\r\n        }\r\n\r\n        next();\r\n    };\r\n}\r\n\r\n/**\r\n * Tenant isolation middleware - ensures users can only access their tenant's resources\r\n * SECURITY FIX CVE-2026-010: Reject requests without tenantId for non-admin users\r\n */\r\nexport function requireTenantAccess(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\r\n    if (!req.user) {\r\n        res.status(401).json({ error: 'backend.authentication_required' });\r\n        return;\r\n    }\r\n\r\n    const context = resolveRequestTenantContext(req, {\r\n        allowAdminPlatformFallback: req.user.role === 'admin'\r\n    });\r\n\r\n    if (!context) {\r\n        res.status(403).json({\r\n            error: 'backend.tenant_resolution_required',\r\n            code: 'TENANT_REQUIRED'\r\n        });\r\n        return;\r\n    }\r\n\r\n    if (req.user.role !== 'admin' && context.tenantId !== req.user.tenantId) {\r\n        res.status(403).json({\r\n            error: 'backend.cannot_access_resources_from_another_tenant',\r\n            code: 'TENANT_MISMATCH'\r\n        });\r\n        return;\r\n    }\r\n\r\n    if (!req.body) req.body = {};\r\n    if (!req.body.tenantId) {\r\n        req.body.tenantId = context.tenantId;\r\n    }\r\n\r\n    next();\r\n}\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-011 & CVE-2026-102: Constant-time string comparison\r\n * Fixed to prevent timing attacks on string length\r\n */\r\nfunction constantTimeCompare(a: string, b: string): boolean {\r\n    // SECURITY FIX CVE-2026-102: Early return is safe when lengths differ\r\n    // Attackers can already tell the length difference from response time\r\n    if (a.length !== b.length) {\r\n        return false;\r\n    }\r\n\r\n    // Use crypto.timingSafeEqual for actual comparison\r\n    return crypto.timingSafeEqual(\r\n        Buffer.from(a, 'utf8'),\r\n        Buffer.from(b, 'utf8')\r\n    );\r\n}\r\n\r\n/**\r\n * API Key authentication for agent/device communication\r\n * SECURITY FIX CVE-2026-011: Use constant-time comparison\r\n * SECURITY FIX CVE-2026-012: Add tenant isolation for API keys\r\n */\r\nexport function authenticateApiKey(req: AuthenticatedRequest, res: Response, next: NextFunction): void {\r\n    const apiKey = req.headers['x-api-key'] as string;\r\n\r\n    if (!apiKey) {\r\n        res.status(401).json({\r\n            error: 'backend.api_key_required',\r\n            code: 'API_KEY_MISSING'\r\n        });\r\n        return;\r\n    }\r\n\r\n    // SECURITY FIX: No default API keys allowed\r\n    const validApiKeys = process.env.VALID_API_KEYS?.split(',').filter(k => k.trim());\r\n\r\n    if (!validApiKeys || validApiKeys.length === 0) {\r\n        logger.error('No valid API keys configured in VALID_API_KEYS environment variable');\r\n        res.status(500).json({\r\n            error: 'backend.server_configuration_error',\r\n            code: 'API_KEYS_NOT_CONFIGURED'\r\n        });\r\n        return;\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-011: Use constant-time comparison to prevent timing attacks\r\n    const isValidKey = validApiKeys.some(validKey => constantTimeCompare(apiKey, validKey.trim()));\r\n\r\n    if (!isValidKey) {\r\n        logger.warn('Invalid API key attempt', { ip: req.ip });\r\n        res.status(401).json({\r\n            error: 'backend.invalid_api_key',\r\n            code: 'API_KEY_INVALID'\r\n        });\r\n        return;\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-012: Extract tenant ID from API key pattern or use default\r\n    // Format: key_tenantId_suffix or use API_KEY_TENANT_ID env var\r\n    const apiKeyTenantId = extractTenantIdFromApiKey(apiKey);\r\n\r\n    // Attach a system user for API key requests with tenant isolation\r\n    req.user = {\r\n        userId: 'api-key-user',\r\n        email: 'api@AetherGuard.local',\r\n        username: 'API Client',\r\n        role: 'tenant',\r\n        plan: 'ultra',\r\n        tenantId: apiKeyTenantId\r\n    };\r\n\r\n    next();\r\n}\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-012: Extract tenant ID from API key or environment\r\n */\r\nfunction extractTenantIdFromApiKey(apiKey: string): string {\r\n    // Check if there's a configured tenant ID for API keys\r\n    const configuredTenantId = process.env.API_KEY_TENANT_ID;\r\n    if (configuredTenantId) {\r\n        return configuredTenantId;\r\n    }\r\n\r\n    // Try to extract tenant ID from API key pattern (e.g., \"key_tenant123_suffix\")\r\n    // Default pattern: the API key may contain tenant info after a delimiter\r\n    const parts = apiKey.split('_');\r\n    if (parts.length >= 2) {\r\n        // Use second part as tenant ID if it looks like a valid ID\r\n        const potentialTenantId = parts[1];\r\n        if (potentialTenantId && potentialTenantId.length >= 8) {\r\n            return potentialTenantId;\r\n        }\r\n    }\r\n\r\n    // Fallback to a default tenant ID\r\n    return 'default-tenant';\r\n}\r\n\r\n/**\r\n * Combined auth - accepts either JWT or API key\r\n */\r\nexport async function authenticateAny(req: AuthenticatedRequest, res: Response, next: NextFunction): Promise<void> {\r\n    const authHeader = req.headers.authorization;\r\n    const apiKey = req.headers['x-api-key'] as string;\r\n\r\n    if (authHeader && authHeader.startsWith('Bearer ')) {\r\n        return authenticate(req, res, next);\r\n    }\r\n\r\n    if (apiKey) {\r\n        return authenticateApiKey(req, res, next);\r\n    }\r\n\r\n    res.status(401).json({\r\n        error: 'backend.authentication_required_jwt_or_api_key',\r\n        code: 'AUTH_REQUIRED'\r\n    });\r\n}\r\n\r\n// Compatibility export for agent-only routes.\r\nexport const authenticateAgent = authenticateApiKey;\r\n\r\n/**\r\n * Request timing middleware interface\r\n */\r\nexport interface TimedRequest extends Request {\r\n  startTime?: number;\r\n}\r\n\r\n/**\r\n * Request timing middleware\r\n * Tracks request processing time and emits events for monitoring\r\n */\r\nexport function requestTimingMiddleware(\r\n  req: TimedRequest,\r\n  res: Response,\r\n  next: NextFunction\r\n): void {\r\n  req.startTime = Date.now();\r\n\r\n  // Listen for response finish event\r\n  res.on('finish', () => {\r\n    const duration = Date.now() - (req.startTime || 0);\r\n    // Emit timing event for monitoring (will be picked up by simulation service)\r\n    if (req.startTime) {\r\n      req.emit('requestTiming', { duration, path: req.path });\r\n    }\r\n  });\r\n\r\n  next();\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\path-validation.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":124,"column":15,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":124,"endColumn":76},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access [paramName] on an `any` value.","line":124,"column":66,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":124,"endColumn":75},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":153,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":153,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4559,4562],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4559,4562],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .validatedPath on an `any` value.","line":153,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":153,"endColumn":35},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":154,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":154,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4618,4621],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4618,4621],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .validatedPathInfo on an `any` value.","line":154,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":154,"endColumn":39}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * 路径验证中间件\r\n * 防止路径遍历攻击 (Path Traversal)\r\n */\r\n\r\nimport { Request, Response, NextFunction } from 'express';\r\nimport path from 'path';\r\nimport fs from 'fs';\r\nimport logger from '../utils/logger';\r\n\r\n/**\r\n * 路径遍历防护选项\r\n */\r\nexport interface PathValidationOptions {\r\n    /** 允许的根目录 */\r\n    baseDir: string;\r\n    /** 是否允许访问子目录 */\r\n    allowSubdirectories?: boolean;\r\n    /** 允许的扩展名列表 (可选) */\r\n    allowedExtensions?: string[];\r\n    /** 是否规范化路径 */\r\n    normalize?: boolean;\r\n    /** 参数名 (从 req.query 或 req.body 中获取) */\r\n    paramName?: string;\r\n    /** 是否必须存在 */\r\n    mustExist?: boolean;\r\n}\r\n\r\n/**\r\n * 解析并验证路径\r\n */\r\nexport function resolveAndValidatePath(\r\n    requestedPath: string,\r\n    options: PathValidationOptions\r\n): { valid: boolean; resolvedPath?: string; error?: string } {\r\n    const {\r\n        baseDir,\r\n        allowSubdirectories = true,\r\n        allowedExtensions,\r\n        normalize = true,\r\n        mustExist = false\r\n    } = options;\r\n\r\n    // 基础验证\r\n    if (!requestedPath || typeof requestedPath !== 'string') {\r\n        return { valid: false, error: 'backend.path_is_required' };\r\n    }\r\n\r\n    // 长度限制\r\n    if (requestedPath.length > 4096) {\r\n        return { valid: false, error: 'backend.path_too_long' };\r\n    }\r\n\r\n    // 检查路径遍历攻击特征\r\n    const traversalPatterns = [\r\n        /\\.\\.[\\\\\\/]/,           // ../ 或 ..\\\r\n        /[\\\\\\/]\\.\\.[\\\\\\/]/,      // /../\r\n        /%2e%2e[\\\\\\/]/i,         // URL编码的 ../\r\n        /%252e%252e[\\\\\\/]/i,     // 双重URL编码\r\n        /\\x2e\\x2e[\\\\\\/]/,        // 十六进制编码\r\n        /\\.\\.\\.+/                // 多个点\r\n    ];\r\n\r\n    for (const pattern of traversalPatterns) {\r\n        if (pattern.test(requestedPath)) {\r\n            logger.warn(`Path traversal attempt detected: ${requestedPath}`);\r\n            return { valid: false, error: 'backend.invalid_path_characters_detected' };\r\n        }\r\n    }\r\n\r\n    // 规范化路径\r\n    let resolvedPath: string;\r\n    if (normalize) {\r\n        // 先规范化，再解析为绝对路径\r\n        const normalizedPath = path.normalize(requestedPath).replace(/\\\\/g, '/');\r\n        resolvedPath = path.resolve(baseDir, normalizedPath);\r\n    } else {\r\n        resolvedPath = path.resolve(baseDir, requestedPath);\r\n    }\r\n\r\n    // 规范化基础目录\r\n    const resolvedBase = path.resolve(baseDir);\r\n\r\n    // 安全检查: 确保解析后的路径在允许目录内\r\n    if (!resolvedPath.startsWith(resolvedBase)) {\r\n        logger.warn(`Path traversal attempt: ${requestedPath} resolved to ${resolvedPath}, outside base ${resolvedBase}`);\r\n        return { valid: false, error: 'backend.access_denied_path_outside_allowed_directory' };\r\n    }\r\n\r\n    // 子目录检查\r\n    if (!allowSubdirectories) {\r\n        const relativePath = path.relative(resolvedBase, resolvedPath);\r\n        if (relativePath.includes(path.sep) || relativePath.includes('/')) {\r\n            return { valid: false, error: 'backend.subdirectories_not_allowed' };\r\n        }\r\n    }\r\n\r\n    // 扩展名检查\r\n    if (allowedExtensions && allowedExtensions.length > 0) {\r\n        const ext = path.extname(resolvedPath).toLowerCase();\r\n        if (!allowedExtensions.includes(ext)) {\r\n            return { valid: false, error: `File extension not allowed. Allowed: ${allowedExtensions.join(', ')}` };\r\n        }\r\n    }\r\n\r\n    // 文件必须存在\r\n    if (mustExist) {\r\n        if (!fs.existsSync(resolvedPath)) {\r\n            return { valid: false, error: 'backend.file_not_found' };\r\n        }\r\n    }\r\n\r\n    return { valid: true, resolvedPath };\r\n}\r\n\r\n/**\r\n * Express 中间件 - 验证路径参数\r\n */\r\nexport function validatePath(options: PathValidationOptions) {\r\n    const { paramName = 'path', mustExist = false } = options;\r\n\r\n    return (req: Request, res: Response, next: NextFunction) => {\r\n        // 从 query 或 body 获取路径\r\n        const requestedPath = req.query[paramName] || req.body?.[paramName];\r\n\r\n        if (!requestedPath || typeof requestedPath !== 'string') {\r\n            return res.status(400).json({\r\n                success: false,\r\n                error: 'backend.path_parameter_is_required',\r\n                code: 'MISSING_PATH'\r\n            });\r\n        }\r\n\r\n        const result = resolveAndValidatePath(requestedPath, {\r\n            ...options,\r\n            mustExist\r\n        });\r\n\r\n        if (!result.valid) {\r\n            logger.warn(`Path validation failed: ${result.error}`, {\r\n                path: requestedPath,\r\n                ip: req.ip\r\n            });\r\n\r\n            return res.status(403).json({\r\n                success: false,\r\n                error: result.error,\r\n                code: 'PATH_VALIDATION_FAILED'\r\n            });\r\n        }\r\n\r\n        // 将验证后的路径附加到请求对象\r\n        (req as any).validatedPath = result.resolvedPath;\r\n        (req as any).validatedPathInfo = {\r\n            original: requestedPath,\r\n            resolved: result.resolvedPath\r\n        };\r\n\r\n        next();\r\n    };\r\n}\r\n\r\n/**\r\n * 便捷方法 - 验证文件路径\r\n */\r\nexport function validateFilePath(baseDir: string, options: Partial<PathValidationOptions> = {}) {\r\n    return validatePath({\r\n        baseDir,\r\n        allowedExtensions: options.allowedExtensions,\r\n        mustExist: options.mustExist ?? true,\r\n        paramName: options.paramName || 'path'\r\n    });\r\n}\r\n\r\nexport default {\r\n    resolveAndValidatePath,\r\n    validatePath,\r\n    validateFilePath\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\plan.middleware.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":72,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":72,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2804,2807],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2804,2807],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":73,"column":66,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":73,"endColumn":73}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Response, NextFunction } from 'express';\r\nimport { AuthenticatedRequest } from './auth.middleware';\r\nimport { getDatabase } from '../config/database';\r\nimport logger from '../utils/logger';\r\n\r\nexport const PLAN_LIMITS = {\r\n    starter: { sites: 1, agents: 1 },\r\n    pro: { sites: 5, agents: 5 },\r\n    ultra: { sites: -1, agents: -1 } // -1 means unlimited\r\n};\r\n\r\ntype PlanType = keyof typeof PLAN_LIMITS;\r\n\r\nexport function requirePlanQuota(resourceType: 'site' | 'agent') {\r\n    return (req: AuthenticatedRequest, res: Response, next: NextFunction): void => {\r\n        if (!req.user) {\r\n            res.status(401).json({ error: 'backend.authentication_required' });\r\n            return;\r\n        }\r\n\r\n        // Admins automatically bypass plan constraints\r\n        if (req.user.role === 'admin') {\r\n            next();\r\n            return;\r\n        }\r\n\r\n        const plan = (req.user.plan || 'starter') as PlanType;\r\n        const limits = PLAN_LIMITS[plan] || PLAN_LIMITS.starter;\r\n\r\n        // Unlimited threshold\r\n        if (resourceType === 'site' && limits.sites === -1) {\r\n            next();\r\n            return;\r\n        }\r\n        if (resourceType === 'agent' && limits.agents === -1) {\r\n            next();\r\n            return;\r\n        }\r\n\r\n        try {\r\n            const db = getDatabase();\r\n            const tenantId = req.user.tenantId;\r\n\r\n            if (resourceType === 'site') {\r\n                const row = db.prepare('SELECT COUNT(*) as count FROM sites WHERE tenant_id = ?').get(tenantId) as { count: number };\r\n                if (row.count >= limits.sites) {\r\n                    res.status(403).json({\r\n                        error: `Plan quota exceeded. Your ${plan} plan allows up to ${limits.sites} site(s). Please upgrade to add more.`,\r\n                        code: 'PLAN_QUOTA_EXCEEDED',\r\n                        plan\r\n                    });\r\n                    return;\r\n                }\r\n            } else if (resourceType === 'agent') {\r\n                // Count how many codes have been issued (active + used) to prevent hoarding constraints\r\n                const row = db.prepare(`\r\n                    SELECT COUNT(*) as count FROM agent_onboarding_codes \r\n                    WHERE tenant_id = ? AND status IN ('active', 'used')\r\n                `).get(tenantId) as { count: number };\r\n\r\n                if (row.count >= limits.agents) {\r\n                    res.status(403).json({\r\n                        error: `Plan quota exceeded. Your ${plan} plan allows up to ${limits.agents} agent(s). Please upgrade to add more.`,\r\n                        code: 'PLAN_QUOTA_EXCEEDED',\r\n                        plan\r\n                    });\r\n                    return;\r\n                }\r\n            }\r\n\r\n            next();\r\n        } catch (error: any) {\r\n            logger.error('Quota checking failed', { error: error.message });\r\n            res.status(500).json({ error: 'backend.failed_to_verify_plan_quotas', code: 'INTERNAL_ERROR' });\r\n        }\r\n    };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\middleware\\rate-limit.middleware.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":54,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":54,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1486,1489],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fi