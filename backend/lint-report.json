` value.","line":270,"column":37,"nodeType":"Property","messageId":"anyAssignment","endLine":270,"endColumn":54},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .host on an `any` value.","line":270,"column":50,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":270,"endColumn":54},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":271,"column":37,"nodeType":"Property","messageId":"anyAssignment","endLine":271,"endColumn":84},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .matched on an `any` value.","line":271,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":271,"endColumn":60},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access ['matched-at'] on an `any` value.","line":271,"column":71,"nodeType":"Literal","messageId":"unsafeMemberExpression","endLine":271,"endColumn":83},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .timestamp on an `any` value.","line":272,"column":64,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":272,"endColumn":73},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":273,"column":37,"nodeType":"Property","messageId":"anyAssignment","endLine":273,"endColumn":74},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":273,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":273,"endColumn":61},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":274,"column":37,"nodeType":"Property","messageId":"anyAssignment","endLine":274,"endColumn":70},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":274,"column":55,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":274,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":275,"column":37,"nodeType":"Property","messageId":"anyAssignment","endLine":275,"endColumn":60},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":275,"column":50,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":275,"endColumn":54}],"suppressedMessages":[],"errorCount":44,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Nuclei 漏洞扫描器集成\r\n * \r\n * 集成 ProjectDiscovery Nuclei 进行漏洞扫描\r\n * https://github.com/projectdiscovery/nuclei\r\n */\r\n\r\nimport { exec, spawn } from 'child_process';\r\nimport { promisify } from 'util';\r\nimport path from 'path';\r\nimport fs from 'fs/promises';\r\nimport logger from '../utils/logger';\r\n\r\nconst execAsync = promisify(exec);\r\n\r\nexport interface VulnerabilityResult {\r\n    templateId: string;\r\n    name: string;\r\n    severity: 'critical' | 'high' | 'medium' | 'low' | 'info';\r\n    host: string;\r\n    matched: string;\r\n    timestamp: Date;\r\n    description?: string;\r\n    reference?: string[];\r\n    tags?: string[];\r\n}\r\n\r\nexport interface ScanProgress {\r\n    status: 'pending' | 'running' | 'completed' | 'failed';\r\n    progress: number; // 0-100\r\n    templatesTotal: number;\r\n    templatesCompleted: number;\r\n    vulnerabilitiesFound: number;\r\n    startTime: Date;\r\n    endTime?: Date;\r\n    error?: string;\r\n}\r\n\r\nexport class NucleiScanner {\r\n    private nucleiPath: string = 'nuclei'; // 默认使用 PATH 中的 nuclei\r\n    private templatesPath: string = '';\r\n    private outputDir: string = '';\r\n    private isAvailable: boolean = false;\r\n\r\n    constructor(options?: { nucleiPath?: string; templatesPath?: string; outputDir?: string }) {\r\n        if (options?.nucleiPath) this.nucleiPath = options.nucleiPath;\r\n        if (options?.templatesPath) this.templatesPath = options.templatesPath;\r\n        this.outputDir = options?.outputDir || path.join(process.cwd(), 'scan-results');\r\n    }\r\n\r\n    /**\r\n     * SECURITY FIX: Validate target URL to prevent command injection\r\n     * Only allows valid HTTP/HTTPS URLs\r\n     */\r\n    private validateTarget(target: string): boolean {\r\n        try {\r\n            const url = new URL(target);\r\n            // Only allow http and https protocols\r\n            if (!['http:', 'https:'].includes(url.protocol)) {\r\n                return false;\r\n            }\r\n            // Reject URLs with suspicious characters that could be used for injection\r\n            const suspiciousChars = /[;&|`$(){}[\\]<>\\\\'\"]/;\r\n            if (suspiciousChars.test(target)) {\r\n                return false;\r\n            }\r\n            return true;\r\n        } catch {\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 检查 Nuclei 是否已安装\r\n     */\r\n    async checkAvailability(): Promise<boolean> {\r\n        try {\r\n            const { stdout } = await execAsync(`${this.nucleiPath} -version`);\r\n            logger.info(`Nuclei available: ${stdout.trim()}`);\r\n            this.isAvailable = true;\r\n            return true;\r\n        } catch (error) {\r\n            logger.warn('Nuclei not found. Install from: https://github.com/projectdiscovery/nuclei');\r\n            this.isAvailable = false;\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 更新 Nuclei 模板\r\n     */\r\n    async updateTemplates(): Promise<boolean> {\r\n        try {\r\n            logger.info('Updating Nuclei templates...');\r\n            const { stdout } = await execAsync(`${this.nucleiPath} -update-templates`);\r\n            logger.info(`Templates updated: ${stdout.trim()}`);\r\n            return true;\r\n        } catch (error: any) {\r\n            logger.error('Failed to update templates', { error: error.message });\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 运行漏洞扫描\r\n     * @param target 目标 URL 或 IP\r\n     * @param options 扫描选项\r\n     */\r\n    async scan(\r\n        target: string,\r\n        options?: {\r\n            severity?: ('critical' | 'high' | 'medium' | 'low' | 'info')[];\r\n            tags?: string[];\r\n            templates?: string[];\r\n            timeout?: number; // 分钟\r\n            rateLimit?: number; // 请求/秒\r\n            onProgress?: (progress: ScanProgress) => void;\r\n        }\r\n    ): Promise<VulnerabilityResult[]> {\r\n        // SECURITY FIX: Validate target before processing\r\n        if (!this.validateTarget(target)) {\r\n            throw new Error('Invalid target URL format. Only valid HTTP/HTTPS URLs are allowed.');\r\n        }\r\n\r\n        if (!this.isAvailable) {\r\n            await this.checkAvailability();\r\n            if (!this.isAvailable) {\r\n                throw new Error('Nuclei is not installed');\r\n            }\r\n        }\r\n\r\n        const results: VulnerabilityResult[] = [];\r\n        const scanId = `scan-${Date.now()}`;\r\n        const outputFile = path.join(this.outputDir, `${scanId}.json`);\r\n\r\n        // 确保输出目录存在\r\n        await fs.mkdir(this.outputDir, { recursive: true });\r\n\r\n        // 构建命令参数\r\n        const args: string[] = [\r\n            '-target', target,\r\n            '-json',\r\n            '-output', outputFile,\r\n            '-silent'\r\n        ];\r\n\r\n        // 严重性过滤\r\n        if (options?.severity && options.severity.length > 0) {\r\n            args.push('-severity', options.severity.join(','));\r\n        }\r\n\r\n        // 标签过滤\r\n        if (options?.tags && options.tags.length > 0) {\r\n            args.push('-tags', options.tags.join(','));\r\n        }\r\n\r\n        // 指定模板\r\n        if (options?.templates && options.templates.length > 0) {\r\n            for (const template of options.templates) {\r\n                args.push('-t', template);\r\n            }\r\n        }\r\n\r\n        // 速率限制\r\n        if (options?.rateLimit) {\r\n            args.push('-rate-limit', options.rateLimit.toString());\r\n        }\r\n\r\n        // 超时\r\n        if (options?.timeout) {\r\n            args.push('-timeout', (options.timeout * 60).toString());\r\n        }\r\n\r\n        // 自定义模板路径\r\n        if (this.templatesPath) {\r\n            args.push('-t', this.templatesPath);\r\n        }\r\n\r\n        logger.info(`Starting Nuclei scan: ${target}`, { args });\r\n\r\n        const progress: ScanProgress = {\r\n            status: 'running',\r\n            progress: 0,\r\n            templatesTotal: 0,\r\n            templatesCompleted: 0,\r\n            vulnerabilitiesFound: 0,\r\n            startTime: new Date()\r\n        };\r\n\r\n        options?.onProgress?.(progress);\r\n\r\n        return new Promise((resolve, reject) => {\r\n            const nucleiProcess = spawn(this.nucleiPath, args, {\r\n                stdio: ['pipe', 'pipe', 'pipe']\r\n            });\r\n\r\n            let stderrData = '';\r\n\r\n            nucleiProcess.stdout.on('data', (data: Buffer) => {\r\n                const lines = data.toString().split('\\n').filter(line => line.trim());\r\n\r\n                for (const line of lines) {\r\n                    try {\r\n                        const result = JSON.parse(line);\r\n                        if (result.info) {\r\n                            const vuln: VulnerabilityResult = {\r\n                                templateId: result['template-id'] || result.templateID,\r\n                                name: result.info.name,\r\n                                severity: result.info.severity || 'info',\r\n                                host: result.host,\r\n                                matched: result.matched || result['matched-at'],\r\n                                timestamp: new Date(result.timestamp || Date.now()),\r\n                                description: result.info.description,\r\n                                reference: result.info.reference,\r\n                                tags: result.info.tags\r\n                            };\r\n                            results.push(vuln);\r\n                            progress.vulnerabilitiesFound = results.length;\r\n                            options?.onProgress?.(progress);\r\n                        }\r\n                    } catch {\r\n                        // 非 JSON 输出，忽略\r\n                    }\r\n                }\r\n            });\r\n\r\n            nucleiProcess.stderr.on('data', (data: Buffer) => {\r\n                stderrData += data.toString();\r\n\r\n                // 尝试解析进度信息\r\n                const progressMatch = stderrData.match(/Templates: (\\d+)\\/(\\d+)/);\r\n                if (progressMatch) {\r\n                    progress.templatesCompleted = parseInt(progressMatch[1]);\r\n                    progress.templatesTotal = parseInt(progressMatch[2]);\r\n                    progress.progress = Math.round((progress.templatesCompleted / progress.templatesTotal) * 100);\r\n                    options?.onProgress?.(progress);\r\n                }\r\n            });\r\n\r\n            nucleiProcess.on('close', async (code) => {\r\n                progress.endTime = new Date();\r\n\r\n                if (code === 0) {\r\n                    progress.status = 'completed';\r\n                    progress.progress = 100;\r\n                    logger.info(`Nuclei scan completed: ${results.length} vulnerabilities found`);\r\n\r\n                    // 尝试读取输出文件获取完整结果\r\n                    try {\r\n                        const fileContent = await fs.readFile(outputFile, 'utf-8');\r\n                        const fileResults = fileContent\r\n                            .split('\\n')\r\n                            .filter(line => line.trim())\r\n                            .map(line => {\r\n                                try {\r\n                                    return JSON.parse(line);\r\n                                } catch {\r\n                                    return null;\r\n                                }\r\n                            })\r\n                            .filter(Boolean);\r\n\r\n                        // 合并结果\r\n                        for (const result of fileResults) {\r\n                            if (!results.find(r => r.templateId === result['template-id'] && r.host === result.host)) {\r\n                                results.push({\r\n                                    templateId: result['template-id'],\r\n                                    name: result.info?.name || 'Unknown',\r\n                                    severity: result.info?.severity || 'info',\r\n                                    host: result.host,\r\n                                    matched: result.matched || result['matched-at'],\r\n                                    timestamp: new Date(result.timestamp || Date.now()),\r\n                                    description: result.info?.description,\r\n                                    reference: result.info?.reference,\r\n                                    tags: result.info?.tags\r\n                                });\r\n                            }\r\n                        }\r\n                    } catch {\r\n                        // 文件不存在或读取失败\r\n                    }\r\n\r\n                    options?.onProgress?.(progress);\r\n                    resolve(results);\r\n                } else {\r\n                    progress.status = 'failed';\r\n                    progress.error = stderrData || `Exit code: ${code}`;\r\n                    logger.error(`Nuclei scan failed`, { code, stderr: stderrData });\r\n                    options?.onProgress?.(progress);\r\n                    reject(new Error(progress.error));\r\n                }\r\n            });\r\n\r\n            nucleiProcess.on('error', (error) => {\r\n                progress.status = 'failed';\r\n                progress.error = error.message;\r\n                progress.endTime = new Date();\r\n                options?.onProgress?.(progress);\r\n                reject(error);\r\n            });\r\n        });\r\n    }\r\n\r\n    /**\r\n     * 快速扫描 - 仅高危和严重漏洞\r\n     */\r\n    async quickScan(target: string, onProgress?: (progress: ScanProgress) => void): Promise<VulnerabilityResult[]> {\r\n        return this.scan(target, {\r\n            severity: ['critical', 'high'],\r\n            rateLimit: 100,\r\n            timeout: 10,\r\n            onProgress\r\n        });\r\n    }\r\n\r\n    /**\r\n     * 完整扫描 - 所有级别\r\n     */\r\n    async fullScan(target: string, onProgress?: (progress: ScanProgress) => void): Promise<VulnerabilityResult[]> {\r\n        return this.scan(target, {\r\n            severity: ['critical', 'high', 'medium', 'low'],\r\n            rateLimit: 50,\r\n            timeout: 60,\r\n            onProgress\r\n        });\r\n    }\r\n\r\n    /**\r\n     * Web 应用扫描 - 专注于 Web 漏洞\r\n     */\r\n    async webAppScan(target: string, onProgress?: (progress: ScanProgress) => void): Promise<VulnerabilityResult[]> {\r\n        return this.scan(target, {\r\n            tags: ['xss', 'sqli', 'ssrf', 'lfi', 'rfi', 'rce', 'injection'],\r\n            severity: ['critical', 'high', 'medium'],\r\n            rateLimit: 30,\r\n            timeout: 30,\r\n            onProgress\r\n        });\r\n    }\r\n\r\n    /**\r\n     * CVE 扫描 - 已知漏洞检测\r\n     */\r\n    async cveScan(target: string, onProgress?: (progress: ScanProgress) => void): Promise<VulnerabilityResult[]> {\r\n        return this.scan(target, {\r\n            tags: ['cve'],\r\n            severity: ['critical', 'high'],\r\n            rateLimit: 50,\r\n            timeout: 30,\r\n            onProgress\r\n        });\r\n    }\r\n\r\n    /**\r\n     * 获取扫描结果摘要\r\n     */\r\n    getSummary(results: VulnerabilityResult[]): {\r\n        total: number;\r\n        bySeverity: Record<string, number>;\r\n        byType: Record<string, number>;\r\n    } {\r\n        const bySeverity: Record<string, number> = {\r\n            critical: 0,\r\n            high: 0,\r\n            medium: 0,\r\n            low: 0,\r\n            info: 0\r\n        };\r\n\r\n        const byType: Record<string, number> = {};\r\n\r\n        for (const result of results) {\r\n            bySeverity[result.severity] = (bySeverity[result.severity] || 0) + 1;\r\n\r\n            const type = result.tags?.[0] || 'other';\r\n            byType[type] = (byType[type] || 0) + 1;\r\n        }\r\n\r\n        return {\r\n            total: results.length,\r\n            bySeverity,\r\n            byType\r\n        };\r\n    }\r\n\r\n    /**\r\n     * 检查是否可用\r\n     */\r\n    getIsAvailable(): boolean {\r\n        return this.isAvailable;\r\n    }\r\n}\r\n\r\n// 导出单例\r\nexport const nucleiScanner = new NucleiScanner();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\openai-compatible-client.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":83,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":83,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2131,2134],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2131,2134],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .response on an `any` value.","line":84,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":84,"endColumn":67},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":84,"column":83,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":84,"endColumn":90},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":109,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":109,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2886,2889],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2886,2889],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .response on an `any` value.","line":110,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":110,"endColumn":61},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":110,"column":77,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":110,"endColumn":84},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":157,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":157,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4049,4052],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4049,4052],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":160,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":160,"endColumn":52},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":160,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":160,"endColumn":29}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import axios from 'axios';\r\nimport { getPlatformCloudBaseUrl } from '../utils/model-access';\r\n\r\nexport interface OpenAICompatibleConfig {\r\n  apiKey: string;\r\n  baseURL: string;\r\n  model: string;\r\n  maxTokens?: number;\r\n  temperature?: number;\r\n}\r\n\r\nexport interface ChatMessage {\r\n  role: 'system' | 'user' | 'assistant';\r\n  content: string;\r\n}\r\n\r\nexport interface ChatCompletionResponse {\r\n  id: string;\r\n  object: string;\r\n  created: number;\r\n  model: string;\r\n  choices: Array<{\r\n    index: number;\r\n    message: {\r\n      role: string;\r\n      content: string;\r\n    };\r\n    finish_reason: string;\r\n  }>;\r\n  usage?: {\r\n    prompt_tokens: number;\r\n    completion_tokens: number;\r\n    total_tokens: number;\r\n  };\r\n}\r\n\r\nexport class OpenAICompatibleClient {\r\n  private apiKey: string;\r\n  private baseURL: string;\r\n  private model: string;\r\n  private maxTokens: number;\r\n  private temperature: number;\r\n\r\n  constructor(config: OpenAICompatibleConfig) {\r\n    this.apiKey = config.apiKey;\r\n    this.baseURL = config.baseURL;\r\n    this.model = config.model;\r\n    this.maxTokens = config.maxTokens || 4000;\r\n    this.temperature = config.temperature ?? 0.2;\r\n  }\r\n\r\n  async generateCompletion(prompt: string, systemPrompt?: string): Promise<string> {\r\n    const messages: ChatMessage[] = [];\r\n    \r\n    if (systemPrompt) {\r\n      messages.push({ role: 'system', content: systemPrompt });\r\n    }\r\n    messages.push({ role: 'user', content: prompt });\r\n\r\n    try {\r\n      const response = await axios.post<ChatCompletionResponse>(\r\n        `${this.baseURL}/chat/completions`,\r\n        {\r\n          model: this.model,\r\n          messages,\r\n          max_tokens: this.maxTokens,\r\n          temperature: this.temperature\r\n        },\r\n        {\r\n          headers: {\r\n            'Authorization': `Bearer ${this.apiKey}`,\r\n            'Content-Type': 'application/json'\r\n          },\r\n          timeout: 120000\r\n        }\r\n      );\r\n\r\n      if (response.data?.choices?.[0]?.message?.content) {\r\n        return response.data.choices[0].message.content;\r\n      }\r\n\r\n      throw new Error('Invalid response format from API');\r\n    } catch (error: any) {\r\n      console.error('OpenAI Compatible API error:', error.response?.data || error.message);\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  async chatCompletion(messages: ChatMessage[]): Promise<string> {\r\n    try {\r\n      const response = await axios.post<ChatCompletionResponse>(\r\n        `${this.baseURL}/chat/completions`,\r\n        {\r\n          model: this.model,\r\n          messages,\r\n          max_tokens: this.maxTokens,\r\n          temperature: this.temperature\r\n        },\r\n        {\r\n          headers: {\r\n            'Authorization': `Bearer ${this.apiKey}`,\r\n            'Content-Type': 'application/json'\r\n          },\r\n          timeout: 120000\r\n        }\r\n      );\r\n\r\n      return response.data.choices[0].message.content;\r\n    } catch (error: any) {\r\n      console.error('Chat completion error:', error.response?.data || error.message);\r\n      throw error;\r\n    }\r\n  }\r\n\r\n  async testConnection(): Promise<boolean> {\r\n    try {\r\n      const response = await this.generateCompletion('Hello, respond with \"OK\"');\r\n      return !!response;\r\n    } catch {\r\n      return false;\r\n    }\r\n  }\r\n}\r\n\r\nexport function createDashScopeClient(\r\n  apiKey: string,\r\n  model: string = 'qwen3-coder-480b-a35b-instruct',\r\n  baseURL: string = getPlatformCloudBaseUrl()\r\n): OpenAICompatibleClient {\r\n  return new OpenAICompatibleClient({\r\n    apiKey,\r\n    baseURL,\r\n    model,\r\n    temperature: 0.2,\r\n    maxTokens: 4000\r\n  });\r\n}\r\n\r\nexport async function testDashScope(apiKey: string): Promise<{\r\n  success: boolean;\r\n  message: string;\r\n  latency?: number;\r\n}> {\r\n  const startTime = Date.now();\r\n\r\n  try {\r\n    const client = createDashScopeClient(apiKey);\r\n    const response = await client.generateCompletion('Hello, respond with OK');\r\n\r\n    const latency = Date.now() - startTime;\r\n\r\n    return {\r\n      success: true,\r\n      message: 'backend.dashscope_connection_successful',\r\n      latency\r\n    };\r\n  } catch (error: any) {\r\n    return {\r\n      success: false,\r\n      message: error.message || 'Connection failed'\r\n    };\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\scanner\\optimization-engine.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":76,"column":51,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":76,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .toString on an `any` value.","line":76,"column":56,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":76,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":77,"column":51,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":77,"endColumn":64},