everity":2,"message":"Unsafe member access .count on an `any` value.","line":205,"column":40,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":205,"endColumn":45}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * 安全查询构建器\r\n * 防止SQL注入攻击\r\n */\r\n\r\nimport logger from './logger';\r\n\r\nexport interface QueryConditions {\r\n    [key: string]: any;\r\n}\r\n\r\nexport interface OrderBy {\r\n    column: string;\r\n    direction?: 'ASC' | 'DESC';\r\n}\r\n\r\nexport interface QueryResult<Row = any> {\r\n    rows: Row[];\r\n}\r\n\r\nexport interface QueryExecutor {\r\n    query(sql: string, values?: any[]): Promise<QueryResult>;\r\n}\r\n\r\nexport class QueryBuilder {\r\n    private pool: QueryExecutor;\r\n    private table: string;\r\n    private selectColumns: string[] = ['*'];\r\n    private conditions: string[] = [];\r\n    private values: any[] = [];\r\n    private orderByClauses: string[] = [];\r\n    private limitValue?: number;\r\n    private offsetValue?: number;\r\n    private paramIndex: number = 1;\r\n\r\n    constructor(pool: QueryExecutor, table: string) {\r\n        this.pool = pool;\r\n        this.table = this.sanitizeIdentifier(table);\r\n    }\r\n\r\n    /**\r\n     * 选择列\r\n     */\r\n    select(columns: string[]): this {\r\n        this.selectColumns = columns.map(col => this.sanitizeIdentifier(col));\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 添加 WHERE 条件 (AND)\r\n     */\r\n    where(column: string, operator: string, value: any): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        const safeOperator = this.sanitizeOperator(operator);\r\n\r\n        this.conditions.push(`${safeColumn} ${safeOperator} $${this.paramIndex}`);\r\n        this.values.push(value);\r\n        this.paramIndex++;\r\n\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 添加 WHERE 条件 (OR)\r\n     */\r\n    orWhere(column: string, operator: string, value: any): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        const safeOperator = this.sanitizeOperator(operator);\r\n\r\n        if (this.conditions.length > 0) {\r\n            this.conditions.push(`OR ${safeColumn} ${safeOperator} $${this.paramIndex}`);\r\n        } else {\r\n            this.conditions.push(`${safeColumn} ${safeOperator} $${this.paramIndex}`);\r\n        }\r\n        this.values.push(value);\r\n        this.paramIndex++;\r\n\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * WHERE IN 条件\r\n     */\r\n    whereIn(column: string, values: any[]): this {\r\n        if (!values.length) {\r\n            throw new Error('whereIn requires at least one value');\r\n        }\r\n\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        const placeholders = values.map(() => `$${this.paramIndex++}`).join(', ');\r\n\r\n        this.conditions.push(`${safeColumn} IN (${placeholders})`);\r\n        this.values.push(...values);\r\n\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * WHERE NULL 条件\r\n     */\r\n    whereNull(column: string): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        this.conditions.push(`${safeColumn} IS NULL`);\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * WHERE NOT NULL 条件\r\n     */\r\n    whereNotNull(column: string): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        this.conditions.push(`${safeColumn} IS NOT NULL`);\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * LIKE 条件 (自动转义通配符)\r\n     */\r\n    whereLike(column: string, pattern: string): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        // 转义 LIKE 中的特殊字符\r\n        const escapedPattern = pattern.replace(/([%_\\\\])/g, '\\\\$1');\r\n\r\n        this.conditions.push(`${safeColumn} LIKE $${this.paramIndex}`);\r\n        this.values.push(escapedPattern);\r\n        this.paramIndex++;\r\n\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 排序\r\n     */\r\n    orderBy(column: string, direction: 'ASC' | 'DESC' = 'ASC'): this {\r\n        const safeColumn = this.sanitizeIdentifier(column);\r\n        const safeDirection = direction === 'DESC' ? 'DESC' : 'ASC';\r\n\r\n        this.orderByClauses.push(`${safeColumn} ${safeDirection}`);\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 限制返回数量\r\n     */\r\n    limit(count: number): this {\r\n        if (!Number.isInteger(count) || count < 0) {\r\n            throw new Error('Limit must be a non-negative integer');\r\n        }\r\n        this.limitValue = count;\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 偏移量\r\n     */\r\n    offset(count: number): this {\r\n        if (!Number.isInteger(count) || count < 0) {\r\n            throw new Error('Offset must be a non-negative integer');\r\n        }\r\n        this.offsetValue = count;\r\n        return this;\r\n    }\r\n\r\n    /**\r\n     * 构建并执行查询\r\n     */\r\n    async execute(): Promise<QueryResult> {\r\n        const sql = this.buildQuery();\r\n\r\n        try {\r\n            logger.debug('Executing query', { sql: sql.substring(0, 500) });\r\n            const result = await this.pool.query(sql, this.values);\r\n            return result;\r\n        } catch (error: any) {\r\n            logger.error('Query execution failed', { error: error.message, sql });\r\n            throw error;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * 获取单个结果\r\n     */\r\n    async first(): Promise<any | null> {\r\n        this.limit(1);\r\n        const result = await this.execute();\r\n        return result.rows[0] || null;\r\n    }\r\n\r\n    /**\r\n     * 获取所有结果\r\n     */\r\n    async get(): Promise<any[]> {\r\n        const result = await this.execute();\r\n        return result.rows;\r\n    }\r\n\r\n    /**\r\n     * 获取计数\r\n     */\r\n    async count(): Promise<number> {\r\n        const result = await this.pool.query(\r\n            `SELECT COUNT(*) FROM ${this.table}`,\r\n            []\r\n        );\r\n        return parseInt(result.rows[0].count, 10);\r\n    }\r\n\r\n    /**\r\n     * 构建SQL查询字符串\r\n     */\r\n    private buildQuery(): string {\r\n        let sql = `SELECT ${this.selectColumns.join(', ')} FROM ${this.table}`;\r\n\r\n        if (this.conditions.length > 0) {\r\n            sql += ' WHERE ' + this.conditions.join(' AND ');\r\n        }\r\n\r\n        if (this.orderByClauses.length > 0) {\r\n            sql += ' ORDER BY ' + this.orderByClauses.join(', ');\r\n        }\r\n\r\n        if (this.limitValue !== undefined) {\r\n            sql += ` LIMIT ${this.limitValue}`;\r\n        }\r\n\r\n        if (this.offsetValue !== undefined) {\r\n            sql += ` OFFSET ${this.offsetValue}`;\r\n        }\r\n\r\n        return sql;\r\n    }\r\n\r\n    /**\r\n     * 净化标识符 (表名、列名)\r\n     */\r\n    private sanitizeIdentifier(identifier: string): string {\r\n        // 只允许字母数字和下划线\r\n        const safePattern = /^[a-zA-Z_][a-zA-Z0-9_]*$/;\r\n        if (!safePattern.test(identifier)) {\r\n            throw new Error(`Invalid identifier: ${identifier}`);\r\n        }\r\n        return identifier;\r\n    }\r\n\r\n    /**\r\n     * 净化操作符\r\n     */\r\n    private sanitizeOperator(operator: string): string {\r\n        const allowedOperators = ['=', '!=', '<>', '<', '>', '<=', '>=', 'LIKE', 'ILIKE', 'NOT LIKE', 'NOT ILIKE', 'IN', 'NOT IN', 'IS', 'IS NOT'];\r\n        const upperOp = operator.toUpperCase();\r\n        if (!allowedOperators.includes(upperOp)) {\r\n            throw new Error(`Invalid operator: ${operator}`);\r\n        }\r\n        return upperOp;\r\n    }\r\n}\r\n\r\nexport default QueryBuilder;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\utils\\system-stats.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":39,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":39,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1248,1251],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1248,1251],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":40,"column":74,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":40,"endColumn":81},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":51,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":51,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1606,1609],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1606,1609],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access [type] on an `any` value.","line":51,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":51,"endColumn":49}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import os from 'os';\r\nimport { exec } from 'child_process';\r\nimport { promisify } from 'util';\r\nimport logger from './logger';\r\n\r\nconst execAsync = promisify(exec);\r\n\r\nexport class SystemStats {\r\n    private static instance: SystemStats;\r\n    private previousCpuTimes: { idle: number, total: number } = { idle: 0, total: 0 };\r\n\r\n    public cpuUsage: number = 0;\r\n    public memoryUsage: number = 0;\r\n    public diskUsage: number = 0;\r\n    public networkUsageMb: number = 0;\r\n\r\n    private previousRx: number = 0;\r\n    private previousTx: number = 0;\r\n    private lastNetworkTime: number = Date.now();\r\n\r\n    private constructor() {\r\n        this.updateStats();\r\n        setInterval(() => this.updateStats(), 2000);\r\n    }\r\n\r\n    public static getInstance(): SystemStats {\r\n        if (!SystemStats.instance) {\r\n            SystemStats.instance = new SystemStats();\r\n        }\r\n        return SystemStats.instance;\r\n    }\r\n\r\n    private async updateStats() {\r\n        try {\r\n            this.cpuUsage = this.calculateCpuUsage();\r\n            this.memoryUsage = this.calculateMemoryUsage();\r\n            this.diskUsage = await this.calculateDiskUsage();\r\n            this.networkUsageMb = await this.calculateNetworkUsage();\r\n        } catch (error: any) {\r\n            logger.error('Failed to update system stats', { error: error.message });\r\n        }\r\n    }\r\n\r\n    private calculateCpuUsage(): number {\r\n        const cpus = os.cpus();\r\n        let idle = 0;\r\n        let total = 0;\r\n\r\n        for (const cpu of cpus) {\r\n            for (const type in cpu.times) {\r\n                total += (cpu.times as any)[type];\r\n            }\r\n            idle += cpu.times.idle;\r\n        }\r\n\r\n        if (this.previousCpuTimes.total === 0) {\r\n            this.previousCpuTimes = { idle, total };\r\n            return 0;\r\n        }\r\n\r\n        const idleDiff = idle - this.previousCpuTimes.idle;\r\n        const totalDiff = total - this.previousCpuTimes.total;\r\n\r\n        this.previousCpuTimes = { idle, total };\r\n\r\n        const usage = 100 - (100 * idleDiff / totalDiff);\r\n        return usage > 0 ? usage : 0;\r\n    }\r\n\r\n    private calculateMemoryUsage(): number {\r\n        const total = os.totalmem();\r\n        const free = os.freemem();\r\n        return ((total - free) / total) * 100;\r\n    }\r\n\r\n    private async calculateDiskUsage(): Promise<number> {\r\n        return new Promise((resolve) => {\r\n            if (process.platform === 'win32') {\r\n                exec('wmic logicaldisk get size,freespace,caption', (error, stdout) => {\r\n                    if (error) return resolve(0);\r\n                    const lines = stdout.trim().split('\\\\n').slice(1);\r\n                    for (const line of lines) {\r\n                        const parts = line.trim().split(/\\\\s+/);\r\n                        if (parts.length >= 3 && parts[0].includes('C:')) {\r\n                            const freeString = parts[1];\r\n                            const totalString = parts[2];\r\n                            const free = parseInt(freeString, 10);\r\n                            const total = parseInt(totalString, 10);\r\n                            if (total > 0) return resolve(((total - free) / total) * 100);\r\n                        }\r\n                    }\r\n                    resolve(0);\r\n                });\r\n            } else {\r\n                exec('df -BG /', (error, stdout) => {\r\n                    if (error) return resolve(0);\r\n                    const lines = stdout.trim().split('\\\\n');\r\n                    if (lines.length > 1) {\r\n                        const parts = lines[1].trim().split(/\\\\s+/);\r\n                        const usageStr = parts[4];\r\n                        if (usageStr) {\r\n                            return resolve(parseInt(usageStr.replace('%', ''), 10));\r\n                        }\r\n                    }\r\n                    resolve(0);\r\n                });\r\n            }\r\n        });\r\n    }\r\n\r\n    private async calculateNetworkUsage(): Promise<number> {\r\n        let currentRx = 0;\r\n        let currentTx = 0;\r\n\r\n        try {\r\n            if (process.platform === 'win32') {\r\n                const { stdout } = await execAsync('netstat -e');\r\n                const lines = stdout.trim().split('\\\\n');\r\n                if (lines.length > 1) {\r\n                    const bytesLine = lines[1].trim().split(/\\\\s+/);\r\n                    currentRx = parseInt(bytesLine[1], 10);\r\n                    currentTx = parseInt(bytesLine[2], 10);\r\n                }\r\n            } else {\r\n                const { stdout } = await execAsync('cat /proc/net/dev');\r\n                const lines = stdout.trim().split('\\\\n').slice(2);\r\n                for (const line of lines) {\r\n                    const parts = line.trim().split(/\\\\s+/).filter(Boolean);\r\n                    if (parts.length >= 10 && !line.includes('lo:')) {\r\n                        currentRx += parseInt(parts[1], 10);\r\n                        currentTx += parseInt(parts[9], 10);\r\n                    }\r\n                }\r\n            }\r\n        } catch (err) {\r\n            return 0;\r\n        }\r\n\r\n        const now = Date.now();\r\n        const timeDiffSeconds = (now - this.lastNetworkTime) / 1000;\r\n\r\n        let mbps = 0;\r\n        if (this.previousRx > 0 && timeDiffSeconds > 0) {\r\n            const bytesDiff = (currentRx - this.previousRx) + (currentTx - this.previousTx);\r\n            // MB/s\r\n            mbps = bytesDiff / (1024 * 1024) / timeDiffSeconds;\r\n        }\r\n\r\n        this.previousRx = currentRx;\r\n        this.previousTx = currentTx;\r\n        this.lastNetworkTime = now;\r\n\r\n        return mbps > 0 ? mbps : 0;\r\n    }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\utils\\validation.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\websocket\\agent-gateway.