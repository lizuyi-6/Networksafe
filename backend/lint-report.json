n}\n\nfunction sanitizePlatformConfig(config: any): any {\n  if (!config) {\n    return config;\n  }\n\n  return {\n    ...config,\n    edgeAuto: config.edgeAuto ? toPublicEdgeAutoPlatformSettings(config.edgeAuto) : config.edgeAuto,\n  };\n}\n\nrouter.get('/', authenticate, async (req: AuthenticatedRequest, res) => {\n  try {\n    const config = await platformConfigService.getConfig(tenantOf(req));\n    const publicConfig = sanitizePlatformConfig(config);\n    sendSuccess(res, publicConfig, { legacy: publicConfig });\n  } catch (error: any) {\n    sendError(res, 500, {\n      code: 'backend.failed_to_load_configuration',\n      message: error?.message || 'backend.failed_to_load_configuration'\r\n    });\r\n  }\r\n});\r\n\r\nrouter.post('/', authenticate, requireRole('admin'), async (req: AuthenticatedRequest, res) => {\r\n  try {\r\n    const tenantId = tenantOf(req);\r\n    const config = await platformConfigService.saveConfig(\r\n      tenantId,\r\n      req.body || {},\r\n      req.user?.userId || 'unknown'\r\n    );\r\n\r\n    await auditLogger.log({\r\n      tenantId,\r\n      eventType: 'platform_config_updated',\r\n      category: 'system',\r\n      severity: 'warning',\r\n      actor: { type: 'user', id: req.user?.userId || 'unknown', email: req.user?.email, ip: req.ip },\r\n      action: 'update_platform_config',\r\n      target: { type: 'tenant', id: tenantId },\r\n        details: {\r\n          antiBotEnabled: config.antiBot.enabled,\r\n          rateLimitRequestsPerMinute: config.rateLimit.requestsPerMinute,\r\n          notificationChannels: config.notifications.channels.length,\r\n          aiRoutingMode: config.aiRouting.mode,\r\n          detectionRuleFirstEnabled: config.detectionPipeline.ruleFirstEnabled,\r\n          detectionEscalationThreshold: config.detectionPipeline.aiEscalationThreshold,\r\n          privacyMode: config.privacyMode,\r\n          deploymentDefault: config.deploymentDefaults.serverType,\r\n          deviceGatewayPrimaryPath: config.deviceGateway.primaryPath\r\n        },\r\n      status: 'success'\n    });\n\n    const publicConfig = sanitizePlatformConfig(config);\n    sendSuccess(res, { config: publicConfig }, {\n      legacy: {\n        message: 'backend.configuration_saved',\n        config: publicConfig\n      }\n    });\n  } catch (error: any) {\n    sendError(res, 500, {\r\n      code: 'backend.failed_to_save_configuration',\r\n      message: error?.message || 'backend.failed_to_save_configuration'\r\n    });\r\n  }\r\n});\r\n\r\nrouter.get('/notifications/deliveries', authenticate, requireRole('admin'), async (req: AuthenticatedRequest, res) => {\r\n  try {\r\n    const limit = Math.min(Number(req.query.limit || 20), 100);\r\n    const deliveries = await platformConfigService.listNotificationDeliveries(tenantOf(req), limit);\r\n    sendSuccess(res, { deliveries }, { legacy: { deliveries } });\r\n  } catch (error: any) {\r\n    sendError(res, 500, {\r\n      code: 'backend.failed_to_load_notification_deliveries',\r\n      message: error?.message || 'backend.failed_to_load_notification_deliveries'\r\n    });\r\n  }\r\n});\r\n\r\nrouter.post('/notifications/test', authenticate, requireRole('admin'), async (req: AuthenticatedRequest, res) => {\r\n  try {\r\n    const channelId = String(req.body?.channelId || '');\r\n    if (!channelId) {\r\n      return sendError(res, 400, {\r\n        code: 'backend.notification_channel_id_required',\r\n        message: 'backend.notification_channel_id_required'\r\n      });\r\n    }\r\n\r\n    const delivery = await notificationDispatcherService.testChannel(tenantOf(req), channelId, {\r\n      id: req.user?.userId || 'unknown',\r\n      email: req.user?.email,\r\n      ip: req.ip\r\n    });\r\n\r\n    sendSuccess(res, { delivery }, { legacy: { delivery } });\r\n  } catch (error: any) {\r\n    sendError(res, 500, {\r\n      code: 'backend.failed_to_send_test_notification',\r\n      message: error?.message || 'backend.failed_to_send_test_notification'\r\n    });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\dashboard.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":8,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":8,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[402,405],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[402,405],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":10,"column":51,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":10,"endColumn":54,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[465,468],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[465,468],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":11,"column":5,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":11,"endColumn":27},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":28,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":28,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1011,1014],"text":"unknown"},"desc":"Use `unknown` instead, this will force 