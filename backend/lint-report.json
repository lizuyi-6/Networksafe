"severity":2,"message":"Unsafe member access ['matched-at'] on an `any` value.","line":211,"column":67,"nodeType":"Literal","messageId":"unsafeMemberExpression","endLine":211,"endColumn":79},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .timestamp on an `any` value.","line":212,"column":60,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":212,"endColumn":69},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":213,"column":33,"nodeType":"Property","messageId":"anyAssignment","endLine":213,"endColumn":69},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":213,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":213,"endColumn":57},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":214,"column":33,"nodeType":"Property","messageId":"anyAssignment","endLine":214,"endColumn":65},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":214,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":214,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":215,"column":33,"nodeType":"Property","messageId":"anyAssignment","endLine":215,"endColumn":55},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .info on an `any` value.","line":215,"column":46,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":215,"endColumn":50},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":256,"column":37,"nodeType":"ReturnStatement","messageId":"unsafeReturn","