alyzer from '../utils/ip-analyzer';\r\nimport { isDemoMode } from '../config/app-mode';\r\n\r\ninterface TrafficStats {\r\n    totalRequests: number;\r\n    blockedRequests: number;\r\n    activeConnections: number;\r\n    successRate: number;\r\n    currentRPS: number;\r\n    history: { time: string; requests: number; blocked: number }[];\r\n    threats: { name: string; value: number; color: string }[];\r\n    systemMetrics?: {\r\n        cpu: number;\r\n        memory: number;\r\n        uptime: number;\r\n    };\r\n    avgProcessingTime?: number;\r\n    processingSamples?: number;\r\n}\r\n\r\nclass SimulationService extends EventEmitter {\r\n    private stats: TrafficStats = {\r\n        totalRequests: 0,\r\n        blockedRequests: 0,\r\n        activeConnections: 0,\r\n        successRate: 100,\r\n        currentRPS: 0,\r\n        history: [],\r\n        threats: []\r\n    };\r\n\r\n    private interval: NodeJS.Timeout | null = null;\r\n    private requestCount: number = 0;\r\n    private blockedCount: number = 0;\r\n    private avgProcessingTime = 0;\r\n    private processingTimes: number[] = [];\r\n    private readonly MAX_SAMPLES = 100;\r\n    private ipAnalyzer: IPAnalyzer;\r\n\r\n    constructor() {\r\n        super();\r\n        this.ipAnalyzer = new IPAnalyzer();\r\n        const now = new Date();\r\n        for (let i = 19; i >= 0; i--) {\r\n            const time = new Date(now.getTime() - i * 1000 * 5);\r\n            this.stats.history.push({\r\n                time: time.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),\r\n                requests: 0,\r\n                blocked: 0\r\n            });\r\n        }\r\n        this.setupTimingListener();\r\n        this.setupAttackListener();\r\n        this.start();\r\n    }\r\n\r\n    private setupTimingListener(): void {\r\n        this.on('requestTiming', (data: { duration: number; path: string }) => {\r\n            this.processingTimes.push(data.duration);\r\n\r\n            // Keep only the most recent 100 samples\r\n            if (this.processingTimes.length > this.MAX_SAMPLES) {\r\n                this.processingTimes.shift();\r\n            }\r\n\r\n            // Calculate average processing time\r\n            this.avgProcessingTime =\r\n                this.processingTimes.reduce((sum, time) => sum + time, 0) /\r\n                this.processingTimes.length;\r\n        });\r\n    }\r\n\r\n    private setupAttackListener(): void {\r\n        this.on('attackBlocked', (data: { ip: string }) => {\r\n            if (data.ip) {\r\n                this.ipAnalyzer.recordAttack(data.ip);\r\n            }\r\n        });\r\n    }\r\n\r\n    public recordRequest(blocked: boolean = false) {\r\n        this.requestCount++;\r\n        if (blocked) {\r\n            this.blockedCount++;\r\n        }\r\n    }\r\n\r\n    public start() {\r\n        if (this.interval) return;\r\n\r\n        this.interval = setInterval(() => {\r\n            this.updateStats();\r\n        }, 2000);\r\n    }\r\n\r\n    private updateStats() {\r\n        const agentSystem = getAgentSystem();\r\n\r\n        this.stats.currentRPS = Math.floor(this.requestCount / 2);\r\n        this.stats.totalRequests += this.requestCount;\r\n        this.stats.blockedRequests += this.blockedCount;\r\n\r\n        this.requestCount = 0;\r\n        this.blockedCount = 0;\r\n\r\n        if (this.stats.totalRequests > 0) {\r\n            this.stats.successRate = Number(\r\n                ((1 - this.stats.blockedRequests / this.stats.totalRequests) * 100).toFixed(2)\r\n            );\r\n        }\r\n\r\n        const loadAvg = os.loadavg();\r\n        const estimatedConnections = Math.max(0, Math.floor(loadAvg[0] * 10));\r\n        this.stats.activeConnections = estimatedConnections;\r\n\r\n        const now = new Date();\r\n        const newPoint = {\r\n            time: now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),\r\n            requests: this.stats.currentRPS,\r\n            blocked: this.blockedCount\r\n        };\r\n\r\n        this.stats.history.push(newPoint);\r\n        if (this.stats.history.length > 20) {\r\n            this.stats.history.shift();\r\n        }\r\n\r\n        if (agentSystem && agentSystem.isInitialized()) {\r\n            const probeReport = agentSystem.getProbeReport();\r\n            const alerts = probeReport.alerts || [];\r\n\r\n            const threatCounts: Record<string, number> = {};\r\n            alerts.forEach(alert => {\r\n                const type = alert.metadata?.threatType || 'Other';\r\n                threatCounts[type] = (threatCounts[type] || 0) + 1;\r\n            });\r\n\r\n            const colors = ['#ef4444', '#f97316', '#eab308', '#3b82f6', '#8b5cf6'];\r\n            this.stats.threats = Object.entries(threatCounts)\r\n                .slice(0, 5)\r\n                .map(([name, value], i) => ({\r\n                    name,\r\n                    value: Math.min(100, value * 10),\r\n                    color: colors[i % colors.length]\r\n                }));\r\n\r\n            this.stats.systemMetrics = {\r\n                cpu: probeReport.system?.cpu?.usage || 0,\r\n                memory: probeReport.system?.memory?.usagePercent || 0,\r\n                uptime: probeReport.uptime || 0\r\n            };\r\n        }\r\n\r\n        // 无论是否是演示模式，威胁列表为空时都保持为空\r\n        if (this.stats.threats.length === 0) {\r\n            this.stats.threats = [];\r\n        }\r\n    }\r\n\r\n    public getStats() {\r\n        const origins = this.ipAnalyzer.getAttackOrigins();\r\n        return {\r\n            ...this.stats,\r\n            avgProcessingTime: Math.round(this.avgProcessingTime),\r\n            processingSamples: this.processingTimes.length,\r\n            attackOrigins: origins.byCountry\r\n        };\r\n    }\r\n\r\n    public stop() {\r\n        if (this.interval) {\r\n            clearInterval(this.interval);\r\n            this.interval = null;\r\n        }\r\n    }\r\n}\r\n\r\nexport default new SimulationService();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\services\\socket-rate-limit.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":44,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":44,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1307,1310],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1307,1310],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":136,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":136,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4500,4503],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4500,4503],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":138,"column":13,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":138,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":138,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":138,"endColumn":30},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any