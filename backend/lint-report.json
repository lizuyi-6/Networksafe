ion","endLine":369,"endColumn":26},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":370,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":370,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .hostname on an `any` value.","line":370,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":370,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":371,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":371,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .platform on an `any` value.","line":371,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":371,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":372,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":372,"endColumn":23},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .status on an `any` value.","line":372,"column":17,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":372,"endColumn":23},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":373,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":373,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .created_at on an `any` value.","line":373,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":373,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":374,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":374,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .last_seen_at on an `any` value.","line":374,"column":21,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":374,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":375,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":375,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .tenant_id on an `any` value.","line":375,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":375,"endColumn":28}],"suppressedMessages":[],"errorCount":34,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Agent Authentication Service\r\n * SECURE FIX: Server-side agent registration and authentication\r\n * Prevents agent impersonation by maintaining a registry of authorized agents\r\n */\r\n\r\nimport crypto from 'crypto';\r\nimport { v4 as uuidv4 } from 'uuid';\r\nimport { getDatabase } from '../config/database';\r\nimport logger from '../utils/logger';\r\nimport redisService from './redis.service';\r\n\r\nconst ENCRYPTION_KEY = process.env.ENCRYPTION_KEY || '';\r\n// SECURITY FIX CVE-2026-013: Use environment variable for salt or generate random salt\r\nconst ENCRYPTION_SALT = process.env.ENCRYPTION_SALT || '';\r\nconst ALGORITHM = 'aes-256-gcm';\r\nconst IV_LENGTH = 12;\r\nconst AUTH_TAG_LENGTH = 16;\r\nconst KEY_LENGTH = 32;\r\n\r\nfunction getEncryptionKey(): Buffer {\r\n  if (!ENCRYPTION_KEY) {\r\n    throw new Error('ENCRYPTION_KEY environment variable is not set');\r\n  }\r\n\r\n  // SECURITY FIX: Require ENCRYPTION_SALT to be set - no fallback allowed\r\n  if (!ENCRYPTION_SALT) {\r\n    throw new Error('ENCRYPTION_SALT environment variable is required - no fallback allowed');\r\n  }\r\n  \r\n  const key = crypto.scryptSync(ENCRYPTION_KEY, ENCRYPTION_SALT, KEY_LENGTH);\r\n  return key;\r\n}\r\n\r\nfunction encryptSecretKey(plaintext: string): string {\r\n  const key = getEncryptionKey();\r\n  const iv = crypto.randomBytes(IV_LENGTH);\r\n  const cipher = crypto.createCipheriv(ALGORITHM, key, iv);\r\n  let encrypted = cipher.update(plaintext, 'utf8', 'hex');\r\n  encrypted += cipher.final('hex');\r\n  const authTag = cipher.getAuthTag();\r\n  return `${iv.toString('hex')}:${authTag.toString('hex')}:${encrypted}`;\r\n}\r\n\r\nfunction decryptSecretKey(encryptedData: string): string {\r\n  const key = getEncryptionKey();\r\n  const parts = encryptedData.split(':');\r\n  if (parts.length !== 3) {\r\n    throw new Error('Invalid encrypted data format');\r\n  }\r\n  const iv = Buffer.from(parts[0], 'hex');\r\n  const authTag = Buffer.from(parts[1], 'hex');\r\n  const encrypted = parts[2];\r\n  const decipher = crypto.createDecipheriv(ALGORITHM, key, iv);\r\n  decipher.setAuthTag(authTag);\r\n  let decrypted = decipher.update(encrypted, 'hex', 'utf8');\r\n  decrypted += decipher.final('utf8');\r\n  return decrypted;\r\n}\r\n\r\nexport interface AgentRegistration {\r\n  agentId: string;\r\n  hostname: string;\r\n  apiKey: string;\r\n  secretKey: string; // For HMAC signing\r\n  fingerprint: string; // Machine fingerprint\r\n  platform: string;\r\n  status: 'pending' | 'approved' | 'revoked';\r\n  createdAt: string;\r\n  lastSeenAt?: string;\r\n  tenantId?: string;\r\n}\r\n\r\nexport interface AuthenticatedAgent {\r\n  agentId: string;\r\n  hostname: string;\r\n  platform: string;\r\n  tenantId?: string;\r\n}\r\n\r\n/**\r\n * Generate a secure random API key\r\n */\r\nfunction generateApiKey(): string {\r\n  return `agent_${crypto.randomBytes(24).toString('hex')}`;\r\n}\r\n\r\n/**\r\n * Generate a secret key for HMAC signing\r\n */\r\nfunction generateSecretKey(): string {\r\n  return crypto.randomBytes(32).toString('hex');\r\n}\r\n\r\n/**\r\n * Create machine fingerprint from provided info\r\n */\r\nfunction createFingerprint(info: { hostname: string; platform: string; mac?: string }): string {\r\n  const data = `${info.hostname}|${info.platform}|${info.mac || 'unknown'}`;\r\n  return crypto.createHash('sha256').update(data).digest('hex');\r\n}\r\n\r\n/**\r\n * Agent Authentication Service\r\n */\r\nexport class AgentAuthService {\r\n  private readonly CACHE_TTL = 3600; // 1 hour\r\n  private agentRegistrationColumns: Set<string> | null = null;\r\n\r\n  private getAgentRegistrationColumns(): Set<string> {\r\n    if (this.agentRegistrationColumns) return this.agentRegistrationColumns;\r\n    const db = getDatabase();\r\n    const rows = db.prepare(`PRAGMA table_info(agent_registrations)`).all() as any[];\r\n    this.agentRegistrationColumns = new Set(rows.map((r) => String(r.name)));\r\n    return this.agentRegistrationColumns;\r\n  }\r\n\r\n  /**\r\n   * Register a new agent (admin operation)\r\n   * Server generates unique agentId and credentials\r\n   * SECURITY FIX CVE-2026-100: Validate hostname, prevent race condition\r\n   */\r\n  registerAgent(info: {\r\n    hostname: string;\r\n    platform: string;\r\n    mac?: string;\r\n    tenantId?: string;\r\n  }): AgentRegistration {\r\n    // SECURITY FIX CVE-2026-100: Validate and sanitize hostname\r\n    const sanitizedHostname = this.sanitizeHostname(info.hostname);\r\n\r\n    if (!sanitizedHostname) {\r\n      throw new Error('Invalid hostname: must be 1-253 alphanumeric characters, dots, or hyphens');\r\n    }\r\n\r\n    const db = getDatabase();\r\n\r\n    // SECURITY FIX CVE-2026-101: Use transaction to prevent race condition\r\n    // This prevents duplicate hostname registrations under high concurrency\r\n    const registrationSuccess = db.transaction<{ registration: AgentRegistration; apiKey: string } | null>(() => {\r\n      // Check for existing hostname (within transaction)\r\n      const existing = db.prepare(`\r\n        SELECT agent_id FROM agent_registrations WHERE hostname = ?\r\n      `).get(sanitizedHostname);\r\n\r\n      if (existing) {\r\n        // Throw error to rollback transaction\r\n        throw new Error(`Hostname '${sanitizedHostname}' is already registered`);\r\n      }\r\n\r\n      // Generate unique agent ID (server-controlled)\r\n      const agentId = `agent-${uuidv4()}`;\r\n\r\n      // Generate credentials\r\n      const apiKey = generateApiKey();\r\n      const secretKey = generateSecretKey();\r\n\r\n      // Create fingerprint\r\n      const fingerprint = createFingerprint({\r\n        hostname: sanitizedHostname,\r\n        platform: info.platform,\r\n        mac: info.mac\r\n      });\r\n\r\n      const registration: AgentRegistration = {\r\n        agentId,\r\n        hostname: sanitizedHostname,\r\n        apiKey,\r\n        secretKey,\r\n        fingerprint,\r\n        platform: info.platform,\r\n        status: 'approved', // Auto-approve for registered agents\r\n        createdAt: new Date().toISOString()\r\n      };\r\n\r\n      // SECURITY FIX CVE-2026-100: Parameterized query - hostname already sanitized\r\n      const cols = this.getAgentRegistrationColumns();\r\n      const encryptedSecretKey = encryptSecretKey(registration.secretKey);\r\n      if (cols.has('tenant_id')) {\r\n        db.prepare(`\r\n          INSERT INTO agent_registrations (\r\n            agent_id, hostname, api_key_hash, secret_key, fingerprint,\r\n            platform, status, created_at, tenant_id\r\n          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\r\n        `).run(\r\n          registration.agentId,\r\n          registration.hostname,\r\n          this.hashApiKey(registration.apiKey),\r\n          encryptedSecretKey,\r\n          JSON.stringify(registration.fingerprint),\r\n          registration.platform,\r\n          registration.status,\r\n          registration.createdAt,\r\n          info.tenantId || null\r\n        );\r\n      } else {\r\n        db.prepare(`\r\n          INSERT INTO agent_registrations (\r\n            agent_id, hostname, api_key_hash, secret_key, fingerprint,\r\n            platform, status, created_at\r\n          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\r\n        `).run(\r\n          registration.agentId,\r\n          registration.hostname,\r\n          this.hashApiKey(registration.apiKey),\r\n          encryptedSecretKey,\r\n          JSON.stringify(registration.fingerprint),\r\n          registration.platform,\r\n          registration.status,\r\n          registration.createdAt\r\n        );\r\n      }\r\n\r\n      return { registration, apiKey };\r\n    });\r\n\r\n    // Check if transaction was successful\r\n    if (!registrationSuccess || typeof registrationSuccess === 'symbol') {\r\n      // If transaction failed (returned true but no data), try again once\r\n      logger.warn('Agent registration transaction returned unexpected result, retrying...');\r\n      throw new Error('Agent registration failed due to concurrent registration. Please try again.');\r\n    }\r\n\r\n    const { registration, apiKey } = registrationSuccess as { registration: AgentRegistration; apiKey: string };\r\n\r\n    logger.info(`Agent registered: ${registration.agentId} (${sanitizedHostname})`);\r\n\r\n    return registration;\r\n  }\r\n\r\n  /**\r\n   * SECURITY FIX CVE-2026-100: Sanitize hostname to prevent SQL injection\r\n   */\r\n  private sanitizeHostname(hostname: string): string | null {\r\n    if (typeof hostname !== 'string') {\r\n      return null;\r\n    }\r\n\r\n    // Remove any characters that aren't alphanumeric, hyphen, or dot\r\n    const sanitized = hostname.replace(/[^a-zA-Z0-9.-]/g, '');\r\n\r\n    // Validate length\r\n    if (sanitized.length < 1 || sanitized.length > 253) {\r\n      return null;\r\n    }\r\n\r\n    // Prevent path traversal\r\n    if (sanitized.includes('..') || sanitized.startsWith('/') || sanitized.startsWith('.')) {\r\n      return null;\r\n    }\r\n\r\n    return sanitized;\r\n  }\r\n\r\n  /**\r\n   * Verify agent credentials on connection\r\n   */\r\n  async verifyAgent(agentId: string, apiKey: string): Promise<AuthenticatedAgent | null> {\r\n    try {\r\n      // Check cache first\r\n      const cacheKey = `agent:auth:${agentId}`;\r\n      const cached = await redisService.get(cacheKey);\r\n      if (cached) {\r\n        return JSON.parse(cached);\r\n      }\r\n\r\n      // Check database\r\n      const db = getDatabase();\r\n      const cols = this.getAgentRegistrationColumns();\r\n      const tenantSelect = cols.has('tenant_id') ? ', tenant_id' : '';\r\n      const result = db.prepare(`\r\n        SELECT agent_id, hostname, platform, api_key_hash, status${tenantSelect}\r\n        FROM agent_registrations\r\n        WHERE agent_id = ? AND status = 'approved'\r\n      `).get(agentId) as any;\r\n\r\n      if (!result) {\r\n        logger.warn(`Agent not found or not approved: ${agentId}`);\r\n        return null;\r\n      }\r\n\r\n      // Verify API key\r\n      if (!this.verifyApiKeyHash(apiKey, result.api_key_hash)) {\r\n        logger.warn(`Invalid API key for agent: ${agentId}`);\r\n        return null;\r\n      }\r\n\r\n      const agent: AuthenticatedAgent = {\r\n        agentId: result.agent_id,\r\n        hostname: result.hostname,\r\n        platform: result.platform,\r\n        tenantId: result.tenant_id || undefined\r\n      };\r\n\r\n      // Cache successful authentication\r\n      await redisService.set(cacheKey, JSON.stringify(agent), this.CACHE_TTL);\r\n\r\n      return agent;\r\n    } catch (error: any) {\r\n      logger.error('Agent verification error', { error, agentId });\r\n      return null;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Get agent's secret key for command signing\r\n   */\r\n  getAgentSecretKey(agentId: string): string | null {\r\n    const db = getDatabase();\r\n    const result = db.prepare(`\r\n      SELECT secret_key FROM agent_registrations\r\n      WHERE agent_id = ? AND status = 'approved'\r\n    `).get(agentId) as any;\r\n\r\n    if (!result?.secret_key) {\r\n      return null;\r\n    }\r\n\r\n    try {\r\n      return decryptSecretKey(result.secret_key);\r\n    } catch (error) {\r\n      logger.error('Failed to decrypt secret key', { error, agentId });\r\n      return null;\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Revoke agent credentials\r\n   */\r\n  revokeAgent(agentId: string): boolean {\r\n    const db = getDatabase();\r\n    db.prepare(`\r\n      UPDATE agent_registrations\r\n      SET status = 'revoked'\r\n      WHERE agent_id = ?\r\n    `).run(agentId);\r\n\r\n    // Clear cache\r\n    redisService.del(`agent:auth:${agentId}`);\r\n\r\n    logger.warn(`Agent revoked: ${agentId}`);\r\n    return true;\r\n  }\r\n\r\n  /**\r\n   * Update last seen timestamp\r\n   */\r\n  async updateLastSeen(agentId: string): Promise<void> {\r\n    const db = getDatabase();\r\n    db.prepare(`\r\n      UPDATE agent_registrations\r\n      SET last_seen_at = datetime('now')\r\n      WHERE agent_id = ?\r\n    `).run(agentId);\r\n  }\r\n\r\n  /**\r\n   * List all registered agents\r\n   */\r\n  listAgents(): AgentRegistration[] {\r\n    const db = getDatabase();\r\n    const results = db.prepare(`\r\n      SELECT agent_id, hostname, platform, status, created_at, last_seen_at, tenant_id\r\n      FROM agent_registrations\r\n      ORDER BY created_at DESC\r\n    `).all() as any[];\r\n\r\n    return results.map(r => ({\r\n      agentId: r.agent_id,\r\n      hostname: r.hostname,\r\n      platform: r.platform,\r\n      status: r.status,\r\n      createdAt: r.created_at,\r\n      lastSeenAt: r.last_seen_at,\r\n      tenantId: r.tenant_id || undefined,\r\n      apiKey: '', // Never return API keys\r\n      secretKey: '',\r\n      fingerprint: ''\r\n    }));\r\n  }\r\n\r\n  /**\r\n   * Hash API key for storage\r\n   */\r\n  private hashApiKey(apiKey: string): string {\r\n    return crypto.createHash('sha256').update(apiKey).digest('hex');\r\n  }\r\n\r\n  /**\r\n   * Verify API key against hash\r\n   */\r\n  private verifyApiKeyHash(apiKey: string, hash: string): boolean {\r\n    const computed = this.hashApiKey(apiKey);\r\n    return crypto.timingSafeEqual(\r\n      Buffer.from(computed, 'hex'),\r\n      Buffer.from(hash, 'hex')\r\n    );\r\n  }\r\n}\r\n\r\nexport default new AgentAuthService();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\anti-bot.middleware.ts","messages":[{"ruleId":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\security\\anti-bot.middleware.ts","nodeType":null}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Request, Response, NextFunction } from 'express';\r\nimport { v4 as uuidv4 } from 'uuid';\r\nimport redisService from './redis.service';\r\nimport logger from '../utils/logger';\r\nimport { defaultConfig as config } from '../config';\r\n\r\nconst KNOWN_BOTS = [\r\n  'googlebot',\r\n  'bingbot',\r\n  'slurp',\r\n  'duckduckbot',\r\n  'baiduspider',\r\n  'yandexbot',\r\n  'sogou',\r\n  'exabot',\r\n  'facebot',\r\n  'facebookexternalhit',\r\n  'ia_archiver',\r\n  'twitterbot',\r\n  'linkedinbot',\r\n  'embedly',\r\n  'quora link preview',\r\n  'showyoubot',\r\n  'outbrain',\r\n  'pinterest',\r\n  'applebot',\r\n  'semrushbot',\r\n];\r\n\r\nconst SUSPICIOUS_PATTERNS = [\r\n  /bot/i,\r\n  /spider/i,\r\n  /crawler/i,\r\n  /scraper/i,\r\n  /curl/i,\r\n  /wget/i,\r\n  /python/i,\r\n  /java/i,\r\n  /go-http-client/i,\r\n  /node/i,\r\n  /axios/i,\r\n  /http.rb/i,\r\n  /okhttp/i,\r\n  /allover/i,\r\n  /scan/i,\r\n  /harvest/i,\r\n];\r\n\r\nconst HONEYPOT_FIELD_NAME = 'website_confirm';\r\n\r\ninterface RequestFingerprint {\r\n  ip: string;\r\n  userAgent: string;\r\n  acceptLanguage: string;\r\n  acceptEncoding: string;\r\n}\r\n\r\ninterface RequestLog {\r\n  timestamp: number;\r\n  id: string;\r\n}\r\n\r\nexport class AntiBotMiddleware {\r\n  private readonly REQUEST_THRESHOLD = 100;\r\n  private readonly FAST_REQUEST_THRESHOLD = 10;\r\n  private readonly BLOCK_DURATION = 3600;\r\n\r\n  private requestLogsFallback: Map<string, RequestLog[]> = new Map();\r\n  private blockedIPsFallback: Map<string, { reason: string; blockedAt: string }> = new Map();\r\n  private lastRequestTimeFallback: Map<string, number> = new Map();\r\n\r\n  private generateFingerprint(req: Request): RequestFingerprint {\r\n    return {\r\n      ip: req.ip || req.connection.remoteAddress || 'unknown',\r\n      userAgent: req.headers['user-agent'] || 'unknown',\r\n      acceptLanguage: req.headers['accept-language'] || 'unknown',\r\n      acceptEncoding: req.headers['accept-encoding'] || 'unknown',\r\n    };\r\n  }\r\n\r\n  private isKnownBot(userAgent: string): boolean {\r\n    return KNOWN_BOTS.some(bot => userAgent.toLowerCase().includes(bot));\r\n  }\r\n\r\n  private isSuspiciousUserAgent(userAgent: string): boolean {\r\n    if (!userAgent || userAgent.length < 10) {\r\n      return true;\r\n    }\r\n\r\n    return SUSPICIOUS_PATTERNS.some(pattern => pattern.test(userAgent));\r\n  }\r\n\r\n  private async checkRequestRate(ip: string): Promise<{ allowed: boolean; rate: number }> {\r\n    const now = Date.now();\r\n    const windowStart = now - 60000;\r\n\r\n    try {\r\n      if (!redisService.isAvailable()) {\r\n        return this.checkRequestRateFallback(ip, now, windowStart);\r\n      }\r\n\r\n      const key = `antibot:requests:${ip}`;\r\n\r\n      await redisService.getClient().zadd(key, now, uuidv4());\r\n      await redisService.getClient().zremrangebyscore(key, 0, windowStart);\r\n      const count = await redisService.getClient().zcard(key);\r\n      await redisService.getClient().expire(key, 60);\r\n\r\n      const fastWindowStart = now - 10000;\r\n      const fastCount = await redisService.getClient().zcount(key, fastWindowStart, now);\r\n\r\n      const allowed = count < this.REQUEST_THRESHOLD && fastCount < this.FAST_REQUEST_THRESHOLD;\r\n\r\n      return { allowed, rate: count };\r\n    } catch (error) {\r\n      logger.error('Error checking request rate', { error, ip });\r\n      return { allowed: true, rate: 0 };\r\n    }\r\n  }\r\n\r\n  private checkRequestRateFallback(ip: string, now: number, windowStart: number): { allowed: boolean; rate: number } {\r\n    const logs = this.requestLogsFallback.get(ip) || [];\r\n    const recentLogs = logs.filter(l => l.timestamp > windowStart);\r\n    recentLogs.push({ timestamp: now, id: uuidv4() });\r\n    this.requestLogsFallback.set(ip, recentLogs);\r\n\r\n    const count = recentLogs.length;\r\n    const fastWindowStart = now - 10000;\r\n    const fastCount = recentLogs.filter(l => l.timestamp > fastWindowStart).length;\r\n\r\n    const allowed = count < this.REQUEST_THRESHOLD && fastCount < this.FAST_REQUEST_THRESHOLD;\r\n    return { allowed, rate: count };\r\n  }\r\n\r\n  private async checkFastSequentialRequests(ip: string): Promise<boolean> {\r\n    const now = Date.now();\r\n\r\n    try {\r\n      if (!redisService.isAvailable()) {\r\n        return this.checkFastSequentialRequestsFallback(ip, now);\r\n      }\r\n\r\n      const key = `antibot:fast:${ip}`;\r\n      const lastRequest = await redisService.get(key);\r\n      if (lastRequest) {\r\n        const timeSinceLastRequest = now - parseInt(lastRequest);\r\n        if (timeSinceLastRequest < 100) {\r\n          return true;\r\n        }\r\n      }\r\n\r\n      await redisService.set(key, now.toString(), 10);\r\n      return false;\r\n    } catch (error) {\r\n      logger.error('Error checking fast requests', { error, ip });\r\n      return false;\r\n    }\r\n  }\r\n\r\n  private checkFastSequentialRequestsFallback(ip: string, now: number): boolean {\r\n    const lastRequest = this.lastRequestTimeFallback.get(ip);\r\n    if (lastRequest) {\r\n      const timeSinceLastRequest = now - lastRequest;\r\n      if (timeSinceLastRequest < 100) {\r\n        return true;\r\n      }\r\n    }\r\n    this.lastRequestTimeFallback.set(ip, now);\r\n    return false;\r\n  }\r\n\r\n  private checkHoneypot(req: Request): boolean {\r\n    if (req.body && typeof req.body === 'object') {\r\n      const honeypotValue = req.body[HONEYPOT_FIELD_NAME];\r\n      if (honeypotValue && honeypotValue.toString().trim().length > 0) {\r\n        return true;\r\n      }\r\n    }\r\n    return false;\r\n  }\r\n\r\n  private async blockIP(ip: string, reason: string): Promise<void> {\r\n    try {\r\n      if (!redisService.isAvailable()) {\r\n        this.blockedIPsFallback.set(ip, {\r\n          reason,\r\n          blockedAt: new Date().toISOString(),\r\n        });\r\n        logger.warn('IP blocked (fallback)', { ip, reason });\r\n        return;\r\n      }\r\n\r\n      const key = `antibot:blocked:${ip}`;\r\n      await redisService.set(\r\n        key,\r\n        JSON.stringify({\r\n          reason,\r\n          blockedAt: new Date().toISOString(),\r\n        }),\r\n        this.BLOCK_DURATION\r\n      );\r\n\r\n      logger.warn('IP blocked for suspicious activity', { ip, reason });\r\n    } catch (error) {\r\n      logger.error('Error blocking IP', { error, ip });\r\n    }\r\n  }\r\n\r\n  private async isIPBlocked(ip: string): Promise<boolean> {\r\n    try {\r\n      if (!redisService.isAvailable()) {\r\n        return this.blockedIPsFallback.has(ip);\r\n      }\r\n\r\n      const key = `antibot:blocked:${ip}`;\r\n      return await redisService.exists(key);\r\n    } catch (error) {\r\n      logger.error('Error checking blocked IP', { error, ip });\r\n      return false;\r\n    }\r\n  }\r\n\r\n  public protect = async (req: Request, res: Response, next: NextFunction): Promise<void> => {\r\n    const fingerprint = this.generateFingerprint(req);\r\n    const userAgent = fingerprint.userAgent.toLowerCase();\r\n\r\n    try {\r\n      if (config.env !== 'production') {\r\n        logger.debug('Skipping anti-bot checks in development environment', { ip: fingerprint.ip });\r\n        next();\r\n        return;\r\n      }\r\n\r\n      const isBlocked = await this.isIPBlocked(fingerprint.ip);\r\n      if (isBlocked) {\r\n        logger.warn('Blocked IP attempted access', { ip: fingerprint.ip });\r\n        res.status(429).json({\r\n          error: 'backend.too_many_requests',\r\n          message: 'backend.your_access_has_been_temporarily_restricted_due_to_suspicious_activity',\r\n        });\r\n        return;\r\n      }\r\n\r\n      if (this.isKnownBot(userAgent)) {\r\n        logger.debug('Known bot allowed', { ip: fingerprint.ip, userAgent: fingerprint.userAgent });\r\n        next();\r\n        return;\r\n      }\r\n\r\n      if (fingerprint.ip === '127.0.0.1' || fingerprint.ip === '::1' || fingerprint.ip === 'localhost') {\r\n        logger.debug('Localhost allowed', { ip: fingerprint.ip });\r\n        next();\r\n        return;\r\n      }\r\n\r\n      if (this.isSuspiciousUserAgent(userAgent)) {\r\n        await this.blockIP(fingerprint.ip, 'Suspicious user agent');\r\n        logger.warn('Suspicious user agent blocked', { ip: fingerprint.ip, userAgent: fingerprint.userAgent });\r\n        res.status(403).json({\r\n          error: 'backend.access_denied',\r\n          message: 'backend.your_request_appears_to_be_automated',\r\n        });\r\n        return;\r\n      }\r\n\r\n      if (this.checkHoneypot(req)) {\r\n        await this.blockIP(fingerprint.ip, 'Honeypot triggered');\r\n        logger.warn('Honeypot triggered', { ip: fingerprint.ip });\r\n        res.status(403).json({\r\n          error: 'backend.access_denied',\r\n          message: 'backend.invalid_request',\r\n        });\r\n        return;\r\n      }\r\n\r\n      const rateCheck = await this.checkRequestRate(fingerprint.ip);\r\n      if (!rateCheck.allowed) {\r\n        await this.blockIP(fingerprint.ip, `Rate limit exceeded: ${rateCheck.rate} req/min`);\r\n        logger.warn('Rate limit exceeded', { ip: fingerprint.ip, rate: rateCheck.rate });\r\n        res.status(429).json({\r\n          error: 'backend.too_many_requests',\r\n          message: 'backend.rate_limit_exceeded_please_slow_down',\r\n          retryAfter: this.BLOCK_DURATION,\r\n        });\r\n        return;\r\n      }\r\n\r\n      const isFastSequential = await this.checkFastSequentialRequests(fingerprint.ip);\r\n      if (isFastSequential) {\r\n        logger.warn('Fast sequential requests detected', { ip: fingerprint.ip });\r\n      }\r\n\r\n      if (!req.headers['user-agent'] || !req.headers['accept']) {\r\n        logger.warn('Missing required headers', { ip: fingerprint.ip, headers: req.headers });\r\n        res.status(400).json({\r\n          error: 'backend.bad_request',\r\n          message: 'backend.invalid_request_headers',\r\n        });\r\n        return;\r\n      }\r\n\r\n      next();\r\n    } catch (error) {\r\n      logger.error('Error in anti-bot middleware', { error, ip: fingerprint.ip });\r\n      next();\r\n    }\r\n  };\r\n\r\n  public static getHoneypotFieldName(): string {\r\n    return HONEYPOT_FIELD_NAME;\r\n  }\r\n}\r\n\r\nexport default new AntiBotMiddleware();\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\audit-logger.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\security\\auth-security.service.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":133,"column":13,"nodeType":"ReturnStatement","messageId":"unsafeReturn","endLine":133,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-return","severity":2,"message":"Unsafe return of a value of type `any`.","line":187,"column":13,"nodeType":"ReturnSta