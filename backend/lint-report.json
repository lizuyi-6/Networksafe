  | 'automation'\r\n    | 'authentication'\r\n    | 'business_logic'\r\n    | 'other';\r\nexport type AnalysisPurpose = 'primary' | 'learning_verification';\r\nexport type ExperimentMode =\r\n    | 'single_agent'\r\n    | 'multi_agent_no_debate'\r\n    | 'multi_agent_with_debate';\r\n\r\nexport interface VerdictDistribution {\r\n    safe: number;\r\n    suspicious: number;\r\n    malicious: number;\r\n}\r\n\r\nexport interface DebateTriggerMetrics {\r\n    triggered: boolean;\r\n    labelConflict: boolean;\r\n    confidenceRange: number;\r\n    divergence: number;\r\n    reasons: string[];\r\n}\r\n\r\nexport interface StageLatencyBreakdown {\r\n    proxyMs: number;\r\n    roleAnalysisMs: number;\r\n    debateMs: number;\r\n    synthesisMs: number;\r\n    asyncReviewMs: number;\r\n    endToEndMs: number;\r\n}\r\n\r\nexport interface AgentIdentity {\r\n    id: string;\r\n    role: AgentRole;\r\n    team: AgentTeam;\r\n    name: string;\r\n    description: string;\r\n    capabilities: string[];\r\n}\r\n\r\nexport interface AgentConfig {\r\n    identity: AgentIdentity;\r\n    modelConfig: ModelConfig;\r\n    timeout: number;\r\n    modelTimeout?: number;\r\n    maxRetries: number;\r\n    heuristicOnly?: boolean;\r\n}\r\n\r\nexport interface ModelConfig {\r\n    provider: 'openai' | 'anthropic' | 'ollama' | 'zhipu' | 'dashscope' | 'local';\r\n    model: string;\r\n    temperature: number;\r\n    maxTokens: number;\r\n    baseURL?: string;\r\n    apiKey?: string;\r\n}\r\n\r\n// ============================================================================\r\n// Traffic & Request Types\r\n// ============================================================================\r\n\r\nexport interface TrafficRequest {\r\n    id: string;\r\n    timestamp: Date;\r\n    sourceIP: string;\r\n    method: string;\r\n    path: string;\r\n    headers: Record<string, string>;\r\n    body?: string;\r\n    queryParams?: Record<string, string>;\r\n    userAgent?: string;\r\n    rawLog?: string;\r\n    tenantId?: string;\r\n    routeModeOverride?: AIRoutingMode;\r\n    analysisPurpose?: AnalysisPurpose;\r\n    traceContext?: TraceContext;\r\n}\r\n\r\nexport interface TrafficContext {\r\n    request: TrafficRequest;\r\n    history: HistoricalBehavior[];\r\n    openApiSpec?: OpenApiSpec;\r\n    relatedRequests: TrafficRequest[];\r\n}\r\n\r\nexport interface HistoricalBehavior {\r\n    timestamp: Date;\r\n    action: string;\r\n    result: 'success' | 'failure' | 'blocked';\r\n    metadata?: Record<string, any>;\r\n}\r\n\r\nexport interface OpenApiSpec {\r\n    path: string;\r\n    method: string;\r\n    parameters: any[];\r\n    requestBody?: any;\r\n    responses: Record<string, any>;\r\n}\r\n\r\n// ============================================================================\r\n// Layer 2: Role Playing - Analysis Types\r\n// ============================================================================\r\n\r\nexport interface AnalysisResult {\r\n    agentId: string;\r\n    role: AgentRole;\r\n    verdict: SecurityVerdict;\r\n    confidence: number;\r\n    classScores: VerdictDistribution;\r\n    reasoning: string;\r\n    evidence: Evidence[];\r\n    attackFamily?: AttackFamily;\r\n    mutations?: RequestMutation[];\r\n    schemaValidation?: SchemaValidation;\r\n    anomalyScore?: number;\r\n    modelTier?: ModelTier;\r\n    routeMode?: AIRoutingMode | 'unknown';\r\n    modelLatencyMs?: number;\r\n    analysisLatencyMs?: number;\r\n}\r\n\r\nexport interface Evidence {\r\n    type: 'pattern' | 'behavior' | 'statistical' | 'semantic' | 'tool_result';\r\n    description: string;\r\n    severity: 'low' | 'medium' | 'high' | 'critical';\r\n    data: any;\r\n    source: string;\r\n}\r\n\r\nexport interface RequestMutation {\r\n    id: string;\r\n    originalValue: string;\r\n    mutatedValue: string;\r\n    mutationType: 'encoding' | 'injection' | 'bypass' | 'obfuscation';\r\n    description: string;\r\n    potentialImpact: string;\r\n}\r\n\r\nexport interface SchemaValidation {\r\n    isValid: boolean;\r\n    violations: SchemaViolation[];\r\n    matchedSchema?: string;\r\n}\r\n\r\nexport interface SchemaViolation {\r\n    field: string;\r\n    expected: string;\r\n    actual: string;\r\n    severity: 'error' | 'warning';\r\n}\r\n\r\n// ============================================================================\r\n// Layer 3: Scene Traversal - Distributed Tracing\r\n// ============================================================================\r\n\r\nexport interface TraceContext {\r\n    traceId: string;\r\n    spanId: string;\r\n    parentSpanId?: string;\r\n    service: string;\r\n    timestamp: Date;\r\n    duration?: number;\r\n    tags: Record<string, string>;\r\n}\r\n\r\nexport interface AttackNarrative {\r\n    id: string;\r\n    traceId: string;\r\n    timeline: NarrativeEvent[];\r\n    services: string[];\r\n    attackChain: AttackChainStep[];\r\n    summary: string;\r\n    riskLevel: 'low' | 'medium' | 'high' | 'critical';\r\n}\r\n\r\nexport interface NarrativeEvent {\r\n    timestamp: Date;\r\n    service: string;\r\n    event: string;\r\n    severity: 'info' | 'warning' | 'error' | 'critical';\r\n    correlationId: string;\r\n    rawLog?: string;\r\n}\r\n\r\nexport interface AttackChainStep {\r\n    order: number;\r\n    service: string;\r\n    action: string;\r\n    payload?: string;\r\n    result: 'success' | 'failure' | 'blocked';\r\n    nextStep?: number;\r\n}\r\n\r\n// ============================================================================\r\n// Layer 4: Capability Incarnation - Tool Execution\r\n// ============================================================================\r\n\r\nexport interface ToolDefinition {\r\n    name: string;\r\n    description: string;\r\n    parameters: ToolParameter[];\r\n    riskLevel: 'low' | 'medium' | 'high';\r\n    requiresSandbox: boolean;\r\n}\r\n\r\nexport interface ToolParameter {\r\n    name: string;\r\n    type: 'string' | 'number' | 'boolean' | 'object' | 'array';\r\n    required: boolean;\r\n    description: string;\r\n    validation?: string;\r\n}\r\n\r\nexport interface ToolExecutionRequest {\r\n    toolName: string;\r\n    parameters: Record<string, any>;\r\n    requestId: string;\r\n    timeout: number;\r\n    sandboxOptions?: SandboxOptions;\r\n}\r\n\r\nexport interface ToolExecutionResult {\r\n    requestId: string;\r\n    toolName: string;\r\n    success: boolean;\r\n    output: any;\r\n    error?: string;\r\n    executionTime: number;\r\n    sandboxed: boolean;\r\n}\r\n\r\nexport interface SandboxOptions {\r\n    enabled: boolean;\r\n    timeout: number;\r\n    memoryLimit: number;\r\n    networkAccess: boolean;\r\n    fileSystemAccess: boolean;\r\n}\r\n\r\n// ============================================================================\r\n// Layer 5: Debate Protocol\r\n// ============================================================================\r\n\r\nexport interface DebateSession {\r\n    id: string;\r\n    requestId: string;\r\n    topic: string;\r\n    participants: AgentRole[];\r\n    rounds: DebateRound[];\r\n    status: 'pending' | 'active' | 'resolved' | 'failed';\r\n    finalVerdict?: DebateVerdict;\r\n    startTime: Date;\r\n    endTime?: Date;\r\n    triggerMetrics?: DebateTriggerMetrics;\r\n    consensusReached?: boolean;\r\n    aggregateDistribution?: VerdictDistribution;\r\n    latencyMs?: number;\r\n}\r\n\r\nexport interface DebateRound {\r\n    roundNumber: number;\r\n    speaker: AgentRole;\r\n    position: 'attack' | 'defend' | 'analyze';\r\n    argument: string;\r\n    evidence: Evidence[];\r\n    timestamp: Date;\r\n}\r\n\r\nexport interface DebateVerdict {\r\n    decision: 'safe' | 'malicious' | 'requires_review';\r\n    confidence: number;\r\n    reasoning: string;\r\n    votingRecord: VotingRecord[];\r\n    arbitratorNotes: string;\r\n    aggregatedDistribution?: VerdictDistribution;\r\n}\r\n\r\nexport interface VotingRecord {\r\n    agentId: string;\r\n    role: AgentRole;\r\n    vote: 'safe' | 'malicious' | 'abstain';\r\n    confidence: number;\r\n    reasoning: string;\r\n}\r\n\r\n// ============================================================================\r\n// Layer 6: Heterogeneous Model Collaboration\r\n// ============================================================================\r\n\r\nexport type ModelTier = 'local' | 'cloud' | 'hybrid';\r\n\r\nexport interface ModelRoutingDecision {\r\n    tier: ModelTier;\r\n    model: string;\r\n    reason: string;\r\n    estimatedLatency: number;\r\n    estimatedCost: number;\r\n}\r\n\r\nexport interface ModelRequest {\r\n    id: string;\r\n    prompt: string;\r\n    context: Record<string, any>;\r\n    tier: ModelTier;\r\n    priority: 'low' | 'medium' | 'high' | 'critical';\r\n    timeout: number;\r\n    sanitizationLevel: 'none' | 'basic' | 'aggressive';\r\n    routeModeOverride?: AIRoutingMode;\r\n    analysisPurpose?: AnalysisPurpose;\r\n}\r\n\r\nexport interface ModelResponse {\r\n    id: string;\r\n    content: string;\r\n    model: string;\r\n    tier: ModelTier;\r\n    latency: number;\r\n    tokensUsed: number;\r\n    sanitized: boolean;\r\n    routeMode?: AIRoutingMode | 'unknown';\r\n}\r\n\r\nexport interface AmbiguityScore {\r\n    score: number;\r\n    factors: string[];\r\n    recommendation: 'local' | 'cloud';\r\n}\r\n\r\n// ============================================================================\r\n// Layer 7: Synthesis & Evolution\r\n// ============================================================================\r\n\r\nexport interface CaseFile {\r\n    id: string;\r\n    requestId: string;\r\n    timestamp: Date;\r\n    summary: string;\r\n    narrative: AttackNarrative;\r\n    debate: DebateSession;\r\n    verdict: DebateVerdict;\r\n    actions: CaseAction[];\r\n    lessons: LessonLearned[];\r\n    policyUpdates: PolicyUpdate[];\r\n}\r\n\r\nexport interface CaseAction {\r\n    action: 'block' | 'allow' | 'monitor' | 'investigate';\r\n    target: string;\r\n    reason: string;\r\n    duration?: number;\r\n    automated: boolean;\r\n}\r\n\r\nexport interface LessonLearned {\r\n    category: string;\r\n    insight: string;\r\n    confidence: number;\r\n    applicableScenarios: string[];\r\n}\r\n\r\nexport interface PolicyUpdate {\r\n    id: string;\r\n    type: 'rule_addition' | 'rule_modification' | 'rule_removal' | 'threshold_adjustment';\r\n    description: string;\r\n    changes: Record<string, any>;\r\n    effectiveFrom: Date;\r\n    source: 'human' | 'ai_evolution';\r\n}\r\n\r\n// ============================================================================\r\n// Message Types for Agent Communication\r\n// ============================================================================\r\n\r\nexport type MessageType = \r\n    | 'analysis_request'\r\n    | 'analysis_result'\r\n    | 'debate_invitation'\r\n    | 'debate_argument'\r\n    | 'debate_verdict'\r\n    | 'tool_request'\r\n    | 'tool_result'\r\n    | 'trace_event'\r\n    | 'model_request'\r\n    | 'model_response'\r\n    | 'case_file'\r\n    | 'policy_update'\r\n    | 'heartbeat_request'\r\n    | 'heartbeat_response';\r\n\r\nexport interface AgentMessage {\r\n    id: string;\r\n    type: MessageType;\r\n    from: AgentRole;\r\n    to: AgentRole | 'broadcast';\r\n    payload: any;\r\n    timestamp: Date;\r\n    correlationId?: string;\r\n    priority: 'low' | 'medium' | 'high' | 'critical';\r\n}\r\n\r\nexport interface MessageEnvelope {\r\n    message: AgentMessage;\r\n    routingKey: string;\r\n    ttl: number;\r\n    retryCount: number;\r\n}\r\n\r\n// ============================================================================\r\n// Final Decision Output\r\n// ============================================================================\r\n\r\nexport interface SecurityDecision {\r\n    id: string;\r\n    requestId: string;\r\n    timestamp: Date;\r\n    verdict: 'allow' | 'block' | 'challenge' | 'monitor';\r\n    confidence: number;\r\n    threatLevel: 'none' | 'low' | 'medium' | 'high' | 'critical';\r\n    reasoning: string;\r\n    evidence: Evidence[];\r\n    actions: CaseAction[];\r\n    caseFileId: string;\r\n    processingTime: number;\r\n    layersActivated: number[];\r\n    aggregatedDistribution?: VerdictDistribution;\r\n    analysisResults?: AnalysisResult[];\r\n    experimentMode?: ExperimentMode;\r\n    attackFamily?: AttackFamily;\r\n    routeMode?: AIRoutingMode | 'unknown';\r\n    stageLatencies?: StageLatencyBreakdown;\r\n    debateSession?: DebateSession;\r\n}\r\n\r\n// ============================================================================\r\n// System Configuration\r\n// ============================================================================\r\n\r\nexport interface MultiAgentConfig {\r\n    enabled: boolean;\r\n    experimentMode?: ExperimentMode;\r\n    primarySingleAgentRole?: 'socrates' | 'plato' | 'aristotle';\r\n    heuristicOnly?: boolean;\r\n    useIsolatedBus?: boolean;\r\n    layers: {\r\n        l1_collaboration: LayerConfig;\r\n        l2_rolePlaying: LayerConfig;\r\n        l3_sceneTraversal: LayerConfig;\r\n        l4_capability: LayerConfig;\r\n        l5_debate: LayerConfig;\r\n        l6_heterogeneous: LayerConfig;\r\n        l7_synthesis: LayerConfig;\r\n    };\r\n    models: {\r\n        local: ModelConfig;\r\n        cloud: ModelConfig;\r\n    };\r\n    thresholds: {\r\n        debateTrigger: number;\r\n        debateDivergence: number;\r\n        debateConfidenceRange: number;\r\n        cloudEscalation: number;\r\n        autoBlock: number;\r\n    };\r\n    timeouts: {\r\n        analysis: number;\r\n        debate: number;\r\n        toolExecution: number;\r\n        modelResponse: number;\r\n    };\r\n}\r\n\r\nexport interface LayerConfig {\r\n    enabled: boolean;\r\n    priority: number;\r\n    timeout: number;\r\n    maxConcurrency: number;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\debate\\debate-protocol.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":82,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":82,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2520,2523],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2520,2523],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":84,"column":71,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":84,"endColumn":78}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Debate Protocol - L5: Debate Protocol Layer\r\n * Core innovation: Multi-agent debate with arbitrator resolution\r\n */\r\n\r\nimport { v4 as uuidv4 } from 'uuid';\r\nimport {\r\n    DebateSession,\r\n    DebateRound,\r\n    DebateVerdict,\r\n    VotingRecord,\r\n    AgentRole,\r\n    AnalysisResult,\r\n    TrafficRequest,\r\n    Evidence,\r\n    DebateTriggerMetrics\r\n} from '../core/types';\r\nimport { MessageBus } from '../core/message-bus';\r\nimport {\r\n    averagePairwiseDivergence,\r\n    blendDistributions,\r\n    confidenceFromDistribution,\r\n    dominantVerdict,\r\n    normalizeDistribution\r\n} from '../core/scoring';\r\nimport logger from '../../utils/logger';\r\n\r\nexport interface DebateConfig {\r\n    maxRounds: number;\r\n    roundTimeout: number;\r\n    consensusThreshold: number;\r\n    arbitratorModel: string;\r\n}\r\n\r\nconst DEFAULT_DEBATE_CONFIG: DebateConfig = {\r\n    maxRounds: 3,\r\n    roundTimeout: 30000,\r\n    consensusThreshold: 0.7,\r\n    arbitratorModel: 'cloud'\r\n};\r\n\r\nexport class DebateProtocol {\r\n    private sessions: Map<string, DebateSession> = new Map();\r\n    private messageBus: MessageBus;\r\n    private config: DebateConfig;\r\n\r\n    constructor(messageBus: MessageBus, config: Partial<DebateConfig> = {}) {\r\n        this.messageBus = messageBus;\r\n        this.config = { ...DEFAULT_DEBATE_CONFIG, ...config };\r\n    }\r\n\r\n    async initiateDebate(\r\n        requestId: string,\r\n        results: AnalysisResult[],\r\n        request: TrafficRequest,\r\n        triggerMetrics?: DebateTriggerMetrics\r\n    ): Promise<DebateSession> {\r\n        const sessionId = uuidv4();\r\n        const startedAt = Date.now();\r\n        \r\n        const session: DebateSession = {\r\n            id: sessionId,\r\n            requestId,\r\n            topic: this.generateDebateTopic(results, request),\r\n            participants: ['socrates', 'plato', 'aristotle', 'arbitrator'],\r\n            rounds: [],\r\n            status: 'active',\r\n            startTime: new Date(),\r\n            triggerMetrics\r\n        };\r\n\r\n        this.sessions.set(sessionId, session);\r\n\r\n        try {\r\n            await this.runDebateRounds(session, results, request);\r\n            session.finalVerdict = await this.arbitrate(session, results);\r\n            session.status = 'resolved';\r\n            session.endTime = new Date();\r\n            session.consensusReached = this.checkConsensus(session, results);\r\n            session.aggregateDistribution = session.finalVerdict.aggregatedDistribution;\r\n            session.latencyMs = Date.now() - startedAt;\r\n        } catch (error: any) {\r\n            session.status = 'failed';\r\n            logger.error(`Debate ${sessionId} failed`, { error: error.message });\r\n        }\r\n\r\n        return session;\r\n    }\r\n\r\n    private generateDebateTopic(results: AnalysisResult[], request: TrafficRequest): string {\r\n        const conflictingViews = results.filter((result) => dominantVerdict(result.classScores) !== dominantVerdict(results[0]?.classScores || result.classScores));\r\n        \r\n        if (conflictingViews.length > 0) {\r\n            return `Conflict resolution: Agents disagree on request to ${request.path}`;\r\n        }\r\n\r\n        const lowConfidence = results.filter(r => r.confidence < 0.7);\r\n        if (lowConfidence.length > 0) {\r\n            return `Confidence review: Low confidence analysis for ${request.path}`;\r\n        }\r\n\r\n        return `Standard review: Analysis of request to ${request.path}`;\r\n    }\r\n\r\n    private async runDebateRounds(\r\n        session: DebateSession,\r\n        results: AnalysisResult[],\r\n        request: TrafficRequest\r\n    ): Promise<void> {\r\n        for (let roundNum = 1; roundNum <= this.config.maxRounds; roundNum++) {\r\n            logger.debug(`Debate ${session.id}: Starting round ${roundNum}`);\r\n\r\n            const round = await this.executeRound(session, roundNum, results, request);\r\n            session.rounds.push(round);\r\n\r\n            if (this.checkConsensus(session, results)) {\r\n                logger.info(`Debate ${session.id}: Consensus reached at round ${roundNum}`);\r\n                break;\r\n            }\r\n        }\r\n    }\r\n\r\n    private async executeRound(\r\n        session: DebateSession,\r\n        roundNum: number,\r\n        results: AnalysisResult[],\r\n        request: TrafficRequest\r\n    ): Promise<DebateRound> {\r\n        const speaker = this.determineSpeaker(roundNum);\r\n        const position = this.determinePosition(speaker);\r\n        \r\n        const argument = await this.generateArgument(speaker, position, results, request, session.rounds);\r\n        \r\n        return {\r\n            roundNumber: roundNum,\r\n            speaker,\r\n            position,\r\n            argument: argument.content,\r\n            evidence: argument.evidence,\r\n            timestamp: new Date()\r\n        };\r\n    }\r\n\r\n    private determineSpeaker(roundNum: number): AgentRole {\r\n        const order: AgentRole[] = ['socrates', 'plato', 'aristotle'];\r\n        return order[(roundNum - 1) % order.length];\r\n    }\r\n\r\n    private determinePosition(speaker: AgentRole): 'attack' | 'defend' | 'analyze' {\r\n        switch (speaker) {\r\n            case 'socrates': return 'attack';\r\n            case 'plato': return 'defend';\r\n            case 'aristotle': return 'analyze';\r\n            default: return 'analyze';\r\n        }\r\n    }\r\n\r\n    private async generateArgument(\r\n        speaker: AgentRole,\r\n        position: 'attack' | 'defend' | 'analyze',\r\n        results: AnalysisResult[],\r\n        request: TrafficRequest,\r\n        previousRounds: DebateRound[]\r\n    ): Promise<{ content: string; evidence: Evidence[] }> {\r\n        const speakerResult = results.find(r => r.role === speaker);\r\n        const otherResults = results.filter(r => r.role !== speaker);\r\n\r\n        let argumentPrompt = this.buildArgumentPrompt(speaker, position, speakerResult, otherResults, request);\r\n\r\n        if (previousRounds.length > 0) {\r\n            argumentPrompt += '\\n\\n--- PREVIOUS ARGUMENTS ---\\n';\r\n            for (const round of previousRounds) {\r\n                argumentPrompt += `${round.speaker} (${round.position}): ${round.argument}\\n`;\r\n            }\r\n        }\r\n\r\n        const evidence: Evidence[] = [];\r\n        let content = '';\r\n\r\n        switch (speaker) {\r\n            case 'socrates':\r\n                content = this.generateSocratesArgument(speakerResult, otherResults, previousRounds);\r\n                if (speakerResult?.mutations && speakerResult.mutations.length > 0) {\r\n                    evidence.push({\r\n                        type: 'semantic',\r\n                        description: `${speakerResult.mutations.length} potential bypass mutation(s) identified`,\r\n                        severity: 'high',\r\n                        data: { mutations: speakerResult.mutations.slice(0, 3) },\r\n                        source: 'Socrates'\r\n                    });\r\n                }\r\n                break;\r\n\r\n            case 'plato':\r\n                content = this.generatePlatoArgument(speakerResult, otherResults, previousRounds);\r\n                if (speakerResult?.schemaValidation && !speakerResult.schemaValidation.isValid) {\r\n                    evidence.push({\r\n                        type: 'pattern',\r\n                        description: `${speakerResult.schemaValidation.violations.length} schema violation(s) found`,\r\n                        severity: 'medium',\r\n                        data: { violations: speakerResult.schemaValidation.violations.slice(0, 3) },\r\n                        source: 'Plato'\r\n                    });\r\n                }\r\n                break;\r\n\r\n            case 'aristotle':\r\n                content = this.generateAristotleArgument(speakerResult, otherResults, previousRounds);\r\n                if (speakerResult?.anomalyScore && speakerResult.anomalyScore > 0.5) {\r\n                    evidence.push({\r\n                        type: 'statistical',\r\n                        description: `Anomaly score: ${(speakerResult.anomalyScore * 100).toFixed(0)}%`,\r\n                        severity: speakerResult.anomalyScore > 0.7 ? 'high' : 'medium',\r\n                        data: { anomalyScore: speakerResult.anomalyScore },\r\n                        source: 'Aristotle'\r\n                    });\r\n                }\r\n                break;\r\n        }\r\n\r\n        return { content, evidence };\r\n    }\r\n\r\n    private buildArgumentPrompt(\r\n        speaker: AgentRole,\r\n        position: string,\r\n        speakerResult: AnalysisResult | undefined,\r\n        otherResults: AnalysisResult[],\r\n        request: TrafficRequest\r\n    ): string {\r\n        return `You are ${speaker} in a security debate about request ${request.path}.\r\n        \r\nYour position: ${position}\r\nYour initial analysis: ${speakerResult?.reasoning || 'No analysis available'}\r\nYour verdict: ${speakerResult?.verdict || 'unknown'}\r\nYour confidence: ${speakerResult?.confidence || 0}\r\n\r\nOther agents' views:\r\n${otherResults.map(r => `- ${r.role}: ${r.verdict} (${(r.confidence * 100).toFixed(0)}% confidence)`).join('\\n')}\r\n\r\nProvide a concise argument supporting your position. Focus on evidence and reasoning.`;\r\n    }\r\n\r\n    private generateSocratesArgument(\r\n        speakerResult: AnalysisResult | undefined,\r\n        otherResults: AnalysisResult[],\r\n        previousRounds: DebateRound[]\r\n    ): string {\r\n        const mutations = speakerResult?.mutations || [];\r\n        const mutationCount = mutations.length;\r\n\r\n        if (mutationCount > 0) {\r\n            const topMutations = mutations.slice(0, 3).map(m => m.description).join(', ');\r\n            return `I've identified ${mutationCount} potential attack vector(s). The most concerning are: ${topMutations}. ` +\r\n                   `Even if current defenses hold, these mutations could bypass detection. ` +\r\n                   `I argue for treating this as potentially malicious.`;\r\n        }\r\n\r\n        const platoResult = otherResults.find(r => r.role === 'plato');\r\n        if (platoResult?.verdict === 'safe') {\r\n            return `While Plato argues the request is schema-compliant, compliance doesn't guarantee safety. ` +\r\n                   `I question whether we've considered all possible attack variations. ` +\r\n                   `What if the attacker is probing for information?`;\r\n        }\r\n\r\n        return `I maintain my position that this request warrants careful scrutiny. ` +\r\n               `The absence of obvious attack patterns doesn't prove innocence.`;\r\n    }\r\n\r\n    private generatePlatoArgument(\r\n        speakerResult: AnalysisResult | undefined,\r\n        otherResults: AnalysisResult[],\r\n        previousRounds: DebateRound[]\r\n    ): string {\r\n        const schemaValidation = speakerResult?.schemaValidation;\r\n\r\n        if (schemaValidation?.isValid) {\r\n            return `The request conforms to expected schema and patterns. ` +\r\n                   `All parameters are properly formatted and within acceptable ranges. ` +\r\n                   `I see no technical violations that would warrant blocking.`;\r\n        }\r\n\r\n        if (schemaValidation && !schemaValidation.isValid) {\r\n            const violations = schemaValidation.violations.slice(0, 3);\r\n            return `I've detected ${schemaValidation.violations.length} schema violation(s): ` +\r\n                   `${violations.map(v => v.field).join(', ')}. ` +\r\n                   `However, these may be errors rather than attacks. Context matters.`;\r\n        }\r\n\r\n        return `Based on schema analysis, I find the request ${speakerResult?.verdict || 'unknown'}. ` +\r\n               `The technical evidence supports this assessment.`;\r\n    }\r\n\r\n    private generateAristotleArgument(\r\n        speakerResult: AnalysisResult | undefined,\r\n        otherResults: AnalysisResult[],\r\n        previousRounds: DebateRound[]\r\n    ): string {\r\n        const anomalyScore = speakerResult?.anomalyScore || 0;\r\n\r\n        if (anomalyScore > 0.7) {\r\n            return `Statistical analysis reveals significant anomalies (score: ${(anomalyScore * 100).toFixed(0)}%). ` +\r\n                   `The behavior pattern deviates substantially from historical norms. ` +\r\n                   `This warrants elevated concern regardless of technical compliance.`;\r\n        }\r\n\r\n        if (anomalyScore > 0.4) {\r\n            return `I observe moderate behavioral anomalies (score: ${(anomalyScore * 100).toFixed(0)}%). ` +\r\n                   `While not definitive, the pattern suggests increased monitoring is warranted. ` +\r\n                   `Historical context adds important nuance to the technical analysis.`;\r\n        }\r\n\r\n        return `Behavioral analysis shows no significant anomalies. ` +\r\n               `The request pattern aligns with historical norms for this source. ` +\r\n               `From a statistical perspective, this appears within normal parameters.`;\r\n    }\r\n\r\n    private checkConsensus(session: DebateSession, results: AnalysisResult[]): boolean {\r\n        if (session.rounds.length < 2) return false;\r\n\r\n        const dominantLabels = new Set(results.map((result) => dominantVerdict(result.classScores)));\r\n        if (dominantLabels.size === 1) {\r\n            return true;\r\n        }\r\n\r\n        return averagePairwiseDivergence(results) <= Math.max(0.05, 1 - this.config.consensusThreshold);\r\n    }\r\n\r\n    private async arbitrate(\r\n        session: DebateSession,\r\n        results: AnalysisResult[]\r\n    ): Promise<DebateVerdict> {\r\n        const votingRecord = this.collectVotes(results);\r\n        const initialAggregateDistribution = blendDistributions(results);\r\n        const aggregateDistribution = this.applyDebateAdjustments(\r\n            initialAggregateDistribution,\r\n            session,\r\n            results,\r\n            votingRecord\r\n        );\r\n        const aggregateVerdict = dominantVerdict(aggregateDistribution);\r\n        \r\n        const maliciousVotes = votingRecord.filter(v => v.vote === 'malicious').length;\r\n        const safeVotes = votingRecord.filter(v => v.vote === 'safe').length;\r\n        const abstainVotes = votingRecord.filter(v => v.vote === 'abstain').length;\r\n        const totalVotes = votingRecord.length;\r\n        const hardEvidenceCount = session.rounds.reduce((sum, round) => (\r\n            sum + round.evidence.filter((evidence) => evidence.severity === 'high' || evidence.severity === 'critical').length\r\n        ), 0);\r\n\r\n        let decision: 'safe' | 'malicious' | 'requires_review';\r\n        let confidence: number;\r\n        let reasoning: string;\r\n\r\n        if (\r\n            maliciousVotes >= Math.ceil(totalVotes / 2) ||\r\n            aggregateDistribution.malicious >= 0.58 ||\r\n            hardEvidenceCount >= 2\r\n        ) {\r\n            const avgConfidence = votingRecord\r\n                .filter(v => v.vote === 'malicious')\r\n                .reduce((sum, v) => sum + v.confidence, 0) / Math.max(maliciousVotes, 1);\r\n            \r\n            decision = 'malicious';\r\n            confidence = Math.max(avgConfidence, confidenceFromDistribution(aggregateDistribution));\r\n            reasoning = `Aggregated posterior favors malicious with ${(aggregateDistribution.malicious * 100).toFixed(0)}% support`;\r\n        } else if (\r\n            safeVotes >= Math.ceil(totalVotes / 2) ||\r\n            (\r\n                safeVotes >= 1 &&\r\n                maliciousVotes === 0 &&\r\n                aggregateDistribution.safe >= aggregateDistribution.malicious\r\n            ) ||\r\n            (\r\n                safeVotes >= 1 &&\r\n                maliciousVotes === 1 &&\r\n                abstainVotes >= 1 &&\r\n                session.triggerMetrics?.labelConflict\r\n            )\r\n        ) {\r\n            const avgConfidence = votingRecord\r\n                .filter(v => v.vote === 'safe')\r\n                .reduce((sum, v) => sum + v.confidence, 0) / Math.max(safeVotes, 1);\r\n            \r\n            decision = 'safe';\r\n            confidence = Math.max(avgConfidence, confidenceFromDistribution(aggregateDistribution));\r\n            reasoning = `Aggregated posterior favors safe with ${(aggregateDistribution.safe * 100).toFixed(0)}% support`;\r\n        } else if (aggregateVerdict === 'malicious' && abstainVotes > 0 && safeVotes > 0) {\r\n            decision = 'requires_review';\r\n            confidence = Math.max(0.55, confidenceFromDistribution(aggregateDistribution));\r\n            reasoning = `Debate preserved ambiguity after conflicting evidence; ${(aggregateDistribution.suspicious * 100).toFixed(0)}% posterior mass remains in review space`;\r\n        } else {\r\n            decision = 'requires_review';\r\n            confidence = Math.max(0.5, confidenceFromDistribution(aggregateDistribution));\r\n            reasoning = `Posterior remains ambiguous with ${(aggregateDistribution.suspicious * 100).toFixed(0)}% suspicious support`;\r\n        }\r\n\r\n        const arbitratorNotes = this.generateArbitratorNotes(session, votingRecord);\r\n\r\n        return {\r\n            decision,\r\n            confidence,\r\n            reasoning,\r\n            votingRecord,\r\n            arbitratorNotes,\r\n            aggregatedDistribution: normalizeDistribution(aggregateDistribution)\r\n        };\r\n    }\r\n\r\n    private applyDebateAdjustments(\r\n        aggregateDistribution: ReturnType<typeof normalizeDistribution>,\r\n        session: DebateSession,\r\n        results: AnalysisResult[],\r\n        votingRecord: VotingRecord[]\r\n    ) {\r\n        const adjusted = {\r\n            ...normalizeDistribution(aggregateDistribution)\r\n        };\r\n        const maliciousVotes = votingRecord.filter((vote) => vote.vote === 'malicious').length;\r\n        const safeVotes = votingRecord.filter((vote) => vote.vote === 'safe').length;\r\n        const abstainVotes = votingRecord.filter((vote) => vote.vote === 'abstain').length;\r\n        const divergence = session.triggerMetrics?.divergence ?? averagePairwiseDivergence(results);\r\n\r\n        if (maliciousVotes >= 2) {\r\n            adjusted.malicious += 0.08;\r\n            adjusted.suspicious -= 0.03;\r\n            adjusted.safe -= 0.05;\r\n        } else if (maliciousVotes === 1 && safeVotes >= 1 && abstainVotes >= 1 && divergence >= 0.08) {\r\n            adjusted.safe += 0.1;\r\n            adjusted.suspicious += 0.03;\r\n            adjusted.malicious -= 0.13;\r\n        } else if (safeVotes >= 2 && divergence >= 0.08) {\r\n            adjusted.safe += 0.07;\r\n            adjusted.suspicious -= 0.04;\r\n            adjusted.malicious -= 0.03;\r\n        }\r\n\r\n        return normalizeDistribution(adjusted);\r\n    }\r\n\r\n    private collectVotes(results: AnalysisResult[]): VotingRecord[] {\r\n        return results.map(result => ({\r\n            agentId: result.agentId,\r\n            role: result.role,\r\n            vote: this.mapVerdictToVote(dominantVerdict(result.classScores)),\r\n            confidence: result.confidence,\r\n            reasoning: result.reasoning\r\n        }));\r\n    }\r\n\r\n    private mapVerdictToVote(verdict: string): 'safe' | 'malicious' | 'abstain' {\r\n        switch (verdict) {\r\n            case 'safe': return 'safe';\r\n            case 'malicious': return 'malicious';\r\n            case 'suspicious': return 'abstain';\r\n            default: return 'abstain';\r\n        }\r\n    }\r\n\r\n    private generateArbitratorNotes(session: DebateSession, votingRecord: VotingRecord[]): string {\r\n        const rounds = session.rounds.length;\r\n        const keyEvidence: string[] = [];\r\n\r\n        for (const round of session.rounds) {\r\n            for (const evidence of round.evidence) {\r\n                keyEvidence.push(`${round.speaker}: ${evidence.description}`);\r\n            }\r\n        }\r\n\r\n        let notes = `Debate completed in ${rounds} round(s).\\n`;\r\n        notes += `Key evidence presented:\\n`;\r\n        notes += keyEvidence.slice(0, 5).map(e => `- ${e}`).join('\\n');\r\n        \r\n        if (keyEvidence.length > 5) {\r\n            notes += `\\n... and ${keyEvidence.length - 5} more items`;\r\n        }\r\n\r\n        return notes;\r\n    }\r\n\r\n    getSession(sessionId: string): DebateSession | undefined {\r\n        return this.sessions.get(sessionId);\r\n    }\r\n\r\n    getActiveDebates(): DebateSession[] {\r\n        return Array.from(this.sessions.values()).filter(s => s.status === 'active');\r\n    }\r\n\r\n    cleanupCompletedDebates(maxAge: number = 3600000): void {\r\n        const now = Date.now();\r\n        for (const [id, session] of this.sessions) {\r\n            if (session.status !== 'active' && \r\n                session.endTime && \r\n                now - session.endTime.getTime() > maxAge) {\r\n                this.sessions.delete(id);\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\nexport default DebateProtocol;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\demo\\demo.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":172,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":172,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6314,6317],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6314,6317],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":173,"column":50,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":173,"endColumn":57}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * Multi-Agent Decision System - Demo Script\r\n * Demonstrates all 7 layers of the AI security analysis system\r\n */\r\n\r\nimport {\r\n    MultiAgentDecisionSystem,\r\n    TrafficRequest,\r\n    ProbeReport,\r\n    SecurityDecision\r\n} from '../index';\r\nimport logger from '../../utils/logger';\r\n\r\nconst SAMPLE_REQUESTS: TrafficRequest[] = [\r\n    {\r\n        id: 'req-normal-001',\r\n        timestamp: new Date(),\r\n        sourceIP: '192.168.1.100',\r\n        method: 'GET',\r\n        path: '/api/users/profile',\r\n        headers: {\r\n            'content-type': 'application/json',\r\n            'user-agent': 'Mozilla/5.0'\r\n        },\r\n        queryParams: { id: '12345' },\r\n        userAgent: 'Mozilla/5.0'\r\n    },\r\n    {\r\n        id: 'req-sql-injection-001',\r\n        timestamp: new Date(),\r\n        sourceIP: '10.0.0.50',\r\n        method: 'POST',\r\n        path: '/api/login',\r\n        headers: {\r\n            'content-type': 'application/x-www-form-urlencoded'\r\n        },\r\n        body: \"username=admin' OR '1'='1' --&password=anything\",\r\n        userAgent: 'sqlmap/1.0'\r\n    },\r\n    {\r\n        id: 'req-xss-001',\r\n        timestamp: new Date(),\r\n        sourceIP: '172.16.0.25',\r\n        method: 'POST',\r\n        path: '/api/comments',\r\n        headers: {\r\n            'content-type': 'application/json'\r\n        },\r\n        body: '{\"comment\": \"<script>alert(document.cookie)</script>\"}',\r\n        userAgent: 'Mozilla/5.0'\r\n    },\r\n    {\r\n        id: 'req-path-traversal-001',\r\n        timestamp: new Date(),\r\n        sourceIP: '192.168.100.200',\r\n        method: 'GET',\r\n        path: '/api/files?path=../../../etc/passwd',\r\n        headers: {},\r\n        queryParams: { path: '../../../etc/passwd' },\r\n        userAgent: 'curl/7.0'\r\n    },\r\n    {\r\n        id: 'req-rate-abuse-001',\r\n        timestamp: new Date(),\r\n        sourceIP: '203.0.113.50',\r\n        method: 'POST',\r\n        path: '/api/auth/login',\r\n        headers: {},\r\n        body: '{\"username\": \"admin\", \"password\": \"test\"}',\r\n        userAgent: 'python-requests/2.0'\r\n    }\r\n];\r\n\r\nclass MultiAgentDemo {\r\n    private system: MultiAgentDecisionSystem;\r\n    private results: { request: TrafficRequest; decision: SecurityDecision }[] = [];\r\n\r\n    constructor() {\r\n        this.system = new MultiAgentDecisionSystem({\r\n            enabled: true,\r\n            thresholds: {\r\n                debateTrigger: 0.3,\r\n                debateDivergence: 0.3,\r\n                debateConfidenceRange: 0.3,\r\n                cloudEscalation: 0.6,\r\n                autoBlock: 0.85\r\n            }\r\n        });\r\n    }\r\n\r\n    async run(): Promise<void> {\r\n        console.log('\\n');\r\n        console.log('╔════════════════════════════════════════════════════════════════╗');\r\n        console.log('║     AetherGuard Multi-Agent Decision System - 7 Layer Demo      ║');\r\n        console.log('╚════════════════════════════════════════════════════════════════╝');\r\n        console.log('\\n');\r\n\r\n        await this.initialize();\r\n        this.setupProbeMonitoring();\r\n        await this.runAnalysis();\r\n        this.displayResults();\r\n        await this.showSystemStats();\r\n        await this.shutdown();\r\n    }\r\n\r\n    private async initialize(): Promise<void> {\r\n        console.log('📦 Initializing Multi-Agent Decision System...');\r\n        console.log('   └─ L1: Multi-Agent Collaboration');\r\n        console.log('   └─ L2: Role Playing (Socrates, Plato, Aristotle)');\r\n        console.log('   └─ L3: Scene Traversal');\r\n        console.log('   └─ L4: Capability Incarnation');\r\n        console.log('   └─ L5: Debate Protocol');\r\n        console.log('   └─ L6: Heterogeneous Model Collaboration');\r\n        console.log('   └─ L7: Synthesis & Self-Evolution');\r\n        console.log('');\r\n\r\n        await this.system.initialize();\r\n        console.log('✅ System initialized successfully\\n');\r\n    }\r\n\r\n    private setupProbeMonitoring(): void {\r\n        this.system.onProbeReport((report: ProbeReport) => {\r\n            const memUsage = report.system.memory.usagePercent.toFixed(1);\r\n            const cpuCores = report.system.cpu.cores;\r\n            const alerts = report.alerts.length;\r\n            \r\n            process.stdout.write(\r\n                `\\r🔍 Probe: Memory ${memUsage}% | CPU ${cpuCores} cores | Alerts ${alerts}   `\r\n            );\r\n        });\r\n    }\r\n\r\n    private async runAnalysis(): Promise<void> {\r\n        console.log('🔍 Running security analysis on sample requests...\\n');\r\n\r\n        for (const request of SAMPLE_REQUESTS) {\r\n            console.log(`\\n━━━ Request: ${request.id} ━━━`);\r\n            console.log(`   Method: ${request.method}`);\r\n            console.log(`   Path: ${request.path}`);\r\n            console.log(`   Source IP: ${request.sourceIP}`);\r\n            if (request.body) {\r\n                console.log(`   Body: ${request.body.substring(0, 80)}${request.body.length > 80 ? '...' : ''}`);\r\n            }\r\n\r\n            try {\r\n                const startTime = Date.now();\r\n                const decision = await this.system.analyze(request);\r\n                const processingTime = Date.now() - startTime;\r\n\r\n                this.results.push({ request, decision });\r\n\r\n                console.log(`\\n   📊 Decision: ${this.formatVerdict(decision.verdict)}`);\r\n                console.log(`   📈 Confidence: ${(decision.confidence * 100).toFixed(1)}%`);\r\n                console.log(`   ⚠️  Threat Level: ${decision.threatLevel.toUpperCase()}`);\r\n                console.log(`   ⏱️  Processing Time: ${processingTime}ms`);\r\n                console.log(`   🔬 Layers Activated: L${decision.layersActivated.join(', L')}`);\r\n                \r\n                if (decision.evidence.length > 0) {\r\n                    console.log(`   📋 Evidence:`);\r\n                    for (const evidence of decision.evidence.slice(0, 3)) {\r\n                        console.log(`      - [${evidence.severity.toUpperCase()}] ${evidence.description}`);\r\n                    }\r\n                }\r\n\r\n                if (decision.actions.length > 0) {\r\n                    console.log(`   🎯 Actions:`);\r\n                    for (const action of decision.actions) {\r\n                        console.log(`      - ${action.action.toUpperCase()}: ${action.target} (${action.reason})`);\r\n                    }\r\n                }\r\n\r\n            } catch (error: any) {\r\n                console.log(`   ❌ Error: ${error.message}`);\r\n            }\r\n\r\n            await this.delay(500);\r\n        }\r\n    }\r\n\r\n    private displayResults(): void {\r\n        console.log('\\n\\n');\r\n        console.log('╔════════════════════════════════════════════════════════════════╗');\r\n        console.log('║                      Analysis Summary                          ║');\r\n        console.log('╚════════════════════════════════════════════════════════════════╝');\r\n\r\n        const allowed = this.results.filter(r => r.decision.verdict === 'allow').length;\r\n        const blocked = this.results.filter(r => r.decision.verdict === 'block').length;\r\n        const monitored = this.results.filter(r => r.decision.verdict === 'monitor').length;\r\n        const challenged = this.results.filter(r => r.decision.verdict === 'challenge').length;\r\n\r\n        console.log(`\\n   Total Requests Analyzed: ${this.results.length}`);\r\n        console.log(`   ✅ Allowed: ${allowed}`);\r\n        console.log(`   🚫 Blocked: ${blocked}`);\r\n        console.log(`   👁️  Monitored: ${monitored}`);\r\n        console.log(`   ❓ Challenged: ${challenged}`);\r\n\r\n        const avgConfidence = this.results.reduce((sum, r) => sum + r.decision.confidence, 0) / this.results.length;\r\n        console.log(`   📊 Average Confidence: ${(avgConfidence * 100).toFixed(1)}%`);\r\n\r\n        const avgProcessingTime = this.results.reduce((sum, r) => sum + r.decision.processingTime, 0) / this.results.length;\r\n        console.log(`   ⏱️  Average Processing Time: ${avgProcessingTime.toFixed(0)}ms`);\r\n    }\r\n\r\n    private async showSystemStats(): Promise<void> {\r\n        console.log('\\n');\r\n        console.log('╔════════════════════════════════════════════════════════════════╗');\r\n        console.log('║                      System Statistics                         ║');\r\n        console.log('╚════════════════════════════════════════════════════════════════╝\\n');\r\n\r\n        const stats = this.system.getStats();\r\n        const health = this.system.getHealthStatus();\r\n        const probeReport = this.system.getProbeReport();\r\n\r\n        console.log('   🏥 Health Status:', health.status.toUpperCase());\r\n        console.log('      - System:', health.details.system);\r\n        console.log('      - Agents:', health.details.agents);\r\n        console.log('      - Message Bus:', health.details.messageBus);\r\n\r\n        console.log('\\n   📊 Orchestrator:');\r\n        console.log(`      - Active Tasks: ${stats.orchestrator.activeTasks}`);\r\n        console.log(`      - Registered Agents: ${stats.orchestrator.registeredAgents}`);\r\n\r\n        console.log('\\n   📨 Message Bus:');\r\n        console.log(`      - Queue Size: ${stats.messageBus.queueSize}`);\r\n        console.log(`      - Subscriptions: ${stats.messageBus.subscriptionCount}`);\r\n\r\n        console.log('\\n   🧠 Synthesis Engine:');\r\n        console.log(`      - Case Files: ${stats.synthesis.totalCaseFiles}`);\r\n        console.log(`      - Lessons Learned: ${stats.synthesis.totalLessons}`);\r\n        console.log(`      - Policy Updates: ${stats.synthesis.totalPolicyUpdates}`);\r\n\r\n        if (stats.synthesis.topPatterns.length > 0) {\r\n            console.log('\\n   🔍 Top Detected Patterns:');\r\n            for (const pattern of stats.synthesis.topPatterns.slice(0, 5)) {\r\n                console.log(`      - ${pattern.pattern}: ${pattern.frequency} occurrences`);\r\n            }\r\n        }\r\n\r\n        console.log('\\n   💾 System Resources:');\r\n        console.log(`      - Memory Usage: ${probeReport.system.memory.usagePercent.toFixed(1)}%`);\r\n        console.log(`      - CPU Cores: ${probeReport.system.cpu.cores}`);\r\n        console.log(`      - Process Uptime: ${(probeReport.system.process.uptime / 60).toFixed(1)} minutes`);\r\n    }\r\n\r\n    private async shutdown(): Promise<void> {\r\n        console.log('\\n\\n🛑 Shutting down system...');\r\n        await this.system.shutdown();\r\n        console.log('✅ Shutdown complete. Goodbye!\\n');\r\n    }\r\n\r\n    private formatVerdict(verdict: string): string {\r\n        const icons: Record<string, string> = {\r\n            'allow': '✅ ALLOW',\r\n            'block': '🚫 BLOCK',\r\n            'monitor': '👁️  MONITOR',\r\n            'challenge': '❓ CHALLENGE'\r\n        };\r\n        return icons[verdict] || verdict.toUpperCase();\r\n    }\r\n\r\n    private delay(ms: number): Promise<void> {\r\n        return new Promise(resolve => setTimeout(resolve, ms));\r\n    }\r\n}\r\n\r\nasync function main(): Promise<void> {\r\n    const demo = new MultiAgentDemo();\r\n    await demo.run();\r\n}\r\n\r\nmain().catch(console.error);\r\n\r\nexport { MultiAgentDemo };\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":151,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":151,"endColumn":34},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":151,"column":31,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":151,"endColumn":34,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6323,6326],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6323,6326],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":231,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":231,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9368,9371],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9368,9371],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":233,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":233,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":239,"column":50,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":239,"endColumn":57}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Multi-Agent Decision System - Main Entry Point\r\n * 7-Layer Architecture for AI-powered Security Analysis\r\n * \r\n * L1: Multi-Agent Collaboration - Traffic routing to specialized agents\r\n * L2: Role Playing - Socrates (Red), Plato (Blue), Aristotle (Analyst)\r\n * L3: Scene Traversal - Distributed tracing and attack narrative\r\n * L4: Capability Incarnation - Safe tool execution\r\n * L5: Debate Protocol - Multi-agent debate with arbitrator\r\n * L6: Heterogeneous Model - Local + Cloud model collaboration\r\n * L7: Synthesis - Case files and self-evolution\r\n */\r\n\r\nimport {\r\n    MultiAgentConfig,\r\n    TrafficRequest,\r\n    TrafficContext,\r\n    SecurityDecision,\r\n    CaseFile,\r\n    AnalysisResult,\r\n    DebateSession,\r\n    AttackNarrative\r\n} from './core/types';\r\nimport { AgentOrchestrator } from './core/agent-orchestrator';\r\nimport { MessageBus, globalMessageBus } from './core/message-bus';\r\nimport { DebateProtocol } from './debate/debate-protocol';\r\nimport { TraceContextManager, traceContextManager } from './tracing/trace-context';\r\nimport { ToolExecutor, toolExecutor } from './capabilities/tool-executor';\r\nimport { ModelRouter, modelRouter } from './models/model-router';\r\nimport { SynthesisEngine, synthesisEngine } from './synthesis/synthesis-engine';\r\nimport { ProbeAgent, ProbeReport, AgentHeartbeat } from './monitoring/probe-agent';\nimport logger from '../utils/logger';\r\n\r\nexport * from './core/types';\r\nexport { AgentOrchestrator } from './core/agent-orchestrator';\r\nexport { BaseAgent, ExpertAgent } from './core/base-agent';\r\nexport { MessageBus, globalMessageBus } from './core/message-bus';\r\nexport { SocratesAgent } from './roles/socrates-agent';\r\nexport { PlatoAgent } from './roles/plato-agent';\r\nexport { AristotleAgent } from './roles/aristotle-agent';\r\nexport { DebateProtocol } from './debate/debate-protocol';\r\nexport { TraceContextManager, traceContextManager } from './tracing/trace-context';\r\nexport { ToolExecutor, toolExecutor } from './capabilities/tool-executor';\r\nexport { ModelRouter, modelRouter } from './models/model-router';\r\nexport { SynthesisEngine, synthesisEngine } from './synthesis/synthesis-engine';\r\nexport { ProbeAgent, ProbeReport, AgentHeartbeat, SystemMetrics, ProbeAlert, ProbeConfig } from './monitoring/probe-agent';\r\n\r\nconst DEFAULT_CONFIG: MultiAgentConfig = {\r\n    enabled: true,\r\n    experimentMode: 'multi_agent_with_debate',\r\n    primarySingleAgentRole: 'aristotle',\r\n    heuristicOnly: false,\r\n    useIsolatedBus: false,\r\n    layers: {\r\n        l1_collaboration: { enabled: true, priority: 1, timeout: 5000, maxConcurrency: 10 },\r\n        l2_rolePlaying: { enabled: true, priority: 2, timeout: 10000, maxConcurrency: 3 },\r\n        l3_sceneTraversal: { enabled: true, priority: 3, timeout: 5000, maxConcurrency: 5 },\r\n        l4_capability: { enabled: true, priority: 4, timeout: 30000, maxConcurrency: 5 },\r\n        l5_debate: { enabled: true, priority: 5, timeout: 60000, maxConcurrency: 3 },\r\n        l6_heterogeneous: { enabled: true, priority: 6, timeout: 30000, maxConcurrency: 10 },\r\n        l7_synthesis: { enabled: true, priority: 7, timeout: 5000, maxConcurrency: 5 }\r\n    },\r\n    models: {\r\n        local: {\r\n            provider: 'ollama',\r\n            model: 'llama3:8b',\r\n            temperature: 0.3,\r\n            maxTokens: 2000,\r\n            baseURL: 'http://localhost:11434'\r\n        },\r\n        cloud: {\r\n            provider: 'zhipu',\r\n            model: 'glm-4',\r\n            temperature: 0.2,\r\n            maxTokens: 4000\r\n        }\r\n    },\r\n    thresholds: {\r\n        debateTrigger: 0.3,\r\n        debateDivergence: 0.3,\r\n        debateConfidenceRange: 0.3,\r\n        cloudEscalation: 0.6,\r\n        autoBlock: 0.85\r\n    },\r\n    timeouts: {\r\n        analysis: 10000,\r\n        debate: 60000,\r\n        toolExecution: 30000,\r\n        modelResponse: 30000\r\n    }\r\n};\r\n\r\nexport class MultiAgentDecisionSystem {\n    private config: MultiAgentConfig;\r\n    private orchestrator: AgentOrchestrator;\r\n    private debateProtocol: DebateProtocol;\r\n    private traceManager: TraceContextManager;\r\n    private toolExecutor: ToolExecutor;\r\n    private modelRouter: ModelRouter;\r\n    private synthesisEngine: SynthesisEngine;\r\n    private probeAgent: ProbeAgent;\r\n    private messageBus: MessageBus;\r\n    private initialized: boolean = false;\r\n    private probeReportCallback: ((report: ProbeReport) => void) | null = null;\r\n\r\n    constructor(config: Partial<MultiAgentConfig> = {}) {\r\n        this.config = { ...DEFAULT_CONFIG, ...config };\r\n        this.messageBus = this.config.useIsolatedBus ? new MessageBus() : globalMessageBus;\r\n        this.orchestrator = new AgentOrchestrator(this.config, this.messageBus);\r\n        this.debateProtocol = new DebateProtocol(this.messageBus);\r\n        this.traceManager = traceContextManager;\r\n        this.toolExecutor = toolExecutor;\r\n        this.modelRouter = modelRouter;\r\n        this.synthesisEngine = synthesisEngine;\r\n        this.probeAgent = new ProbeAgent(\r\n            {\r\n                identity: {\r\n                    id: 'probe-main',\r\n                    role: 'orchestrator',\r\n                    team: 'analyst',\r\n                    name: 'ProbeAgent',\r\n                    description: 'System monitoring and health check agent',\r\n                    capabilities: ['monitoring', 'health_check', 'metrics_collection']\r\n                },\r\n                modelConfig: this.config.models.local,\r\n                timeout: 5000,\r\n                maxRetries: 1\r\n            },\r\n            this.messageBus\r\n        );\r\n    }\r\n\r\n    async initialize(): Promise<void> {\r\n        if (this.initialized) {\r\n            logger.warn('Multi-Agent Decision System already initialized');\r\n            return;\r\n        }\r\n\r\n        this.messageBus.setModelRequestHandler(async (request) => {\r\n            return this.modelRouter.route(request);\r\n        });\r\n\r\n        await this.orchestrator.initialize();\r\n        await this.probeAgent.initialize();\r\n\r\n        // Register orchestrator agents with probe agent for monitoring\r\n        const orchestratorAgents = this.orchestrator.getAgents();\r\n        for (const [role, agent] of Object.entries(orchestratorAgents)) {\r\n            this.probeAgent.updateAgentHeartbeat({\r\n                agentId: agent.getIdentity().id,\r\n                role: role as any,\r\n                status: 'healthy',\r\n                lastSeen: new Date(),\r\n                responseTime: 0,\r\n                tasksCompleted: 0,\r\n                tasksPending: 0,\r\n                errorCount: 0,\r\n                memoryUsage: 0,\r\n                cpuUsage: 0\r\n            });\r\n        }\r\n\r\n        this.probeAgent.onReport((report) => {\r\n            if (this.probeReportCallback) {\r\n                this.probeReportCallback(report);\r\n            }\r\n        });\r\n\r\n        this.initialized = true;\r\n        logger.info('Multi-Agent Decision System initialized', {\r\n            layers: Object.keys(this.config.layers).length,\r\n            thresholds: this.config.thresholds,\r\n            probeAgent: 'active'\r\n        });\r\n    }\r\n\r\n    async analyze(\r\n        request: TrafficRequest,\r\n        context?: Partial<TrafficContext>\r\n    ): Promise<SecurityDecision> {\r\n        if (!this.initialized) {\r\n            await this.initialize();\r\n        }\r\n\r\n        const startTime = Date.now();\r\n        const traceId = request.traceContext?.traceId || this.createTraceId();\r\n\r\n        this.traceManager.addTraceEvent(traceId, {\r\n            service: 'multi-agent-system',\r\n            event: `Analysis started for ${request.method} ${request.path}`,\r\n            severity: 'info'\r\n        });\r\n\r\n        try {\r\n            const decision = await this.orchestrator.analyze(request, context);\r\n\r\n            this.traceManager.addTraceEvent(traceId, {\r\n                service: 'orchestrator',\r\n                event: `Decision: ${decision.verdict} (confidence: ${(decision.confidence * 100).toFixed(0)}%)`,\r\n                severity: decision.threatLevel === 'critical' ? 'critical' :\r\n                          decision.threatLevel === 'high' ? 'error' :\r\n                          decision.threatLevel === 'medium' ? 'warning' : 'info'\r\n            });\r\n\r\n            const narrative = this.traceManager.buildAttackNarrative(traceId);\r\n            \r\n            const debate = decision.debateSession;\r\n\r\n            const caseFile = this.synthesisEngine.generateCaseFile(\r\n                decision,\r\n                narrative,\r\n                debate || this.createEmptyDebate(request.id)\r\n            );\r\n\r\n            decision.caseFileId = caseFile.id;\r\n            decision.processingTime = Date.now() - startTime;\r\n            decision.layersActivated = Array.from(new Set([...(decision.layersActivated || []), 7])).sort();\r\n            if (decision.stageLatencies) {\r\n                decision.stageLatencies.synthesisMs = Number((Date.now() - startTime - (decision.stageLatencies.roleAnalysisMs + decision.stageLatencies.debateMs)).toFixed(2));\r\n                decision.stageLatencies.endToEndMs = Number((Date.now() - startTime).toFixed(2));\r\n            }\r\n\r\n            this.traceManager.addTraceEvent(traceId, {\r\n                service: 'synthesis',\r\n                event: `Case file generated: ${caseFile.id}`,\r\n                severity: 'info'\r\n            });\r\n\r\n            return decision;\r\n\r\n        } catch (error: any) {\r\n            logger.error('Multi-Agent analysis failed', { \r\n                error: error.message, \r\n                requestId: request.id \r\n            });\r\n\r\n            this.traceManager.addTraceEvent(traceId, {\r\n                service: 'error-handler',\r\n                event: `Analysis failed: ${error.message}`,\r\n                severity: 'critical'\r\n            });\r\n\r\n            throw error;\r\n        }\r\n    }\r\n\r\n    private createTraceId(): string {\r\n        return `trace-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;\r\n    }\r\n\r\n    private createEmptyDebate(requestId: string): DebateSession {\r\n        return {\r\n            id: 'no-debate',\r\n            requestId,\r\n            topic: 'No debate required',\r\n            participants: [],\r\n            rounds: [],\r\n            status: 'resolved',\r\n            startTime: new Date(),\r\n            finalVerdict: {\r\n                decision: 'safe',\r\n                confidence: 0.5,\r\n                reasoning: 'No debate was triggered',\r\n                votingRecord: [],\r\n                arbitratorNotes: 'Skipped debate phase',\r\n                aggregatedDistribution: {\r\n                    safe: 0.5,\r\n                    suspicious: 0.3,\r\n                    malicious: 0.2\r\n                }\r\n            }\r\n        };\r\n    }\r\n\r\n    async shutdown(): Promise<void> {\r\n        await this.probeAgent.shutdown();\r\n        await this.orchestrator.shutdown();\r\n        this.messageBus.shutdown();\r\n        this.initialized = false;\r\n        logger.info('Multi-Agent Decision System shutdown complete');\r\n    }\r\n\r\n    onProbeReport(callback: (report: ProbeReport) => void): void {\r\n        this.probeReportCallback = callback;\r\n    }\r\n\r\n    getProbeReport(): ProbeReport {\n        return this.probeAgent.generateReport();\n    }\n\n    getProbeAgentStates(): AgentHeartbeat[] {\n        return this.probeAgent.getAgentStates();\n    }\n\n    recordProbeAgentHeartbeat(heartbeat: Partial<AgentHeartbeat> & { agentId: string }): void {\n        this.probeAgent.updateAgentHeartbeat(heartbeat);\n    }\n\n    getHealthStatus(): { status: 'healthy' | 'degraded' | 'unhealthy'; details: Record<string, string> } {\n        return this.probeAgent.getHealthStatus();\n    }\n\r\n    getStats(): {\r\n        orchestrator: ReturnType<AgentOrchestrator['getStats']>;\r\n        messageBus: ReturnType<MessageBus['getStats']>;\r\n        traceManager: ReturnType<TraceContextManager['getStats']>;\r\n        modelRouter: ReturnType<ModelRouter['getStats']>;\r\n        synthesis: ReturnType<SynthesisEngine['getEvolutionStats']>;\r\n    } {\r\n        return {\r\n            orchestrator: this.orchestrator.getStats(),\r\n            messageBus: this.messageBus.getStats(),\r\n            traceManager: this.traceManager.getStats(),\r\n            modelRouter: this.modelRouter.getStats(),\r\n            synthesis: this.synthesisEngine.getEvolutionStats()\r\n        };\r\n    }\r\n\r\n    getConfig(): MultiAgentConfig {\r\n        return { ...this.config };\r\n    }\r\n\r\n    isInitialized(): boolean {\r\n        return this.initialized;\r\n    }\r\n}\r\n\r\nexport const createMultiAgentSystem = (config?: Partial<MultiAgentConfig>): MultiAgentDecisionSystem => {\r\n    return new MultiAgentDecisionSystem(config);\r\n};\r\n\r\nexport default MultiAgentDecisionSystem;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\agents\\base-investigation.agent.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":48,"column":83,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":48,"endColumn":86,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1799,1802],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1799,1802],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":55,"column":64,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":55,"endColumn":67,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2082,2085],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2082,2085],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript