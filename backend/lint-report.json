{\r\n        this.cleanupInterval = setInterval(() => {\r\n            this.cleanupExpiredFlows();\r\n        }, 60000);\r\n    }\r\n\r\n    getOrCreateFlow(packet: ParsedPacket): FlowState | null {\r\n        if (!packet.ipHeader || !packet.transportHeader) {\r\n            return null;\r\n        }\r\n\r\n        const key = this.createFlowKey(packet);\r\n        const keyStr = this.flowKeyToString(key);\r\n\r\n        let flowId = this.flowByKey.get(keyStr);\r\n        if (flowId) {\r\n            const flow = this.flows.get(flowId);\r\n            if (flow) {\r\n                this.updateFlow(flow, packet);\r\n                return flow;\r\n            }\r\n        }\r\n\r\n        if (this.flows.size >= this.maxFlows) {\r\n            this.evictOldestFlow();\r\n        }\r\n\r\n        const newFlow = this.createFlow(key, packet);\r\n        this.flows.set(newFlow.id, newFlow);\r\n        this.flowByKey.set(keyStr, newFlow.id);\r\n\r\n        return newFlow;\r\n    }\r\n\r\n    private createFlow(key: FlowKey, packet: ParsedPacket): FlowState {\r\n        const now = BigInt(Date.now()) * BigInt(1_000_000);\r\n        \r\n        const flow: FlowState = {\r\n            key,\r\n            id: uuidv4(),\r\n            startTime: now,\r\n            lastActivity: now,\r\n            packetCount: 1,\r\n            byteCount: packet.ipHeader?.totalLength || 0,\r\n            state: this.getInitialState(packet),\r\n            direction: packet.metadata.direction\r\n        };\r\n\r\n        if (packet.protocol === 'tcp') {\r\n            const tcp = packet.transportHeader as any;\r\n            if (tcp?.flags?.syn && !tcp?.flags?.ack) {\r\n                flow.direction = 'outbound';\r\n            }\r\n        }\r\n\r\n        return flow;\r\n    }\r\n\r\n    private updateFlow(flow: FlowState, packet: ParsedPacket): void {\r\n        flow.lastActivity = BigInt(Date.now()) * BigInt(1_000_000);\r\n        flow.packetCount++;\r\n        flow.byteCount += packet.ipHeader?.totalLength || 0;\r\n\r\n        if (packet.protocol === 'tcp') {\r\n            this.updateTCPState(flow, packet);\r\n        }\r\n    }\r\n\r\n    private createFlowKey(packet: ParsedPacket): FlowKey {\r\n        const ip = packet.ipHeader!;\r\n        const transport = packet.transportHeader as any;\r\n\r\n        return {\r\n            sourceIP: ip.sourceIP,\r\n            destIP: ip.destIP,\r\n            sourcePort: transport.sourcePort || 0,\r\n            destPort: transport.destPort || 0,\r\n            protocol: packet.protocol as 'tcp' | 'udp' | 'icmp'\r\n        };\r\n    }\r\n\r\n    private flowKeyToString(key: FlowKey): string {\r\n        return `${key.sourceIP}:${key.sourcePort}->${key.destIP}:${key.destPort}:${key.protocol}`;\r\n    }\r\n\r\n    private getInitialState(packet: ParsedPacket): TCPState | 'active' {\r\n        if (packet.protocol === 'tcp') {\r\n            const tcp = packet.transportHeader as any;\r\n            if (tcp?.flags?.syn && !tcp?.flags?.ack) {\r\n                return 'syn_sent';\r\n            }\r\n            if (tcp?.flags?.syn && tcp?.flags?.ack) {\r\n                return 'syn_received';\r\n            }\r\n            return 'established';\r\n        }\r\n        return 'active';\r\n    }\r\n\r\n    private updateTCPState(flow: FlowState, packet: ParsedPacket): void {\r\n        const tcp = packet.transportHeader as any;\r\n        if (!tcp?.flags) return;\r\n\r\n        const currentState = flow.state as TCPState;\r\n\r\n        if (tcp.flags.rst) {\r\n            flow.state = 'closed';\r\n            return;\r\n        }\r\n\r\n        switch (currentState) {\r\n            case 'syn_sent':\r\n                if (tcp.flags.syn && tcp.flags.ack) {\r\n                    flow.state = 'established';\r\n                }\r\n                break;\r\n            case 'syn_received':\r\n                if (tcp.flags.ack) {\r\n                    flow.state = 'established';\r\n                }\r\n                break;\r\n            case 'established':\r\n                if (tcp.flags.fin) {\r\n                    flow.state = tcp.flags.ack ? 'close_wait' : 'fin_wait_1';\r\n                }\r\n                break;\r\n            case 'fin_wait_1':\r\n                if (tcp.flags.ack) {\r\n                    flow.state = 'fin_wait_2';\r\n                }\r\n                if (tcp.flags.fin) {\r\n                    flow.state = 'closing';\r\n                }\r\n                break;\r\n            case 'fin_wait_2':\r\n                if (tcp.flags.fin) {\r\n                    flow.state = 'time_wait';\r\n                }\r\n                break;\r\n            case 'close_wait':\r\n                if (tcp.flags.fin) {\r\n                    flow.state = 'last_ack';\r\n                }\r\n                break;\r\n            case 'closing':\r\n                if (tcp.flags.ack) {\r\n                    flow.state = 'time_wait';\r\n                }\r\n                break;\r\n            case 'last_ack':\r\n                if (tcp.flags.ack) {\r\n                    flow.state = 'closed';\r\n                }\r\n                break;\r\n        }\r\n    }\r\n\r\n    private cleanupExpiredFlows(): void {\r\n        const now = BigInt(Date.now()) * BigInt(1_000_000);\r\n        const expiredFlows: string[] = [];\r\n\r\n        for (const [id, flow] of this.flows) {\r\n            const age = Number(now - flow.lastActivity) / 1_000_000;\r\n            const timeout = this.getFlowTimeout(flow);\r\n\r\n            if (age > timeout || flow.state === 'closed') {\r\n                expiredFlows.push(id);\r\n            }\r\n        }\r\n\r\n        for (const id of expiredFlows) {\r\n            this.removeFlow(id);\r\n        }\r\n\r\n        if (expiredFlows.length > 0) {\r\n            logger.debug(`Cleaned up ${expiredFlows.length} expired flows`);\r\n        }\r\n    }\r\n\r\n    private getFlowTimeout(flow: FlowState): number {\r\n        const state = flow.state;\r\n        \r\n        if (typeof state === 'string') {\r\n            switch (state) {\r\n                case 'time_wait': return 60000;\r\n                case 'close_wait': return 300000;\r\n                case 'fin_wait_1':\r\n                case 'fin_wait_2': return 120000;\r\n                case 'established': return 86400000;\r\n                default: return this.flowTimeout;\r\n            }\r\n        }\r\n        \r\n        return this.flowTimeout;\r\n    }\r\n\r\n    private evictOldestFlow(): void {\r\n        let oldestId: string | null = null;\r\n        let oldestTime = BigInt(Number.MAX_SAFE_INTEGER);\r\n\r\n        for (const [id, flow] of this.flows) {\r\n            if (flow.lastActivity < oldestTime) {\r\n                oldestTime = flow.lastActivity;\r\n                oldestId = id;\r\n            }\r\n        }\r\n\r\n        if (oldestId) {\r\n            this.removeFlow(oldestId);\r\n            logger.debug(`Evicted oldest flow: ${oldestId}`);\r\n        }\r\n    }\r\n\r\n    private removeFlow(flowId: string): void {\r\n        const flow = this.flows.get(flowId);\r\n        if (flow) {\r\n            const keyStr = this.flowKeyToString(flow.key);\r\n            this.flowByKey.delete(keyStr);\r\n            this.flows.delete(flowId);\r\n        }\r\n    }\r\n\r\n    getFlow(flowId: string): FlowState | undefined {\r\n        return this.flows.get(flowId);\r\n    }\r\n\r\n    getFlowByKey(key: FlowKey): FlowState | undefined {\r\n        const keyStr = this.flowKeyToString(key);\r\n        const flowId = this.flowByKey.get(keyStr);\r\n        return flowId ? this.flows.get(flowId) : undefined;\r\n    }\r\n\r\n    getFlowStatistics(flowId: string): FlowStatistics | null {\r\n        const flow = this.flows.get(flowId);\r\n        if (!flow) return null;\r\n\r\n        const duration = Number(flow.lastActivity - flow.startTime) / 1_000_000_000;\r\n        const seconds = Math.max(duration, 1);\r\n\r\n        return {\r\n            flowId: flow.id,\r\n            duration: seconds,\r\n            packetsPerSecond: flow.packetCount / seconds,\r\n            bytesPerSecond: flow.byteCount / seconds,\r\n            avgPacketSize: flow.byteCount / Math.max(flow.packetCount, 1),\r\n            retransmissions: 0,\r\n            outOfOrder: 0\r\n        };\r\n    }\r\n\r\n    getAllFlows(): FlowState[] {\r\n        return Array.from(this.flows.values());\r\n    }\r\n\r\n    getActiveFlowCount(): number {\r\n        return this.flows.size;\r\n    }\r\n\r\n    getFlowsByIP(ip: string): FlowState[] {\r\n        return Array.from(this.flows.values()).filter(\r\n            f => f.key.sourceIP === ip || f.key.destIP === ip\r\n        );\r\n    }\r\n\r\n    getFlowsByState(state: TCPState | 'active'): FlowState[] {\r\n        return Array.from(this.flows.values()).filter(f => f.state === state);\r\n    }\r\n\r\n    shutdown(): void {\r\n        if (this.cleanupInterval) {\r\n            clearInterval(this.cleanupInterval);\r\n            this.cleanupInterval = null;\r\n        }\r\n        this.flows.clear();\r\n        this.flowByKey.clear();\r\n        logger.info('Flow manager shutdown complete');\r\n    }\r\n\r\n    getStats(): {\r\n        totalFlows: number;\r\n        tcpFlows: number;\r\n        udpFlows: number;\r\n        establishedFlows: number;\r\n        closingFlows: number;\r\n    } {\r\n        let tcpFlows = 0;\r\n        let udpFlows = 0;\r\n        let establishedFlows = 0;\r\n        let closingFlows = 0;\r\n\r\n        for (const flow of this.flows.values()) {\r\n            if (flow.key.protocol === 'tcp') {\r\n                tcpFlows++;\r\n                const state = flow.state as TCPState;\r\n                if (state === 'established') establishedFlows++;\r\n                if (['fin_wait_1', 'fin_wait_2', 'close_wait', 'closing', 'last_ack', 'time_wait'].includes(state)) {\r\n                    closingFlows++;\r\n                }\r\n            } else if (flow.key.protocol === 'udp') {\r\n                udpFlows++;\r\n            }\r\n        }\r\n\r\n        return {\r\n            totalFlows: this.flows.size,\r\n            tcpFlows,\r\n            udpFlows,\r\n            establishedFlows,\r\n            closingFlows\r\n        };\r\n    }\r\n}\r\n\r\nexport default FlowManager;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\traffic-interceptor\\core\\hal.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":94,"column":26,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":94,"endColumn":29,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2993,2996],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2993,2996],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":147,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":147,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4591,4594],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4591,4594],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":148,"column":72,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":148,"endColumn":79},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":235,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":235,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7380,7383],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7380,7383],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":236,"column":72,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":236,"endColumn":79}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Hardware Abstraction Layer - Cross-platform traffic capture interface\r\n */\r\n\r\nimport {\r\n    Platform,\r\n    PacketMetadata,\r\n    ParsedPacket,\r\n    Verdict,\r\n    InterceptionResult,\r\n    InterceptorConfig,\r\n    InterceptorStats,\r\n    LinuxConfig,\r\n    WindowsConfig\r\n} from './types';\r\nimport { Packet } from './packet';\r\nimport { RingBuffer } from '../processing/ring-buffer';\r\nimport logger from '../../utils/logger';\r\n\r\nexport interface TrafficCaptureInterface {\r\n    initialize(config: InterceptorConfig): Promise<void>;\r\n    start(): Promise<void>;\r\n    stop(): Promise<void>;\r\n    getStats(): InterceptorStats;\r\n    setVerdictCallback(callback: (packet: Packet) => Promise<Verdict>): void;\r\n    isRunning(): boolean;\r\n}\r\n\r\nexport abstract class BaseCapture implements TrafficCaptureInterface {\r\n    protected config: InterceptorConfig | null = null;\r\n    protected running: boolean = false;\r\n    protected verdictCallback: ((packet: Packet) => Promise<Verdict>) | null = null;\r\n    protected stats: InterceptorStats = this.createEmptyStats();\r\n    protected packetBuffer: RingBuffer<Packet> | null = null;\r\n\r\n    abstract initialize(config: InterceptorConfig): Promise<void>;\r\n    abstract start(): Promise<void>;\r\n    abstract stop(): Promise<void>;\r\n\r\n    protected createEmptyStats(): InterceptorStats {\r\n        return {\r\n            uptime: 0,\r\n            packetsProcessed: BigInt(0),\r\n            packetsAllowed: BigInt(0),\r\n            packetsBlocked: BigInt(0),\r\n            packetsInspected: BigInt(0),\r\n            bytesProcessed: BigInt(0),\r\n            currentFlows: 0,\r\n            activeConnections: 0,\r\n            droppedPackets: BigInt(0),\r\n            bufferOverflows: BigInt(0),\r\n            avgProcessingTime: 0,\r\n            cpuUsage: 0,\r\n            memoryUsage: 0\r\n        };\r\n    }\r\n\r\n    setVerdictCallback(callback: (packet: Packet) => Promise<Verdict>): void {\r\n        this.verdictCallback = callback;\r\n    }\r\n\r\n    getStats(): InterceptorStats {\r\n        return { ...this.stats };\r\n    }\r\n\r\n    isRunning(): boolean {\r\n        return this.running;\r\n    }\r\n\r\n    protected updateStats(packet: Packet, verdict: Verdict, processingTime: number): void {\r\n        this.stats.packetsProcessed++;\r\n        this.stats.bytesProcessed += BigInt(packet.raw.length);\r\n\r\n        switch (verdict) {\r\n            case 'allow':\r\n                this.stats.packetsAllowed++;\r\n                break;\r\n            case 'block':\r\n                this.stats.packetsBlocked++;\r\n                break;\r\n            case 'inspect':\r\n                this.stats.packetsInspected++;\r\n                break;\r\n        }\r\n\r\n        const totalTime = this.stats.avgProcessingTime * \r\n            Number(this.stats.packetsProcessed - BigInt(1)) + processingTime;\r\n        this.stats.avgProcessingTime = totalTime / Number(this.stats.packetsProcessed);\r\n    }\r\n}\r\n\r\nexport class LinuxCapture extends BaseCapture {\r\n    private xdpAttached: boolean = false;\r\n    private afXdpSocket: any = null;\r\n    private linuxConfig: LinuxConfig | null = null;\r\n\r\n    async initialize(config: InterceptorConfig): Promise<void> {\r\n        this.config = config;\r\n        this.linuxConfig = {\r\n            useXDP: true,\r\n            useTC: false,\r\n            xdpMode: 'skb',\r\n            afXdpSocket: true,\r\n            mapSize: 1024\r\n        };\r\n\r\n        this.packetBuffer = new RingBuffer({ size: config.bufferSize || 10000 });\r\n\r\n        logger.info('Linux capture initialized', {\r\n            useXDP: this.linuxConfig.useXDP,\r\n            xdpMode: this.linuxConfig.xdpMode\r\n        });\r\n    }\r\n\r\n    async start(): Promise<void> {\r\n        if (!this.config) {\r\n            throw new Error('Capture not initialized');\r\n        }\r\n\r\n        this.running = true;\r\n        logger.info('Linux capture started');\r\n\r\n        this.startCaptureLoop();\r\n    }\r\n\r\n    private startCaptureLoop(): void {\r\n        const captureLoop = async () => {\r\n            while (this.running) {\r\n                await this.processBatch();\r\n                await this.sleep(1);\r\n            }\r\n        };\r\n        captureLoop();\r\n    }\r\n\r\n    private async processBatch(): Promise<void> {\r\n        if (!this.packetBuffer || !this.verdictCallback) return;\r\n\r\n        const packets = this.packetBuffer.readBatch(32);\r\n        \r\n        for (const packet of packets) {\r\n            const startTime = Date.now();\r\n            \r\n            try {\r\n                const verdict = await this.verdictCallback(packet);\r\n                this.updateStats(packet, verdict, Date.now() - startTime);\r\n            } catch (error: any) {\r\n                logger.error('Error processing packet', { error: error.message });\r\n            }\r\n        }\r\n    }\r\n\r\n    async stop(): Promise<void> {\r\n    