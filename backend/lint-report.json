\n    verbose?: boolean;\r\n}\r\n\r\n/**\r\n * Seed the database with demo data\r\n */\r\nexport async function seedDatabase(options: SeedOptions = {}): Promise<void> {\r\n    const { clearExisting = false, verbose = true } = options;\r\n\r\n    try {\r\n        if (!isDemoMode()) {\r\n            throw new Error('Demo seed is disabled when APP_MODE is not demo.');\r\n        }\r\n\r\n        await initDatabase();\r\n        const db = getDatabase();\r\n\r\n        if (verbose) logger.info('Starting database seeding...');\r\n\r\n        // Clear existing data if requested\r\n        if (clearExisting) {\r\n            if (verbose) logger.info('Clearing existing data...');\r\n            db.exec('DELETE FROM alerts');\r\n            db.exec('DELETE FROM api_keys');\r\n            db.exec('DELETE FROM scan_results');\r\n            db.exec('DELETE FROM metrics');\r\n            db.exec('DELETE FROM security_rules');\r\n            db.exec('DELETE FROM sites');\r\n            db.exec('DELETE FROM agents');\r\n            db.exec('DELETE FROM devices');\r\n            db.exec('DELETE FROM users');\r\n        }\r\n\r\n        // SECURITY FIX CVE-2026-037: Admin credentials must come from environment variables\r\n        const adminEmail = process.env.ADMIN_EMAIL;\r\n        const adminPassword = process.env.ADMIN_PASSWORD;\r\n\r\n        if (!adminEmail || !adminPassword) {\r\n            throw new Error(\r\n                'SECURITY ERROR: ADMIN_EMAIL and ADMIN_PASSWORD environment variables are required. ' +\r\n                'Cannot seed database with default credentials.'\r\n            );\r\n        }\r\n\r\n        // Validate password strength\r\n        if (adminPassword.length < 12) {\r\n            throw new Error('SECURITY ERROR: ADMIN_PASSWORD must be at least 12 characters long.');\r\n        }\r\n\r\n        // Create admin user\r\n        const adminId = uuidv4();\r\n        const adminTenantId = uuidv4();\r\n        const adminPasswordHash = await bcrypt.hash(adminPassword, 12);\r\n\r\n        db.prepare(`\r\n      INSERT OR IGNORE INTO users (id, email, username, password_hash, role, tenant_id, status)\r\n      VALUES (?, ?, ?, ?, ?, ?, ?)\r\n    `).run(adminId, adminEmail, 'Administrator', adminPasswordHash, 'admin', adminTenantId, 'active');\r\n\r\n        if (verbose) logger.info(`Created admin user: ${adminEmail}`);\r\n\r\n        // SECURITY FIX CVE-2026-037: Demo user credentials from environment or skip\r\n        const demoEmail = process.env.DEMO_EMAIL;\r\n        const demoPassword = process.env.DEMO_PASSWORD;\r\n\r\n        const tenantId = uuidv4();\r\n        const tenantUserId = uuidv4();\r\n\r\n        if (demoEmail && demoPassword) {\r\n            const tenantPasswordHash = await bcrypt.hash(demoPassword, 12);\r\n\r\n            db.prepare(`\r\n      INSERT OR IGNORE INTO users (id, email, username, password_hash, role, tenant_id, status)\r\n      VALUES (?, ?, ?, ?, ?, ?, ?)\r\n    `).run(tenantUserId, demoEmail, 'Demo User', tenantPasswordHash, 'tenant', tenantId, 'active');\r\n\r\n            if (verbose) logger.info(`Created demo user: ${demoEmail}`);\r\n        } else {\r\n            if (verbose) logger.info('Skipping demo user creation (DEMO_EMAIL/DEMO_PASSWORD not set)');\r\n        }\r\n\r\n        // Create demo sites\r\n        const sites = [\r\n            { domain: 'example.com', target: 'http://localhost:8080' },\r\n            { domain: 'api.example.com', target: 'http://localhost:3000' },\r\n            { domain: 'admin.example.com', target: 'http://localhost:4000' }\r\n        ];\r\n\r\n        for (const site of sites) {\r\n            db.prepare(`\r\n        INSERT OR IGNORE INTO sites (domain, target, sslEnabled, antiBotEnabled, rateLimitEnabled)\r\n        VALUES (?, ?, 1, 1, 1)\r\n      `).run(site.domain, site.target);\r\n        }\r\n\r\n        if (verbose) logger.info(`Created ${sites.length} demo sites`);\r\n\r\n        // Create demo agents\r\n        const agents = [\r\n            { id: uuidv4(), hostname: 'web-server-01', platform: 'linux', arch: 'x64', version: '2.0.0', status: 'online' },\r\n            { id: uuidv4(), hostname: 'api-server-01', platform: 'linux', arch: 'x64', version: '2.0.0', status: 'online' },\r\n            { id: uuidv4(), hostname: 'db-server-01', platform: 'linux', arch: 'x64', version: '1.9.5', status: 'offline' }\r\n        ];\r\n\r\n        for (const agent of agents) {\r\n            db.prepare(`\r\n        INSERT OR IGNORE INTO agents (id, hostname, platform, arch, version, status, lastHeartbeat)\r\n        VALUES (?, ?, ?, ?, ?, ?, datetime('now'))\r\n      `).run(agent.id, agent.hostname, agent.platform, agent.arch, agent.version, agent.status);\r\n        }\r\n\r\n        if (verbose) logger.info(`Created ${agents.length} demo agents`);\r\n\r\n        // Create demo devices (ESP32)\r\n        const devices = [\r\n            { id: uuidv4(), mac: 'AA:BB:CC:DD:EE:01', firmware: '1.2.0', status: 'online' },\r\n            { id: uuidv4(), mac: 'AA:BB:CC:DD:EE:02', firmware: '1.2.0', status: 'offline' }\r\n        ];\r\n\r\n        for (const device of devices) {\r\n            db.prepare(`\r\n        INSERT OR IGNORE INTO devices (id, device_type, mac_address, firmware_version, status, last_seen)\r\n        VALUES (?, 'esp32', ?, ?, ?, datetime('now'))\r\n      `).run(device.id, device.mac, device.firmware, device.status);\r\n        }\r\n\r\n        if (verbose) logger.info(`Created ${devices.length} demo devices`);\r\n\r\n        // Create demo alerts\r\n        const alerts = [\r\n            { type: 'intrusion_attempt', severity: 'critical', source: 'web-server-01', message: 'backend.sql_injection_attempt_detected_from_192_168_1_100' },\r\n            { type: 'brute_force', severity: 'warning', source: 'api-server-01', message: 'backend.multiple_failed_login_attempts_from_10_0_0_5' },\r\n            { type: 'port_scan', severity: 'info', source: 'web-server-01', message: 'backend.port_scan_activity_detected_from_172_16_0_50' },\r\n            { type: 'vulnerability', severity: 'critical', source: 'db-server-01', message: 'backend.cve_2024_1234_vulnerability_detected_in_openssl' }\r\n        ];\r\n\r\n        for (const alert of alerts) {\r\n            db.prepare(`\r\n        INSERT INTO alerts (type, severity, source, message)\r\n        VALUES (?, ?, ?, ?)\r\n      `).run(alert.type, alert.severity, alert.source, alert.message);\r\n        }\r\n\r\n        if (verbose) logger.info(`Created ${alerts.length} demo alerts`);\r\n\r\n        // Create demo API key\r\n        const apiKeyId = uuidv4();\r\n        const apiKey = 'AetherGuard_' + uuidv4().replace(/-/g, '');\r\n        const apiKeyHash = await bcrypt.hash(apiKey, 10);\r\n\r\n        db.prepare(`\r\n      INSERT OR IGNORE INTO api_keys (id, name, key_hash, user_id, tenant_id, permissions)\r\n      VALUES (?, ?, ?, ?, ?, ?)\r\n    `).run(apiKeyId, 'Demo API Key', apiKeyHash, adminId, adminTenantId, '[\"read\", \"write\"]');\r\n\r\n        if (verbose) {\r\n            logger.info('Created demo API key');\r\n            logger.info(`API Key (save this): ${apiKey}`);\r\n        }\r\n\r\n        // Save changes\r\n        db.save();\r\n\r\n        if (verbose) {\r\n            logger.info('Database seeding completed successfully!');\r\n            logger.info('---');\r\n            logger.info('SECURITY NOTE: Admin credentials were set from environment variables.');\r\n            logger.info('Ensure ADMIN_EMAIL and ADMIN_PASSWORD are kept secure.');\r\n        }\r\n\r\n    } catch (error: any) {\r\n        logger.error('Database seeding failed', { error: error.message });\r\n        throw error;\r\n    }\r\n}\r\n\r\n/**\r\n * Run seeder as standalone script\r\n */\r\nasync function main() {\r\n    console.log('🌱 AetherGuard Database Seeder\\n');\r\n\r\n    const clearExisting = process.argv.includes('--clear');\r\n\r\n    if (clearExisting) {\r\n        console.log('⚠️  Warning: --clear flag detected, existing data will be removed!\\n');\r\n    }\r\n\r\n    try {\r\n        await seedDatabase({ clearExisting, verbose: true });\r\n        console.log('\\n✅ Seeding completed!');\r\n        process.exit(0);\r\n    } catch (error) {\r\n        console.error('\\n❌ Seeding failed:', error);\r\n        process.exit(1);\r\n    } finally {\r\n        closeDatabase();\r\n    }\r\n}\r\n\r\n// Run if executed directly\r\nif (require.main === module) {\r\n    main();\r\n}\r\n\r\nexport default seedDatabase;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\database\\seeds\\seed-manager.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\demo-agent.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .type on an `any` value.","line":46,"column":37,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":46,"endColumn":41}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * AetherGuard E2E Demo Script\r\n * \r\n * 模拟真实的生产环境场景\r\n */\r\n\r\nimport { io, Socket } from 'socket.io-client';\r\n\r\nconst SERVER_URL = 'http://localhost:8080';\r\nconst AGENT_ID = `agent-demo-${Date.now().toString(36)}`;\r\n\r\nconst mockThreats = [\r\n    { type: 'sql_injection', severity: 'critical', sourceIP: '192.168.1.100', description: 'SQL注入攻击' },\r\n    { type: 'xss_attack', severity: 'high', sourceIP: '10.0.0.55', description: 'XSS跨站脚本攻击' },\r\n    { type: 'brute_force', severity: 'high', sourceIP: '203.0.113.50', description: 'SSH暴力破解' },\r\n    { type: 'port_scan', severity: 'medium', sourceIP: '172.16.0.99', description: '端口扫描' },\r\n    { type: 'ddos_attack', severity: 'critical', sourceIP: '45.33.32.156', description: 'DDoS攻击' }\r\n];\r\n\r\nasync function runDemo() {\r\n    console.log('═══════════════════════════════════════════════');\r\n    console.log('       AetherGuard - 交付演示测试');\r\n    console.log('═══════════════════════════════════════════════\\n');\r\n    console.log(`Agent ID: ${AGENT_ID}`);\r\n    console.log(`Server:   ${SERVER_URL}\\n`);\r\n\r\n    const socket = io(SERVER_URL, {\r\n        auth: { type: 'agent', agentId: AGENT_ID }\r\n    });\r\n\r\n    socket.on('connect', () => {\r\n        console.log('✅ 已连接到控制平台');\r\n\r\n        // Register\r\n        socket.emit('agent:register', {\r\n            agentId: AGENT_ID,\r\n            hostname: 'demo-web-server',\r\n            platform: 'linux',\r\n            arch: 'x64',\r\n            version: '2.0.0'\r\n        });\r\n        console.log('📝 Agent 已注册\\n');\r\n    });\r\n\r\n    socket.on('command', (cmd) => {\r\n        console.log(`📥 收到指令: ${cmd.type}`);\r\n    });\r\n\r\n    // Heartbeat\r\n    setInterval(() => {\r\n        if (socket.connected) {\r\n            const cpu = Math.floor(20 + Math.random() * 40);\r\n            const mem = Math.floor(40 + Math.random() * 30);\r\n            socket.emit('agent:heartbeat', {\r\n                agentId: AGENT_ID,\r\n                hostname: 'demo-web-server',\r\n                platform: 'linux',\r\n                uptime: Math.floor(process.uptime()),\r\n                cpuUsage: cpu,\r\n                memoryUsage: mem,\r\n                lastHeartbeat: new Date().toISOString(),\r\n                isOnline: true\r\n            });\r\n            console.log(`💓 心跳: CPU ${cpu}% | 内存 ${mem}%`);\r\n        }\r\n    }, 10000);\r\n\r\n    // Threat simulation\r\n    let threatIdx = 0;\r\n    setInterval(() => {\r\n        if (socket.connected) {\r\n            const threat = mockThreats[threatIdx % mockThreats.length];\r\n            threatIdx++;\r\n\r\n            socket.emit('agent:threat', {\r\n                agentId: AGENT_ID,\r\n                threat: { ...threat, timestamp: new Date().toISOString() },\r\n                timestamp: new Date().toISOString()\r\n            });\r\n\r\n            const emoji = threat.severity === 'critical' ? '🔴' : threat.severity === 'high' ? '🟠' : '🟡';\r\n            console.log(`${emoji} 威胁: [${threat.severity}] ${threat.type} - ${threat.description} (来自 ${threat.sourceIP})`);\r\n        }\r\n    }, 8000);\r\n\r\n    console.log('📊 Demo 运行中... 按 Ctrl+C 停止\\n');\r\n}\r\n\r\nrunDemo().catch(console.error);\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":81,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":81,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3372,3375],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3372,3375],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":113,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":113,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4353,4356],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4353,4356],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":115,"column":29,"n