deType":"Identifier","messageId":"unsafeMemberExpression","endLine":386,"endColumn":82},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":387,"column":21,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":387,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .some on an `any` value.","line":387,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":387,"endColumn":34},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":387,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":387,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11658,11661],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11658,11661],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .severity on an `any` value.","line":387,"column":50,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":387,"endColumn":58},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .length on an `any` value.","line":389,"column":18,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":389,"endColumn":24},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":398,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":400,"endColumn":45},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .summary on an `any` value.","line":398,"column":33,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":398,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .summary on an `any` value.","line":399,"column":18,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":399,"endColumn":25}],"suppressedMessages":[],"errorCount":44,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Base Investigation Agent\r\n *\r\n * Abstract base class for all investigation agents.\r\n * Extends the existing BaseAgent pattern with investigation-specific capabilities.\r\n */\r\n\r\nimport { InvestigationContext, InvestigationAgentType } from '../types';\r\nimport { AgentConfig, MessageBus, BaseAgent } from '../../core';\r\nimport type { AgentMessage } from '../../core/types';\r\nimport type { AnalysisResult, ModelResponse, TrafficContext } from '../../core/types';\r\nimport { distributionFromVerdict } from '../../core/scoring';\r\n\r\nexport abstract class BaseInvestigationAgent extends BaseAgent {\r\n  protected agentType: InvestigationAgentType;\r\n  protected expertise: string[];\r\n  private processedMessageIds: Set<string> = new Set();\r\n  private maxProcessedMessages: number = 10000;\r\n\r\n  constructor(config: AgentConfig, messageBus: MessageBus, agentType: InvestigationAgentType, expertise: string[]) {\r\n    super(config, messageBus);\r\n    this.agentType = agentType;\r\n    this.expertise = expertise;\r\n  }\r\n\r\n  private isMessageProcessed(messageId: string): boolean {\r\n    return this.processedMessageIds.has(messageId);\r\n  }\r\n\r\n  private markMessageProcessed(messageId: string): void {\r\n    if (this.processedMessageIds.size >= this.maxProcessedMessages) {\r\n      const iterator = this.processedMessageIds.values();\r\n      const oldest = iterator.next().value;\r\n      if (oldest !== undefined) {\r\n        this.processedMessageIds.delete(oldest);\r\n      }\r\n    }\r\n    this.processedMessageIds.add(messageId);\r\n  }\r\n\r\n  protected isOwnMessage(message: AgentMessage): boolean {\r\n    return message.from === this.identity.role;\r\n  }\r\n\r\n  /**\r\n   * Core investigation analysis method implemented by subclasses.\r\n   */\r\n  protected abstract analyzeInvestigation(context: InvestigationContext): Promise<any>;\r\n\r\n  /**\r\n   * BaseAgent-compatible analyze method.\r\n   * Supports investigation-native input and gracefully adapts traffic input.\r\n   */\r\n  public async analyze(context: TrafficContext): Promise<AnalysisResult>;\r\n  public async analyze(context: InvestigationContext): Promise<any>;\r\n  public async analyze(context: TrafficContext | InvestigationContext): Promise<AnalysisResult | any> {\r\n    if (this.isInvestigationContext(context)) {\r\n      return this.analyzeInvestigation(context);\r\n    }\r\n\r\n    const investigationContext = this.createInvestigationContextFromTraffic(context);\r\n    const result = await this.analyzeInvestigation(investigationContext);\r\n    return this.toAnalysisResult(result);\r\n  }\r\n\r\n  /**\r\n   * Get system prompt for AI model\r\n   */\r\n  public abstract getSystemPrompt(): string;\r\n\r\n  /**\r\n   * Handle analysis request message\r\n   */\r\n  protected async handleAnalysisRequest(message: AgentMessage): Promise<void> {\r\n    if (this.isMessageProcessed(message.id)) {\r\n      return;\r\n    }\r\n    this.markMessageProcessed(message.id);\r\n\r\n    if (this.isOwnMessage(message)) {\r\n      return;\r\n    }\r\n\r\n    const result = await this.analyzeInvestigation(message.payload);\r\n    await this.sendMessage(message.from, 'analysis_result', {\r\n      originalMessageId: message.id,\r\n      result\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Handle debate invitation message\r\n   */\r\n  protected async handleDebateInvitation(message: AgentMessage): Promise<void> {\r\n    if (this.isMessageProcessed(message.id)) {\r\n      return;\r\n    }\r\n    this.markMessageProcessed(message.id);\r\n\r\n    if (this.isOwnMessage(message)) {\r\n      return;\r\n    }\r\n\r\n    const response = {\r\n      originalMessageId: message.id,\r\n      accepted: true,\r\n      agentType: this.agentType\r\n    };\r\n    await this.sendMessage(message.from, 'debate_argument', response);\r\n  }\r\n\r\n  /**\r\n   * Handle debate argument message\r\n   */\r\n  protected async handleDebateArgument(message: AgentMessage): Promise<void> {\r\n    if (this.isMessageProcessed(message.id)) {\r\n      return;\r\n    }\r\n    this.markMessageProcessed(message.id);\r\n\r\n    if (this.isOwnMessage(message)) {\r\n      return;\r\n    }\r\n\r\n    const argument = await this.generateDebateArgument(message.payload);\r\n    await this.sendMessage(message.from, 'debate_argument', {\r\n      originalMessageId: message.id,\r\n      argument\r\n    });\r\n  }\r\n\r\n  /**\r\n   * Handle tool result message\r\n   */\r\n  protected async handleToolResult(message: AgentMessage): Promise<void> {\r\n    if (this.isMessageProcessed(message.id)) {\r\n      return;\r\n    }\r\n    this.markMessageProcessed(message.id);\r\n\r\n    if (this.isOwnMessage(message)) {\r\n      return;\r\n    }\r\n\r\n    await this.processToolResult(message.payload);\r\n  }\r\n\r\n  /**\r\n   * Generate debate argument - can be overridden by subclasses\r\n   */\r\n  protected async generateDebateArgument(payload: any): Promise<any> {\r\n    return {\r\n      agentType: this.agentType,\r\n      expertise: this.expertise,\r\n      analysis: 'Debate argument generated by base implementation'\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Process tool result - can be overridden by subclasses\r\n   */\r\n  protected async processToolResult(payload: any): Promise<void> {\r\n    // Default implementation - subclasses can override\r\n  }\r\n\r\n  /**\r\n   * Get agent capabilities\r\n   */\r\n  public getCapabilities(): string[] {\r\n    return this.expertise;\r\n  }\r\n\r\n  /**\r\n   * Get agent type\r\n   */\r\n  public getAgentType(): InvestigationAgentType {\r\n    return this.agentType;\r\n  }\r\n\r\n  /**\r\n   * Preprocess context before analysis\r\n   */\r\n  protected preprocessContext(context: InvestigationContext): InvestigationContext {\r\n    // Common preprocessing logic\r\n    // Filter logs by timestamp range if bug report has occurrence time\r\n    if (context.bugReport.timestamp) {\r\n      const timeWindow = 3600000; // 1 hour window\r\n      context.systemState.logs = context.systemState.logs.filter(log => {\r\n        const timeDiff = Math.abs(log.timestamp.getTime() - context.bugReport.timestamp.getTime());\r\n        return timeDiff <= timeWindow;\r\n      });\r\n    }\r\n\r\n    return context;\r\n  }\r\n\r\n  /**\r\n   * Extract relevant logs based on severity and service\r\n   */\r\n  protected extractRelevantLogs(\r\n    logs: any[],\r\n    severity?: string[],\r\n    services?: string[]\r\n  ): any[] {\r\n    let filtered = logs;\r\n\r\n    if (severity && severity.length > 0) {\r\n      filtered = filtered.filter(log => severity.includes(log.level));\r\n    }\r\n\r\n    if (services && services.length > 0) {\r\n      filtered = filtered.filter(log => services.includes(log.service));\r\n    }\r\n\r\n    return filtered.sort((a, b) => b.timestamp.getTime() - a.timestamp.getTime());\r\n  }\r\n\r\n  /**\r\n   * Extract error traces\r\n   */\r\n  protected extractErrorTraces(traces: any[]): any[] {\r\n    return traces.filter(trace => trace.status === 'error');\r\n  }\r\n\r\n  /**\r\n   * Call AI model for analysis\r\n   */\r\n  protected async analyzeWithAI(\r\n    prompt: string,\r\n    contextData: any\r\n  ): Promise<any> {\r\n    try {\r\n      const analysisPrompt = this.buildInvestigationPrompt(prompt, contextData);\r\n      const response = await this.callModel(analysisPrompt);\r\n\r\n      return this.parseModelResponse(response);\r\n    } catch (error) {\r\n      console.error(`[${this.agentType}] AI analysis failed:`, error);\r\n      return this.fallbackAnalysis(contextData);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Build analysis prompt for AI model\r\n   */\r\n  protected buildInvestigationPrompt(prompt: string, contextData: any): string {\r\n    return `\r\nYou are a specialized investigation agent for ${this.agentType}.\r\n\r\nYour expertise includes: ${this.expertise.join(', ')}\r\n\r\nTask: ${prompt}\r\n\r\nContext:\r\n${JSON.stringify(contextData, null, 2)}\r\n\r\nPlease analyze the provided context and provide:\r\n1. Key findings\r\n2. Potential issues or anomalies\r\n3. Recommendations for further investigation\r\n4. Confidence level in your analysis\r\n\r\nFormat your response as JSON.\r\n`;\r\n  }\r\n\r\n  /**\r\n   * Parse model response\r\n   */\r\n  protected parseModelResponse(response: ModelResponse | string): any {\r\n    try {\r\n      const content = typeof response === 'string' ? response : response.content;\r\n      // Try to extract JSON from response\r\n      const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\r\n      if (jsonMatch) {\r\n        return JSON.parse(jsonMatch[0]);\r\n      }\r\n      // If no JSON, return as text\r\n      return { analysis: content };\r\n    } catch (error) {\r\n      console.error(`[${this.agentType}] Failed to parse model response:`, error);\r\n      const content = typeof response === 'string' ? response : response.content;\r\n      return { analysis: content, error: 'backend.failed_to_parse_response' };\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Fallback analysis when AI model fails\r\n   */\r\n  protected fallbackAnalysis(contextData: any): any {\r\n    return {\r\n      findings: [],\r\n      analysis: 'AI model unavailable, using rule-based analysis',\r\n      confidence: 0.3,\r\n      error: 'backend.ai_model_unavailable'\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Calculate time-based correlation\r\n   */\r\n  protected calculateTimeCorrelation(timestamps: Date[]): any {\r\n    if (timestamps.length < 2) {\r\n      return { pattern: 'insufficient_data' };\r\n    }\r\n\r\n    const sorted = timestamps.sort((a, b) => a.getTime() - b.getTime());\r\n    const intervals: number[] = [];\r\n\r\n    for (let i = 1; i < sorted.length; i++) {\r\n      intervals.push(sorted[i].getTime() - sorted[i - 1].getTime());\r\n    }\r\n\r\n    const avgInterval = intervals.reduce((a, b) => a + b, 0) / intervals.length;\r\n\r\n    return {\r\n      totalEvents: timestamps.length,\r\n      avgInterval,\r\n      minInterval: Math.min(...intervals),\r\n      maxInterval: Math.max(...intervals),\r\n      pattern: this.detectTimePattern(intervals)\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Detect time patterns in intervals\r\n   */\r\n  private detectTimePattern(intervals: number[]): string {\r\n    // Check for regular intervals\r\n    const variance = this.calculateVariance(intervals);\r\n    const avg = intervals.reduce((a, b) => a + b, 0) / intervals.length;\r\n    const coefficientOfVariation = Math.sqrt(variance) / avg;\r\n\r\n    if (coefficientOfVariation < 0.2) {\r\n      return 'regular';\r\n    } else if (coefficientOfVariation < 0.5) {\r\n      return 'semi_regular';\r\n    } else {\r\n      return 'irregular';\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Calculate variance\r\n   */\r\n  private calculateVariance(values: number[]): number {\r\n    const avg = values.reduce((a, b) => a + b, 0) / values.length;\r\n    return values.reduce((sum, val) => sum + Math.pow(val - avg, 2), 0) / values.length;\r\n  }\r\n\r\n  private isInvestigationContext(context: TrafficContext | InvestigationContext): context is InvestigationContext {\r\n    const candidate = context as InvestigationContext;\r\n    return !!candidate?.bugReport && !!candidate?.systemState;\r\n  }\r\n\r\n  private createInvestigationContextFromTraffic(context: TrafficContext): InvestigationContext {\r\n    return {\r\n      bugReport: {\r\n        id: context.request.id,\r\n        title: `${context.request.method} ${context.request.path}`,\r\n        description: 'Traffic-derived investigation context',\r\n        severity: 'medium',\r\n        category: 'functional',\r\n        environment: {\r\n          os: 'unknown',\r\n          runtime: 'unknown',\r\n          version: 'unknown'\r\n        },\r\n        reporter: context.request.sourceIP,\r\n        timestamp: context.request.timestamp\r\n      },\r\n      systemState: {\r\n        logs: [],\r\n        traces: [],\r\n        metrics: {\r\n          cpu: { usage: 0, loadAverage: [0, 0, 0] },\r\n          memory: { used: 0, total: 0, percentage: 0 }\r\n        },\r\n        codeContext: undefined\r\n      }\r\n    };\r\n  }\r\n\r\n  private toAnalysisResult(result: any): AnalysisResult {\r\n    const findings = Array.isArray(result?.findings) ? result.findings : [];\r\n    const confidence = typeof result?.confidence === 'number' ? result.confidence : 0.5;\r\n    const verdict = findings.some((f: any) => f?.severity === 'critical')\r\n      ? 'malicious'\r\n      : findings.length > 0\r\n        ? 'suspicious'\r\n        : 'unknown';\r\n\r\n    return {\r\n      agentId: this.identity.id,\r\n      role: this.identity.role,\r\n      verdict,\r\n      confidence: Math.max(0, Math.min(1, confidence)),\r\n      reasoning: typeof result?.summary === 'string'\r\n        ? result.summary\r\n        : 'Investigation analysis completed',\r\n      evidence: [],\r\n      classScores: distributionFromVerdict(verdict, Math.max(0, Math.min(1, confidence)))\r\n    };\r\n  }\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\agents\\bug-reproduction.agent.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":40,"column":77,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":40,"endColumn":80,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1382,1385],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1382,1385],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":54,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":54,"endColumn":78},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .findings on an `any` value.","line":55,"column":43,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":55,"endColumn":51},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":61,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":61,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":64,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":71,"endColumn":6},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":76,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":76,"endColumn":17},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":78,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":78,"endColumn":17},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":86,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":86,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2892,2895],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2892,2895],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproductionSteps on an `any` value.","line":90,"column":20,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":90,"endColumn":37},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproductionSteps on an `any` value.","line":90,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":90,"endColumn":68},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .severity on an `any` value.","line":102,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":102,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .environment on an `any` value.","line":102,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":102,"endColumn":68},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .category on an `any` value.","line":114,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":114,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .category on an `any` value.","line":114,"column":56,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":114,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":116,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":116,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .category on an `any` value.","line":116,"column":25,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":116,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .category on an `any` value.","line":118,"column":54,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":118,"endColumn":62},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of type `any[]` to a variable of type `string[]`.","line":120,"column":9,"nodeType":"Property","messageId":"unsafeAssignment","endLine":120,"endColumn":39},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .category on an `any` value.","line":120,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":120,"endColumn":38},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":181,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":181,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5689,5692],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5689,5692],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .runtime on an `any` value.","line":186,"column":21,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":186,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":186,"column":32,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":186,"endColumn":60},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .runtime on an `any` value.","line":186,"column":44,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":186,"endColumn":51},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of type `any[]` to a variable of type `string[]`.","line":192,"column":9,"nodeType":"Property","messageId":"unsafeAssignment","endLine":192,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .runtime on an `any` value.","line":192,"column":32,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":192,"endColumn":39},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":203,"column":82,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":203,"endColumn":85,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6354,6357],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6354,6357],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":272,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":275,"endColumn":6},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .steps on an `any` value.","line":277,"column":17,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":277,"endColumn":22},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":278,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":278,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .steps on an `any` value.","line":278,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":278,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":279,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":279,"endColumn":73},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .prerequisites on an `any` value.","line":279,"column":37,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":279,"endColumn":50},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":280,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":280,"endColumn":82},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .expectedBehavior on an `any` value.","line":280,"column":40,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":280,"endColumn":56},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":281,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":281,"endColumn":76},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .actualBehavior on an `any` value.","line":281,"column":38,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":281,"endColumn":52},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":329,"column":70,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":329,"endColumn":73,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10529,10532],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10529,10532],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":354,"column":65,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":354,"endColumn":68,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11365,11368],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11365,11368],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .reproducibilityScore on an `any` value.","line":356,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":356,"endColumn":65}],"suppressedMessages":[],"errorCount":39,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * Bug Reproduction Agent\r\n *\r\n * Specializes in reproducing bugs by analyzing user reports, system state, and test scenarios.\r\n */\r\n\r\nimport { BaseInvestigationAgent } from './base-investigation.agent';\r\nimport { InvestigationContext, InvestigationAgentType, Finding, ReproductionGuide } from '../types';\r\nimport { AgentConfig, MessageBus } from '../../core';\r\n\r\nexport class BugReproductionAgent extends BaseInvestigationAgent {\r\n  constructor(config: AgentConfig, messageBus: MessageBus) {\r\n    super(config, messageBus, InvestigationAgentType.BUG_REPRODUCTION, [\r\n      'test_case_generation',\r\n      'scenario_analysis',\r\n      'reproduction_step_identification',\r\n      'environment_analysis',\r\n      'prerequisite_detection',\r\n      'behavior_verification'\r\n    ]);\r\n  }\r\n\r\n  /**\r\n   * Get system prompt for AI model\r\n   */\r\n  public getSystemPrompt(): string {\r\n    return `You are a Bug Reproduction Agent specializing in:\r\n- Analyzing bug reports and user feedback\r\n- Generating detailed reproduction steps\r\n- Identifying prerequisites and environment requirements\r\n- Validating bugs against system state\r\n- Creating test scenarios\r\n\r\nYour goal is to help developers reproduce bugs quickly and accurately.`;\r\n  }\r\n\r\n  /**\r\n   * Analyze bug and attempt to generate reproduction steps\r\n   */\r\n  public async analyzeInvestigation(context: InvestigationContext): Promise<any> {\r\n    console.log('[BugReproductionAgent] Starting bug reproduction analysis...');\r\n\r\n    const findings: Finding[] = [];\r\n\r\n    // Analyze bug report\r\n    const reportAnalysis = this.analyzeBugReport(context.bugReport);\r\n    findings.push(...reportAnalysis);\r\n\r\n    // Check system environment\r\n    const environmentCheck = this.checkEnvironment(context);\r\n    findings.push(...environmentCheck);\r\n\r\n    // Analyze reproduction steps if provided\r\n    const reproductionAnalysis = await this.analyzeReproductionSteps(context);\r\n    findings.push(...reproductionAnalysis.findings);\r\n\r\n    // Generate reproduction guide\r\n    const reproductionGuide = await this.generateReproductionGuide(context);\r\n\r\n    // Validate against system state\r\n    const validation = this.validateAgainstSystemState(context);\r\n\r\n    // AI-powered reproduction analysis\r\n    const aiAnalysis = await this.analyzeWithAI(\r\n      'Analyze this bug report and generate detailed reproduction steps. Identify prerequisites, environment requirements, and expected vs actual behavior.',\r\n      {\r\n        bugReport: context.bugReport,\r\n        systemState: context.systemState,\r\n        existingSteps: context.bugReport.reproductionSteps\r\n      }\r\n    );\r\n\r\n    return {\r\n      findings,\r\n      reproductionGuide,\r\n      validation,\r\n      reportAnalysis,\r\n      aiAnalysis,\r\n      summary: this.generateSummary(reproductionGuide, validation)\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Analyze bug report\r\n   */\r\n  private analyzeBugReport(bugReport: any): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    // Check if reproduction steps are provided\r\n    if (!bugReport.reproductionSteps || bugReport.reproductionSteps.length === 0) {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'high',\r\n        description: 'Bug report lacks reproduction steps - makes investigation difficult',\r\n        location: 'bug_report',\r\n        evidence: ['No reproduction steps provided'],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    // Check severity level\r\n    if (bugReport.severity === 'critical' && !bugReport.environment) {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'medium',\r\n        description: 'Critical bug missing environment information',\r\n        location: 'bug_report',\r\n        evidence: ['No environment data'],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    // Check bug category\r\n    if (bugReport.category === 'security' || bugReport.category === 'crash') {\r\n      findings.push({\r\n        type: bugReport.category,\r\n        severity: 'high',\r\n        description: `Bug categorized as ${bugReport.category} - requires immediate attention`,\r\n        location: 'bug_report',\r\n        evidence: [bugReport.category],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Check environment configuration\r\n   */\r\n  private checkEnvironment(context: InvestigationContext): Finding[] {\r\n    const findings: Finding[] = [];\r\n    const env = context.bugReport.environment;\r\n\r\n    if (!env) {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'medium',\r\n        description: 'No environment information provided',\r\n        location: 'environment',\r\n        evidence: ['Environment data missing'],\r\n        relatedFindings: []\r\n      });\r\n      return findings;\r\n    }\r\n\r\n    // Check OS version\r\n    if (!env.os || env.os === 'unknown') {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'low',\r\n        description: 'OS version not specified',\r\n        location: 'environment',\r\n        evidence: ['Missing OS version'],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    // Check runtime version\r\n    if (!env.runtime || env.runtime === 'unknown') {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'low',\r\n        description: 'Runtime version not specified',\r\n        location: 'environment',\r\n        evidence: ['Missing runtime version'],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    // Check for known problematic versions\r\n    const knownIssues = this.checkKnownIssues(env);\r\n    findings.push(...knownIssues);\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Check for known issues with environment\r\n   */\r\n  private checkKnownIssues(environment: any): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    // Add known issue checks here\r\n    // Example: specific Node.js versions with known bugs\r\n    if (environment.runtime && environment.runtime.includes('v14')) {\r\n      findings.push({\r\n        type: 'configuration',\r\n        severity: 'medium',\r\n        description: 'Node.js v14 has known issues - consider upgrading',\r\n        location: 'environment',\r\n        evidence: [environment.runtime],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Analyze reproduction steps\r\n   */\r\n  private async analyzeReproductionSteps(context: InvestigationContext): Promise<any> {\r\n    const findings: Finding[] = [];\r\n    const steps = context.bugReport.reproductionSteps || [];\r\n\r\n    if (steps.length === 0) {\r\n      return { findings, stepAnalysis: null };\r\n    }\r\n\r\n    // Analyze step clarity\r\n    steps.forEach((step, index) => {\r\n      if (step.length < 10) {\r\n        findings.push({\r\n          type: 'configuration',\r\n          severity: 'low',\r\n          description: `Reproduction step ${index + 1} is too vague: \"${step}\"`,\r\n          location: `reproduction_steps[${index}]`,\r\n          evidence: [step],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      if (!step.includes('click') && !step.includes('open') && !step.includes('navigate') && !step.includes('select')) {\r\n        findings.push({\r\n          type: 'configuration',\r\n          severity: 'low',\r\n          description: `Reproduction step ${index + 1} may lack clear action: \"${step}\"`,\r\n          location: `reproduction_steps[${index}]`,\r\n          evidence: [step],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    });\r\n\r\n    const stepAnalysis = {\r\n      totalSteps: steps.length,\r\n      clearSteps: steps.filter(s => s.length >= 10).length,\r\n      vagueSteps: findings.length,\r\n      complexity: this.assessComplexity(steps)\r\n    };\r\n\r\n    return { findings, stepAnalysis };\r\n  }\r\n\r\n  /**\r\n   * Assess complexity of reproduction steps\r\n   */\r\n  private assessComplexity(steps: string[]): 'simple' | 'moderate' | 'complex' {\r\n    if (steps.length <= 2) return 'simple';\r\n    if (steps.length <= 5) return 'moderate';\r\n    return 'complex';\r\n  }\r\n\r\n  /**\r\n   * Generate reproduction guide\r\n   */\r\n  private async generateReproductionGuide(context: InvestigationContext): Promise<ReproductionGuide> {\r\n    const bugReport = context.bugReport;\r\n    const existingSteps = bugReport.reproductionSteps || [];\r\n\r\n    // Build guide\r\n    const guide: ReproductionGuide = {\r\n      steps: existingSteps,\r\n      prerequisites: this.identifyPrerequisites(context),\r\n      expectedBehavior: 'System should function normally without errors',\r\n      actualBehavior: bugReport.description,\r\n      successRate: existingSteps.length > 0 ? 0.8 : 0.3\r\n    };\r\n\r\n    // Enhance with AI analysis if available\r\n    const aiSteps = await this.analyzeWithAI(\r\n      'Generate detailed, step-by-step reproduction instructions. Include prerequisites, environment setup, and clear expected vs actual behavior.',\r\n      { bugReport, context }\r\n    );\r\n\r\n    if (aiSteps.steps) {\r\n      guide.steps = aiSteps.steps;\r\n      guide.prerequisites = aiSteps.prerequisites || guide.prerequisites;\r\n      guide.expectedBehavior = aiSteps.expectedBehavior || guide.expectedBehavior;\r\n      guide.actualBehavior = aiSteps.actualBehavior || guide.actualBehavior;\r\n      guide.successRate = 0.9;\r\n    }\r\n\r\n    return guide;\r\n  }\r\n\r\n  /**\r\n   * Identify prerequisites for reproduction\r\n   */\r\n  private identifyPrerequisites(context: InvestigationContext): string[] {\r\n    const prerequisites: string[] = [];\r\n    const category = context.bugReport.category;\r\n\r\n    // General prerequisites\r\n    prerequisites.push('Valid user account');\r\n    prerequisites.push('Network connectivity');\r\n\r\n    // Category-specific prerequisites\r\n    switch (category) {\r\n      case 'security':\r\n        prerequisites.push('Appropriate permissions/roles');\r\n        prerequisites.push('Security testing environment');\r\n        break;\r\n      case 'performance':\r\n        prerequisites.push('Load testing tools');\r\n        prerequisites.push('Performance monitoring enabled');\r\n        break;\r\n      case 'functional':\r\n        prerequisites.push('Test data prepared');\r\n        prerequisites.push('Feature access enabled');\r\n        break;\r\n      case 'memory':\r\n        prerequisites.push('Memory profiling tools');\r\n        prerequisites.push('High load environment');\r\n        break;\r\n      case 'concurrency':\r\n        prerequisites.push('Multiple concurrent users');\r\n        prerequisites.push('Concurrency testing setup');\r\n        break;\r\n    }\r\n\r\n    return prerequisites;\r\n  }\r\n\r\n  /**\r\n   * Validate against system state\r\n   */\r\n  private validateAgainstSystemState(context: InvestigationContext): any {\r\n    const validation = {\r\n      hasLogs: context.systemState.logs.length > 0,\r\n      hasTraces: context.systemState.traces.length > 0,\r\n      hasMetrics: !!context.systemState.metrics,\r\n      hasCodeContext: !!context.systemState.codeContext,\r\n      reproducibilityScore: 0\r\n    };\r\n\r\n    // Calculate reproducibility score\r\n    let score = 0;\r\n    if (context.bugReport.reproductionSteps && context.bugReport.reproductionSteps.length > 0) score += 0.3;\r\n    if (validation.hasLogs) score += 0.2;\r\n    if (validation.hasTraces) score += 0.2;\r\n    if (validation.hasCodeContext) score += 0.2;\r\n    if (context.bugReport.environment) score += 0.1;\r\n\r\n    validation.reproducibilityScore = score;\r\n\r\n    return validation;\r\n  }\r\n\r\n  /**\r\n   * Generate summary\r\n   */\r\n  private generateSummary(guide: ReproductionGuide, validation: any): string {\r\n    return `Bug reproduction analysis: ${guide.steps.length} steps identified, ` +\r\n      `reproducibility score: ${(validation.reproducibilityScore * 100).toFixed(0)}%.`;\r\n  }\r\n}\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\agents\\code-analysis.agent.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":45,"column":77,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":45,"endColumn":80,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1425,1428],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1425,1428],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":66,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":66,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2173,2176],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2173,2176],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":72,"column":7,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":79,"endColumn":8},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .findings on an `any` value.","line":81,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":81,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .findings on an `any` value.","line":82,"column":37,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":82,"endColumn":45},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":89,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":89,"endColumn":17},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":97,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":97,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3010,3013],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3010,3013],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":101,"column":56,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":101,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":105,"column":61,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":105,"endColumn":69},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":109,"column":79,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":109,"endColumn":87},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":113,"column":60,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":113,"endColumn":68},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":114,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":114,"endColumn":39},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":114,"column":31,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":114,"endColumn":39}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"﻿/**\r\n * Code Analysis Agent\r\n *\r\n * Specializes in analyzing code to identify bugs, vulnerabilities, and code quality issues.\r\n */\r\n\r\nimport { BaseInvestigationAgent } from './base-investigation.agent';\r\nimport { InvestigationContext, InvestigationAgentType, Finding } from '../types';\r\nimport { AgentConfig, MessageBus } from '../../core';\r\nimport * as fs from 'fs/promises';\r\nimport * as path from 'path';\r\n\r\nexport class CodeAnalysisAgent extends BaseInvestigationAgent {\r\n  private projectRoot: string;\r\n\r\n  constructor(config: AgentConfig, messageBus: MessageBus) {\r\n    super(config, messageBus, InvestigationAgentType.CODE_ANALYSIS, [\r\n      'static_analysis',\r\n      'code_review',\r\n      'bug_detection',\r\n      'vulnerability_scanning',\r\n      'code_smell_detection',\r\n      'dependency_analysis'\r\n    ]);\r\n    this.projectRoot = path.resolve(process.cwd(), '../..');\r\n  }\r\n\r\n  /**\r\n   * Get system prompt for AI model\r\n   */\r\n  public getSystemPrompt(): string {\r\n    return `You are a Code Analysis Agent specializing in:\r\n- Static code analysis and pattern detection\r\n- Bug identification and root cause analysis\r\n- Security vulnerability scanning\r\n- Code quality assessment\r\n- Dependency analysis\r\n\r\nYour goal is to identify code issues that could cause bugs or security problems.`;\r\n  }\r\n\r\n  /**\r\n   * Analyze code for issues\r\n   */\r\n  public async analyzeInvestigation(context: InvestigationContext): Promise<any> {\r\n    console.log('[CodeAnalysisAgent] Starting code analysis...');\r\n\r\n    const findings: Finding[] = [];\r\n\r\n    // Get code context if available\r\n    const codeContext = context.systemState.codeContext;\r\n    if (codeContext) {\r\n      const fileAnalysis = await this.analyzeFile(codeContext);\r\n      findings.push(...fileAnalysis);\r\n    }\r\n\r\n    // Analyze related files if bug category suggests code issues\r\n    if (context.bugReport.category === 'security' ||\r\n        context.bugReport.category === 'functional' ||\r\n        context.bugReport.category === 'crash') {\r\n      const relatedIssues = await this.analyzeRelatedCode(context);\r\n      findings.push(...relatedIssues);\r\n    }\r\n\r\n    // AI-powered code analysis\r\n    let aiAnalysis: any = {};\r\n    if (codeContext || context.bugReport.category === 'security') {\r\n      const codeContextForAI = codeContext ?\r\n        await this.readCodeFile(codeContext.filePath) :\r\n        'No specific file identified';\r\n\r\n      aiAnalysis = await this.analyzeWithAI(\r\n        'Analyze this code for bugs, vulnerabilities, and code quality issues.',\r\n        {\r\n          bugReport: context.bugReport,\r\n          codeContext: codeContextForAI,\r\n          codePath: codeContext?.filePath\r\n        }\r\n      );\r\n\r\n      if (aiAnalysis.findings) {\r\n        findings.push(...aiAnalysis.findings);\r\n      }\r\n    }\r\n\r\n    return {\r\n      findings,\r\n      codeIssues: findings,\r\n      aiAnalysis,\r\n      summary: this.generateSummary(findings)\r\n    };\r\n  }\r\n\r\n  /**\r\n   * Analyze specific file\r\n   */\r\n  private async analyzeFile(codeContext: any): Promise<Finding[]> {\r\n    const findings: Finding[] = [];\r\n\r\n    try {\r\n      const code = await this.readCodeFile(codeContext.filePath);\r\n      const lines = code.split('\\n');\r\n\r\n      // Basic static analysis\r\n      const issues = this.performStaticAnalysis(codeContext.filePath, code, lines);\r\n\r\n      findings.push(...issues);\r\n    } catch (error) {\r\n      console.error(`[CodeAnalysisAgent] Failed to analyze file ${codeContext.filePath}:`, error);\r\n      findings.push({\r\n        type: 'error',\r\n        severity: 'low',\r\n        description: `Could not analyze file ${codeContext.filePath}: ${error}`,\r\n        location: codeContext.filePath,\r\n        evidence: [],\r\n        relatedFindings: []\r\n      });\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Perform static code analysis\r\n   */\r\n  private performStaticAnalysis(filePath: string, code: string, lines: string[]): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    // Check for common issues\r\n    lines.forEach((line, index) => {\r\n      const lineNumber = index + 1;\r\n\r\n      // Check for TODO/FIXME comments\r\n      if (line.includes('TODO') || line.includes('FIXME')) {\r\n        findings.push({\r\n          type: 'configuration',\r\n          severity: 'low',\r\n          description: `Found incomplete code marker at line ${lineNumber}`,\r\n          location: `${filePath}:${lineNumber}`,\r\n          evidence: [line.trim()],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      // Check for console.log in production code\r\n      if (line.includes('console.log') && !line.includes('//')) {\r\n        findings.push({\r\n          type: 'configuration',\r\n          severity: 'low',\r\n          description: `Found console.log statement at line ${lineNumber}`,\r\n          location: `${filePath}:${lineNumber}`,\r\n          evidence: [line.trim()],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      // Check for hardcoded credentials (basic check)\r\n      if (line.match(/password\\s*=\\s*['\"][^'\"]+['\"]/i) ||\r\n          line.match(/api_?key\\s*=\\s*['\"][^'\"]+['\"]/i)) {\r\n        findings.push({\r\n          type: 'security',\r\n          severity: 'high',\r\n          description: `Possible hardcoded credential at line ${lineNumber}`,\r\n          location: `${filePath}:${lineNumber}`,\r\n          evidence: [line.trim()],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      // Check for SQL injection patterns\r\n      if (line.match(/query\\s*=\\s*['\"].*\\$\\{.*\\}/) ||\r\n          line.match(/execute\\(['\"].*\\+.*['\"]\\)/)) {\r\n        findings.push({\r\n          type: 'security',\r\n          severity: 'critical',\r\n          description: `Possible SQL injection vulnerability at line ${lineNumber}`,\r\n          location: `${filePath}:${lineNumber}`,\r\n          evidence: [line.trim()],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n\r\n      // Check for eval usage\r\n      if (line.includes('eval(')) {\r\n        findings.push({\r\n          type: 'security',\r\n          severity: 'high',\r\n          description: `Use of eval() at line ${lineNumber} (security risk)`,\r\n          location: `${filePath}:${lineNumber}`,\r\n          evidence: [line.trim()],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    });\r\n\r\n    // Check for complex functions (cyclomatic complexity)\r\n    const functionComplexity = this.analyzeComplexity(filePath, code);\r\n    findings.push(...functionComplexity);\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Analyze code complexity\r\n   */\r\n  private analyzeComplexity(filePath: string, code: string): Finding[] {\r\n    const findings: Finding[] = [];\r\n\r\n    // Simple complexity check: count branches in functions\r\n    const functionPattern = /(?:function|const\\s+\\w+\\s*=\\s*(?:async\\s*)?\\(|=>\\s*{)/g;\r\n    const functions = code.match(functionPattern) || [];\r\n\r\n    if (functions.length > 0) {\r\n      // This is a simplified check - real complexity analysis would be more sophisticated\r\n      const avgComplexity = code.split(/\\b(if\\b|else\\b|for\\b|while\\b|case\\b|catch\\b)/g).length / functions.length;\r\n\r\n      if (avgComplexity > 20) {\r\n        findings.push({\r\n          type: 'performance',\r\n          severity: 'medium',\r\n          description: `File ${filePath} has high average cyclomatic complexity: ${avgComplexity.toFixed(2)}`,\r\n          location: filePath,\r\n          evidence: [`Average complexity: ${avgComplexity.toFixed(2)}`],\r\n          relatedFindings: []\r\n        });\r\n      }\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Analyze related code based on bug category\r\n   */\r\n  private async analyzeRelatedCode(context: InvestigationContext): Promise<Finding[]> {\r\n    const findings: Finding[] = [];\r\n\r\n    try {\r\n      // Look for files related to the bug\r\n      const searchPaths = this.getSearchPaths(context);\r\n\r\n      for (const searchPath of searchPaths) {\r\n        const fullPath = path.join(this.projectRoot, searchPath);\r\n\r\n        try {\r\n          const files = await this.findRelevantFiles(fullPath);\r\n          const issues = await this.analyzeFiles(files, context);\r\n          findings.push(...issues);\r\n        } catch (error) {\r\n          // File or directory may not exist, continue\r\n          console.debug(`[CodeAnalysisAgent] Path not found: ${fullPath}`);\r\n        }\r\n      }\r\n    } catch (error) {\r\n      console.error('[CodeAnalysisAgent] Error analyzing related code:', error);\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Get search paths based on bug category\r\n   */\r\n  private getSearchPaths(context: InvestigationContext): string[] {\r\n    const category = context.bugReport.category;\r\n    const paths: string[] = [];\r\n\r\n    switch (category) {\r\n      case 'security':\r\n        paths.push(\r\n          'backend/src/security',\r\n          'backend/src/middleware',\r\n          'backend/src/auth'\r\n        );\r\n        break;\r\n      case 'performance':\r\n        paths.push(\r\n          'backend/src/services',\r\n          'backend/src/database',\r\n          'backend/src/cache'\r\n        );\r\n        break;\r\n      case 'functional':\r\n        paths.push(\r\n          'backend/src/api',\r\n          'backend/src/controllers'\r\n        );\r\n        break;\r\n      case 'crash':\r\n        paths.push(\r\n          'backend/src/index.ts',\r\n          'backend/src/server.ts',\r\n          'backend/src/app.ts'\r\n        );\r\n        break;\r\n      default:\r\n        paths.push('backend/src');\r\n    }\r\n\r\n    return paths;\r\n  }\r\n\r\n  /**\r\n   * Find relevant files\r\n   */\r\n  private async findRelevantFiles(dirPath: string): Promise<string[]> {\r\n    const files: string[] = [];\r\n\r\n    try {\r\n      const entries = await fs.readdir(dirPath, { withFileTypes: true });\r\n\r\n      for (const entry of entries) {\r\n        const fullPath = path.join(dirPath, entry.name);\r\n\r\n        if (entry.isDirectory()) {\r\n          const subFiles = await this.findRelevantFiles(fullPath);\r\n          files.push(...subFiles);\r\n        } else if (entry.isFile() && (entry.name.endsWith('.ts') || entry.name.endsWith('.js'))) {\r\n          files.push(fullPath);\r\n        }\r\n      }\r\n    } catch (error) {\r\n      // Directory may not exist\r\n    }\r\n\r\n    return files.slice(0, 20); // Limit to 20 files\r\n  }\r\n\r\n  /**\r\n   * Analyze multiple files\r\n   */\r\n  private async analyzeFiles(filePaths: string[], context: InvestigationContext): Promise<Finding[]> {\r\n    const findings: Finding[] = [];\r\n\r\n    for (const filePath of filePaths) {\r\n      try {\r\n        const code = await this.readCodeFile(filePath);\r\n        const lines = code.split('\\n');\r\n        const issues = this.performStaticAnalysis(filePath, code, lines);\r\n        findings.push(...issues);\r\n      } catch (error) {\r\n        console.error(`[CodeAnalysisAgent] Failed to analyze ${filePath}:`, error);\r\n      }\r\n    }\r\n\r\n    return findings;\r\n  }\r\n\r\n  /**\r\n   * Read code file\r\n   */\r\n  private async readCodeFile(filePath: string): Promise<string> {\r\n    const fullPath = path.isAbsolute(filePath) ?\r\n      filePath :\r\n      path.join(this.projectRoot, filePath);\r\n\r\n    try {\r\n      return await fs.readFile(fullPath, 'utf-8');\r\n    } catch (error) {\r\n      throw new Error(`Failed to read file ${fullPath}: ${error}`);\r\n    }\r\n  }\r\n\r\n  /**\r\n   * Generate analysis summary\r\n   */\r\n  private generateSummary(findings: Finding[]): string {\r\n    const critical = findings.filter(f => f.severity === 'critical').length;\r\n    const high = findings.filter(f => f.severity === 'high').length;\r\n    const medium = findings.filter(f => f.severity === 'medium').length;\r\n\r\n    return `Code analysis complete: ${findings.length} issues found ` +\r\n      `(${critical} critical, ${high} high, ${medium} medium).`;\r\n  }\r\n}\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\ai-agents\\investigation\\agents\\log-analysis.agent.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":40,"column":77,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":40,"endColumn":80,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1267,1270],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1267,1270],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":58,"column":7,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":58,"endColumn":27},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":58,"column":11,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":58,"endColumn":18},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":59,"column":7,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":59,"endColumn":27},{"ruleId":"@t