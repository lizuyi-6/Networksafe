\n  maxQueueSize: 512\n};\n\nfunction normalizeHeaderValue(value: unknown): string {\n  if (Array.isArray(value)) {\n    return value.map((item) => String(item ?? '')).join(', ');\n  }\n  return String(value ?? '');\n}\n\nfunction normalizeHeaders(headers: Record<string, unknown>): Record<string, string> {\n  return Object.entries(headers || {}).reduce<Record<string, string>>((acc, [key, value]) => {\n    if (!key) {\n      return acc;\n    }\n    acc[key.toLowerCase()] = normalizeHeaderValue(value);\n    return acc;\n  }, {});\n}\n\nfunction normalizeHttpVersion(version: string): string {\n  const trimmed = String(version || '').trim();\n  if (!trimmed) {\n    return 'HTTP/1.1';\n  }\n  if (/^HTTP\\//i.test(trimmed)) {\n    return trimmed.toUpperCase();\n  }\n  return `HTTP/${trimmed}`;\n}\n\nfunction isTextualContentType(contentType: string): boolean {\n  const normalized = contentType.toLowerCase();\n  return (\n    normalized.includes('application/json') ||\n    normalized.includes('application/x-www-form-urlencoded') ||\n    normalized.startsWith('text/')\n  );\n}\n\nfunction isSkippedRequest(req: Request, contentType: string): boolean {\n  if (req.method === 'OPTIONS') {\n    return true;\n  }\n\n  const path = req.path || req.originalUrl || '';\n  if (path === '/health' || path === '/api/health') {\n    return true;\n  }\n\n  const normalized = contentType.toLowerCase();\n  return normalized.startsWith('multipart/') || normalized.includes('application/octet-stream');\n}\n\nfunction resolveSourceIp(req: Request): string {\n  return String(\n    req.ip ||\n    req.socket?.remoteAddress ||\n    (req.connection as any)?.remoteAddress ||\n    ''\n  ).trim();\n}\n\nfunction fallbackBodyBytes(req: Request): Buffer {\n  if (Buffer.isBuffer((req as any).rawBody)) {\n    return Buffer.from((req as any).rawBody);\n  }\n\n  if (typeof req.body === 'string') {\n    return Buffer.from(req.body, 'utf8');\n  }\n\n  if (req.body && typeof req.body === 'object' && !Buffer.isBuffer(req.body)) {\n    return Buffer.from(JSON.stringify(req.body), 'utf8');\n  }\n\n  return Buffer.alloc(0);\n}\n\nfunction buildSnapshot(req: Request): PendingHttpSnapshot | null {\n  const contentType = String(req.headers['content-type'] || '').trim();\n  if (isSkippedRequest(req, contentType)) {\n    return null;\n  }\n\n  if (contentType && !isTextualContentType(contentType)) {\n    return {\n      tenantId: (req as any).user?.tenantId || 'global',\n      requestId: String(req.headers['x-request-id'] || randomUUID()),\n      method: req.method,\n      url: req.originalUrl || req.url || '/',\n      httpVersion: normalizeHttpVersion(req.httpVersion),\n      headers: normalizeHeaders(req.headers as Record<string, unknown>),\n      rawBody: Buffer.alloc(0),\n      sourceIp: resolveSourceIp(req),\n      contentType\n    };\n  }\n\n  return {\n    tenantId: (req as any).user?.tenantId || 'global',\n    requestId: String(req.headers['x-request-id'] || randomUUID()),\n    method: req.method,\n    url: req.originalUrl || req.url || '/',\n    httpVersion: normalizeHttpVersion(req.httpVersion),\n    headers: normalizeHeaders(req.headers as Record<string, unknown>),\n    rawBody: fallbackBodyBytes(req),\n    sourceIp: resolveSourceIp(req),\n    contentType\n  };\n}\n\nfunction toHttpProtocolFindingSignatures(findings: ProtocolFinding[]): string[] {\n  return Array.from(\n    new Set((findings || []).map((finding) => `${String(finding?.code || 'unknown')}:${String(finding?.severity || 'medium')}`))\n  ).sort();\n}\n\nfunction buildHttpShadowTask(snapshot: PendingHttpSnapshot, maxBodyBytes: number): ProtocolShadowTask {\n  const rawBody = snapshot.rawBody.subarray(0, maxBodyBytes);\n  const truncated = snapshot.rawBody.length > rawBody.length;\n  const httpRequest: HttpTrafficEvaluateRequest = {\n    tenantId: snapshot.tenantId,\n    requestId: snapshot.requestId,\n    method: snapshot.method,\n    url: snapshot.url,\n    httpVersion: snapshot.httpVersion,\n    headers: snapshot.headers,\n    bodyBase64: rawBody.toString('base64'),\n    sourceIp: snapshot.sourceIp,\n    truncated\n  };\n  const baseline = httpTrafficEvaluatorService.evaluateBaseline(httpRequest);\n\n  return {\n    tenantId: snapshot.tenantId,\n    protocol: 'http',\n    requestId: snapshot.requestId,\n    url: snapshot.url,\n    protocolRequest: {\n      tenantId: snapshot.tenantId,\n      requestId: snapshot.requestId,\n      protocol: 'http',\n      direction: 'ingress',\n      sourceRef: snapshot.sourceIp,\n      channel: snapshot.url,\n      headers: snapshot.headers,\n      metadata: {\n        method: snapshot.method,\n        url: snapshot.url,\n        httpVersion: snapshot.httpVersion,\n        sourceIp: snapshot.sourceIp,\n        contentType: snapshot.contentType\n      },\n      payloadBase64: httpRequest.bodyBase64,\n      truncated,\n      timestamp: new Date().toISOString()\n    },\n    baseline: {\n      protocol: 'http',\n      verdict: baseline.verdict === 'block' ? 'block' : 'allow',\n      action: baseline.verdict === 'block' ? 'block' : 'inspect',\n      matchedRule: baseline.matchedRule,\n      findings: baseline.threats.map((threat) => ({\n        code: threat.type,\n        severity: threat.severity,\n        message: threat.description\n      })),\n      decisionSource: baseline.decisionSource,\n      processingTimeMicros: baseline.processingTimeMicros,\n      costMetrics: {}\n    }\n  };\n}\n\nclass FastpathTrafficShadowService {\n  private readonly queue: ProtocolShadowTask[] = [];\n  private readonly workerConfig: FastpathShadowWorkerConfig = { ...DEFAULT_WORKER_CONFIG };\n  private activeWorkers = 0;\n  private pendingSubmissions = 0;\n  private idleResolvers: Array<() => void> = [];\n\n  submitFromRequest(req: Request): void {\n    const snapshot = buildSnapshot(req);\n    if (!snapshot) {\n      return;\n    }\n\n    this.pendingSubmissions += 1;\n    void this.maybeQueueSnapshot(snapshot).finally(() => {\n      this.pendingSubmissions = Math.max(0, this.pendingSubmissions - 1);\n      this.resolveIdle();\n    });\n  }\n\n  resetForTests(): void {\n    this.queue.length = 0;\n    this.activeWorkers = 0;\n    this.pendingSubmissions = 0;\n    this.workerConfig.concurrency = DEFAULT_WORKER_CONFIG.concurrency;\n    this.workerConfig.maxQueueSize = DEFAULT_WORKER_CONFIG.maxQueueSize;\n    this.resolveIdle();\n  }\n\n  setWorkerConfigForTests(config: Partial<FastpathShadowWorkerConfig>): void {\n    if (typeof config.concurrency === 'number') {\n      this.workerConfig.concurrency = Math.max(0, Math.floor(config.concurrency));\n    }\n    if (typeof config.maxQueueSize === 'number') {\n      this.workerConfig.maxQueueSize = Math.max(1, Math.floor(config.maxQueueSize));\n    }\n  }\n\n  async awaitIdleForTests(): Promise<void> {\n    if (this.queue.length === 0 && this.activeWorkers === 0 && this.pendingSubmissions === 0) {\n      return;\n    }\n\n    await new Promise<void>((resolve) => {\n      this.idleResolvers.push(resolve);\n    });\n  }\n\n  private async maybeQueueSnapshot(snapshot: PendingHttpSnapshot): Promise<void> {\n    try {\n      const config = await platformConfigService.getConfig(snapshot.tenantId);\n      if (!config.fastpath.enabled || !config.fastpath.trafficShadowEnabled) {\n        return;\n      }\n\n      const sampleRatePct = Math.max(0, Math.min(100, Number(config.fastpath.trafficShadowSampleRatePct || 0)));\n      if (sampleRatePct <= 0) {\n        return;\n      }\n\n      const sampleBucket = hashTrafficSampleKey({\n        tenantId: snapshot.tenantId,\n        requestId: snapshot.requestId,\n        method: snapshot.method,\n        url: snapshot.url\n      });\n      if (sampleBucket >= sampleRatePct) {\n        return;\n      }\n\n      const maxBodyBytes = Math.max(0, Number(config.fastpath.trafficMaxBodyBytes || 65536));\n      this.enqueue(buildHttpShadowTask(snapshot, maxBodyBytes));\n    } catch (error: any) {\n      logger.warn('fastpath_traffic_shadow_error', {\n        tenantId: snapshot.tenantId,\n        requestId: snapshot.requestId,\n        url: snapshot.url,\n        error: error?.message || 'shadow_config_error'\n      });\n    }\n  }\n\n  private enqueue(task: ProtocolShadowTask): void {\n    if (this.queue.length >= this.workerConfig.maxQueueSize) {\n      logger.warn('fastpath_traffic_shadow_dropped', {\n        tenantId: task.tenantId,\n        requestId: task.requestId,\n        url: task.url,\n        protocol: task.protocol,\n        queueDepth: this.queue.length,\n        maxQueueSize: this.workerConfig.maxQueueSize\n      });\n      return;\n    }\n\n    this.queue.push(task);\n    this.drain();\n  }\n\n  private drain(): void {\n    while (this.activeWorkers < this.workerConfig.concurrency && this.queue.length > 0) {\n      const task = this.queue.shift();\n      if (!task) {\n        break;\n      }\n\n      this.activeWorkers += 1;\n      void this.processTask(task).finally(() => {\n        this.activeWorkers = Math.max(0, this.activeWorkers - 1);\n        this.drain();\n        this.resolveIdle();\n      });\n    }\n\n    this.resolveIdle();\n  }\n\n  private async processTask(task: ProtocolShadowTask): Promise<void> {\n    const fastpath = await fastpathClientService.evaluateProtocol(task.protocolRequest);\n\n    if (!fastpath) {\n      logger.warn('fastpath_traffic_shadow_error', {\n        tenantId: task.tenantId,\n        requestId: task.requestId,\n        url: task.url,\n        protocol: task.protocol,\n        error: 'fastpath_unavailable'\n      });\n      return;\n    }\n\n    const baselineFindings = toHttpProtocolFindingSignatures(task.baseline.findings);\n    const fastpathFindings = toHttpProtocolFindingSignatures(fastpath.findings);\n    const mismatch =\n      task.baseline.verdict !== fastpath.verdict ||\n      baselineFindings.join('|') !== fastpathFindings.join('|');\n\n    if (mismatch) {\n      logger.warn('fastpath_traffic_shadow_mismatch', {\n        tenantId: task.tenantId,\n        requestId: task.requestId,\n        url: task.url,\n        protocol: task.protocol,\n        baselineVerdict: task.baseline.verdict,\n        fastpathVerdict: fastpath.verdict,\n        baselineMatchedRule: task.baseline.matchedRule,\n        fastpathMatchedRule: fastpath.matchedRule,\n        baselineFindings,\n        fastpathFindings,\n        truncated: Boolean(task.protocolRequest.truncated)\n      });\n    }\n  }\n\n  private resolveIdle(): void {\n    if (this.queue.length > 0 || this.activeWorkers > 0 || this.pendingSubmissions > 0) {\n      return;\n    }\n\n    while (this.idleResolvers.length > 0) {\n      const resolve = this.idleResolvers.shift();\n      resolve?.();\n    }\n  }\n}\n\nexport const fastpathTrafficShadowService = new FastpathTrafficShadowService();\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\services\\http-traffic-evaluator.service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":156,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":156,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4592,4595],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4592,4595],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .bodyText on an `any` value.","line":156,"column":43,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":156,"endColumn":51}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Buffer } from 'buffer';\r\nimport { createHash } from 'cry