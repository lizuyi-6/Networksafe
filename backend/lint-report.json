:[{"messageId":"suggestUnknown","fix":{"range":[14285,14288],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[14285,14288],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":482,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":482,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15529,15532],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15529,15532],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":76,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Router, Response } from 'express';\r\nimport { authenticate, AuthenticatedRequest, requireTenantAccess } from '../../middleware/auth.middleware';\r\nimport { requirePlanQuota } from '../../middleware/plan.middleware';\r\nimport { sendError, sendSuccess } from '../../core/http/api-response';\r\nimport { PLATFORM_TENANT_ID } from '../../core/tenant/tenant-context';\r\nimport logger from '../../utils/logger';\r\nimport dns from 'dns';\r\nimport { promisify } from 'util';\r\nimport { securityOperationsService } from '../../services/security-operations.service';\r\nimport auditLogger from '../../security/audit-logger.service';\r\nimport {\r\n  createSite,\r\n  deleteSiteForUser,\r\n  getSiteForUser,\r\n  listSitesForUser,\r\n  setSiteRepositoryDatabase,\r\n  updateSite\r\n} from '../../modules/sites/site.repository';\r\n\r\nconst router = Router();\r\nconst dnsLookup = promisify(dns.lookup);\r\n\r\nexport function setDatabase(db: any | null): void {\r\n  setSiteRepositoryDatabase(db);\r\n}\r\n\r\nfunction safeAuditLog(payload: any): void {\r\n  Promise.resolve(auditLogger.log(payload)).catch((error: any) => {\r\n    logger.warn('Audit log unavailable for site route', { error: error?.message });\r\n  });\r\n}\r\n\r\nfunction getSiteExternalRefs(site: any): string[] {\r\n  const refs = new Set<string>();\r\n  if (site?.id !== undefined && site?.id !== null) {\r\n    refs.add(String(site.id));\r\n  }\r\n  if (site?.domain) {\r\n    const domain = String(site.domain);\r\n    refs.add(domain);\r\n    refs.add(`https://${domain}`);\r\n    refs.add(`http://${domain}`);\r\n  }\r\n  if (site?.target) {\r\n    refs.add(String(site.target));\r\n    try {\r\n      refs.add(new URL(String(site.target)).hostname);\r\n    } catch {\r\n      // ignore invalid URLs here; validation already happens on writes\r\n    }\r\n  }\r\n  return Array.from(refs);\r\n}\r\n\r\nfunction hydrateSiteSecurity(tenantId: string, site: any) {\r\n  try {\r\n    const refs = getSiteExternalRefs(site);\r\n    const host = (() => {\r\n      try {\r\n        return site?.target ? new URL(String(site.target)).hostname : undefined;\r\n      } catch {\r\n        return undefined;\r\n      }\r\n    })();\r\n\r\n    securityOperationsService.upsertAsset({\r\n      tenantId,\r\n      assetType: 'site',\r\n      externalRef: String(site.id),\r\n      displayName: site.domain || `site-${site.id}`,\r\n      primaryAddress: host,\r\n      status: 'protected',\r\n      metadata: {\r\n        domain: site.domain,\r\n        target: site.target,\r\n        sslEnabled: Boolean(site.sslEnabled)\r\n      }\r\n    });\r\n\r\n    if (site?.domain) {\r\n      securityOperationsService.upsertAsset({\r\n        tenantId,\r\n        assetType: 'domain',\r\n        externalRef: String(site.domain),\r\n        displayName: String(site.domain),\r\n        primaryAddress: host,\r\n        status: 'observed',\r\n        metadata: { siteId: site.id, target: site.target }\r\n      });\r\n    }\r\n\r\n    if (host) {\r\n      securityOperationsService.upsertAsset({\r\n        tenantId,\r\n        assetType: 'host',\r\n        externalRef: host,\r\n        displayName: host,\r\n        primaryAddress: host,\r\n        status: 'observed',\r\n        metadata: { siteId: site.id, domain: site.domain }\r\n      });\r\n    }\r\n\r\n    const context = securityOperationsService.getOperationalContextForExternalRefs(\r\n      tenantId,\r\n      refs,\r\n      ['site', 'domain', 'url', 'host']\r\n    );\r\n\r\n    return {\r\n      refs,\r\n      context,\r\n      primaryAsset:\r\n        context.assets.find((asset) => asset.assetType === 'site' && asset.externalRef === String(site.id)) ||\r\n        context.assets.find((asset) => asset.assetType === 'domain' && asset.externalRef === String(site.domain || '')) ||\r\n        context.assets[0] ||\r\n        null\r\n    };\r\n  } catch {\r\n    return {\r\n      refs: getSiteExternalRefs(site),\r\n      context: {\r\n        assets: [],\r\n        findings: [],\r\n        alerts: [],\r\n        actions: [],\r\n        trafficSessions: [],\r\n        serviceExposure: [],\r\n        scanRuns: []\r\n      },\r\n      primaryAsset: null\r\n    };\r\n  }\r\n}\r\n\r\n// SECURITY FIX: Apply authentication to all routes\r\nrouter.use(authenticate);\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-006: Enhanced SSRF protection\r\n * Validates URL and resolved IP against private ranges\r\n */\r\nasync function validateTargetUrl(target: string): Promise<{ valid: boolean; error?: string }> {\r\n  try {\r\n    const targetUrl = new URL(target);\r\n\r\n    // Block non-HTTP(S) protocols\r\n    if (!['http:', 'https:'].includes(targetUrl.protocol)) {\r\n      return { valid: false, error: 'backend.only_http_and_https_protocols_are_allowed' };\r\n    }\r\n\r\n    const hostname = targetUrl.hostname;\r\n\r\n    // Block obvious internal hostnames\r\n    const blockedHosts = [\r\n      'localhost', '127.0.0.1', '0.0.0.0', '::1', '[::1]',\r\n      'metadata.google.internal', 'metadata.google',\r\n      '169.254.169.254', 'metadata', 'metadata.internal'\r\n    ];\r\n    if (blockedHosts.includes(hostname.toLowerCase())) {\r\n      return { valid: false, error: 'backend.internal_addresses_not_allowed' };\r\n    }\r\n\r\n    // SECURITY FIX: Resolve hostname and check resolved IP\r\n    try {\r\n      const { address } = await dnsLookup(hostname);\r\n      if (isPrivateIP(address)) {\r\n        logger.warn('SSRF attempt blocked: DNS resolved to private IP', { hostname, resolvedIP: address });\r\n        return { valid: false, error: 'backend.target_resolves_to_private_ip_address' };\r\n      }\r\n    } catch (dnsError) {\r\n      // If DNS resolution fails, block the request\r\n      return { valid: false, error: 'backend.unable_to_resolve_target_hostname' };\r\n    }\r\n\r\n    return { valid: true };\r\n  } catch {\r\n    return { valid: false, error: 'backend.invalid_url_format' };\r\n  }\r\n}\r\n\r\n/**\r\n * SECURITY FIX CVE-2026-006/022: Complete private IP range detection\r\n */\r\nfunction isPrivateIP(ip: string): boolean {\r\n  // IPv4 private ranges\r\n  const ipv4PrivatePatterns = [\r\n    /^127\\./,                    // Loopback\r\n    /^10\\./,                     // Class A private\r\n    /^192\\.168\\./,               // Class C private\r\n    /^172\\.(1[6-9]|2[0-9]|3[0-1])\\./, // Class B private (172.16.0.0 - 172.31.255.255)\r\n    /^169\\.254\\./,               // Link-local\r\n    /^0\\./,                      // Current network\r\n    /^224\\./,                    // Multicast\r\n    /^240\\./,                    // Reserved\r\n    /^255\\./,                    // Broadcast\r\n  ];\r\n\r\n  for (const pattern of ipv4PrivatePatterns) {\r\n    if (pattern.test(ip)) {\r\n      return true;\r\n    }\r\n  }\r\n\r\n  // IPv6 private ranges\r\n  if (ip.includes(':')) {\r\n    const ipv6Lower = ip.toLowerCase();\r\n    if (\r\n      ipv6Lower === '::1' ||           // Loopback\r\n      ipv6Lower.startsWith('fe80:') || // Link-local\r\n      ipv6Lower.startsWith('fc') ||    // Unique local\r\n      ipv6Lower.startsWith('fd') ||    // Unique local\r\n      ipv6Lower.startsWith('::ffff:')  // IPv4-mapped IPv6\r\n    ) {\r\n      return true;\r\n    }\r\n  }\r\n\r\n  return false;\r\n}\r\n\r\n/**\r\n * GET /api/sites\r\n * Get all sites\r\n * SECURITY FIX CVE-2026-002: Added tenant isolation\r\n */\r\nrouter.get('/', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const user = req.user!;\r\n    const sites = await listSitesForUser(user.role, user.tenantId);\r\n\r\n    // Convert integer booleans\r\n    const formattedSites = sites.map((site: any) => {\r\n      const normalized = {\r\n        ...site,\r\n        sslEnabled: Boolean(site.sslEnabled),\r\n        antiBotEnabled: Boolean(site.antiBotEnabled),\r\n        rateLimitEnabled: Boolean(site.rateLimitEnabled),\r\n        concurrencyEnabled: Boolean(site.concurrencyEnabled)\r\n      };\r\n      const security = hydrateSiteSecurity(\r\n        user.role === 'admin'\r\n          ? (site.tenant_id || user.tenantId || PLATFORM_TENANT_ID)\r\n          : (user.tenantId || PLATFORM_TENANT_ID),\r\n        normalized\r\n      );\r\n\r\n      return {\r\n        ...normalized,\r\n        securitySummary: {\r\n          asset: security.primaryAsset,\r\n          alerts: security.context.alerts.slice(0, 3),\r\n          findings: security.context.findings.slice(0, 3),\r\n          actions: security.context.actions.slice(0, 3),\r\n          recentScans: security.context.scanRuns.slice(0, 3),\r\n          serviceExposure: security.context.serviceExposure.slice(0, 5)\r\n        }\r\n      };\r\n    });\r\n\r\n    return sendSuccess(res, formattedSites);\r\n  } catch (error: any) {\r\n    logger.error('Failed to get sites', { error });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * GET /api/sites/:id\r\n * Get site by ID\r\n * SECURITY FIX CVE-2026-002: Added tenant isolation\r\n */\r\nrouter.get('/:id', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const user = req.user!;\r\n    const site = await getSiteForUser(req.params.id, user.role, user.tenantId);\r\n\r\n    if (!site) {\r\n      return sendError(res, 404, {\r\n        code: 'SITE_NOT_FOUND',\r\n        message: 'backend.site_not_found'\r\n      });\r\n    }\r\n\r\n    const tenantId = user.role === 'admin'\r\n      ? (site.tenant_id || user.tenantId || PLATFORM_TENANT_ID)\r\n      : (user.tenantId || PLATFORM_TENANT_ID);\r\n    const security = hydrateSiteSecurity(tenantId, site);\r\n\r\n    return sendSuccess(res, {\r\n      ...site,\r\n      securityOverview: {\r\n        asset: security.primaryAsset,\r\n        assets: security.context.assets,\r\n        findings: security.context.findings,\r\n        alerts: security.context.alerts,\r\n        actions: security.context.actions,\r\n        scans: security.context.scanRuns,\r\n        trafficSessions: security.context.trafficSessions,\r\n        serviceExposure: security.context.serviceExposure\r\n      },\r\n      relatedAlerts: security.context.alerts,\r\n      relatedFindings: security.context.findings,\r\n      relatedActions: security.context.actions,\r\n      relatedScans: security.context.scanRuns,\r\n      relatedFlows: security.context.trafficSessions,\r\n      serviceExposure: security.context.serviceExposure\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to get site', { error });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * POST /api/sites\r\n * Create new site\r\n * SECURITY FIX CVE-2026-002/006: Added tenant isolation and enhanced SSRF protection\r\n */\r\nrouter.post('/', requirePlanQuota('site'), async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const { domain, target, sslEnabled = true, security } = req.body;\r\n    const user = req.user!;\r\n\r\n    if (!domain || !target) {\r\n      return res.status(400).json({ success: false, error: 'backend.domain_and_target_are_required' });\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-006: Enhanced SSRF validation with DNS resolution check\r\n    const validation = await validateTargetUrl(target);\r\n    if (!validation.valid) {\r\n      return sendError(res, 400, {\r\n        code: 'INVALID_TARGET',\r\n        message: String(validation.error || 'backend.invalid_url_format')\r\n      });\r\n    }\r\n\r\n    const siteId = await createSite({\r\n      domain,\r\n      target,\r\n      sslEnabled: sslEnabled ? 1 : 0,\r\n      tenant_id: user.tenantId,\r\n      antiBotEnabled: security?.antiBot ? 1 : 0,\r\n      rateLimitEnabled: security?.rateLimit?.enabled ? 1 : 0,\r\n      concurrencyEnabled: security?.concurrency?.enabled ? 1 : 0,\r\n      rateLimitRequests: security?.rateLimit?.requestsPerMinute || 60,\r\n      concurrencyMax: security?.concurrency?.maxConcurrent || 5\r\n    });\r\n\r\n    logger.info(`Site created: ${domain} -> ${target}`, { userId: user.userId, tenantId: user.tenantId });\r\n    safeAuditLog({\r\n      tenantId: user.tenantId,\r\n      eventType: 'site_created',\r\n      category: 'system',\r\n      severity: 'warning',\r\n      actor: { type: 'user', id: user.userId, email: user.email, ip: req.ip },\r\n      target: { type: 'server', id: domain },\r\n      action: 'create_site',\r\n      details: { domain, target, sslEnabled },\r\n      status: 'success'\r\n    });\r\n\r\n    return sendSuccess(res, { id: siteId, domain, target }, undefined, 201);\r\n  } catch (error: any) {\r\n    logger.error('Failed to create site', { error });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * PUT /api/sites/:id\r\n * Update site\r\n * SECURITY FIX CVE-2026-002/006: Added tenant isolation and SSRF protection\r\n */\r\nrouter.put('/:id', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const { domain, target, sslEnabled, security } = req.body;\r\n    const user = req.user!;\r\n    const existingSite = await getSiteForUser(req.params.id, user.role, user.tenantId);\r\n\r\n    if (!existingSite) {\r\n      return sendError(res, 404, {\r\n        code: 'SITE_NOT_FOUND',\r\n        message: 'backend.site_not_found'\r\n      });\r\n    }\r\n\r\n    // SECURITY FIX CVE-2026-006: Validate target URL if being updated\r\n    if (target) {\r\n      const validation = await validateTargetUrl(target);\r\n      if (!validation.valid) {\r\n        return sendError(res, 400, {\r\n          code: 'INVALID_TARGET',\r\n          message: String(validation.error || 'backend.invalid_url_format')\r\n        });\r\n      }\r\n    }\r\n\r\n    await updateSite(req.params.id, {\r\n      domain,\r\n      target,\r\n      sslEnabled: typeof sslEnabled === 'boolean' ? sslEnabled : undefined,\r\n      antiBotEnabled: security?.antiBot,\r\n      rateLimitEnabled: security?.rateLimit?.enabled,\r\n      concurrencyEnabled: security?.concurrency?.enabled,\r\n      rateLimitRequests: security?.rateLimit?.requestsPerMinute,\r\n      concurrencyMax: security?.concurrency?.maxConcurrent\r\n    });\r\n\r\n    logger.info(`Site updated: ${req.params.id}`, { userId: user.userId });\r\n    safeAuditLog({\r\n      tenantId: user.tenantId,\r\n      eventType: 'site_updated',\r\n      category: 'system',\r\n      severity: 'warning',\r\n      actor: { type: 'user', id: user.userId, email: user.email, ip: req.ip },\r\n      target: { type: 'server', id: String(req.params.id) },\r\n      action: 'update_site',\r\n      details: {\r\n        siteId: req.params.id,\r\n        domain: domain || existingSite.domain,\r\n        target: target || existingSite.target,\r\n        sslEnabled: typeof sslEnabled === 'boolean' ? sslEnabled : existingSite.sslEnabled\r\n      },\r\n      status: 'success'\r\n    });\r\n\r\n    return sendSuccess(res, { updated: true }, {\r\n      legacy: { status: 'ok' }\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to update site', { error });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\n/**\r\n * DELETE /api/sites/:id\r\n * Delete site\r\n * SECURITY FIX CVE-2026-002: Added tenant isolation\r\n */\r\nrouter.delete('/:id', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const user = req.user!;\r\n    const changes = await deleteSiteForUser(req.params.id, user.role, user.tenantId);\r\n\r\n    if (changes === 0) {\r\n      return sendError(res, 404, {\r\n        code: 'SITE_NOT_FOUND',\r\n        message: 'backend.site_not_found'\r\n      });\r\n    }\r\n\r\n    logger.info(`Site deleted: ${req.params.id}`, { userId: user.userId });\r\n    safeAuditLog({\r\n      tenantId: user.tenantId,\r\n      eventType: 'site_deleted',\r\n      category: 'system',\r\n      severity: 'critical',\r\n      actor: { type: 'user', id: user.userId, email: user.email, ip: req.ip },\r\n      target: { type: 'server', id: String(req.params.id) },\r\n      action: 'delete_site',\r\n      details: { siteId: req.params.id },\r\n      status: 'success'\r\n    });\r\n\r\n    return sendSuccess(res, { deleted: true }, {\r\n      legacy: { status: 'ok' }\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Failed to delete site', { error });\r\n    return sendError(res, 500, {\r\n      code: 'INTERNAL_ERROR',\r\n      message: 'backend.internal_server_error'\r\n    });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\smart-fix.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":127,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":127,"endColumn":58},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .title on an `any` value.","line":133,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":133,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .enableAI on an `any` value.","line":137,"column":26,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":137,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":138,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":143,"endColumn":8},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .aiProvider on an `any` value.","line":138,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":138,"endColumn":38},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":144,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":144,"endColumn":45},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .maxAttempts on an `any` value.","line":144,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":144,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":145,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":145,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .executionTimeout on an `any` value.","line":145,"column":34,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":145,"endColumn":50},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .enableRealTimeMonitoring on an `any` value.","line":146,"column":42,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":146,"endColumn":66},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":156,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":156,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5520,5523],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5520,5523],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":158,"column":44,"nodeType":"Property","messageId":"anyAssignment","endLine":158,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":158,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":158,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":168,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":168,"endColumn":59},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":197,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":197,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6755,6758],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6755,6758],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":199,"column":44,"nodeType":"Property","messageId":"anyAssignment","endLine":199,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":199,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":199,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":209,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":209,"endColumn":58},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .title on an `any` value.","line":215,"column":48,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":215,"endColumn":53},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":225,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":225,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7527,7530],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7527,7530],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":227,"column":44,"nodeType":"Property","messageId":"anyAssignment","endLine":227,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":227,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":227,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":252,"column":17,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":252,"endColumn":41},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":253,"column":17,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":253,"endColumn":26},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .get on an `any` value.","line":253,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":253,"endColumn":26},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":259,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":259,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8694,8697],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8694,8697],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":261,"column":9,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":261,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":261,"column":21,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":261,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":270,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":270,"endColumn":14},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":273,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":273,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8923,8926],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8923,8926],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":275,"column":44,"nodeType":"Property","messageId":"anyAssignment","endLine":275,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":275,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":275,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":286,"column":11,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":286,"endColumn":42},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .logs on an `any` value.","line":309,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":309,"endColumn":23},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .logs on an `any` value.","line":309,"column":49,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":309,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":311,"column":9,"nodeType":"AssignmentExpression","messageId":"anyAssignment","endLine":311,"endColumn":50},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .logs on an `any` value.","line":311,"column":17,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":311,"endColumn":21},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of an `any` typed value.","line":311,"column":24,"nodeType":"MemberExpression","messageId":"unsafeCall","endLine":311,"endColumn":42},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .logs on an `any` value.","line":311,"column":32,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":311,"endColumn":36},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .configFiles on an `any` value.","line":314,"column":19,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":314,"endColumn":30},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .configFiles on an `any` value.","line":316,"column":59,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":316,"endColumn":70},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .configFiles on an `any` value.","line":318,"column":21,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":318,"endColumn":32},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":327,"column":7,"nodeType":"Property","messageId":"anyAssignment","endLine":327,"endColumn":57},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":327,"column":54,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":327,"endColumn":57,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10710,10713],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10710,10713],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":341,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":341,"endColumn":46},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .systemInfo on an `any` value.","line":341,"column":30,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":341,"endColumn":40},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":342,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":342,"endColumn":34},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .logs on an `any` value.","line":342,"column":24,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":342,"endColumn":28},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":343,"column":9,"nodeType":"Property","messageId":"anyAssignment","endLine":343,"endColumn":48},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .configFiles on an `any` value.","line":343,"column":31,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":343,"endColumn":42},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":351,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":351,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11368,11371],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11368,11371],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":353,"column":44,"nodeType":"Property","messageId":"anyAssignment","endLine":353,"endColumn":64},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .message on an `any` value.","line":353,"column":57,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":353,"endColumn":64}],"suppressedMessages":[],"errorCount":53,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Router, Request, Response } from 'express';\r\nimport { authenticate, requireRole, AuthenticatedRequest } from '../../middleware/auth.middleware';\r\nimport { SmartFixer } from '../../scanner/smart-fixer';\r\nimport { OptimizationEngine } from '../../scanner/optimization-engine';\r\nimport { InputValidator } from '../../security/input-validator';\r\nimport logger from '../../utils/logger';\r\n\r\nconst router = Router();\r\nconst optimizationEngine = new OptimizationEngine();\r\nconst inputValidator = new InputValidator();\r\n\r\n// SECURITY FIX CVE-2026-004/018: Apply authentication to all routes\r\nrouter.use(authenticate);\r\nrouter.use(requireRole('admin'));\r\n\r\n/**\r\n * AI Prompt Injection Protection\r\n * SECURITY FIX: Validate and sanitize AI prompts to prevent prompt injection attacks\r\n */\r\nclass AIPromptValidator {\r\n  /**\r\n   * Dangerous patterns that could indicate prompt injection attempts\r\n   */\r\n  private static readonly DANGEROUS_PATTERNS = [\r\n    // Ignore previous instructions\r\n    /ignore\\s+(all\\s+)?previous\\s+instructions?/i,\r\n    /disregard\\s+(all\\s+)?previous\\s+instructions?/i,\r\n    /forget\\s+(all\\s+)?previous\\s+instructions?/i,\r\n\r\n    // Override attempts\r\n    /override\\s+(your\\s+)?(programming|instructions|system|rules)/i,\r\n    /bypass\\s+(your\\s+)?(security|rules|restrictions)/i,\r\n    /break\\s+(your\\s+)?(programming|rules|guidelines)/i,\r\n\r\n    // System prompt extraction\r\n    /(show|print|output|display|reveal|tell\\s+me)\\s+(your\\s+)?(system\\s+)?(prompt|instructions|programming|rules)/i,\r\n    /what\\s+(are\\s+)?(your\\s+)?(instructions|rules|constraints|guidelines)/i,\r\n\r\n    // SQL/Code injection\r\n    /execute\\s+(the\\s+)?following\\s*(sql|code|command|script)/i,\r\n    /run\\s*(this|the)\\s*(sql|code|command)/i,\r\n    /drop\\s+table/i,\r\n    /exec\\s*(\\(|\\s)/i,\r\n\r\n    // Data exfiltration\r\n    /(print|output|display|show)\\s+(all\\s+)?(users?|passwords?|credentials?|keys?|tokens?|secrets?)/i,\r\n    /(send|transmit|exfiltrate)\\s+(all\\s+)?(data|logs|credentials)/i,\r\n\r\n    // Configuration/Environment access\r\n    /(access|read|show)\\s+(your\\s+)?(environment|env|config|settings|\\.env)/i,\r\n    /get\\s+(the\\s+)?(jwt_secret|api_key|secret_key|password)/i,\r\n  ];\r\n\r\n  /**\r\n   * Validate an AI prompt for injection attempts\r\n   * @param prompt The prompt to validate\r\n   * @returns Object with valid flag and error message if invalid\r\n   */\r\n  static validatePrompt(prompt: string): { valid: boolean; error?: string; sanitized?: string } {\r\n    if (!prompt || typeof prompt !== 'string') {\r\n      return { valid: false, error: 'backend.prompt_must_be_a_non_empty_string' };\r\n    }\r\n\r\n    // Check length limits\r\n    if (prompt.length > 10000) {\r\n      return { valid: false, error: 'backend.prompt_is_too_long_maximum_10000_characters_allowed' };\r\n    }\r\n\r\n    // Check for dangerous patterns\r\n    for (const pattern of this.DANGEROUS_PATTERNS) {\r\n      if (pattern.test(prompt)) {\r\n        logger.warn('Blocked AI prompt with dangerous pattern', {\r\n          pattern: pattern.source,\r\n          promptLength: prompt.length\r\n        });\r\n\r\n        return {\r\n          valid: false,\r\n          error: 'backend.prompt_contains_potentially_malicious_content_request_rejected_for_security_reasons'\r\n        };\r\n      }\r\n    }\r\n\r\n    // Additional checks for structured output attempts\r\n    const structuredOutputAttempts = [\r\n      /\\bjson\\b.*\\{.*\\}/i,\r\n      /\\bxml\\b.*<.*>/i,\r\n      /\\bformat\\b.*\\{(json|xml|yaml)\\}/i,\r\n    ];\r\n\r\n    for (const pattern of structuredOutputAttempts) {\r\n      if (pattern.test(prompt)) {\r\n        logger.warn('Prompt contains structured output request', {\r\n          pattern: pattern.source\r\n        });\r\n        // This is allowed but should be monitored\r\n        break;\r\n      }\r\n    }\r\n\r\n    return { valid: true, sanitized: prompt.trim() };\r\n  }\r\n\r\n  /**\r\n   * Sanitize user input for AI prompts\r\n   * @param prompt The prompt to sanitize\r\n   * @returns Sanitized prompt\r\n   */\r\n  static sanitizePrompt(prompt: string): string {\r\n    // Remove potential control characters\r\n    let sanitized = prompt.replace(/[\\x00-\\x1F\\x7F]/g, '');\r\n\r\n    // Limit repeated characters (prevent DoS)\r\n    sanitized = sanitized.replace(/(.{10,}?)\\1{10,}/g, '$1');\r\n\r\n    return sanitized;\r\n  }\r\n}\r\n\r\n/**\r\n * POST /api/scanner/smart-fix\r\n * Fix a problem using AI\r\n * SECURITY FIX CVE-2026-004: Added authentication and admin role requirement\r\n */\r\nrouter.post('/smart-fix', async (req: AuthenticatedRequest, res: Response) => {\r\n  try {\r\n    const { recommendation, context, options } = req.body;\r\n\r\n    if (!recommendation) {\r\n      return res.status(400).json({ success: false, error: 'backend.recommendation_is_required' });\r\n    }\r\n\r\n    logger.info(`Starting smart fix for: ${recommendation.title}`);\r\n\r\n    // Create smart fixer with options\r\n    const smartFixer = new SmartFixer({\r\n      enableAI: options?.enableAI !== false,\r\n      aiProvider: options?.aiProvider || {\r\n        name: process.env.AI_PROVIDER || 'ollama',\r\n        apiKey: process.env.OPENAI_API_KEY || process.env.ANTHROPIC_API_KEY,\r\n        baseURL: process.env.AI_BASE_URL,\r\n        model: process.env.AI_MODEL || 'llama2'\r\n      },\r\n      maxAttempts: options?.maxAttempts || 3,\r\n      executionTimeout: options?.executionTimeout || 60000,\r\n      enableRealTimeMonitoring: options?.enableRealTimeMonitoring !== false\r\n    });\r\n\r\n    // Run smart fix\r\n    const result = await smartFixer.fixProblem(recommendation, context);\r\n\r\n    res.json({\r\n      success: true,\r\n      data: result\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Smart fix failed', { error });\r\n    res.status(500).json({ success: false, error: error.message });\r\n  }\r\n});\r\n\r\n/**\r\n * POST /api/scanner/batch-fix\r\n * Fix multiple problems in batch\r\n */\r\nrouter.post('/batch-fix', async (req: Request, res: Response) => {\r\n  try {\r\n    const { recommendations, context, options } = req.body;\r\n\r\n    if (!recommendations || !Array.isArray(recommendations)) {\r\n      return res.status(400).json({ success: false, error: 'backend.recommendations_array_is_required' });\r\n    }\r\n\r\n    logger.info(`Batch fixing ${recommendations.length} problems`);\r\n\r\n    const smartFixer = new SmartFixer(options);\r\n\r\n    const results = await smartFixer.batchFix(recommendations, context);\r\n\r\n    const summary = {\r\n      total: results.length,\r\n      successful: results.filter(r => r.success).length,\r\n      failed: results.filter(r => !r.success).length,\r\n      totalAttempts: results.reduce((sum, r) => sum + r.attempts.length, 0),\r\n      totalTime: results.reduce((sum, r) => sum + r.totalTime, 0)\r\n    };\r\n\r\n    logger.info('Batch fix complete', { summary });\r\n\r\n    res.json({\r\n      success: true,\r\n      data: {\r\n        results,\r\n        summary\r\n      }\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Batch fix failed', { error });\r\n    res.status(500).json({ success: false, error: error.message });\r\n  }\r\n});\r\n\r\n/**\r\n * POST /api/scanner/dry-fix\r\n * Simulate fixing without executing\r\n */\r\nrouter.post('/dry-fix', async (req: Request, res: Response) => {\r\n  try {\r\n    const { recommendation, context, options } = req.body;\r\n\r\n    if (!recommendation) {\r\n      return res.status(400).json({ success: false, error: 'backend.recommendation_is_required' });\r\n    }\r\n\r\n    logger.info(`Dry run for: ${recommendation.title}`);\r\n\r\n    const smartFixer = new SmartFixer(options);\r\n\r\n    const dryRunResult = await smartFixer.dryFix(recommendation, context);\r\n\r\n    res.json({\r\n      success: true,\r\n      data: dryRunResult\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('Dry fix failed', { error });\r\n    res.status(500).json({ success: false, error: error.message });\r\n  }\r\n});\r\n\r\n/**\r\n * GET /api/scanner/ai-status\r\n * Check AI provider status\r\n */\r\nrouter.get('/ai-status', async (req: Request, res: Response) => {\r\n  try {\r\n    const provider = {\r\n      name: process.env.AI_PROVIDER || 'ollama',\r\n      model: process.env.AI_MODEL || 'llama2',\r\n      baseURL: process.env.AI_BASE_URL || 'http://localhost:11434',\r\n      configured: !!(process.env.OPENAI_API_KEY || process.env.ANTHROPIC_API_KEY || process.env.AI_BASE_URL)\r\n    };\r\n\r\n    // Test connection if configured\r\n    let status = 'not_configured';\r\n    let error = null;\r\n\r\n    if (provider.configured) {\r\n      try {\r\n        if (provider.name === 'ollama') {\r\n          // Test Ollama connection\r\n          const axios = require('axios');\r\n          await axios.get(`${provider.baseURL}/api/tags`, { timeout: 5000 });\r\n          status = 'available';\r\n        } else if (provider.name === 'openai' || provider.name === 'anthropic') {\r\n          // Just check if API key is present\r\n          status = 'available';\r\n        }\r\n      } catch (err: any) {\r\n        status = 'unavailable';\r\n        error = err.message;\r\n      }\r\n    }\r\n\r\n    res.json({\r\n      success: true,\r\n      data: {\r\n        provider,\r\n        status,\r\n        error\r\n      }\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('AI status check failed', { error });\r\n    res.status(500).json({ success: false, error: error.message });\r\n  }\r\n});\r\n\r\n/**\r\n * POST /api/scanner/ai-analyze\r\n * Analyze a problem using AI\r\n * SECURITY FIX: Added prompt injection validation\r\n */\r\nrouter.post('/ai-analyze', async (req: Request, res: Response) => {\r\n  try {\r\n    const { problem, context } = req.body;\r\n\r\n    if (!problem) {\r\n      return res.status(400).json({ success: false, error: 'backend.problem_is_required' });\r\n    }\r\n\r\n    // SECURITY: Validate problem description for prompt injection\r\n    const validation = AIPromptValidator.validatePrompt(problem);\r\n    if (!validation.valid) {\r\n      logger.warn('Blocked AI analysis with potentially malicious prompt', {\r\n        error: validation.error\r\n      });\r\n      return res.status(400).json({\r\n        success: false,\r\n        error: validation.error || 'Invalid prompt content'\r\n      });\r\n    }\r\n\r\n    // Use sanitized prompt\r\n    const sanitizedProblem = AIPromptValidator.sanitizePrompt(problem);\r\n\r\n    // Also validate context if provided\r\n    if (context) {\r\n      if (context.logs && Array.isArray(context.logs)) {\r\n        // Limit logs to prevent DoS\r\n        context.logs = context.logs.slice(0, 100);\r\n      }\r\n\r\n      if (context.configFiles) {\r\n        // Limit config file content\r\n        for (const [key, value] of Object.entries(context.configFiles)) {\r\n          if (typeof value === 'string' && value.length > 50000) {\r\n            context.configFiles[key as string] = value.substring(0, 50000) + '... (truncated)';\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    const { AIEngine } = await import('../../scanner/ai-engine');\r\n\r\n    const aiEngine = new AIEngine({\r\n      name: (process.env.AI_PROVIDER || 'ollama') as any,\r\n      apiKey: process.env.OPENAI_API_KEY || process.env.ANTHROPIC_API_KEY,\r\n      baseURL: process.env.AI_BASE_URL,\r\n      model: process.env.AI_MODEL || 'llama2'\r\n    });\r\n\r\n    const analysis = await aiEngine.analyzeProblem({\r\n      problem: {\r\n        title: 'User Reported Issue',\r\n        description: sanitizedProblem,\r\n        category: 'general',\r\n        priority: 'medium'\r\n      },\r\n      context: {\r\n        systemInfo: context?.systemInfo || {},\r\n        logs: context?.logs || [],\r\n        configFiles: context?.configFiles || {}\r\n      }\r\n    });\r\n\r\n    res.json({\r\n      success: true,\r\n      data: analysis\r\n    });\r\n  } catch (error: any) {\r\n    logger.error('AI analysis failed', { error });\r\n    res.status(500).json({ success: false, error: error.message });\r\n  }\r\n});\r\n\r\nexport default router;\r\n","usedDeprecatedRules":[]},{"filePath":"X:\\github-repos\\Networksafe\\backend\\src\\api\\routes\\stats.routes.ts","messages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":66,"column":15,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":66,"endColumn":53},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":66,"column":50,"nodeT