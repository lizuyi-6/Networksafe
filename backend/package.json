{
  "name": "fluxguard-backend",
  "version": "1.0.0",
  "description": "FluxGuard Control Platform - Agent-based Security System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "agent": "ts-node-dev --respawn --transpile-only src/agent-cli.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "seed": "ts-node src/database/seeds/demo_data.ts",
    "seed:clear": "ts-node src/database/seeds/demo_data.ts --clear"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "greenlock-express": "^4.0.3",
    "le-challenge-fs": "^2.0.9",
    "le-store-certbot": "^2.0.9",
    "sql.js": "^1.10.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "ws": "^8.16.0",
    "axios": "^1.6.5",
    "socket.io": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/ws": "^8.5.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "ts-jest": "^29.1.2",
    "jest": "^29.7.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "socket.io-client": "^4.7.4"
  }
}