{
  "name": "fluxguard-backend",
  "version": "1.0.0",
  "description": "FluxGuard Control Platform - Agent-based Security System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "agent": "ts-node-dev --respawn --transpile-only src/agent-cli.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest",
    "test:coverage": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --coverage",
    "test:agents": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --testPathPattern=ai-agents",
    "demo:agents": "cross-env NODE_ENV=development ts-node src/ai-agents/demo/demo.ts",
    "seed": "ts-node src/database/seeds/demo_data.ts",
    "seed:clear": "ts-node src/database/seeds/demo_data.ts --clear",
    "cleanup:demo:dry-run": "ts-node scripts/cleanup-demo-data.ts",
    "cleanup:demo": "ts-node scripts/cleanup-demo-data.ts --execute"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "greenlock-express": "^4.0.3",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "le-challenge-fs": "^2.0.9",
    "le-store-certbot": "^2.0.9",
    "socket.io": "^4.7.4",
    "better-sqlite3": "^11.0.0",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
