{
  "name": "AetherGuard-backend",
  "version": "1.0.0",
  "description": "AetherGuard Control Platform - Agent-based Security System",
  "main": "dist/index.js",
  "bin": {
    "aetherguard": "dist/cli/aetherguard.js"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "agent": "ts-node-dev --respawn --transpile-only src/agent-cli.ts",
    "cli": "ts-node-dev --transpile-only src/cli/aetherguard.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest",
    "test:shard1": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --maxWorkers=50% --shard=1/4",
    "test:shard2": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --maxWorkers=50% --shard=2/4",
    "test:shard3": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --maxWorkers=50% --shard=3/4",
    "test:shard4": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --maxWorkers=50% --shard=4/4",
    "test:all": "npm run test:shard1 && npm run test:shard2 && npm run test:shard3 && npm run test:shard4",
    "test:coverage": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --coverage",
    "test:agents": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --testPathPattern=ai-agents",
    "test:module": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true jest --config=jest.config.modular.js",
    "test:core": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=core jest --config=jest.config.modular.js",
    "test:security": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=security jest --config=jest.config.modular.js",
    "test:scanner": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=scanner jest --config=jest.config.modular.js",
    "test:websocket": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=websocket jest --config=jest.config.modular.js",
    "test:services": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=services jest --config=jest.config.modular.js",
    "test:agent": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=agent jest --config=jest.config.modular.js",
    "test:utils": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=utils jest --config=jest.config.modular.js",
    "test:routes": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=routes jest --config=jest.config.modular.js",
    "test:controllers": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true TEST_MODULE=controllers jest --config=jest.config.modular.js",
    "demo:agents": "cross-env NODE_ENV=development ts-node src/ai-agents/demo/demo.ts",
    "eval:owasp": "cross-env NODE_ENV=test JWT_SECRET=test-jwt-secret-minimum-32-characters-long AUDIT_LOG_SECRET=test-audit-log-secret-minimum-32-characters DISABLE_REDIS=true ts-node scripts/run-owasp-eval.ts",
    "seed": "ts-node src/database/seeds/demo_data.ts",
    "seed:clear": "ts-node src/database/seeds/demo_data.ts --clear",
    "cleanup:demo:dry-run": "ts-node scripts/cleanup-demo-data.ts",
    "cleanup:demo": "ts-node scripts/cleanup-demo-data.ts --execute"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "greenlock-express": "^4.0.3",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "le-challenge-fs": "^2.0.9",
    "le-store-certbot": "^2.0.9",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
