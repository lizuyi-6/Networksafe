# AetherGuard Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Server will not start without these
# ============================================

# JWT Secret for token signing (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis password
REDIS_PASSWORD=your-redis-password-here

# ============================================
# REQUIRED FOR DATABASE SEEDING
# ============================================

# Admin credentials (password must be 12+ characters)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecureAdminPass123!

# Demo user (optional)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=SecureDemoPass123!

# ============================================
# API KEYS
# ============================================

# Valid API keys (comma-separated)
VALID_API_KEYS=AetherGuard_test_key_001,AetherGuard_test_key_002

# Device API keys (comma-separated) — current primary devices are Gateway Appliances; ESP32 device keys retained as legacy
DEVICE_API_KEYS=device_key_001,device_key_002

# ============================================
# AI INTEGRATION (Optional)
# ============================================

# Zhipu AI API Key
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4

# Built-in cloud AI route (Tencent LKEAP Anthropic-compatible)
PLATFORM_API_PROTOCOL=anthropic-compatible
PLATFORM_API_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/anthropic
PLATFORM_API_MESSAGES_PATH=/v1/messages
PLATFORM_API_KEY=your-platform-api-key

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3005

# Data directory (use distinct paths for production and demo)
DATA_DIR=./data

# Environment: development | production | test
NODE_ENV=development

# Application mode: production | demo
APP_MODE=production

# Demo-only switches
DEMO_AUTO_SEED=false
ENABLE_ATTACK_SIM=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis URL (optional, defaults to localhost)
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# API rate limit engine: legacy | redis-lua
API_RATE_LIMIT_ENGINE=legacy
