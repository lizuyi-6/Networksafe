# AetherGuard Backend Environment Configuration
# Copy this file to .env and fill in your values
# Fastest path: run `node scripts/setup.mjs` from the repo root — it generates
# this file with random secrets for local development.

# ============================================
# REQUIRED - Server will not start without these
# (enforced in ALL modes, including development —
#  see src/bootstrap/runtime-env.ts and src/middleware/auth.middleware.ts)
# ============================================

# JWT Secret for token signing (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Audit log signing secret (min 32 characters)
AUDIT_LOG_SECRET=your-audit-log-signing-secret-change-me-too

# Local development may run without Postgres. Production startup requires
# both values to be exactly true and also requires SHADOW_DATABASE_URL.
AUDIT_LOG_FAIL_CLOSED=false
AUDIT_SHADOW_REQUIRED=false

# ============================================
# REDIS (local development default: disabled)
# ============================================

# Local dev default: skip Redis and use the in-memory rate-limit fallback.
# ⚠ MUST NOT be true in production — production startup hard-rejects DISABLE_REDIS=true.
DISABLE_REDIS=true
# Process-local login sessions are permitted only in an explicitly configured
# non-production lab. They are lost when the backend restarts.
ALLOW_LAB_IN_MEMORY_AUTH_SESSIONS=true

# Redis password + URL (only used when DISABLE_REDIS is not true).
# NOTE: dotenv does NOT expand ${VARS} — write the full literal URL.
REDIS_PASSWORD=your-redis-password-here
# REDIS_URL=redis://:your-redis-password-here@localhost:6379

# ============================================
# REQUIRED FOR DATABASE SEEDING
# ============================================

# Admin credentials (password must be 12+ characters)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecureAdminPass123!

# Demo user (optional)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=SecureDemoPass123!

# ============================================
# API KEYS
# ============================================

# Valid API keys (comma-separated)
VALID_API_KEYS=AetherGuard_test_key_001,AetherGuard_test_key_002

# Device API keys (comma-separated) — current primary devices are Gateway Appliances; ESP32 device keys retained as legacy
DEVICE_API_KEYS=device_key_001,device_key_002

# ============================================
# AI INTEGRATION (Optional)
# ============================================

# Zhipu AI API Key
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4

# Built-in cloud AI route (Tencent LKEAP Anthropic-compatible)
PLATFORM_API_PROTOCOL=anthropic-compatible
PLATFORM_API_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/anthropic
PLATFORM_API_MESSAGES_PATH=/v1/messages
PLATFORM_API_KEY=your-platform-api-key

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3005

# Data directory (use distinct paths for production and demo)
DATA_DIR=./data

# Environment: development | production | test
NODE_ENV=development

# Application mode: production | demo
APP_MODE=production

# Local development profile. Production must use prod-enterprise.
ENTERPRISE_RUNTIME_MODE=lab
ALLOW_PUBLIC_REGISTRATION=true

# Demo-only switches
DEMO_AUTO_SEED=false
ENABLE_ATTACK_SIM=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional enterprise OIDC logout/revocation endpoints (https required outside
# explicitly opted-in non-production testing).
OIDC_END_SESSION_ENDPOINT=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_TOKEN_REVOCATION_ENDPOINT=

# API rate limit engine: legacy | redis-lua
API_RATE_LIMIT_ENGINE=legacy
