# FluxGuard Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Server will not start without these
# ============================================

# JWT Secret for token signing (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis password
REDIS_PASSWORD=your-redis-password-here

# ============================================
# REQUIRED FOR DATABASE SEEDING
# ============================================

# Admin credentials (password must be 12+ characters)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=SecureAdminPass123!

# Demo user (optional)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=SecureDemoPass123!

# ============================================
# API KEYS
# ============================================

# Valid API keys (comma-separated)
VALID_API_KEYS=fluxguard_test_key_001,fluxguard_test_key_002

# Device API keys for ESP32 (comma-separated)
DEVICE_API_KEYS=device_key_001,device_key_002

# ============================================
# AI INTEGRATION (Optional)
# ============================================

# Zhipu AI API Key
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3005

# Environment: development | production | test
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis URL (optional, defaults to localhost)
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
