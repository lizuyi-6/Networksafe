VITE_API_TARGET=http://127.0.0.1:8080
VITE_USE_MOCK=false

# SECURITY (audit 2026-08, FE-001): demo mode is a build-time opt-in. Leave
# unset (or `false`) for production-ish builds; set `true` only for demo
# builds where simulated success responses are acceptable.
# VITE_ENABLE_DEMO_MODE=false

# SECURITY (audit 2026-08, FE-002): comma-separated origins the browser may
# be redirected to for OIDC (authorizationUrl / endSessionUrl), e.g.
# https://accounts.example.com. Unset = same-origin relative redirects only.
# VITE_TRUSTED_EXTERNAL_ORIGINS=
