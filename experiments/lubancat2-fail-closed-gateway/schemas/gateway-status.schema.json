{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherGuard Cat2 gateway status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "faultReason",
    "serverInterface",
    "uplinkInterface",
    "bridgeInterface",
    "managementInterface",
    "serverInterfaceExists",
    "uplinkInterfaceExists",
    "serverGateKernel",
    "releaseExpiresAt",
    "activeLeaseId",
    "leaseStatePhase",
    "leaseTimerActive",
    "activeLeaseTimerCount",
    "bridgeUp",
    "topologyReady",
    "managementAvailable",
    "policyDigest",
    "gatePrimitive",
    "timestamp"
  ],
  "properties": {
    "state": {"enum": ["isolated", "released", "fault"]},
    "faultReason": {"type": ["string", "null"]},
    "serverInterface": {"type": "string", "minLength": 1},
    "uplinkInterface": {"type": "string", "minLength": 1},
    "bridgeInterface": {"type": "string", "minLength": 1},
    "managementInterface": {"type": "string", "minLength": 1},
    "serverInterfaceExists": {"type": "boolean"},
    "uplinkInterfaceExists": {"type": "boolean"},
    "serverGateKernel": {"type": "string", "minLength": 1},
    "releaseExpiresAt": {"type": ["string", "null"], "format": "date-time"},
    "activeLeaseId": {"type": ["string", "null"], "pattern": "^[a-f0-9]{32}$"},
    "leaseStatePhase": {"type": ["string", "null"], "enum": ["prepared", "active", null]},
    "leaseTimerActive": {"type": "boolean"},
    "activeLeaseTimerCount": {"type": "integer", "minimum": 0},
    "bridgeUp": {"type": "boolean"},
    "topologyReady": {"type": "boolean"},
    "managementAvailable": {"type": "boolean"},
    "policyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gatePrimitive": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
