{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherGuard Cat2 experiment test result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultKind",
    "schemaVersion",
    "runId",
    "testId",
    "category",
    "trafficProfile",
    "status",
    "transport",
    "gatewayCommit",
    "cat2Hostname",
    "protectedEndpoint",
    "serverInterface",
    "uplinkInterface",
    "managementInterface",
    "captureInterface",
    "stateBefore",
    "stateAfter",
    "startedAt",
    "finishedAt",
    "command",
    "exitCode",
    "expected",
    "observed",
    "passed",
    "unauthorizedConnections",
    "escapedPackets",
    "escapedBytes",
    "uplinkObservedPackets",
    "probeCommandExecuted",
    "probeReachedUpstream",
    "packetObservedOnUplink",
    "releaseLatencyMs",
    "isolationLatencyMs",
    "managementAvailable",
    "cleanupAttempted",
    "cleanupSucceeded",
    "cleanupDetails",
    "reasonCode",
    "evidenceFiles",
    "trafficObservations",
    "notes"
  ],
  "properties": {
    "resultKind": {"const": "test-result"},
    "schemaVersion": {"const": 2},
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "testId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "category": {
      "enum": ["connectivity", "isolation", "authorization", "fault", "topology", "performance", "reboot"]
    },
    "trafficProfile": {
      "enum": ["NONE", "RELEASE_POSITIVE", "ISOLATED_NEGATIVE_WITH_CONTROL", "RELEASE_THEN_ISOLATED"]
    },
    "status": {"enum": ["PASSED", "FAILED", "PARTIAL", "NOT_RUN", "BLOCKED"]},
    "transport": {"type": "string", "minLength": 1},
    "gatewayCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "cat2Hostname": {"type": "string", "minLength": 1},
    "protectedEndpoint": {"type": "string", "minLength": 1},
    "serverInterface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "uplinkInterface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "managementInterface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "captureInterface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "stateBefore": {"enum": ["isolated", "released", "fault", "unknown"]},
    "stateAfter": {"enum": ["isolated", "released", "fault", "unknown"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
    "expected": {"type": "string", "minLength": 1},
    "observed": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "unauthorizedConnections": {"type": "integer", "minimum": 0},
    "escapedPackets": {"type": "integer", "minimum": 0},
    "escapedBytes": {"type": "integer", "minimum": 0},
    "uplinkObservedPackets": {"type": "integer", "minimum": 0},
    "probeCommandExecuted": {"type": "boolean"},
    "probeReachedUpstream": {"type": ["boolean", "null"]},
    "packetObservedOnUplink": {"type": ["boolean", "null"]},
    "releaseLatencyMs": {"type": ["number", "null"], "minimum": 0},
    "isolationLatencyMs": {"type": ["number", "null"], "minimum": 0},
    "managementAvailable": {"type": "boolean"},
    "cleanupAttempted": {"type": "boolean"},
    "cleanupSucceeded": {"type": "boolean"},
    "cleanupDetails": {"type": "string", "minLength": 1},
    "reasonCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "evidenceFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "trafficObservations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
