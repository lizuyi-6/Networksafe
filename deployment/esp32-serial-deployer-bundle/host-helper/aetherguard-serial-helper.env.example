SERIAL_HELPER_DEVICE=/dev/ttyUSB0
SERIAL_HELPER_BAUD=115200
SERIAL_HELPER_REOPEN_DELAY=2

# The helper only executes these fixed allow-list commands.
# Update the install command for your real control-plane endpoint.
AETHERGUARD_INSTALL_CMD="curl -fsSL http://control-plane.example:3005/install.sh | bash"

# Optional overrides. If omitted, the helper uses its built-in defaults.
# AETHERGUARD_BACKUP_CMD="ts=$(date +%Y%m%d%H%M%S); backup_dir=/tmp/aetherguard_backup_$ts; mkdir -p \"$backup_dir\" && tar -czf \"$backup_dir/etc_aetherguard.tgz\" /etc/AetherGuard /etc/hosts 2>/dev/null"
# AETHERGUARD_REMOVE_CMD="rm -rf /opt/AetherGuard"
