{
  "gatewayId": "gw-CHANGEME",
  "backendUrl": "https://control-plane.example.com",
  "tenantId": "tenant-CHANGEME",
  "sePublicKeyPath": "/etc/aetherguard/se-public-key.pem",
  "breakerTarget": "server-lan-bridge",
  "serialPort": "/dev/ttyACM0",
  "serialBaud": 115200,
  "heartbeatStaleMs": 45000,
  "releaseTtlMs": 30000,
  "statusReportIntervalMs": 10000,
  "serialChannelKeyHex": "CHANGE_ME_64_HEX_CHARS_M1_M2_CHANNEL_MAC_KEY"
}
