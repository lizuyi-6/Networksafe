#!/usr/sbin/nft -f
#
# AetherGuard Gateway Appliance: Released Ruleset (AUD-04-1)
#
# Applied ONLY after the full hardware grant chain (M2 signature, counter,
# policyDigest, interlock feedback). SERVER<->LANWAN transparent L2 bridge
# forwarding is permitted for the release window; the appliance auto-reverts
# to isolated_ruleset.nft on expiry or any fail-closed trigger.
#
# Same AUD-04-1 structure as the isolated file: own tables, no flush,
# atomic replace prologue, bridge-family data plane, MGMT strictly separate.
#
define SERVER = eth0
define LANWAN = eth1
define MGMT = eth2

table bridge aetherguard
delete table bridge aetherguard

table bridge aetherguard {
    chain forward {
        type filter hook forward priority filter; policy drop;

        # RELEASED: only the explicit SERVER<->LANWAN port pair may forward.
        # Accepting by port pair (not blanket policy accept) covers ARP,
        # IPv4, IPv6 ND, non-IP EtherTypes, broadcast and multicast between
        # exactly the two data ports — a transparent L2 bridge.
        iifname "$SERVER" oifname "$LANWAN" counter accept
        iifname "$LANWAN" oifname "$SERVER" counter accept

        # Any other port pairing (e.g. a rogue fourth port, mgmt leaking
        # into the bridge) is dropped and counted.
        counter drop
    }
}

table inet aetherguard_mgmt
delete table inet aetherguard_mgmt

table inet aetherguard_mgmt {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        iifname "$MGMT" accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # Released authorizes the L2 bridge only — routed mgmt<->data
        # forwarding stays forbidden in every state.
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
