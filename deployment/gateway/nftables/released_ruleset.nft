#!/usr/sbin/nft -f
#
# AetherGuard Gateway Appliance: Released Ruleset
#
# Applied when bridge state is 'released' (temporary release window active).
# SERVER <-> LAN/WAN forwarding is ALLOWED for the duration of the release window.
# MGMT port remains reachable for appliance management.
#
# This ruleset is applied by the Gateway Daemon ONLY when:
# - Hardware grant signature verified (SE public key)
# - Monotonic counter advanced (no rollback)
# - Grant not expired
# - policyDigest matches local signed policy
# - Controller confirmed interlock released
# - Feedback auxiliary contact confirms relay closed
#
# Auto-reasserts to isolated_ruleset.nft when:
# - Release window expires (default 30s, configurable)
# - Any fail-closed trigger (PRD §4.4)
#

flush ruleset

# Define interfaces (adjust to actual interface names on deployment)
define SERVER = eth0
define LANWAN = eth1
define MGMT = eth2

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    # Allow loopback
    iif lo accept

    # Allow established/related
    ct state established,related accept

    # Allow MGMT port (appliance management)
    iif $MGMT accept

    # Allow ICMP
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    # Log and drop everything else
    log prefix "INPUT-DROP: "
    drop
  }

  chain forward {
    type filter hook forward priority filter; policy accept;

    # RELEASED: Allow SERVER <-> LAN/WAN transparent L2 bridge forwarding
    # This is the core release behavior.
    iif $SERVER oif $LANWAN accept
    iif $LANWAN oif $SERVER accept

    # Allow MGMT <-> any
    iif $MGMT accept
    oif $MGMT accept

    # Allow established/related
    ct state established,related accept

    # Log any dropped forward (should not happen in released state)
    log prefix "FORWARD-DROP: "
    drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}

# Optional: Add connection tracking limits or rate limiting here
# to prevent the protected server from abusing the release window.
# Example:
# table inet limiter {
#   chain forward {
#     type filter hook forward priority filter + 10;
#     iif $SERVER oif $LANWAN limit rate over 1000 mbytes/second drop
#   }
# }
