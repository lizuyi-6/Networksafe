#!/usr/sbin/nft -f
#
# AetherGuard Gateway Appliance: Isolated Ruleset (AUD-04-1)
#
# Data plane is a TRANSPARENT L2 BRIDGE (PRD §3/§4): frames between the
# SERVER and LAN/WAN bridge ports are filtered in the nft BRIDGE family at
# the bridge forward hook — not the L3 inet forward hook. Isolated is the
# fail-closed default: bridged frames are dropped.
#
# AUD-04-1 fixes vs the old file:
#   - NO `flush ruleset` (that nuked every other table on the appliance).
#     Atomic replace uses the canonical declare/delete/recreate prologue,
#     touching ONLY our own tables.
#   - Own tables (`bridge aetherguard`, `inet aetherguard_mgmt`) — other
#     software's tables are untouched.
#   - MGMT is NOT a bridge port. Appliance management lives in a separate
#     minimal inet table; MGMT→SERVER/LANWAN forwarding is explicitly
#     dropped, so a compromised mgmt path cannot reach protected segments.
#
# Interface names: adjust these defines to the deployment's port names
# (the preflight check verifies they exist).
define SERVER = eth0
define LANWAN = eth1
define MGMT = eth2

# --- atomic replace prologue (create-if-missing, then delete, then recreate)
table bridge aetherguard
delete table bridge aetherguard

table bridge aetherguard {
    chain forward {
        type filter hook forward priority filter; policy drop;

        # ISOLATED: the SERVER<->LANWAN bridge is shut. Every bridged frame
        # (ARP, IPv4, IPv6 ND, non-IP EtherTypes, broadcast, multicast)
        # between the two data ports is dropped — fail-closed.
        iifname "$SERVER" oifname "$LANWAN" counter drop
        iifname "$LANWAN" oifname "$SERVER" counter drop

        # Anything else bridged through us (should not exist) is dropped
        # and counted for the readback gate.
        counter drop
    }
}

# Appliance management plane — separate from the L2 bridge data plane.
table inet aetherguard_mgmt
delete table inet aetherguard_mgmt

table inet aetherguard_mgmt {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        iifname "$MGMT" accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        # The appliance must never route between mgmt and the protected
        # segments, nor between them and anything else.
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
