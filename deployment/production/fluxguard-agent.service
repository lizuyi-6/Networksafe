[Unit]
Description=AetherGuard Probe Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aetherguard/backend
EnvironmentFile=/etc/aetherguard/agent.env
ExecStart=/usr/bin/npm run agent -- --server=${AETHERGUARD_SERVER}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
