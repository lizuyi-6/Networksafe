[Unit]
Description=FluxGuard Probe Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fluxguard/backend
EnvironmentFile=/etc/fluxguard/agent.env
ExecStart=/usr/bin/npm run agent -- --server=${FLUXGUARD_SERVER}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
