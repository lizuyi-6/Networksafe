# Copy this file to /etc/aetherguard/agents/<instance>.env for each agent instance.
# Example instances on the same host:
# - /etc/aetherguard/agents/prod-node-01.env
# - /etc/aetherguard/agents/prod-node-01-a.env
# - /etc/aetherguard/agents/prod-node-01-b.env

# Center URL (HTTP/WS endpoint of control plane)
AETHERGUARD_SERVER=http://127.0.0.1:3005

# One-time onboarding code. The agent clears this after the first successful exchange.
AETHERGUARD_ONBOARDING_CODE=

# Optional identity hints used during onboarding exchange
AETHERGUARD_HOSTNAME=prod-node-01
AETHERGUARD_PLATFORM=linux
AETHERGUARD_MAC=

# Long-lived credentials (auto-filled into this env file after onboarding exchange)
AETHERGUARD_AGENT_ID=
AETHERGUARD_AGENT_API_KEY=
AETHERGUARD_AGENT_SECRET_KEY=

# Optional heartbeat interval (milliseconds)
AETHERGUARD_HEARTBEAT_INTERVAL_MS=30000

# Production runtime defaults
NODE_ENV=production
LOG_LEVEL=info
