# Center URL (HTTPS/WSS endpoint of control plane)
FLUXGUARD_SERVER=https://center.example.com

# One-time onboarding code. Use once and then remove.
FLUXGUARD_ONBOARDING_CODE=

# Optional identity hints used during onboarding exchange
FLUXGUARD_HOSTNAME=
FLUXGUARD_PLATFORM=linux
FLUXGUARD_MAC=

# Long-lived credentials (auto-filled after onboarding exchange)
FLUXGUARD_AGENT_ID=
FLUXGUARD_AGENT_API_KEY=
FLUXGUARD_AGENT_SECRET_KEY=

# Optional heartbeat interval (milliseconds)
FLUXGUARD_HEARTBEAT_INTERVAL_MS=30000
