DEVICE_COMPANION_CONTROL_PLANE_URL=http://127.0.0.1:3005
DEVICE_COMPANION_GATEWAY_PATH=/ws/device
DEVICE_COMPANION_SERIAL_DEVICE=/dev/ttyACM0
DEVICE_COMPANION_SERIAL_BAUD=115200
DEVICE_COMPANION_DEVICE_ID=host-edge-01
DEVICE_COMPANION_DEVICE_API_KEY=dev-device-key-2026
DEVICE_COMPANION_DEVICE_VERSION=v1
DEVICE_COMPANION_CHIP_MODEL=STM32H563ZI
DEVICE_COMPANION_FLASH_SIZE=8388608
DEVICE_COMPANION_PUBLIC_KEY_FILE=/etc/AetherGuard/device-confirmation-pub.pem

AETHERGUARD_BACKUP_CMD=ts=$(date +%Y%m%d%H%M%S); backup_dir=/tmp/aetherguard_backup_$ts; mkdir -p "$backup_dir" && tar -czf "$backup_dir/etc_aetherguard.tgz" /etc/AetherGuard /etc/hosts 2>/dev/null
AETHERGUARD_INSTALL_CMD=
AETHERGUARD_REMOVE_CMD=rm -rf /opt/AetherGuard
AETHERGUARD_RECOVERY_FLASH_CMD=
AETHERGUARD_FACTORY_RESET_CMD=
