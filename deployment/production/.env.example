# AetherGuardduction Environment Configuration
# Copy this file to .env and modify values for your deployment

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=AetherGuard_redis_secret_2024_change_me

# ===========================================
# JWT Configuration (Minimum 32 characters)
# ===========================================
JWT_SECRET=AetherGuard_jwt_secret_production_2024_minimum_32_chars_change_me
AUDIT_LOG_SECRET=AetherGuard_audit_secret_production_2024_32chars_change_me

# ===========================================
# Agent Configuration
# ===========================================
AGENT_ID=probe-agent-production-01
AGENT_HOSTNAME=AetherGuard-probe
AGENT_API_KEY=probe_agent_production_key_32_characters_change_me

# ===========================================
# Optional: AI Configuration
# ===========================================
# ZHIPU_API_KEY=your_zhipu_api_key_here
# OLLAMA_URL=http://ollama:11434

# ===========================================
# Optional: SSL Configuration
# ===========================================
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
