[Unit]
Description=AetherGuard Agent Instance %i
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# DP-015 (audit 2026-08): the wrapper only needs to run `docker` (talk to the
# docker socket) and read the instance env dir — not unrestricted root. The
# container itself keeps its own isolation; host-side we apply the same
# hardening family as the gateway unit. User stays root ONLY because docker
# group membership is deployment-specific; everything below still constrains
# the wrapper. Deployments with a docker-enabled service account should set
# User= that account instead.
User=root
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
EnvironmentFile=/etc/aetherguard/agents/%i.env
Environment=AETHERGUARD_AGENT_ENV_DIR=/etc/aetherguard/agents
Environment=AETHERGUARD_ENV_FILE=/etc/aetherguard/agents/%i.env
Environment=AETHERGUARD_AGENT_IMAGE=app-backend:latest
ExecStartPre=-/usr/bin/docker rm -f aetherguard-agent-%i
ExecStart=/opt/aetherguard/docker-stack/current/deployment/production/aetherguard-agent-container.sh %i
ExecStop=-/usr/bin/docker stop aetherguard-agent-%i
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (DP-015): the wrapper is a docker CLI shim — it needs the docker
# socket (AF_UNIX), DNS/HTTP to localhost for health probes, and read access
# to /etc/aetherguard + the docker CLI; nothing else. ProtectSystem=strict
# with explicit read paths still allows executing the pinned script.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aetherguard
ReadOnlyPaths=/etc/aetherguard
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
