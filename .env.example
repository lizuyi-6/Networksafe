# NewSecurity Environment Configuration

# ==============
# Server Config
# ==============
NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443

# ==============
# AI Provider
# ==============
# Options: openai, anthropic, ollama
AI_PROVIDER=ollama

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama Configuration (if using Ollama)
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama2

# Alternative models to try:
# AI_MODEL=llama2:13b
# AI_MODEL=mistral
# AI_MODEL=neural-chat
# AI_MODEL=codellama

# ==============
# Database
# ==============
# Data directory for SQLite
DATA_DIR=/app/data

# ==============
# Redis
# ==============
REDIS_URL=redis://redis:6379

# ==============
# SSL/TLS
# ==============
# Email for Let's Encrypt
SSL_EMAIL=admin@example.com

# Use staging environment for testing (set to "false" for production)
LETSENCRYPT_STAGING=true

# ==============
# Security
# ==============
# API key for admin API
ADMIN_API_KEY=your-secret-api-key-here

# ==============
# Smart Fixing
# ==============
# Maximum number of fix attempts
MAX_FIX_ATTEMPTS=3

# Enable real-time AI monitoring during fixes
ENABLE_AI_MONITORING=true

# Execution timeout for fix commands (milliseconds)
FIX_EXECUTION_TIMEOUT=60000

# ==============
# Logging
# ==============
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log to file (in addition to console)
LOG_TO_FILE=true

# ==============
# Monitoring
# ==============
# Enable performance monitoring
ENABLE_PERFORMANCE_TRACKING=true

# Slow query threshold (milliseconds)
SLOW_QUERY_THRESHOLD=1000

# Memory warning threshold (MB)
MEMORY_WARNING_THRESHOLD=500

# ==============
# Zhipu AI (智谱AI / BigModel)
# ==============
# Recommended for Chinese users
# Get API key from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here
# If using Zhipu AI, set provider to 'zhipu'
# AI_PROVIDER=zhipu
# AI_MODEL=glm-4
# Available models: glm-4, glm-4-flash, glm-4-air, glm-4-plus
