# ─────────────────────────────────────────────────────────────
# AetherGuard Environment Variables - copy to .env and fill in
#
# Fastest path: run  `node scripts/setup.mjs`  from the repo root —
# it copies this template to .env and fills every "change_me" value
# with a cryptographically random secret (bash alternative:
# `bash deployment/production/setup-env.sh`).
#
# All keys below marked "Required" are enforced at startup:
#   - docker-compose.yml uses `:?` guards (container refuses to start), and/or
#   - backend/src/bootstrap/runtime-env.ts rejects missing/placeholder values
#     in production (any value starting with "change_me" is a hard error).
# ─────────────────────────────────────────────────────────────

# Required: Redis password (min 16 chars)
REDIS_PASSWORD=change_me_strong_password

# Required: JWT signing secret (min 32 chars) - GENERATE NEW ONE!
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# Required: Audit log signing secret (min 32 chars) - GENERATE NEW ONE!
AUDIT_LOG_SECRET=change_me_audit_log_secret_at_least_32_chars

# Required: Encryption key for agent secrets (min 32 chars) - GENERATE NEW ONE!
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Run: openssl rand -hex 32
ENCRYPTION_KEY=change_me_encryption_key_at_least_32_chars

# Required: Encryption salt for agent secrets (min 16 chars) - GENERATE NEW ONE!
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Run: openssl rand -hex 16
ENCRYPTION_SALT=change_me_encryption_salt_16chars

# Required: Admin password (min 12 chars, strong password required!)
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Must NOT be a known weak value (e.g. "change_me", "admin123"). Use a strong unique password.
ADMIN_PASSWORD=change_me_to_strong_admin_password

# Required for production gateway/device command signing (min 24 chars)
DEVICE_COMMAND_SECRET=change_me_device_command_secret_at_least_24_chars

# Required in production (APP_ROLE=all or gateway): serial helper trust anchor
# (min 32 chars, MUST be distinct from DEVICE_COMMAND_SECRET — enforced at startup)
SERIAL_HELPER_SHARED_SECRET=change_me_serial_helper_secret_at_least_32_chars

# Required: Postgres password for the compose postgres service.
# ⚠ Keep POSTGRES_PASSWORD and the password inside SHADOW_DATABASE_URL identical —
#   the postgres container initializes with POSTGRES_PASSWORD, the backend connects
#   with SHADOW_DATABASE_URL. If they diverge the backend cannot authenticate.
POSTGRES_PASSWORD=change_me_postgres_password
SHADOW_DATABASE_URL=postgres://aetherguard:change_me_postgres_password@postgres:5432/aetherguard

# Database reality check (see CLAUDE.md 数据库节 / backend/src/config/database.ts):
# the primary write path is still SQLite (persisted in the backend_data volume);
# Postgres currently mirrors shadow tables only. With DB_MODE=postgres the backend
# REFUSES to start unless this flag acknowledges the SQLite primary store
# (database.ts guard: "SQLite fallback is disabled. Postgres connection is required.").
# Set to false only when a true Postgres primary write path ships.
SQLITE_FALLBACK_ENABLED=true

# MinIO artifact store credentials (compose starts MinIO with these; backend uses them as S3 client)
S3_ACCESS_KEY=aetherguard
S3_SECRET_KEY=change_me_s3_secret_key

# Optional: Admin email
ADMIN_EMAIL=admin@AetherGuard.com

# Optional: comma-separated API keys for external integrations
VALID_API_KEYS=

# Optional: comma-separated API keys for devices (current: Gateway Appliance; ESP32 device keys retained as legacy)
# Leave empty and docker-compose falls back to a known dev default (startup warning in production).
DEVICE_API_KEYS=

# Optional: cloud AI platform API key (empty = AI escalation routes start degraded; startup warning only)
PLATFORM_API_KEY=

# Optional: PEM public key for the physical confirmation hardware gate used by agents
AETHERGUARD_HARDWARE_GATE_PUBLIC_KEY=

# Optional: host ports for Docker compose
FRONTEND_PORT=8080
BACKEND_PORT=3005
REDIS_PORT=6379

# Optional: CORS origins for frontend host
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Optional: API rate limit engine switch (legacy | redis-lua)
API_RATE_LIMIT_ENGINE=legacy
