# ─────────────────────────────────────────────────────────────
# AetherGuard Environment Variables - copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# Required: Redis password (min 16 chars)
REDIS_PASSWORD=change_me_strong_password

# Required: JWT signing secret (min 32 chars) - GENERATE NEW ONE!
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# Required: Audit log signing secret (min 32 chars) - GENERATE NEW ONE!
AUDIT_LOG_SECRET=change_me_audit_log_secret_at_least_32_chars

# Required: Encryption key for agent secrets (min 32 chars) - GENERATE NEW ONE!
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Run: openssl rand -hex 32
ENCRYPTION_KEY=change_me_encryption_key_at_least_32_chars

# Required: Encryption salt for agent secrets (min 16 chars) - GENERATE NEW ONE!
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Run: openssl rand -hex 16
ENCRYPTION_SALT=change_me_encryption_salt_16chars

# Required: Admin password (min 12 chars, strong password required!)
# ⚠ Compose guard: docker-compose uses :? syntax — container will NOT start if this is unset.
# Must NOT be a known weak value (e.g. "change_me", "admin123"). Use a strong unique password.
ADMIN_PASSWORD=change_me_to_strong_admin_password

# Required for production gateway/device command signing (min 24 chars)
DEVICE_COMMAND_SECRET=change_me_device_command_secret_at_least_24_chars

# Optional: Admin email
ADMIN_EMAIL=admin@AetherGuard.com

# Optional: comma-separated API keys for external integrations
VALID_API_KEYS=

# Optional: comma-separated API keys for devices (current: Gateway Appliance; ESP32 device keys retained as legacy)
DEVICE_API_KEYS=

# Optional: PEM public key for the physical confirmation hardware gate used by agents
AETHERGUARD_HARDWARE_GATE_PUBLIC_KEY=

# Optional: host ports for Docker compose
FRONTEND_PORT=8080
BACKEND_PORT=3005
REDIS_PORT=6379

# Optional: CORS origins for frontend host
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Optional: API rate limit engine switch (legacy | redis-lua)
API_RATE_LIMIT_ENGINE=legacy
