{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherguard.local/schemas/asw/release.schema.json",
  "title": "Aether Security World - Frozen Dataset Release v0.1",
  "description": "manifest.json for a frozen release (e.g. ASW-v0.1). Once frozen it is immutable: any change is a new release_id, and downstream training projects read releases and never write back. REVISION 1: `split_statistics.group_overlap_audit` now carries `maxItems: 0`, so a non-empty audit is a schema violation rather than a prose wish; and `split_assignments` carries one row per split strategy, because brief §16 requires all eight OOD splits to be reproducible from the release, which a single-strategy manifest could not express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_commit",
    "schema_versions",
    "generator_prompt_hash",
    "source_world_count",
    "expanded_episode_count",
    "sample_count",
    "class_distribution",
    "attack_family_distribution",
    "app_distribution",
    "workflow_distribution",
    "evidence_distribution",
    "split_statistics",
    "split_assignments",
    "rejected_count",
    "validation_summary",
    "file_sha256"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^ASW-v[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[a-z0-9._-]+)?$"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "git_dirty": {
      "type": "boolean",
      "default": false
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "episode",
        "evidence",
        "policy",
        "oracle_output"
      ],
      "properties": {
        "world": {
          "type": "string"
        },
        "episode": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "oracle_output": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "world_spec": {
          "type": "string"
        }
      }
    },
    "generator_prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "model_version"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "world_count": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "valid_worlds_per_1k_tokens": {
            "type": "number",
            "minimum": 0
          },
          "provider": {
            "type": "string",
            "enum": [
              "replay",
              "live"
            ],
            "default": "replay"
          }
        }
      }
    },
    "source_world_count": {
      "type": "integer",
      "minimum": 0
    },
    "expanded_episode_count": {
      "type": "integer",
      "minimum": 0
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "class_distribution": {
      "$comment": "Keyed by observable_decision. world_truth distribution is reported separately so the abstention rate is never tuned to a target (brief §26).",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": [
        "safe",
        "attack",
        "insufficient_evidence"
      ]
    },
    "world_truth_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "attack_family_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "attack_family_reachability": {
      "$comment": "REVISION 1: for every declared attack_family, the number of probe actions on which the oracle actually produced world_truth=attack. A declared family with 0 reachable samples is a hard release failure - it means the world declares an attack it cannot express.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attack_family",
          "declared_worlds",
          "reachable_samples"
        ],
        "properties": {
          "attack_family": {
            "type": "string"
          },
          "declared_worlds": {
            "type": "integer",
            "minimum": 0
          },
          "reachable_samples": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "family_coverage": {
      "$comment": "REVISION 2 (task A6): witness-level reachability per (world, family). 'invariant' families are the world's declared invariant CATEGORIES; a witness is an episode where the invariant was actually EVALUATED (satisfied/violated, not skipped out of scope). 'failure' families are the spec-declared attack families; a witness is an attack episode whose violated category maps to the family (or whose world declares it). Families with zero witnesses are listed under 'unsupported' and are NEVER counted in supported_count - a world that declares a family it cannot express must be visible in the manifest, not silently dropped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_families",
        "failure_families",
        "supported_count",
        "unsupported_count",
        "unsupported"
      ],
      "properties": {
        "invariant_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/family_reachability_row" }
        },
        "failure_families": {
          "type": "array",
          "items": { "$ref": "#/$defs/family_reachability_row" }
        },
        "supported_count": { "type": "integer", "minimum": 0 },
        "unsupported_count": { "type": "integer", "minimum": 0 },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/family_reachability_row" }
        }
      }
    },
    "invariant_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "app_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "workflow_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "evidence_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "episode_length_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "counterfactual_family_count": {
      "type": "integer",
      "minimum": 0
    },
    "average_variants_per_world": {
      "type": "number",
      "minimum": 0
    },
    "split_statistics": {
      "$comment": "The PRIMARY strategy's summary. The full table for all eight strategies is split_assignments.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "group_key",
        "counts",
        "group_overlap_audit"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "iid",
            "world_ood",
            "app_ood",
            "workflow_ood",
            "policy_ood",
            "attack_ood",
            "evidence_ood",
            "generator_ood"
          ]
        },
        "group_key": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "group_overlap_audit": {
          "$comment": "REVISION 1: maxItems 0. A group key value appearing in two splits is a schema violation, not a note. Previously this was a free array and 'Must be empty' lived only in the description, so a release with a straddling counterfactual family validated cleanly.",
          "maxItems": 0,
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_key",
              "value",
              "splits"
            ],
            "properties": {
              "group_key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "splits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              }
            }
          }
        }
      }
    },
    "split_assignments": {
      "description": "REVISION 1: one entry per split strategy, so all eight brief §16 OOD splits are reproducible from the frozen release.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy",
          "group_key",
          "counts",
          "group_overlap_audit"
        ],
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "iid",
              "world_ood",
              "app_ood",
              "workflow_ood",
              "policy_ood",
              "attack_ood",
              "evidence_ood",
              "generator_ood"
            ]
          },
          "group_key": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "group_overlap_audit": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "rejection_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "duplicate_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dedup_strategy_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "validation_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "checked",
          "passed",
          "failed"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "checked": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "details": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "step5_token_usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_unique_worlds_per_1k_output_tokens": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "file_sha256": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "family_reachability_row": {
      "$comment": "REVISION 2 (task A6): one (world, family) reachability row. 'supported' is the honest flag - false means the world declared this family but no episode produced a witness for it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "world_id",
        "witnesses",
        "witness_episode_ids",
        "supported"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["invariant", "failure"]
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "world_id": {
          "type": "string",
          "minLength": 1
        },
        "witnesses": {
          "type": "integer",
          "minimum": 0
        },
        "witness_episode_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported": {
          "type": "boolean"
        }
      }
    }
  }
}
