{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherguard.local/schemas/asw/episode.schema.json",
  "title": "Aether Security World - Episode v0.1",
  "description": "A stateful security episode: an ordered history, a current event, the observation set, and the oracle's decision. An episode is the unit that enters the dataset; a bare HTTP request is never an episode. REVISION 1: `observation` is now split into `model_visible` (what a model may read) and `decision_metadata` (what only the oracle and the gates may read). Previously the model-visible side carried trust_level, attacker_controllable, required_for_decision, freshness, contradicts, evidence_availability_level and relevant/irrelevant_history - i.e. the answer key for exactly the abstention classes the design works hardest to build. `action` is now REQUIRED so a frozen release can be independently recomputed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "world_id",
    "world_family_id",
    "counterfactual_family_id",
    "variant_type",
    "action",
    "timeline",
    "current_event",
    "observation",
    "oracle_output"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^EP-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^W-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "world_family_id": {
      "$comment": "REVISION 1: DERIVED, never authored. world_family_id = 'WF-' + stable_hash(world structural skeleton) (design §10.1). An author-writable family id let a generator collapse the whole dataset into one leakage group (or, conversely, split one world's surface variants across splits).",
      "type": "string",
      "pattern": "^WF-[0-9a-f]{12,64}$"
    },
    "counterfactual_family_id": {
      "$comment": "REVISION 1: DERIVED, never authored. counterfactual_family_id = 'CF-' + stable_hash((world_family_id, world_id, seed, sorted(critical axes))).",
      "type": "string",
      "pattern": "^CF-[0-9a-f]{12,64}$"
    },
    "variant_type": {
      "type": "string",
      "enum": [
        "base",
        "critical_intervention",
        "irrelevant_perturbation",
        "evidence_masked",
        "trust_provenance_variant"
      ]
    },
    "split": {
      "$comment": "Assigned once, at release time, by the primary split strategy. The full multi-strategy table lives in release.manifest split_assignments.",
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "holdout"
      ]
    },
    "intervention": {
      "$comment": "Present iff variant_type == 'critical_intervention' (enforced by allOf/if-then below - revision 1: this used to be a plain optional property, so an intervention could be applied with no record of which variable moved).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_variable",
        "before",
        "after",
        "expected_effect"
      ],
      "properties": {
        "intervention_variable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "before": {},
        "after": {},
        "expected_effect": {
          "type": "string",
          "enum": [
            "verdict_flip",
            "verdict_invariant",
            "observable_downgrade"
          ]
        },
        "actual_effect": {
          "$comment": "Filled by the oracle/gate after evaluation; a mismatch with expected_effect is a Gate 5 rejection, never a relabel.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "verdict_flip",
            "verdict_invariant",
            "observable_downgrade",
            null
          ]
        }
      }
    },
    "action": {
      "$ref": "action.schema.json"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 1
    },
    "current_event": {
      "$ref": "#/$defs/event"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_visible",
        "decision_metadata"
      ],
      "properties": {
        "model_visible": {
          "$comment": "REVISION 1: the ONLY part of an episode a model may read. Closed sub-schemas below forbid every oracle-classification key: no trust_level, no attacker_controllable, no freshness, no contradicts, no evidence_availability_level, no relevant/irrelevant_history, no causal_tag. `provenance` and `timestamp` ARE visible - a real analyst knows a value came from a user-supplied header, and inferring trust from provenance is the skill being trained; handing over the oracle's own classification would be handing over the label.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "renderer",
            "request",
            "evidence",
            "timeline"
          ],
          "properties": {
            "renderer": {
              "type": "string",
              "enum": [
                "structured_state",
                "http_request",
                "reverse_proxy_log",
                "application_log",
                "audit_log",
                "api_gateway_record",
                "multi_event_trace",
                "mixed_evidence_bundle"
              ]
            },
            "current_time": {
              "description": "VirtualClock 'now' for this episode; freshness is derivable from evidence timestamps against it, which is why freshness itself stays in decision_metadata.",
              "type": "string"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "path"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "HEAD",
                    "OPTIONS"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "query": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {
                  "type": [
                    "object",
                    "array",
                    "string",
                    "null"
                  ]
                },
                "rendered_text": {
                  "$comment": "The exact bytes the model sees. Header ORDER lives here (revision 1: a JSON object header map is normalised away by canonical_json, so an order-only perturbation was both invisible and deduped - it is now carried by the rendered string). Cosmetic surface only: reordering headers, re-encoding or changing trace ids must never change the verdict.",
                  "type": "string"
                }
              }
            },
            "evidence": {
              "description": "Projection of decision_metadata.evidence_classification restricted to visible items and to these seven keys. Gate 2 asserts the projection is exact.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence_observation"
              }
            },
            "timeline": {
              "description": "History events WITHOUT causal_tag. Which history mattered is decision metadata, not an observation.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/event_observation"
              }
            }
          }
        },
        "decision_metadata": {
          "$comment": "REVISION 1: everything the oracle and the quality gates need and the model must never see. Excluded from serialize_for_model by construction, and asserted by test_model_visible_boundary.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_classification",
            "evidence_availability_level"
          ],
          "properties": {
            "evidence_classification": {
              "description": "Full evidence items with trust_level / freshness / attacker_controllable / contradicts. Includes both visible and masked items; `visible_in_observation` is the authoritative flag.",
              "type": "array",
              "items": {
                "$ref": "evidence.schema.json"
              }
            },
            "hidden_evidence_ids": {
              "description": "Ids present in the world catalog but masked out of this observation. Ids only - values are not duplicated here, so a leaked field cannot carry a hidden value.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "evidence_availability_level": {
              "type": "string",
              "enum": [
                "complete",
                "partially_missing",
                "minimally_sufficient",
                "insufficient",
                "contradictory",
                "stale",
                "attacker_controlled"
              ]
            },
            "relevant_history": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "irrelevant_history": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "causal_tags": {
              "$comment": "event_id -> relevant|irrelevant. The author's causal claim, verified by Gate 6: an event tagged irrelevant whose state_after feeds the decision ref closure is a Gate 6 failure.",
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "relevant",
                  "irrelevant"
                ]
              }
            }
          }
        }
      }
    },
    "oracle_output": {
      "$ref": "oracle-output.schema.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "pipeline_version"
      ],
      "properties": {
        "created_at": {
          "description": "VirtualClock value (design §8.1: wall-clock fields are VirtualClock-derived and excluded from the no-wall-clock data path).",
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "generator_provenance": {
          "$comment": "REVISION 1: closed key allowlist. This used to be an unconstrained object, so a spec's hypotheses (hypothesized_verdict / expected_effect / rationale) could ride into a frozen release. Because Gate 3/5 rejects families whose hypotheses DISAGREE with the oracle, surviving hypotheses are by construction label-consistent - publishing them hands the evaluator a near-perfect label predictor. Only non-semantic provenance keys survive.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_version",
            "prompt_version",
            "prompt_hash"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "model_version": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            },
            "prompt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_generation_id": {
              "type": "string"
            },
            "decoding_parameters": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "validation_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate",
              "passed"
            ],
            "properties": {
              "gate": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "split_assignments": {
      "$comment": "REVISION 1: one row per split strategy (design §10.3). Previously an episode carried a single `split`, so a frozen release could express only one of the eight OOD strategies required by brief §16.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy",
          "group_key",
          "split"
        ],
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "iid",
              "world_ood",
              "app_ood",
              "workflow_ood",
              "policy_ood",
              "attack_ood",
              "evidence_ood",
              "generator_ood"
            ]
          },
          "group_key": {
            "type": "string"
          },
          "split": {
            "type": "string",
            "enum": [
              "train",
              "validation",
              "test",
              "holdout"
            ]
          }
        }
      }
    },
    "group_keys": {
      "$comment": "REVISION 2: the twelve derived group-key VALUES stamped onto the episode at assembly time (design §10.1; task A7). They are DERIVED, never authored - the same pure functions in security_world/model/grouping.py drive split assignment, leakage audit and this stamping, so the three cannot drift. Gate 2 asserts (a) every key is present and non-empty and (b) each declaration-independent value equals its re-derived value. The schema keeps the field optional so historical documents still load; the GATE makes it mandatory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterfactual_family_id",
        "world_family_id",
        "policy_graph_hash",
        "workflow_template_hash",
        "attack_family",
        "semantic_scenario_signature",
        "app_domain",
        "generator_id",
        "generator_model_family",
        "policy_family_id",
        "workflow_family_id",
        "invariant_family_id"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "counterfactual_family_id": {
          "$ref": "#/$defs/group_key_family_id"
        },
        "world_family_id": {
          "$ref": "#/$defs/group_key_family_id"
        },
        "policy_family_id": {
          "$ref": "#/$defs/group_key_family_id"
        },
        "workflow_family_id": {
          "$ref": "#/$defs/group_key_family_id"
        },
        "invariant_family_id": {
          "$ref": "#/$defs/group_key_family_id"
        },
        "policy_graph_hash": {
          "$ref": "#/$defs/group_key_hash"
        },
        "workflow_template_hash": {
          "$ref": "#/$defs/group_key_hash"
        },
        "semantic_scenario_signature": {
          "$ref": "#/$defs/group_key_hash"
        },
        "attack_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "app_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generator_model_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "REVISION 1: this conditional is what actually enforces 'an intervention must leave a record'. Verified by schemas/examples/episode.invalid.json (rejected) and by scripts/validate_schemas.py, which now asserts the rejection PATH, not merely that a rejection happened.",
      "if": {
        "properties": {
          "variant_type": {
            "const": "critical_intervention"
          }
        },
        "required": [
          "variant_type"
        ]
      },
      "then": {
        "required": [
          "intervention"
        ]
      }
    },
    {
      "$comment": "Phase 2B: a trust_provenance_variant re-attributes one evidence item (source / provenance / trust / freshness) while keeping its asserted value. It must leave the same record of what moved, otherwise the model is asked to infer a change it cannot see.",
      "if": {
        "properties": {
          "variant_type": {
            "const": "trust_provenance_variant"
          }
        },
        "required": [
          "variant_type"
        ]
      },
      "then": {
        "required": [
          "intervention"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "variant_type": {
            "const": "irrelevant_perturbation"
          }
        },
        "required": [
          "variant_type"
        ]
      },
      "then": {
        "required": [
          "intervention"
        ]
      }
    }
  ],
  "$defs": {
    "group_key_family_id": {
      "$comment": "REVISION 2: derived family ids (world WF-, counterfactual CF-, policy PF-, workflow WFF-, invariant IF-) are prefix + 12..64 hex, exactly like world_family_id/counterfactual_family_id above. The family ids are the first 12 hex chars of the corresponding structural hash, so they are 1:1 with policy_graph_hash / workflow_template_hash / invariant_family_hash.",
      "type": "string",
      "pattern": "^(WF|CF|PF|WFF|IF)-[0-9a-f]{12,64}$"
    },
    "group_key_hash": {
      "$comment": "REVISION 2: full sha256 hex digests used as group-key values (policy_graph_hash / workflow_template_hash / semantic_scenario_signature).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_observation": {
      "$comment": "REVISION 1: closed seven-key projection. The model may read what a piece of evidence asserts, where it came from and when - not how the oracle classified it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "type",
        "asserts_ref",
        "value",
        "source",
        "provenance",
        "timestamp"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "asserts_ref": {
          "$comment": "REVISION 2: the canonical ID-view path BNF (design §4.3) - the SAME pattern as evidence.schema.json, world.schema.json cached_subject and policy.schema.json ref paths. There is exactly one path grammar in this project; this projection must not be a second, laxer notation (task A3).",
          "type": "string",
          "pattern": "^(actor|resource|session|token|workflow|workflow_instance|cache|service|credential|role)\\.[A-Za-z0-9][A-Za-z0-9._-]{0,62}(\\.[A-Za-z0-9_]+)+$"
        },
        "value": {},
        "source": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "event_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "t_index",
        "at",
        "event_type",
        "actor_id"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "t_index": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 512
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "denied",
            "error",
            "unknown"
          ]
        },
        "emitted_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "t_index",
        "at",
        "event_type",
        "actor_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVT-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "t_index": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "login",
            "logout",
            "mfa_challenge",
            "resource_created",
            "resource_updated",
            "permission_changed",
            "role_changed",
            "token_issued",
            "token_used",
            "token_revoked",
            "privilege_downgraded",
            "password_reset",
            "account_disabled",
            "account_enabled",
            "session_revoked",
            "workflow_transition",
            "cache_populated",
            "cache_invalidated",
            "sensitive_operation",
            "request",
            "other"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^ACT-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "state_before": {
          "$ref": "#/$defs/state_fragment"
        },
        "state_after": {
          "$ref": "#/$defs/state_fragment"
        },
        "emitted_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "causal_tag": {
          "type": "string",
          "enum": [
            "relevant",
            "irrelevant"
          ],
          "default": "relevant"
        },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "denied",
            "error",
            "unknown"
          ]
        }
      }
    },
    "state_fragment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor_states": {
          "type": "object",
          "additionalProperties": true
        },
        "session_states": {
          "type": "object",
          "additionalProperties": true
        },
        "token_states": {
          "type": "object",
          "additionalProperties": true
        },
        "resource_states": {
          "type": "object",
          "additionalProperties": true
        },
        "workflow_states": {
          "type": "object",
          "additionalProperties": true
        },
        "cache_states": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
