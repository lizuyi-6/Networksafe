{
  "name": "aetherguard-gateway-simulator",
  "version": "1.0.0",
  "description": "Software simulation of AetherGuard Gateway Appliance (M1-M4) for control-loop verification",
  "scripts": {
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "sim": "ts-node sim.ts",
    "test:invalid-sig": "ts-node test-scenarios.ts --trigger=invalid-signature",
    "test:counter-rollback": "ts-node test-scenarios.ts --trigger=counter-rollback",
    "test:heartbeat-stale": "ts-node test-scenarios.ts --trigger=heartbeat-stale",
    "test:estop": "ts-node test-scenarios.ts --trigger=estop"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
