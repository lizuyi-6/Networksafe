# Default: text files normalize to LF in the repo, render with native EOL.
* text=auto eol=lf

# Source — always LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.py text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.gz binary
*.db binary
*.sqlite binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.bin binary
*.elf binary
*.so binary
*.dll binary
*.exe binary
*.docx binary
*.xlsx binary
*.pptx binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
