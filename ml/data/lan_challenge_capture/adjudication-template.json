{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adjudication record for one disagreement between Reviewer A and Reviewer B",
  "description": "Template for resolving a single sampleId where reviewerA and reviewerB disagree. One record per disagreement. All fields required except where noted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sampleId", "disagreementField", "reviewerALabel", "reviewerBLabel", "finalResolution", "adjudicator", "rationale", "resolvedAt"],
  "properties": {
    "sampleId": { "type": "string", "pattern": "^viguard-lan-[0-9]{6}$" },
    "disagreementField": {
      "type": "string",
      "enum": ["verdict", "attackFamily", "recommendedAction", "contextSufficient", "requestIntent", "exploitOutcome"],
      "description": "The field on which A and B disagreed."
    },
    "reviewerALabel": { "type": ["string", "boolean", "null"], "description": "Reviewer A's value for the disputed field." },
    "reviewerBLabel": { "type": ["string", "boolean", "null"], "description": "Reviewer B's value for the disputed field." },
    "finalResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "attackFamily", "recommendedAction", "contextSufficient", "requestIntent", "exploitOutcome"],
      "properties": {
        "verdict": { "type": "string", "enum": ["attack", "benign", "unknown"] },
        "attackFamily": { "type": ["string", "null"] },
        "recommendedAction": { "type": "string", "enum": ["allow", "block", "review", "monitor"] },
        "contextSufficient": { "type": "boolean" },
        "requestIntent": { "type": "string", "enum": ["malicious_attempt", "prompt_injection_attempt", "benign_operational", "benign_resembling_attack", "ambiguous_or_inconclusive"] },
        "exploitOutcome": { "type": "string", "enum": ["confirmed", "not_confirmed", "not_applicable"] }
      }
    },
    "adjudicator": { "type": "string", "description": "Identifier of the adjudicator (role or pseudonymous id, not a real name)." },
    "rationale": { "type": "string", "minLength": 1, "description": "Request-side evidence justifying the resolution (do not rely on response outcome to relabel a malicious attempt as benign)." },
    "resolvedAt": { "type": "string", "description": "ISO-8601 timestamp of adjudication." }
  }
}
