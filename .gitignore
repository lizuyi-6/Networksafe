# Generated security-test reports (re-run with `npm run eval:owasp`)
security-tests/reports/

# Generated PCB manufacturing outputs (re-built from KiCad sources)
# Ignore the whole release/ tree: gerbers, drill, BOM, pick-and-place,
# DRC/ERC reports, assembly PDFs, export logs, preview renders.
hardware/kicad/**/release/
hardware/kicad/**/*.drc
hardware/kicad/**/*.rpt
hardware/kicad/**/*.erc
/esp32-serial-deployer-pcb-erc.rpt
hardware/kicad/**/erc.log
hardware/kicad/**/drc.log
hardware/kicad/**/fp-info-cache
hardware/kicad/**/-cache.lib
hardware/kicad/**/*-bak
hardware/kicad/**/*.bak

# Rust fastpath build artifacts
rust-fastpath/target/

# Bundled third-party routing/JDK tooling inside archived KiCad trees
# (freerouting installer + JRE — large, regenerable, must not be tracked)
hardware/kicad/**/tools/freerouting/
hardware/kicad/**/tools/jre*/
hardware/kicad/**/*.msi
hardware/kicad/**/*.jar
hardware/kicad/**/tools/**/*.exe

