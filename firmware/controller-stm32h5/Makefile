# AetherGuard Gateway Controller (M2) - STM32H563ZI Makefile
#
# NOTE: This is a template. The full Makefile is generated by STM32CubeMX
# when you create the project from controller-stm32h5.ioc. The generated
# Makefile includes all HAL/CMSIS source files and correct linker paths.
#
# This template shows the application source files to add to the build.
#
# Usage:
#   1. Open controller-stm32h5.ioc in STM32CubeMX
#   2. Configure peripherals (see README.md)
#   3. Generate code (Project Manager → Makefile)
#   4. Add these application sources to the generated Makefile C_SOURCES
#   5. make -j$(nproc)

# Toolchain
CC = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy
SIZE = arm-none-eabi-size

# Application sources (add to generated Makefile C_SOURCES)
APP_SOURCES = \
Core/Src/main.c \
Core/Src/controller_tasks.c \
Core/Src/serial_json.c \
Core/Src/se_driver.c \
Core/Src/interlock_driver.c

# Include paths (add to generated Makefile C_INCLUDES)
APP_INCLUDES = \
-ICore/Inc

# Build (stub — real build uses generated Makefile)
# See README.md for full workflow.
.PHONY: help
help:
	@echo "See README.md for STM32CubeMX project generation workflow"
	@echo "Application sources to add to generated Makefile:"
	@echo "  $(APP_SOURCES)"
